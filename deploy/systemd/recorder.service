[Unit]
Description=qrackpot UDP recorder (mpegts .ts for Track 2)
After=network.target
PartOf=pipeline.service

[Service]
Type=simple
User=anmolmohan_turingsdesign_com
WorkingDirectory=/mnt/data/sportscomm
EnvironmentFile=/etc/sportscomm/pipeline.env
ExecStartPre=/bin/mkdir -p /mnt/data/sportscomm/files/logs/deliveries/${BMF_SESSION_ID}
ExecStart=/usr/bin/ffmpeg -y -hide_banner -loglevel warning \
    -fflags +genpts -err_detect ignore_err \
    -i "udp://0.0.0.0:9998?fifo_size=1000000&overrun_nonfatal=1" \
    -c copy -f mpegts \
    /mnt/data/sportscomm/files/logs/deliveries/${BMF_SESSION_ID}/match_${BMF_SESSION_ID}.ts
Restart=always
RestartSec=10s
StandardOutput=append:/var/log/sportscomm/recorder.log
StandardError=append:/var/log/sportscomm/recorder-err.log

[Install]
WantedBy=multi-user.target
