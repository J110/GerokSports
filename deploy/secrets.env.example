# Copy to /etc/sportscomm/secrets.env on the VM (sudo, perms 0600)
# Production secrets — do NOT commit real values

# Groq — main Scout / OpenScout / Scorer
GROQ_API_KEY=

# Fireworks AI — for Qwen delivery detection (Phase 1+)
FIREWORKS_API_KEY=

# OpenRouter — experimentation
OPENROUTER_API_KEY=

# Cricbuzz match identity (transitional — until phased out)
CRICBUZZ_MATCH_ID=
CRICBUZZ_MATCH_SLUG=

# Pipeline tuning
USE_OPEN_SCOUT=1
OPENSCOUT_DECOUPLED=1
SCOUT_RAW_DUMP=1
PYTHONUNBUFFERED=1
SHADOW_DELIVERY_DETECTOR=1
