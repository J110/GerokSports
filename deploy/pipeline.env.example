# Pipeline runtime env — copy to /etc/sportscomm/pipeline.env on the VM
# perms: 0600, owner: root

# Required API keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Cricbuzz match identity
CRICBUZZ_MATCH_ID=152097
CRICBUZZ_MATCH_SLUG=rcb-vs-mi-54th-match-indian-premier-league-2026

# Frame source: 'file' for replay, 'srt' for live (Phase 1 work)
FRAME_SOURCE=file
FRAME_FILE_PATH=/mnt/data/recordings/match_replay.mp4

# Pipeline tuning (carried from yesterday's hot-patches)
USE_OPEN_SCOUT=1
OPENSCOUT_DECOUPLED=1
SCOUT_RAW_DUMP=1
SHADOW_DELIVERY_DETECTOR=0
PYTHONUNBUFFERED=1
SKIP_PREMATCH_S=400

# Optional: SCOUT_REPLAY_LOG to skip Groq calls, replay from cache
# SCOUT_REPLAY_LOG=/mnt/data/recordings/scout_raw.jsonl
