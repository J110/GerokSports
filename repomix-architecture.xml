2763:     def _add_fow(self, wicket_num: int | None, batter: str,
2764:                  score: int | str | None, overs: str | None,
2765:                  how: str | None = None, bowler: str | None = None):
2766:         """Add or upgrade a FOW entry. Confirmed entries are immutable.
2767: 
2768:         Three cases for an existing slot at the same wicket number:
2769:           1. Placeholder (batter ∈ {None, "", "unknown"}): UPGRADE
2770:              with the new details (this is exactly what placeholders
2771:              exist for).
2772:           2. Real entry, same batter: idempotent re-write — silently
2773:              skip (we may have rolled through this dismissal twice).
2774:           3. Real entry, different batter:
2775:              a. SCOREBOARD-PROVABLY-WRONG existing entry — replace
2776:                 in place. The "existing" batter is provably wrong
2777:                 when they're currently still batting (`status ==
2778:                 "batting"`) or never came in at all (`yet_to_bat`).
2779:                 Cricket law: a batter cannot be dismissed AND still
2780:                 be at the crease. The new dismissal is the truth
2781:                 and we MUST rewrite W{wk} so we don't bump to W{wk+1}
2782:                 and outrun the team's wicket counter.
2783:              b. Otherwise REFUSE the rewrite (immutable history).
2784:         """
2785:         wk = int(wicket_num or 0)
2786:         if wk <= 0:
2787:             wk = len(self.fall_of_wickets) + 1
2788: 
2789:         # Cold-start back-fill placeholders carry score="?" / overs="?"
2790:         # because the wicket fell BEFORE the pipeline started observing.
2791:         # A fresh dismissal that arrives later (with a real score/overs)
2792:         # is for a DIFFERENT wicket — typically the next one — not
2793:         # the historic one. Promote `wk` to the next free slot in
2794:         # that case so we don't smash Cricbuzz-known history.
2795:         #
2796:         # IMPORTANT: only promote when the new dismissal is genuinely
2797:         # for a *future* wicket — i.e. the team's wickets counter
2798:         # has already advanced past `wk`. If wk == total wickets,
2799:         # the new dismissal IS the wk-th wicket and should upgrade
2800:         # the back-fill in place (the back-fill was a guess that's
2801:         # now being proven correct).
2802:         _team_wkts = int(self._inn.get("wickets") or 0)
2803:         for existing in self.fall_of_wickets:
2804:             if existing.get("wicket") == wk:
2805:                 _ex_score = existing.get("score")
2806:                 _ex_overs = existing.get("overs")
2807:                 _is_backfill = (
2808:                     existing.get("tentative", False)
2809:                     and (_ex_score in (None, "?", "")
2810:                          or _ex_overs in (None, "?", "")))
2811:                 if (_is_backfill
2812:                         and score is not None and score != "?"
2813:                         and overs is not None and overs != "?"
2814:                         and _team_wkts > wk):
2815:                     new_wk = len(self.fall_of_wickets) + 1
2816:                     log.info(
2817:                         f"[FOW] W{wk} is cold-start back-fill "
2818:                         f"(unknown score/overs); fresh dismissal "
2819:                         f"{batter} at {score}/{overs} routed to "
2820:                         f"W{new_wk} instead (team_wkts="
2821:                         f"{_team_wkts}).")
2822:                     wk = new_wk
2823:                     break
2824: 
2825:         for existing in self.fall_of_wickets:
2826:             if existing.get("wicket") == wk:
2827:                 _existing_batter = existing.get("batter")
2828:                 _is_tentative = existing.get("tentative", False)
2829:                 _is_unwitnessed = existing.get("_unwitnessed", False)
2830:                 if (_existing_batter in (None, "", "unknown")
2831:                         or _is_tentative
2832:                         or _is_unwitnessed):
2833:                     existing["batter"] = batter
2834:                     existing["score"] = score
2835:                     existing["overs"] = overs
2836:                     if how:
2837:                         existing["how"] = how
2838:                     if bowler:
2839:                         existing["bowler"] = bowler
2840:                     existing.pop("tentative", None)
2841:                     existing.pop("_unwitnessed", None)
2842:                     existing["_witnessed"] = True
2843:                     _flag_str = []
2844:                     if _is_unwitnessed:
2845:                         _flag_str.append("was _unwitnessed")
2846:                     if _is_tentative:
2847:                         _flag_str.append("was tentative")
2848:                     _flag_suf = (f" ({', '.join(_flag_str)})"
2849:                                  if _flag_str else "")
2850:                     log.info(f"[FOW] Upgraded placeholder W{wk}: "
2851:                              f"{batter} at {score}/{wk} ({overs})"
2852:                              f"{_flag_suf}")
2853:                     # Fix 10 (2026-04-26, Path A): post-witnessed
2854:                     # dismissal slot-rotation hook.  Fires on the
2855:                     # placeholder→witnessed upgrade.  Closes the
2856:                     # rotation gap observed in CSK-vs-GT (Sarfaraz,
2857:                     # Dube, Overton) where `_auto_dismiss_for_new_
2858:                     # batter` flips status="out" without clearing
2859:                     # `_inn["striker"]` / `["non_striker"]`.  See
2860:                     # helper docstring for full rationale.
2861:                     self._post_witnessed_dismissal_slot_rotation(
2862:                         batter)
2863:                     # Fire FOW-upgrade callback (Fix 3): pass the
2864:                     # legal-ball index parsed from `overs="X.Y"`.
2865:                     # Wrapped in try/except so a misbehaving consumer
2866:                     # cannot poison the FOW write path itself.
2867:                     if self.on_fow_upgrade is not None and overs:
2868:                         try:
2869:                             _ball_y = int(str(overs).split(".")[-1])
2870:                             if _ball_y > 0:
2871:                                 self.on_fow_upgrade(_ball_y)
2872:                         except (ValueError, IndexError, Exception) as _e:
2873:                             log.warn(
2874:                                 f"[FOW-REORDER] callback raised "
2875:                                 f"{type(_e).__name__}: {_e}; "
2876:                                 f"continuing without reorder")
2877:                 elif _existing_batter == batter:
2878:                     log.info(f"[FOW] Idempotent re-add of W{wk} "
2879:                              f"({batter}) — no change")
2880:                 else:
2881:                     # Witnessed FOW entries are IMMUTABLE.  The
2882:                     # legacy "provably wrong" rewrite path that used
2883:                     # to overwrite based on `batting_card` status
2884:                     # was the source of the Jofra-Archer→Vaibhav-
2885:                     # Sooryavanshi flip on 2026-04-19: a real
2886:                     # wicket event correctly populated W6 with
2887:                     # Archer, but a later wicket event for a batter
2888:                     # whose card status was momentarily "yet_to_bat"
2889:                     # tripped the rewrite and silently replaced the
2890:                     # confirmed Archer entry.
2891:                     #
2892:                     # New rule: once an entry is witnessed
2893:                     # (populated by `_add_fow` from a real ball
2894:                     # event), it can never be rewritten.  If the
2895:                     # new dismissal genuinely belongs to W{wk}
2896:                     # (rare — would imply W{wk-1}…W{wk} all
2897:                     # mis-fired), we surface the conflict in the
2898:                     # log so the underlying mis-attribution is
2899:                     # visible, rather than papering over it.
2900:                     log.warn(
2901:                         f"[FOW] Rewrite REFUSED for W{wk}: "
2902:                         f"witnessed entry {_existing_batter} is "
2903:                         f"immutable; new dismissal {batter} at "
2904:                         f"{score}/{overs} not applied. If this is "
2905:                         f"a real wk-conflict, investigate the "
2906:                         f"upstream wicket-counter / striker state "
2907:                         f"that produced the duplicate W{wk}.")
2908:                 return
2909: 
2910:         fow = {"wicket": wk, "score": score, "overs": overs,
2911:                "batter": batter, "_witnessed": True}
2912:         if how:
2913:             fow["how"] = how
2914:         if bowler:
2915:             fow["bowler"] = bowler
