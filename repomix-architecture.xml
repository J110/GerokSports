1480: def _extract_stat_pairs(raw: str) -> list[tuple[int, int]]:
1481:     """Extract runs(balls) pairs from a raw string.
1482:     '9(7) 12(8)' → [(9,7), (12,8)]
1483:     'SURYAKUMAR ROHIT 9 7 12 8' → [(9,7), (12,8)]"""
1484:     pairs = re.findall(r'(\d+)\s*\((\d+)\)', raw)
1485:     if pairs:
1486:         return [(int(a), int(b)) for a, b in pairs]
1487:     nums = re.findall(r'\d+', raw)
1488:     if len(nums) >= 4:
1489:         return [(int(nums[i]), int(nums[i + 1]))
1490:                 for i in range(0, len(nums) - 1, 2)]
1491:     return []
