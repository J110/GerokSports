3900:     def _find_player_team(name: str) -> str | None:
3901:         """Resolve a player name to its team using the scraped squads.
3902: 
3903:         Returns None for unknown / ambiguous / placeholder names so the
3904:         caller can treat the card as 'too incomplete to judge'.
3905:         """
3906:         if not name:
3907:             return None
3908:         up = name.upper().strip()
3909:         if _is_placeholder(up):
3910:             return None
3911:         hit = _UPPER_TO_TEAM.get(up)
3912:         if hit and hit != "__AMBIGUOUS__":
3913:             return hit
3914:         # Last-token fallback (broadcast often shows "V SOORYAVANSHI")
3915:         parts = up.split()
3916:         if len(parts) > 1 and len(parts[-1]) >= 4:
3917:             hit = _UPPER_TO_TEAM.get(parts[-1])
3918:             if hit and hit != "__AMBIGUOUS__":
3919:                 return hit
3920:         # Substring sweep — last resort
3921:         for key, team in _UPPER_TO_TEAM.items():
3922:             if team == "__AMBIGUOUS__" or len(key) < 4:
3923:                 continue
3924:             if up == key or up in key or key in up:
3925:                 return team
3926:         return None
