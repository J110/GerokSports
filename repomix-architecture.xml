 983: def _should_latch_innings_1_candidate(
 984:         cand_score: int, cand_wkts: int, cand_overs_raw,
 985:         existing_score: int, existing_wkts: int) -> tuple[bool, str | None]:
 986:     """Decide whether a candidate innings-1 final should overwrite
 987:     the latched value via max-wins logic, gated by T20 sanity bounds.
 988: 
 989:     Returns (should_latch, reject_reason).  When `should_latch` is
 990:     False, `reject_reason` is "sanity_bound" if the candidate is
 991:     impossibly high (extractor hallucination) or "max_wins_lost" if
 992:     the candidate is legitimate but doesn't beat the existing latch.
 993:     """
 994:     try:
 995:         cand_overs_f = float(cand_overs_raw)
 996:     except (TypeError, ValueError):
 997:         cand_overs_f = -1.0
 998:     if (cand_overs_f > _INNINGS_TOTAL_MAX_OVERS
 999:             or cand_score > _INNINGS_TOTAL_MAX_SCORE):
1000:         return False, "sanity_bound"
1001:     if (cand_score > existing_score
1002:             or (cand_score == existing_score
1003:                 and cand_wkts > existing_wkts)):
1004:         return True, None
1005:     return False, "max_wins_lost"
