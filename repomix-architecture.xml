4075:     # Centralised innings-change execution (Rule 2). Triggered by the
4076:     # deterministic 20-over / 10-wicket triggers OR the broadcast-signal
4077:     # consensus path. Idempotent: scoreboard.set_innings_2 + the
4078:     # _innings_reset_done_for tracker each guard against double-firing.
4079:     def execute_innings_change(source: str, target: int | None = None) -> bool:
4080:         nonlocal team_locked, _bowling_team_strip_count
4081:         nonlocal pending_innings_2, pending_target, _inn2_consecutive
4082:         nonlocal batting_team, bowling_team
4083:         nonlocal _inn_break_pending, _inn_break_pending_frame
4084:         nonlocal _inn_break_pending_source
4085:         if scoreboard.current_innings >= 2:
4086:             return False
4087:         prev_score = int(scoreboard._inn.get("score") or 0) \
4088:             if scoreboard._inn else 0
4089:         prev_overs = scoreboard._inn.get("overs") if scoreboard._inn else None
4090:         prev_wkts = int(scoreboard._inn.get("wickets") or 0) \
4091:             if scoreboard._inn else 0
4092:         derived_target = target
4093:         if derived_target is None and prev_score > 0:
4094:             derived_target = prev_score + 1
4095: 
4096:         # Cold-start mid-innings-2 detection.
4097:         #
4098:         # Two independent signals — either is sufficient:
4099:         #
4100:         # (1) `frame_count <= 20` — pipeline just started, hasn't had
4101:         #     time to observe a full first innings.
4102:         #
4103:         # (2) Current "innings 1" state is *physically incompatible*
4104:         #     with a completed innings 1: overs < 18.0 AND wickets < 8.
4105:         #     Cricket physics: an innings cannot end at, e.g., 2.2 ov
4106:         #     / 2 wkts.  If we discover via a target hint that we're
4107:         #     in innings 2 while our "innings 1" tracker is at 20/2
4108:         #     (2.2), we never actually were in innings 1 — the
4109:         #     cold-start assigned the visible (chasing) team to
4110:         #     innings 1 and we accumulated chase data into the wrong
4111:         #     slot.
4112:         #
4113:         # (3) Pre-fix: 2026-04-19 KKR/RR cold-start at F61 with
4114:         #     pipeline state KKR 20/2 (2.2) ⇒ scorer reads target=156
4115:         #     ⇒ executes the *real* innings change ⇒ blanks the 20/2
4116:         #     to 0/0 AND swaps teams (KKR→bowling).  The `delta>7`
4117:         #     poison guard then blocked every legitimate 22/25/29
4118:         #     score reading because tracker had been wiped to 0.
4119:         #     Pipeline frozen at 0/0 inn 2 forever.
4120:         cold_start_inn2_by_frame = (frame_count <= 20)
4121:         # Use floats safely — `prev_overs` is a string like "2.2".
4122:         try:
4123:             _prev_overs_f = (
4124:                 float(prev_overs) if prev_overs is not None else 0.0)
4125:         except (ValueError, TypeError):
4126:             _prev_overs_f = 0.0
4127:         cold_start_inn2_by_state = (
4128:             _prev_overs_f < 18.0 and prev_wkts < 8)
4129:         cold_start_inn2 = (
4130:             cold_start_inn2_by_frame or cold_start_inn2_by_state)
4131:         log.info(
4132:             f"  [INNINGS-CHANGE] source={source}  inn1 final="
4133:             f"{prev_score}/{prev_wkts} ({prev_overs})  target="
4134:             f"{derived_target}  cold_start_inn2={cold_start_inn2} "
4135:             f"(by_frame={cold_start_inn2_by_frame} "
4136:             f"by_state={cold_start_inn2_by_state})  "
4137:             f"frame={frame_count}")
4138: 
4139:         if cold_start_inn2:
4140:             # Preserve the state we built up during cold-start —
4141:             # it was actually innings 2 the whole time.  RELABEL
4142:             # innings[1] → innings[2] without blanking.  Without
4143:             # this the score / batter / bowler progress (which is
4144:             # *real* observed data) gets wiped to 0/0 and the
4145:             # delta>7 poison guard then blocks every recovery
4146:             # frame, freezing the pipeline at 0/0 inn 2.
4147:             if (scoreboard.current_innings == 1
4148:                     and scoreboard._inn):
4149:                 _carry = dict(scoreboard._inn)
4150:                 if derived_target is not None:
4151:                     _carry["target"] = derived_target
4152:                 scoreboard.innings[2] = _carry
4153:                 scoreboard.innings[1] = scoreboard._blank()
4154:                 scoreboard.current_innings = 2
4155:                 # Mark inn-2 reset as already done so a later
4156:                 # `set_innings_2` call (e.g. via the deterministic
4157:                 # path firing on a stale frame) won't blank what we
4158:                 # just preserved.
4159:                 scoreboard._innings2_reset_done = True
4160:             else:
4161:                 scoreboard.set_innings_2(derived_target)
4162:             log.info(
4163:                 f"  [INNINGS-CHANGE] cold-start path: relabelled "
4164:                 f"inn1→inn2 (preserved {prev_score}/{prev_wkts} "
4165:                 f"({prev_overs})), batting={batting_team} "
4166:                 f"bowling={bowling_team} (no swap — team roles "
4167:                 f"match the visible strip)")
4168:         else:
4169:             scoreboard.set_innings_2(derived_target)
4170:             team_locked = False
4171:             new_bat = bowling_team
4172:             new_bowl = batting_team
4173:             if new_bat and new_bowl:
4174:                 assign_teams(new_bat, new_bowl, innings=2)
4175:                 team_locked = True
4176:             else:
4177:                 log.warn(
4178:                     "  [INNINGS-CHANGE] Teams unknown at transition "
4179:                     "— leaving null; cold-start will re-derive from "
4180:                     "innings-2 broadcast.")
4181:         if ball_analyzer:
4182:             ball_analyzer.on_innings_change(2)
4183:         reset_for_innings(2)
4184:         _bowling_team_strip_count = 0
4185:         pending_innings_2 = False
4186:         pending_target = None
4187:         _inn2_consecutive = 0
4188:         _inn_break_pending = False
4189:         _inn_break_pending_frame = 0
4190:         _inn_break_pending_source = None
4191:         return True
