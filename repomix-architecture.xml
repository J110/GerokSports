2924:     def _post_witnessed_dismissal_slot_rotation(
2925:             self, dismissed: str | None) -> None:
2926:         """Post-witnessed-FOW slot-clear / rotation invariant
2927:         (Fix 10, Path A — 2026-04-26).
2928: 
2929:         Cricket physics: a witnessed-out batter cannot retain
2930:         occupancy of either active crease slot
2931:         (``self._inn["striker"]`` / ``["non_striker"]``).  This
2932:         hook fires from `_add_fow` after stamping
2933:         ``_witnessed=True`` on a FOW entry (both the
2934:         placeholder-upgrade and new-entry creation paths).
2935: 
2936:         Three behaviours by case:
2937: 
2938:           1. Dismissed batter occupied **striker** slot only.
2939:              Rotate the surviving non_striker into the striker
2940:              slot; clear non_striker pending new-batter
2941:              admission.  Mirrors typical post-wicket broadcast
2942:              state at end-of-over (when ends swap) and
2943:              converges to the correct mid-over state within
2944:              1–2 strip reads when the new batter actually
2945:              faces.
2946: 
2947:           2. Dismissed batter occupied **non_striker** slot
2948:              only.  Clear non_striker; striker unchanged.
2949:              Run-out at the non-striker end is the most common
2950:              path here.
2951: 
2952:           3. Dismissed name in **neither** slot.  Two sub-
2953:              cases observed in production:
2954:              (a) Cold-start back-fill of historic wickets
2955:                  where current crease state legitimately
2956:                  reflects a much later innings stage than the
2957:                  upgraded wicket: no-op (correct).
2958:              (b) **Real-time delayed witness — placeholder
2959:                  window outlived crease rotation** (Fix 13,
2960:                  Path D extension, 2026-04-26).  Powell W4
2961:                  placeholder added at F179 (`_unwitnessed`),
2962:                  upgraded at F258 (~2 min / 79 frames later);
2963:                  in the gap, broadcast had already rotated the
2964:                  crease past Powell's tenure, so the slot
2965:                  check no-ops.  But the dismissal still needs
2966:                  to commit to `batting_card.status="out"` and
2967:                  `active_batters` removal — `_add_fow` doesn't
2968:                  propagate either of those.  Path D adds Case
2969:                  5 below to handle this sub-case.
2970: 
2971:           4. Anomaly: dismissed name occupied **both** slots
2972:              (e.g. striker self-collision Fix 5 didn't catch).
2973:              Defensive clear of both with WARN log.
2974: 
2975:           5. (Fix 13, Path D, 2026-04-26) Dismissed name not
2976:              in either slot, but present in `batting_card`
2977:              with status="batting".  Card-side propagation:
2978:              flip `batting_card[name].status = "out"`.
2979:              Distinct telemetry tag
2980:              `[POST-WICKET-CARD-PROPAGATE]` separates this
2981:              from regular slot-rotation fires.  Same root
2982:              cricket-physics invariant (a witnessed-out
2983:              batter cannot be active anywhere), just a
2984:              different state surface than the crease slots.
2985:              Derived views (`_extractor_batter_names`,
2986:              transient active-batter lists in scorer-decision
2987:              paths) are recomputed from `batting_card.status`
2988:              downstream, so flipping the card propagates to
2989:              those views without direct mutation.
2990: 
2991:         Why hook here and not at the four ``status="out"``
2992:         callsites:  ``dismiss_batter()`` (line 2763) already
2993:         clears slots explicitly, but
2994:         ``_auto_dismiss_for_new_batter`` (line 1528) and the
2995:         ``validate_state_consistency`` demote paths (3091,
2996:         3124) flip status without touching ``_inn`` slots —
2997:         leaving the dismissed name to trigger downstream
2998:         ``[STRIKER-COLLISION]`` (Fix 5) and ``[WS-SCRUB]``
2999:         cascades for the rest of the over.  Centralising the
3000:         invariant at ``_add_fow``'s witnessed stamp covers the
3001:         auto-dismiss path (which calls ``_add_fow``) and any
3002:         future witnessed-FOW write site without requiring
3003:         per-callsite touch-ups.
3004: 
3005:         Coverage caveat: the validate-resurrection demote paths
3006:         (lines 3091, 3124) do *not* call ``_add_fow`` (the FOW
3007:         entry already exists from the original witnessing).
3008:         For those paths, the slot would have been cleared at
3009:         the *original* witnessing, when this hook first ran.
3010:         If a resurrection re-populated the slot before
3011:         validate demotes it back, the slot will not be re-
3012:         cleared by this hook.  Filed as a follow-up under the
3013:         "Complete the SM-cutover" architectural item.
3014: 
3015:         Validation evidence (CSK-vs-GT 2026-04-26): three
3016:         rotation-gap instances (Sarfaraz F1670, Dube F1813,
3017:         Overton F2410+) with 88 / 443+ / 240+ defensive
3018:         cascade fires per stuck-non_striker window before
3019:         new-batter admission resolved the slot.  This hook
3020:         closes the upstream gap; Fix 5 and ``[WS-SCRUB]``
3021:         stay as backstops, expected post-fix fire counts
3022:         approach 0.
3023: 
3024:         Idempotent: re-asserting a witnessed dismissal whose
3025:         name has already been cleared from slots is a no-op.
3026:         Composes with ``dismiss_batter()``'s explicit clear
3027:         (lines 2800-2803), which becomes a no-op because this
3028:         hook already cleared the slots earlier in the call
3029:         chain via ``_add_fow``.
3030:         """
3031:         if not dismissed or not self._inn:
3032:             return
3033:         striker_dismissed = (self._inn.get("striker") == dismissed)
3034:         non_striker_dismissed = (
3035:             self._inn.get("non_striker") == dismissed)
3036:         if not (striker_dismissed or non_striker_dismissed):
3037:             # Case 3 / 5 split (Fix 13, Path D, 2026-04-26):
3038:             # not in either slot.  Check whether the dismissed
3039:             # batter is still showing as active in
3040:             # `batting_card` (status="batting") — if so this is
3041:             # the real-time-delayed-witness sub-case (3b /
3042:             # Case 5) and the card-side dismissal still needs
3043:             # to commit.  If status is already "out" or
3044:             # "yet_to_bat", this is the legitimate cold-start
3045:             # back-fill (Case 3a) — no-op.
3046:             #
3047:             # Note: `_extractor_batter_names` and any transient
3048:             # active-batter sets passed to scorer-decision
3049:             # paths are recomputed downstream from
3050:             # `batting_card.status`, so flipping the card
3051:             # status propagates naturally to those derived
3052:             # views without needing direct mutation here.
3053:             _card_entry = self.batting_card.get(dismissed)
3054:             _card_active = (_card_entry is not None
3055:                             and _card_entry.get("status")
3056:                             == "batting")
3057:             if _card_active:
3058:                 self.batting_card[dismissed]["status"] = "out"
3059:                 log.info(
3060:                     f"[POST-WICKET-CARD-PROPAGATE] "
3061:                     f"'{dismissed}' dismissed but not in crease "
3062:                     f"slots — batting_card.status flipped "
3063:                     f"'batting'→'out' (real-time-delayed-"
3064:                     f"witness path, Fix 13 Case 5).")
3065:             return
3066:         if striker_dismissed and not non_striker_dismissed:
3067:             _surviving = self._inn.get("non_striker")
3068:             self._inn["striker"] = _surviving
3069:             self._inn["non_striker"] = None
3070:             log.info(
3071:                 f"[POST-WICKET-ROTATION] striker '{dismissed}' "
3072:                 f"dismissed → rotated non_striker "
3073:                 f"'{_surviving}' into striker slot; "
3074:                 f"non_striker cleared pending new-batter "
3075:                 f"admission.")
3076:         elif non_striker_dismissed and not striker_dismissed:
3077:             self._inn["non_striker"] = None
3078:             log.info(
3079:                 f"[POST-WICKET-ROTATION] non_striker "
3080:                 f"'{dismissed}' dismissed → slot cleared "
3081:                 f"pending new-batter admission.")
3082:         else:
3083:             self._inn["striker"] = None
3084:             self._inn["non_striker"] = None
3085:             log.warn(
3086:                 f"[POST-WICKET-ROTATION] anomaly: "
3087:                 f"'{dismissed}' occupied BOTH striker and "
3088:                 f"non_striker slots — both cleared "
3089:                 f"defensively (likely prior collision state "
3090:                 f"that Fix 5 did not catch).")
