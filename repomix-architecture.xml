 726:     # ------------------------------------------------------------------
 727:     def update_player_styles(self, styles: dict[str, dict]) -> int:
 728:         """Merge ``styles`` into ``_player_styles`` and patch any existing
 729:         ``batting_card`` / ``bowling_card`` entries in place.
 730: 
 731:         Used by the background Pass-2 enrichment: when Pass-2 completes
 732:         after ``setup_innings`` has already populated cards from Pass-1
 733:         styles, this method applies the corrections without rebuilding
 734:         the cards (which would wipe live stats). Future ``setup_innings``
 735:         calls (e.g. for innings 2) will pick up the merged
 736:         ``_player_styles`` automatically.
 737: 
 738:         Returns the number of card slots updated (sum of batting+bowling
 739:         cards touched), useful for telemetry and tests.
 740:         """
 741:         if not styles:
 742:             return 0
 743:         self._player_styles.update(styles)
 744:         n_updated = 0
 745:         for name, st in styles.items():
 746:             if not isinstance(st, dict):
 747:                 continue
 748:             bat = st.get("batting_style", "unknown")
 749:             bowl = st.get("bowling_style", "unknown")
 750:             if name in self.batting_card:
 751:                 self.batting_card[name]["batting_style"] = bat
 752:                 self.batting_card[name]["bowling_style"] = bowl
 753:                 n_updated += 1
 754:             if name in self.bowling_card:
 755:                 self.bowling_card[name]["batting_style"] = bat
 756:                 self.bowling_card[name]["bowling_style"] = bowl
 757:                 n_updated += 1
 758:         log.info(f"[STYLES-PATCH] Updated {n_updated} card slots from "
 759:                  f"background Pass-2 enrichment ({len(styles)} players)")
 760:         return n_updated
