 801:     def _handle_warm(self, card: dict, frame: FrameInput) -> dict | None:
 802:         self._try_resolve_pending(frame)
 803: 
 804:         # Innings transition detection
 805:         if self._detect_innings_change(card, frame):
 806:             return self._build_payload()
 807: 
 808:         def _val(card_v, self_v):
 809:             """Resolve value: prefer card, fall back to state, then 0."""
 810:             if card_v is not None:
 811:                 return card_v
 812:             if self_v is not None:
 813:                 return self_v
 814:             return 0
 815: 
 816:         c_score = _val(card.get("score"), self.score)
 817:         c_wickets = _val(card.get("wickets"), self.wickets)
 818:         new_overs = _val(card.get("overs"), self.overs)
 819:         old_overs = self.overs if self.overs is not None else 0
 820: 
 821:         d_score = c_score - (self.score if self.score is not None else 0)
 822:         d_wickets = c_wickets - (self.wickets if self.wickets is not None else 0)
 823:         d_overs = round(new_overs - old_overs, 2)
 824: 
 825:         # Clear deferred flag when overs/wickets advance — the full score gap
 826:         # is already captured in d_score since SM never updated during deferral.
 827:         if self._deferred_score > 0 and (d_overs > 0 or d_wickets > 0):
 828:             self._deferred_score = 0
 829:             self._deferred_frames = 0
 830: 
 831:         # Diff validation (cricket physics)
 832:         if d_score < 0:
 833:             self._deferred_score = 0
 834:             return None
 835:         if d_wickets < 0:
 836:             return None
 837:         if d_overs < 0:
 838:             # Require N consecutive regression frames before re-entering
 839:             # COLD_START.  A single FRAME_POISONED scout read (or a
 840:             # _validate_overs correction triggered by a stale this_over
 841:             # ribbon) can flip ext_overs backwards for one frame, and the
 842:             # pre-consensus behaviour dropped the VERY NEXT real ball
 843:             # event into cold-start (lost forever once the streak re-
 844:             # warmed).  With consensus, a genuine regression (innings
 845:             # reset, DRS overs revert) still propagates after N frames;
 846:             # a one-off glitch is transparently ignored.
 847:             if (self._overs_regress_from is None
 848:                     or old_overs > self._overs_regress_from):
 849:                 self._overs_regress_from = old_overs
 850:             self._overs_regress_streak += 1
 851:             if self._overs_regress_streak < self._OVERS_REGRESS_THRESHOLD:
 852:                 log.info(
 853:                     f"[SM] Overs regression ({old_overs}→{new_overs}) "
 854:                     f"— deferred "
 855:                     f"({self._overs_regress_streak}/"
 856:                     f"{self._OVERS_REGRESS_THRESHOLD}), ignoring frame")
 857:                 self._update_supplements(card, frame)
 858:                 self.frames_since_event += 1
 859:                 return None
 860:             log.info(
 861:                 f"[SM] Overs regression ({self._overs_regress_from}→"
 862:                 f"{new_overs}) confirmed after "
 863:                 f"{self._overs_regress_streak} frames — "
 864:                 f"re-entering COLD_START")
 865:             self._last_warm_state = self._snapshot()
 866:             self.mode = "COLD_START"
 867:             self.cold_candidate = None
 868:             self.cold_candidate_streak = 0
 869:             self.cold_frames = 0
 870:             self._stale_reject_count = 0
 871:             self._deferred_score = 0
 872:             self._overs_regress_streak = 0
 873:             self._overs_regress_from = None
 874:             return None
 875: 
 876:         # Forward progress (or equality) — clear any pending regression
 877:         # streak so a transient glitch doesn't carry across frames.
 878:         if self._overs_regress_streak > 0:
 879:             log.info(
 880:                 f"[SM] Overs-regression streak cleared "
 881:                 f"({self._overs_regress_streak} frame(s) of "
 882:                 f"{self._overs_regress_from}→? were transient) — "
 883:                 f"back in sync at {new_overs}")
 884:             self._overs_regress_streak = 0
 885:             self._overs_regress_from = None
 886:         if d_wickets > 2:
 887:             return None
 888: 
 889:         # Use ball-count delta (base-6 aware) for multi-ball detection
 890:         d_balls = (self._overs_to_balls(new_overs)
 891:                    - self._overs_to_balls(old_overs))
 892: 
 893:         # ── Cricket-rules diff validation ──────────────────────────────
 894:         # Replaces the older heuristic stack (per-ball ceiling, chase
 895:         # ceiling, absolute T20 ceiling, single-ball d_score>7).  Every
 896:         # diff we accept must satisfy:
 897:         #   - new state passes absolute + chase ceilings, AND
 898:         #   - the diff itself satisfies cricket physics
 899:         #     (multi-ball ceilings, no negative deltas, etc.)
 900:         # Striker / bowler deltas are passed as None for now: the
 901:         # validator falls back to invariants-only and lets _infer_event
 902:         # classify the event from team-level deltas.  This is the
 903:         # "Option 1" partial-data path from the spec.
 904:         cr_diff = Diff(
 905:             d_score=d_score, d_balts=d_balls, d_wkt=d_wickets,
 906:             d_str_runs=None, d_str_balls=None,
 907:             d_bwl_runs=None, d_bwl_wkt=None, d_bwl_balls=None)
 908:         cr_result = validate_diff(
 909:             cr_diff,
 910:             new_score=c_score, new_wickets=c_wickets, new_overs=new_overs,
 911:             target=self.target, innings=self.innings)
 912:         if not cr_result.ok:
 913:             log.warn(
 914:                 f"[SM] REJECT (cricket_rules: {cr_result.reject_reason})  "
 915:                 f"prev={self.score}/{self.wickets} ({old_overs}) → "
 916:                 f"card={c_score}/{c_wickets} ({new_overs})")
 917:             self._stale_reject_count += 1
 918:             if self._stale_reject_count > 10:
 919:                 log.info("[SM] Too many consecutive rejections — "
 920:                          "re-entering COLD_START to re-calibrate")
 921:                 self._last_warm_state = self._snapshot()
 922:                 self.mode = "COLD_START"
 923:                 self.cold_candidate = None
 924:                 self.cold_candidate_streak = 0
 925:                 self.cold_frames = 0
 926:                 self._stale_reject_count = 0
 927:             return None
 928: 
 929:         self._stale_reject_count = 0
 930: 
 931:         # Score-only change with no overs/wicket movement and no broadcast
 932:         # confirmation: defer rather than firing a potentially wrong EXTRA.
 933:         # The score may have been updated from a graphic overlay before overs
 934:         # caught up.  If broadcast_extra is present on this frame, emit
 935:         # immediately — no deferral needed.
 936:         if (d_score > 0 and d_overs == 0 and d_wickets == 0
 937:                 and not card.get("broadcast_extra")
 938:                 and self._deferred_frames < 2):
 939:             self._deferred_score += d_score
 940:             self._deferred_frames += 1
 941:             self._update_supplements(card, frame)
 942:             self.frames_since_event += 1
 943:             log.info(f"[SM] Deferring score +{d_score} (overs stuck at "
 944:                      f"{old_overs}, total deferred={self._deferred_score})")
 945:             return None
 946: 
 947:         # Resolve deferred via broadcast_extra confirmation or timeout
 948:         if (self._deferred_score > 0 and d_overs == 0 and d_wickets == 0
 949:                 and (card.get("broadcast_extra")
 950:                      or self._deferred_frames >= 2)):
 951:             self._deferred_score = 0
 952:             self._deferred_frames = 0
 953: 
 954:         # No change = steady state — still adopt new data (batter names, etc.)
 955:         if d_score == 0 and d_wickets == 0 and d_overs == 0:
 956:             # Snapshot batter prev values BEFORE _update_batters mutates
 957:             # them, so _identify_and_set_striker can compute deltas
 958:             # against the previous frame.
 959:             _pb1r, _pb1b = self.bat1_runs, self.bat1_balls
 960:             _pb2r, _pb2b = self.bat2_runs, self.bat2_balls
 961:             self._update_batters(card)
 962:             self._identify_and_set_striker(
 963:                 card, frame, _pb1r, _pb1b, _pb2r, _pb2b)
 964:             self._update_supplements(card, frame)
 965:             self.frames_since_event += 1
 966:             return None
 967: 
 968:         prev = self._snapshot()
 969:         # Capture batter prevs separately — `prev` here is the SM-state
 970:         # snapshot used by event inference, which keys by bat1/bat2 slot.
 971:         # Striker resolution needs prev-by-name to survive a batter swap
 972:         # in _accept_update; pull the same numbers via the snapshot.
 973:         _pb1r = prev.get("bat1_runs")
 974:         _pb1b = prev.get("bat1_balls")
 975:         _pb2r = prev.get("bat2_runs")
 976:         _pb2b = prev.get("bat2_balls")
 977:         self._accept_update(card)
 978:         # Resolve striker AFTER _accept_update so any batter rotation
 979:         # is reflected in self.bat1_name/bat2_name; use saved prevs.
 980:         self._identify_and_set_striker(
 981:             card, frame, _pb1r, _pb1b, _pb2r, _pb2b)
 982: 
 983:         event = self._infer_event(d_score, d_wickets, d_overs, prev, card,
 984:                                   frame)
 985: 
 986:         if event:
 987:             self._apply_event(event, prev, card, frame)
 988:             self.last_event = event
 989:             self.frames_since_event = 0
 990:             log.info(f"[SM] {event['type']}  "
 991:                      f"{self.score}/{self.wickets} ({self.overs})  "
 992:                      f"striker={event.get('striker')}")
 993: 
 994:         self._recompute()
 995:         return self._build_payload(event)
 996: 
