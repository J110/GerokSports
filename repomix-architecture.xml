4415:     def _canon_player_name(raw, *, bowler: bool = False):
4416:         """Resolve a raw scout name to its canonical squad key.
4417: 
4418:         Issue 1 defense-in-depth (2026-04-21).  SM canonicalizes at
4419:         _build_scorecard; this is the second line of defense at the WS
4420:         boundary so the UI never sees raw surnames leak through.
4421:         Returns the original value (including None) when resolution
4422:         fails so we don't blank the UI just because a name is
4423:         momentarily unrecognized.
4424:         """
4425:         if not raw:
4426:             return raw
4427:         try:
4428:             resolved = scoreboard.resolve_name(raw)
4429:             if not resolved:
4430:                 return raw
4431:             card = (scoreboard.bowling_card if bowler
4432:                     else scoreboard.batting_card)
4433:             if not card:
