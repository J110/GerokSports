2060:         # whole boundary (X.0), the current bowler's overs must also
2061:         # end on .0 — they bowled the closing ball of the over (no
2062:         # mid-over bowler changes in T20). Snap forward if Extractor /
2063:         # Scorer briefly lagged on the closing ball.
2064:         if (self.overs is not None and self.bowler_overs is not None):
2065:             try:
2066:                 t_balls = (int(self.overs) * 6
2067:                            + round((self.overs % 1) * 10))
2068:                 b_balls = (int(self.bowler_overs) * 6
2069:                            + round((self.bowler_overs % 1) * 10))
2070:             except (ValueError, TypeError):
2071:                 t_balls = b_balls = 0
