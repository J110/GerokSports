2746:             self._tracker.force_set(f"bowl:{name}:wickets", seed_w)
2747:             self._tracker.force_set(f"bowl:{name}:overs", seed_o)
2748:             if from_scout:
2749:                 log.info(
2750:                     f"[BOWLER SEED] {name} figures seeded from scout "
2751:                     f"text to {seed_w}-{seed_r} ({seed_o}) — "
2752:                     f"mid-spell entry (impact sub / mid-match join)")
2753:             else:
2754:                 log.info(
2755:                     f"[BOWLER SEED] {name} figures seeded to 0-0(0.0) "
2756:                     f"on spell start (skipping cold-start consensus)")
