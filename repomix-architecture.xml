1166:     def _snapshot(self) -> dict:
1167:         return {
1168:             "score": self.score, "wickets": self.wickets, "overs": self.overs,
1169:             "bat1_name": self.bat1_name, "bat1_runs": self.bat1_runs,
1170:             "bat1_balls": self.bat1_balls,
1171:             "bat2_name": self.bat2_name, "bat2_runs": self.bat2_runs,
1172:             "bat2_balls": self.bat2_balls,
1173:             "bowler_name": self.bowler_name,
1174:             "bowler_wickets": self.bowler_wickets,
1175:             "bowler_runs": self.bowler_runs,
1176:         }
1177: 
1178:     def _accept_update(self, card: dict) -> None:
1179:         if card.get("score") is not None:
1180:             self.score = card["score"]
1181:         if card.get("wickets") is not None:
1182:             self.wickets = card["wickets"]
1183:         if card.get("overs") is not None:
1184:             self.overs = card["overs"]
1185: 
1186:         self._update_batters(card)
1187: 
1188:         if card.get("bowler_name"):
1189:             # Issue 2 (2026-04-21): bowler rotation rule.  A bowler
1190:             # can't bowl two consecutive overs — if the incoming name
1191:             # matches the previous-over bowler, reject the identity
1192:             # flip AND the attached figures (the whole row is poisoned
1193:             # because Scout is reading the wrong graphic).
1194:             _prev = (getattr(self.scoreboard, "_prev_over_bowler", None)
1195:                      if self.scoreboard else None)
1196:             # Stale-graphic detection (refined 2026-04-21): if the
1197:             # proposed bowler is DIFFERENT from the current SM bowler
1198:             # (including null→named transitions right after over
1199:             # rollover) and their figures match/regress against the
1200:             # scoreboard's historical snapshot, it's a resurrected
1201:             # end-of-spell graphic.  Same-figures rejection is gated
1202:             # on NOT being in the `_bowler_must_change` grace window
1203:             # (legitimate returning bowlers read as "same figures" for
1204:             # the first frame before delivering).  Overs-regression
1205:             # rejection applies unconditionally — a spell can never go
1206:             # backwards.
1207:             _is_stale = False
1208:             if (card["bowler_name"] != self.bowler_name
1209:                     and self.scoreboard is not None):
1210:                 hist = self.scoreboard.bowling_card.get(
1211:                     card["bowler_name"], {})
1212:                 hr = hist.get("runs")
1213:                 hw = hist.get("wickets")
1214:                 ho = hist.get("overs")
1215:                 cr = card.get("bowler_runs")
1216:                 cw = card.get("bowler_wickets")
1217:                 co = card.get("bowler_overs")
1218:                 _must_change = bool(getattr(
1219:                     self.scoreboard, "_bowler_must_change", False))
1220:                 if (not _must_change
1221:                         and hr is not None and cr is not None
1222:                         and cw is not None and co is not None):
1223:                     try:
1224:                         if (int(cr) == int(hr)
1225:                                 and int(cw) == int(hw or 0)
1226:                                 and str(co) == str(ho)):
1227:                             _is_stale = True
1228:                     except (TypeError, ValueError):
1229:                         pass
1230:                 if not _is_stale and ho is not None and co is not None:
1231:                     try:
1232:                         if float(co) < float(ho):
1233:                             _is_stale = True
1234:                     except (TypeError, ValueError):
1235:                         pass
1236:             if (_prev and card["bowler_name"] == _prev) or _is_stale:
1237:                 # Skip all bowler fields on this card.
1238:                 pass
1239:             else:
1240:                 self.bowler_name = card["bowler_name"]
1241:                 if card.get("bowler_wickets") is not None:
1242:                     self.bowler_wickets = card["bowler_wickets"]
1243:                 if card.get("bowler_runs") is not None:
1244:                     self.bowler_runs = card["bowler_runs"]
1245:                 if card.get("bowler_overs") is not None:
1246:                     self.bowler_overs = card["bowler_overs"]
1247:         else:
1248:             if card.get("bowler_wickets") is not None:
1249:                 self.bowler_wickets = card["bowler_wickets"]
1250:             if card.get("bowler_runs") is not None:
1251:                 self.bowler_runs = card["bowler_runs"]
1252:             if card.get("bowler_overs") is not None:
1253:                 self.bowler_overs = card["bowler_overs"]
1254: 
1255:         if card.get("speed_kph"):
1256:             self.last_speed = card["speed_kph"]
1257:         if card.get("broadcast_target") and not self.target:
1258:             # Fix 16: route through canonical setter so cached
1259:             # innings-1 scalars are reset, not just the field flip.
1260:             self.set_innings_2(target=card["broadcast_target"],
1261:                                batting_team=self.batting_team,
1262:                                reason="_update_misc.target_arrival")
1263: 
1264:     def _update_batters(self, card: dict) -> None:
1265:         card_b1 = card.get("bat1_name")
1266:         card_b2 = card.get("bat2_name")
1267:         if not card_b1 and not card_b2:
1268:             return
1269: 
1270:         # Dismissed-batter resurrection guard (2026-04-21).  Live probe
1271:         # of SRH-vs-DC inn2 caught SM broadcasting `striker=Axar Patel`
1272:         # AFTER Patel's wicket (W7).  Root cause: a stale broadcast
1273:         # strip briefly re-showed Patel's name, _update_batters accepted
1274:         # it, and SM re-slotted him into bat1/bat2.  Scrub any card
1275:         # entry that names a batter the scoreboard already marks as
1276:         # dismissed — those reads are OCR noise from post-wicket
1277:         # graphics and must not re-enter SM's crease state.
1278:         if self.scoreboard is not None:
1279:             for _key in ("bat1_name", "bat2_name"):
1280:                 _nm = card.get(_key)
1281:                 if not _nm:
1282:                     continue
1283:                 _card = (self.scoreboard.batting_card or {}).get(_nm)
1284:                 if _card and _card.get("status") == "out":
1285:                     log.warn(
1286:                         f"[SM] dropping {_key}='{_nm}' from card — "
1287:                         f"scoreboard shows status=out (stale strip "
1288:                         f"read of dismissed batter)")
1289:                     card[_key] = None
1290:                     card.pop(_key.replace("_name", "_runs"), None)
1291:                     card.pop(_key.replace("_name", "_balls"), None)
1292:         card_b1 = card.get("bat1_name")
1293:         card_b2 = card.get("bat2_name")
1294:         if not card_b1 and not card_b2:
1295:             return
1296: 
1297:         # Bootstrap: adopt batter names when internal state has none
1298:         if not self.bat1_name and not self.bat2_name:
1299:             self.bat1_name = card_b1
1300:             self.bat1_runs = card.get("bat1_runs")
1301:             self.bat1_balls = card.get("bat1_balls")
1302:             self.bat2_name = card_b2
1303:             self.bat2_runs = card.get("bat2_runs")
1304:             self.bat2_balls = card.get("bat2_balls")
1305:             if not self.striker:
1306:                 self.striker = self.bat1_name
1307:                 self.non_striker = self.bat2_name
1308:             return
1309: 
1310:         # Use fuzzy-match aware set difference for arrivals/departures
1311:         card_batters = [n for n in (card_b1, card_b2) if n]
1312:         my_batters = [n for n in (self.bat1_name, self.bat2_name) if n]
1313: 
1314:         def _fuzzy_in(name, names_list):
1315:             for n in names_list:
1316:                 if self._same_name(name, n):
1317:                     return True
1318:             return False
1319: 
1320:         arrived = [n for n in card_batters if not _fuzzy_in(n, my_batters)]
1321:         departed = [n for n in my_batters if not _fuzzy_in(n, card_batters)]
1322: 
1323:         if (len(arrived) == 1 and len(departed) == 1):
1324:             gone = departed[0]
1325:             new = arrived[0]
1326:             if self.bat1_name == gone:
1327:                 self.bat1_name = new
1328:                 self.bat1_runs = (card.get("bat1_runs") if card_b1 == new
1329:                                   else card.get("bat2_runs"))
1330:                 self.bat1_balls = (card.get("bat1_balls") if card_b1 == new
1331:                                    else card.get("bat2_balls"))
1332:             elif self.bat2_name == gone:
1333:                 self.bat2_name = new
1334:                 self.bat2_runs = (card.get("bat2_runs") if card_b2 == new
1335:                                   else card.get("bat1_runs"))
1336:                 self.bat2_balls = (card.get("bat2_balls") if card_b2 == new
1337:                                    else card.get("bat1_balls"))
1338:         else:
1339:             # Cross-match card batters to internal batters by fuzzy name
1340:             for card_name, card_runs, card_balls in [
1341:                 (card_b1, card.get("bat1_runs"), card.get("bat1_balls")),
1342:                 (card_b2, card.get("bat2_runs"), card.get("bat2_balls")),
1343:             ]:
1344:                 if not card_name:
1345:                     continue
1346:                 if (self.bat1_name
1347:                         and self._same_name(card_name, self.bat1_name)):
1348:                     if card_runs is not None:
1349:                         self.bat1_runs = card_runs
1350:                     if card_balls is not None:
1351:                         self.bat1_balls = card_balls
1352:                 elif (self.bat2_name
1353:                         and self._same_name(card_name, self.bat2_name)):
1354:                     if card_runs is not None:
1355:                         self.bat2_runs = card_runs
1356:                     if card_balls is not None:
1357:                         self.bat2_balls = card_balls
1358: 
1359:     def _update_supplements(self, card: dict, frame: FrameInput) -> None:
1360:         if card.get("speed_kph"):
1361:             self.last_speed = card["speed_kph"]
1362:         if card.get("broadcast_target") and not self.target:
1363:             # Fix 16: route through canonical setter so cached
1364:             # innings-1 scalars are reset, not just the field flip.
1365:             self.set_innings_2(
1366:                 target=card["broadcast_target"],
1367:                 batting_team=self.batting_team,
1368:                 reason="_update_supplements.target_arrival")
1369:         if frame.broadcast_venue and not self.venue:
1370:             self.venue = frame.broadcast_venue
1371: 
1372:         # Broadcast this-over: backfill ? positions only
1373:         if card.get("broadcast_this_over"):
1374:             for i, token in enumerate(card["broadcast_this_over"]):
1375:                 if (i < len(self.this_over)
1376:                         and i < len(self.this_over_src)
1377:                         and self.this_over_src[i] == "bcast"):
1378:                     self.this_over[i] = token
1379: 
1380:         # Striker resolution moved to _identify_and_set_striker so that
1381:         # balls-faced and runs-delta evidence can take precedence over
1382:         # the broadcast indicator (which suffers from surname-cluster
1383:         # ambiguity, e.g. KKR's Singh/Roy where the broadcast strip
1384:         # showing "Singh" matches both Rinku Singh and his partner).
1385:         # _identify_and_set_striker is invoked from on_frame BEFORE
1386:         # _update_batters mutates internal batter state, so the
1387:         # resulting deltas are well-defined.
1388: 
1389:     def _identify_and_set_striker(self, card: dict,
1390:                                   frame: FrameInput,
1391:                                   prev_b1_runs: int | None,
1392:                                   prev_b1_balls: int | None,
1393:                                   prev_b2_runs: int | None,
1394:                                   prev_b2_balls: int | None) -> None:
1395:         """Resolve striker by evidence priority.
1396: 
1397:         The broadcast `striker` indicator was previously the sole source
1398:         and matched by full-name substring. That broke on the KKR pair
1399:         Rinku Singh / Anukul Roy, where the strip-shown "Singh" is a
1400:         substring of both internal batter names ("Rinku Singh" and the
1401:         late-overs partner sharing the surname). Result: broadcast
1402:         flipped striker on every frame, overriding the correct evidence
1403:         from balls-faced and runs deltas.
1404: 
1405:         Priority (evidence wins, inference last):
1406:           1. Balls-faced delta — only the striker's ball count ticks
1407:              on a legal delivery. Works for dots, runs, wickets;
1408:              unambiguous on every frame where a legal ball was bowled.
1409:           2. Runs delta — only the striker's runs increase. Works on
1410:              frames where a run-scoring delivery happened.
1411:           3. Broadcast indicator — match against FIRST names so
1412:              surname-clusters (Singh/Roy) don't produce false matches.
1413:           4. Keep current striker (no evidence to flip).
1414:         """
1415:         # Map card-side bat1/bat2 to internal batters by name (positions
1416:         # may differ; the broadcast strip can swap the two rows).
1417:         b1_internal = self.bat1_name
1418:         b2_internal = self.bat2_name
1419:         if not b1_internal and not b2_internal:
1420:             return
1421: 
1422:         candidates: dict[str, dict] = {}
1423:         for cn_key, cr_key, cb_key in [
1424:             ("bat1_name", "bat1_runs", "bat1_balls"),
1425:             ("bat2_name", "bat2_runs", "bat2_balls"),
1426:         ]:
1427:             cname = card.get(cn_key)
1428:             if not cname:
1429:                 continue
1430:             if b1_internal and self._same_name(cname, b1_internal):
1431:                 prev_r, prev_b, internal = (prev_b1_runs, prev_b1_balls,
1432:                                             b1_internal)
1433:             elif b2_internal and self._same_name(cname, b2_internal):
1434:                 prev_r, prev_b, internal = (prev_b2_runs, prev_b2_balls,
1435:                                             b2_internal)
1436:             else:
1437:                 continue
1438:             cur_r = card.get(cr_key)
1439:             cur_b = card.get(cb_key)
1440:             d_r = ((cur_r - prev_r) if (cur_r is not None
1441:                                          and prev_r is not None)
1442:                    else None)
1443:             d_b = ((cur_b - prev_b) if (cur_b is not None
1444:                                          and prev_b is not None)
1445:                    else None)
1446:             candidates[internal] = {"d_runs": d_r, "d_balls": d_b}
1447: 
1448:         new_striker: str | None = None
1449:         method: str | None = None
1450: 
1451:         # Priority 1: balls-faced delta == 1 (one batter's ball count
1452:         # ticked, the other's didn't). Most reliable signal.
1453:         bumped_b = [n for n, c in candidates.items() if c["d_balls"] == 1]
1454:         flat_b = [n for n, c in candidates.items() if c["d_balls"] == 0]
1455:         if len(bumped_b) == 1 and len(flat_b) >= 1:
1456:             new_striker = bumped_b[0]
1457:             method = "balls_delta"
1458: 
1459:         # Priority 2: runs delta > 0 (only the striker scored)
1460:         if not new_striker:
1461:             bumped_r = [n for n, c in candidates.items()
1462:                         if c["d_runs"] is not None and c["d_runs"] > 0]
1463:             flat_r = [n for n, c in candidates.items() if c["d_runs"] == 0]
1464:             if len(bumped_r) == 1 and len(flat_r) >= 1:
1465:                 new_striker = bumped_r[0]
1466:                 method = "runs_delta"
1467: 
1468:         # Priority 3: broadcast indicator with FIRST-NAME match.  Skip
1469:         # when both batters share the same first name (rare but defends
1470:         # against the symmetric ambiguity we built this for).
1471:         if not new_striker and card.get("broadcast_striker"):
1472:             ind = card["broadcast_striker"].lower().strip()
1473:             b1_first = ((b1_internal or "").split() or [""])[0].lower()
1474:             b2_first = ((b2_internal or "").split() or [""])[0].lower()
1475:             if b1_first and b2_first and b1_first != b2_first:
1476:                 if b1_first in ind and b2_first not in ind:
1477:                     new_striker = b1_internal
1478:                     method = "broadcast_first_name"
1479:                 elif b2_first in ind and b1_first not in ind:
1480:                     new_striker = b2_internal
1481:                     method = "broadcast_first_name"
1482: 
1483:         if new_striker and new_striker != self.striker:
1484:             log.info(f"[STRIKER] method={method} striker={new_striker} "
1485:                      f"(was={self.striker})")
1486:             self.striker = new_striker
1487:             if new_striker == self.bat1_name:
1488:                 self.non_striker = self.bat2_name
1489:             elif new_striker == self.bat2_name:
1490:                 self.non_striker = self.bat1_name
1491: 
1492:     # ------------------------------------------------------------------
1493:     # Event inference
1494:     # ------------------------------------------------------------------
1495: 
1496:     @staticmethod
1497:     def _overs_to_balls(overs: float) -> int:
1498:         """Convert overs (base-6) to total balls. 8.5 → 53, 9.0 → 54."""
1499:         full = int(overs)
1500:         part = round((overs - full) * 10)
1501:         return full * 6 + part
1502: 
1503:     def _infer_event(self, d_score: int, d_wickets: int, d_overs: float,
1504:                      prev: dict, card: dict,
1505:                      frame: FrameInput) -> dict | None:
1506: 
1507:         striker, non_striker, striker_runs = self._identify_striker(
1508:             prev, card, frame)
1509: 
1510:         # MULTI_BALL: skipped deliveries (use ball count, not decimal overs)
1511:         new_overs = card.get("overs") or self.overs or 0
1512:         old_overs = prev.get("overs") or 0
1513:         d_balls = self._overs_to_balls(new_overs) - self._overs_to_balls(old_overs)
1514:         if d_balls > 1:
1515:             return {"type": "MULTI_BALL", "runs": d_score,
1516:                     "overs_skipped": d_overs, "wickets_in_gap": d_wickets,
1517:                     "balls_skipped": d_balls, "striker": striker}
1518: 
1519:         # EXTRAS: score changed, overs didn't
1520:         if d_score > 0 and d_overs == 0 and d_wickets == 0:
1521:             return self._infer_extra(d_score, striker, card, frame)
1522: 
1523:         # WICKET
1524:         if d_wickets > 0:
1525:             return self._infer_wicket(d_score, d_wickets, d_overs, prev, card,
1526:                                       frame, striker)
1527: 
1528:         # LEGAL DELIVERY
1529:         if d_overs > 0:
1530:             return self._infer_legal(d_score, striker, striker_runs, card,
1531:                                      frame)
1532: 
1533:         return None
1534: 
1535:     def _identify_striker(self, prev: dict, card: dict,
1536:                           frame: FrameInput) -> tuple:
1537:         """Who faced this ball?  Priority: balls delta → broadcast → state.
1538: 
1539:         Cross-matches card batters to previous batters by fuzzy name
1540:         regardless of slot position (extractor may swap bat1/bat2 order).
1541:         """
1542:         # Build cross-match: for each card batter, find matching prev batter
1543:         matches = self._cross_match_batters(prev, card)
1544: 
1545:         # Check balls delta via cross-matched pairs
1546:         d_bat: dict[str, tuple] = {}
1547:         for my_name, (c_runs, c_balls, p_runs, p_balls) in matches.items():
1548:             if c_balls is not None and p_balls is not None:
1549:                 d_balls = c_balls - p_balls
1550:                 d_runs = max((c_runs or 0) - (p_runs or 0), 0)
1551:                 d_bat[my_name] = (d_balls, d_runs)
1552: 
1553:         strikers = [n for n, (db, _) in d_bat.items() if db == 1]
1554:         non_strikers = [n for n, (db, _) in d_bat.items() if db != 1]
1555: 
1556:         if len(strikers) == 1:
1557:             s = strikers[0]
1558:             ns = non_strikers[0] if non_strikers else (
1559:                 self.bat2_name if s == self.bat1_name else self.bat1_name)
1560:             return s, ns, d_bat[s][1]
1561: 
1562:         # Broadcast indicator fallback
1563:         if card.get("broadcast_striker"):
1564:             ind = card["broadcast_striker"].lower()
1565:             if self.bat1_name and ind in self.bat1_name.lower():
1566:                 runs = (d_bat[self.bat1_name][1]
1567:                         if self.bat1_name in d_bat else 0)
1568:                 return self.bat1_name, self.bat2_name, runs
1569:             if self.bat2_name and ind in self.bat2_name.lower():
1570:                 runs = (d_bat[self.bat2_name][1]
1571:                         if self.bat2_name in d_bat else 0)
1572:                 return self.bat2_name, self.bat1_name, runs
1573: 
1574:         # State fallback
1575:         cs = card.get("score") if card.get("score") is not None else 0
1576:         ss = self.score if self.score is not None else 0
1577:         return self.striker, self.non_striker, max(cs - ss, 0)
1578: 
1579:     def _cross_match_batters(self, prev: dict, card: dict) -> dict:
1580:         """Match card batters to internal state batters by fuzzy name.
1581: 
1582:         Returns {my_name: (card_runs, card_balls, prev_runs, prev_balls)}
1583:         for each matched batter.  Handles extractor swapping bat1/bat2 slots.
1584:         """
1585:         result: dict[str, tuple] = {}
1586:         card_batters = []
1587:         for prefix in ("bat1", "bat2"):
1588:             cn = card.get(f"{prefix}_name")
1589:             if cn:
1590:                 card_batters.append((
1591:                     cn, card.get(f"{prefix}_runs"),
1592:                     card.get(f"{prefix}_balls")))
1593: 
1594:         used_card: set[int] = set()
1595:         for my_name in (self.bat1_name, self.bat2_name):
1596:             if not my_name:
1597:                 continue
1598:             for i, (cn, cr, cb) in enumerate(card_batters):
1599:                 if i in used_card:
1600:                     continue
1601:                 if self._same_name(cn, my_name):
1602:                     # Find prev stats for this batter
1603:                     p_runs, p_balls = None, None
1604:                     for pp in ("bat1", "bat2"):
1605:                         pn = prev.get(f"{pp}_name")
1606:                         if pn and self._same_name(pn, my_name):
1607:                             p_runs = prev.get(f"{pp}_runs")
1608:                             p_balls = prev.get(f"{pp}_balls")
1609:                             break
1610:                     result[my_name] = (cr, cb, p_runs, p_balls)
1611:                     used_card.add(i)
1612:                     break
1613: 
1614:         return result
1615: 
1616:     def _infer_extra(self, d_score: int, striker: str | None,
1617:                      card: dict, frame: FrameInput) -> dict:
1618:         if card.get("broadcast_extra") == "WD":
1619:             return {"type": "WIDE", "runs": d_score, "legal": False,
1620:                     "this_over_token": "Wd", "striker": striker}
1621:         if card.get("broadcast_extra") == "NB":
1622:             return {"type": "NO_BALL", "runs": d_score, "legal": False,
1623:                     "batter_runs": d_score - 1, "free_hit_next": True,
1624:                     "this_over_token": "Nb", "striker": striker}
1625: 
1626:         event: dict = {
1627:             "type": "EXTRA", "runs": d_score, "legal": False,
1628:             "this_over_token": str(d_score), "striker": striker,
1629:             "needs_resolution": True,
1630:         }
1631:         self.pending_extra = event
1632:         self.pending_extra_frames = 0
1633: 
1634:         for rf in self.recent_frames[-3:]:
1635:             text = (rf.scout_text or "").lower()
1636:             if "wide" in text and "no ball" not in text:
1637:                 event["type"] = "WIDE"
1638:                 event["this_over_token"] = "Wd"
1639:                 event["needs_resolution"] = False
1640:                 self.pending_extra = None
1641:                 break
1642:             if "no ball" in text or "free hit" in text:
1643:                 event["type"] = "NO_BALL"
1644:                 event["this_over_token"] = "Nb"
1645:                 event["free_hit_next"] = True
1646:                 event["needs_resolution"] = False
1647:                 self.pending_extra = None
1648:                 break
1649: 
1650:         return event
1651: 
1652:     def _infer_wicket(self, d_score: int, d_wickets: int, d_overs: float,
1653:                       prev: dict, card: dict, frame: FrameInput,
1654:                       striker: str | None) -> dict:
1655:         prev_batters = {n for n in [prev.get("bat1_name"),
1656:                                     prev.get("bat2_name")] if n}
1657:         curr_batters = {n for n in [card.get("bat1_name"),
1658:                                     card.get("bat2_name")] if n}
1659:         departed = prev_batters - curr_batters
1660:         arrived = curr_batters - prev_batters
1661: 
1662:         dismissed = departed.pop() if len(departed) == 1 else None
1663:         new_batter = arrived.pop() if len(arrived) == 1 else None
1664: 
1665:         d_bowler_w = 0
1666:         if (card.get("bowler_wickets") is not None
1667:                 and prev.get("bowler_wickets") is not None):
1668:             d_bowler_w = card["bowler_wickets"] - prev["bowler_wickets"]
1669: 
1670:         if d_score > 0 and d_bowler_w == 0:
1671:             wicket_type = "run_out"
1672:         elif d_bowler_w > 0:
1673:             wicket_type = "bowler_wicket"
1674:         else:
1675:             wicket_type = "unknown"
1676: 
1677:         action = (frame.action_text or "").lower()
1678:         for wt in ["caught", "bowled", "lbw", "stumped", "run out",
1679:                     "hit wicket"]:
1680:             if wt in action:
1681:                 wicket_type = wt.replace(" ", "_")
1682:                 break
1683: 
1684:         event: dict = {
1685:             "type": "WICKET", "runs": d_score, "dismissed": dismissed,
1686:             "new_batter": new_batter, "wicket_type": wicket_type,
1687:             "legal": d_overs > 0, "this_over_token": "W",
1688:             "striker": striker,
1689:         }
1690: 
1691:         if dismissed is None:
1692:             event["needs_resolution"] = True
1693:             self.pending_wicket = event
1694:             self.pending_wicket_frames = 0
1695: 
1696:         return event
1697: 
1698:     def _infer_legal(self, d_score: int, striker: str | None,
1699:                      striker_runs: int, card: dict,
1700:                      frame: FrameInput) -> dict:
1701:         """Classify legal delivery based on team score delta.
1702: 
1703:         Batter stat deltas are unreliable (extractor lags scorer by 1-2 frames),
1704:         so event type is determined from d_score alone, matching BED's logic.
1705:         LEG_BYE is only inferred from explicit broadcast signals, not stat gaps.
1706:         """
1707:         if d_score == 0:
1708:             return {"type": "DOT", "runs": 0,
1709:                     "this_over_token": ".", "striker": striker}
1710:         if d_score == 4:
1711:             return {"type": "FOUR", "runs": 4,
1712:                     "this_over_token": "4", "striker": striker}
1713:         if d_score == 6:
1714:             return {"type": "SIX", "runs": 6,
1715:                     "this_over_token": "6", "striker": striker}
1716:         return {"type": "RUNS", "runs": d_score, "batter_runs": d_score,
1717:                 "this_over_token": str(d_score), "striker": striker}
1718: 
