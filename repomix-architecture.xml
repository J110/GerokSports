 109:     def update_batter(self, name: str, new_runs: int | None,
 110:                       new_balls: int | None) -> tuple[int | None, int | None]:
 111:         existing = self.batters.get(name)
 112:         if not existing:
 113:             self.batters[name] = {"runs": new_runs, "balls": new_balls}
 114:             return new_runs, new_balls
 115:         old_r = existing.get("runs") or 0
 116:         old_b = existing.get("balls") or 0
 117:         if new_runs is None:
 118:             new_runs = old_r
 119:         if new_balls is None:
 120:             new_balls = old_b
 121:         mmb = self._max_missed_balls()
 122:         max_balls_inc = max(1, mmb)
 123:         max_runs_inc = 6 * max_balls_inc
 124:         r_delta = new_runs - old_r
 125:         b_delta = new_balls - old_b
 126:         if r_delta < 0 or r_delta > max_runs_inc:
 127:             new_runs = old_r
 128:         if b_delta < 0 or b_delta > max_balls_inc:
 129:             new_balls = old_b
 130:         # Also: batter runs can't exceed team score
 131:         if self.score is not None and new_runs > self.score:
 132:             new_runs = old_r
 133:         existing["runs"] = new_runs
 134:         existing["balls"] = new_balls
 135:         return new_runs, new_balls
