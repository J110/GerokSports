1679: def detect_dismissal_in_vision(vision_desc: str) -> dict | None:
1680:     """Backup: detect dismissal patterns in raw vision text.
1681: 
1682:     Requires fielder/bowler attribution (c/b/lbw/run out/st).
1683:     Bare 'OUT' without attribution is ignored — could be impact sub.
1684:     Frames with impact sub context are skipped entirely.
1685:     """
1686:     if not vision_desc:
1687:         return None
1688: 
1689:     upper = vision_desc.upper()
1690: 
1691:     # Impact sub context → skip entirely, "OUT" means leaving XI
1692:     if any(ind in upper for ind in _IMPACT_SUB_INDICATORS):
1693:         return None
1694: 
1695:     _PATTERNS = [
1696:         (r'(\w[\w\s]*?)\s+(\d+)\s*\((\d+)\)\s+c\s+([\w\s]+?)\s+b\s+(\w+)',
1697:          "caught"),
1698:         (r'(\w[\w\s]*?)\s+(\d+)\s*\((\d+)\)\s+st\s+([\w\s]+?)\s+b\s+(\w+)',
1699:          "stumped"),
1700:         (r'(\w[\w\s]*?)\s+(\d+)\s*\((\d+)\)\s+lbw\s+b\s+(\w+)',
1701:          "lbw"),
1702:         (r'(\w[\w\s]*?)\s+(\d+)\s*\((\d+)\)\s+b\s+(\w+)',
1703:          "bowled"),
1704:         (r'(\w[\w\s]*?)\s+(\d+)\s*\((\d+)\)\s+run\s+out',
1705:          "run_out"),
1706:         (r'(\w[\w\s]*?)\s+(\d+)\s*\((\d+)\)\s+retired',
1707:          "retired"),
1708:     ]
1709:     for pattern, mode in _PATTERNS:
1710:         m = re.search(pattern, vision_desc, re.IGNORECASE)
1711:         if m:
1712:             groups = m.groups()
1713:             result = {
1714:                 "batter": groups[0].strip(),
1715:                 "type": mode,
1716:                 "runs": int(groups[1]),
1717:                 "balls": int(groups[2]),
1718:             }
1719:             if mode in ("caught", "stumped"):
1720:                 result["fielder"] = groups[3].strip()
1721:                 result["bowler"] = groups[4].strip()
1722:             elif mode in ("lbw", "bowled"):
1723:                 result["bowler"] = groups[3].strip()
1724:             return result
1725:     return None
