 150:     def _detect_ball(self, state: dict) -> dict | None:
 151:         if not self._prev_state:
 152:             return None
 153:         prev_sc = self._prev_state.get("scorecard", {})
 154:         curr_sc = state.get("scorecard", {})
 155:         prev_ov = prev_sc.get("overs")
 156:         curr_ov = curr_sc.get("overs")
 157:         if not prev_ov or not curr_ov or prev_ov == curr_ov:
 158:             return None
 159:         prev_b = self._to_balls(prev_ov)
 160:         curr_b = self._to_balls(curr_ov)
 161:         if curr_b - prev_b != 1:
 162:             return None
 163:         s_d = (curr_sc.get("score") or 0) - (prev_sc.get("score") or 0)
 164:         w_d = (curr_sc.get("wickets") or 0) - (prev_sc.get("wickets") or 0)
 165:         if abs(s_d) > 7 and w_d == 0:
 166:             return None
 167:         if w_d > 0:
 168:             return {"type": "WICKET", "runs": s_d, "over": curr_ov, "certain": True}
 169:         if s_d == 0:
 170:             return {"type": "DOT", "runs": 0, "over": curr_ov, "certain": True}
 171:         if s_d == 4:
 172:             return {"type": "FOUR", "runs": 4, "over": curr_ov, "certain": True}
 173:         if s_d == 6:
 174:             return {"type": "SIX", "runs": 6, "over": curr_ov, "certain": True}
 175:         return {"type": f"{s_d}_RUNS", "runs": s_d, "over": curr_ov, "certain": True}
 176: 
 177:     def _detect_over_change(self, state: dict) -> dict | None:
 178:         if not self._prev_state:
 179:             return None
 180:         curr = state.get("scorecard", {}).get("overs")
 181:         prev = self._prev_state.get("scorecard", {}).get("overs")
 182:         if not curr or not prev:
 183:             return None
 184:         if int(float(curr)) > int(float(prev)):
 185:             return state.get("over_history", {}).get(str(int(float(prev))), {})
 186:         return None
 187: 
 188:     @staticmethod
 189:     def _to_balls(overs) -> int:
 190:         o = float(overs or "0")
 191:         return int(o) * 6 + round((o % 1) * 10)
 192: 
 193:     @staticmethod
 194:     def _allowed_name_set(ws_payload: dict) -> set[str]:
 195:         """S3 allowlist — names commentary may reference for the
 196:         current ball: striker, non_striker, bowler, and the team
 197:         names (and any partial form of those)."""
 198:         out: set[str] = set()
 199:         sc = ws_payload.get("scorecard", {}) or {}
 200:         match = ws_payload.get("match", {}) or {}
 201:         for k in ("striker", "non_striker", "current_bowler",
 202:                   "batting_team", "bowling_team"):
 203:             v = sc.get(k) or match.get(k)
 204:             if isinstance(v, str) and v.strip():
 205:                 vl = v.lower().strip()
 206:                 out.add(vl)
 207:                 for tok in vl.split():
 208:                     if len(tok) >= 3:
 209:                         out.add(tok)
 210:         for k in ("team_a", "team_b"):
 211:             v = match.get(k)
 212:             if isinstance(v, str) and v.strip():
 213:                 out.add(v.lower().strip())
 214:                 for tok in v.lower().split():
 215:                     if len(tok) >= 3:
 216:                         out.add(tok)
 217:         return out
 218: 
 219:     @staticmethod
 220:     def _known_player_set(ws_payload: dict) -> set[str]:
 221:         """All player surnames/given-names in either squad. Used to
 222:         spot when commentary references a real player who isn't on
 223:         the field for THIS ball — the canonical S3 hallucination."""
 224:         out: set[str] = set()
 225:         for sq in ("full_batting_squad", "full_bowling_squad"):
 226:             for p in ws_payload.get(sq, []) or []:
 227:                 n = (p.get("name") or "").lower().strip()
 228:                 if not n:
 229:                     continue
 230:                 out.add(n)
 231:                 for tok in n.split():
 232:                     if len(tok) >= 3:
 233:                         out.add(tok)
 234:         return out
