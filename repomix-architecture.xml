2053:         if (self.bat1_runs is not None and self.bat1_balls
2054:                 and self.bat1_balls > 0):
2055:             self.bat1_sr = round(self.bat1_runs / self.bat1_balls * 100, 2)
2056:         if (self.bat2_runs is not None and self.bat2_balls
2057:                 and self.bat2_balls > 0):
