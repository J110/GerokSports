1008: def _reconcile_bowler_overs(
1009:         bowling_card: list[dict],
1010:         team_overs: str | float | None,
1011:         current_bowler: str | None) -> list[dict]:
1012:     """Cross-field consistency for bowler overs vs. team overs.
1013: 
1014:     Cricket invariant: a bowler bowls a complete over (no mid-over
1015:     bowler changes in T20). When team overs cross a whole boundary
1016:     (X.0), the bowler who bowled that closing ball MUST have their
1017:     overs ending in .0 too. Anything else is logically impossible.
1018: 
1019:     The Scout/Extractor pipeline can briefly miss the closing ball of
1020:     an over for the bowler (broadcast strip flickers, scout reads a
1021:     stale frame, etc.) — leaving e.g. team=1.0 / bowler=0.5 in the UI.
1022:     This helper snaps the **current bowler's** overs forward to the
1023:     next whole boundary when (and only when) the team has clearly
1024:     crossed one and the bowler is lagging by ≤5 balls within the same
1025:     incomplete over.
1026: 
1027:     We never push a bowler's overs PAST team overs, and we never
1028:     snap a non-current bowler (their spell already ended; their card
1029:     figure is final).
1030:     """
1031:     if not bowling_card or not current_bowler or team_overs is None:
1032:         return bowling_card
1033:     try:
1034:         team_balls = overs_to_balls(str(team_overs))
1035:     except (ValueError, TypeError, AttributeError):
1036:         return bowling_card
1037:     if team_balls <= 0 or team_balls % 6 != 0:
1038:         return bowling_card
1039: 
1040:     for entry in bowling_card:
1041:         if entry.get("name") != current_bowler:
1042:             continue
1043:         try:
1044:             bow_balls = overs_to_balls(str(entry.get("overs") or "0"))
1045:         except (ValueError, TypeError, AttributeError):
1046:             return bowling_card
1047:         if bow_balls % 6 == 0:
1048:             return bowling_card
1049:         snapped_balls = ((bow_balls // 6) + 1) * 6
1050:         if snapped_balls > team_balls:
1051:             return bowling_card
1052:         snapped_overs = _balls_to_overs_str(snapped_balls)
1053:         log.info(
1054:             f"  [CONSISTENCY] {current_bowler} overs "
1055:             f"{entry.get('overs')} → {snapped_overs} "
1056:             f"(team @ {team_overs}, bowler must finish over)")
1057:         entry["overs"] = snapped_overs
1058:         if entry.get("runs") is not None and snapped_balls > 0:
1059:             entry["economy"] = round(
1060:                 entry["runs"] / (snapped_balls / 6), 1)
1061:         return bowling_card
1062:     return bowling_card
1063: 
