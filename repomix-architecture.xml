4038:     def initialize_this_over(self, overs) -> None:
4039:         """Pre-fill this-over when joining mid-over."""
4040:         overs_f = float(overs or "0")
4041:         balls_this_over = round((overs_f % 1) * 10)
4042:         if balls_this_over > 0 and len(self.this_over) == 0:
4043:             self.this_over = ["?"] * balls_this_over
