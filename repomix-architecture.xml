1396: def parse_bowling_figures(raw: str) -> dict | None:
1397:     """Parse any bowling figure format into standard fields.
1398: 
1399:     Formats seen on broadcast:
1400:       1-0-18-0    → overs=1, maidens=0, runs=18, wickets=0
1401:       2-34 (3.2)  → wickets=2, runs=34, overs=3.2
1402:       0-18 (1)    → wickets=0, runs=18, overs=1
1403:       3/25        → wickets=3, runs=25
1404:     """
1405:     if not raw or not isinstance(raw, str):
1406:         return None
1407:     raw = raw.strip()
1408: 
1409:     full = re.match(r'(\d+\.?\d*)-(\d+)-(\d+)-(\d+)', raw)
1410:     if full:
1411:         return {
1412:             "overs": full.group(1),
1413:             "maidens": int(full.group(2)),
1414:             "runs": int(full.group(3)),
1415:             "wickets": int(full.group(4)),
1416:         }
1417: 
1418:     wr_overs = re.match(r'(\d+)\s*[-/]\s*(\d+)\s*\((\d+\.?\d*)\)', raw)
1419:     if wr_overs:
1420:         w, r = int(wr_overs.group(1)), int(wr_overs.group(2))
1421:         o = wr_overs.group(3)
1422:         if w > r and w > 5:
1423:             w, r = r, w
1424:         if "." not in o:
1425:             o = o + ".0"
1426:         return {"wickets": w, "runs": r, "overs": o}
1427: 
1428:     wr = re.match(r'(\d+)\s*[-/]\s*(\d+)$', raw)
1429:     if wr:
1430:         w, r = int(wr.group(1)), int(wr.group(2))
1431:         if w > r and w > 5:
1432:             w, r = r, w
1433:         return {"wickets": w, "runs": r}
1434: 
1435:     return None
1436: 
