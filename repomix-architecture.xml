1871: def filter_bowler_batter_row_contamination(extracted: dict,
1872:                                            scoreboard=None) -> dict:
1873:     """Strip bowler reads that are actually active batting rows."""
1874:     if scoreboard is None:
1875:         return extracted
1876:     bowler = extracted.get("bowler")
1877:     if not isinstance(bowler, dict):
1878:         return extracted
1879:     name = (bowler.get("name") or "").strip()
1880:     if not name:
1881:         return extracted
1882:     batting_card = getattr(scoreboard, "batting_card", None) or {}
1883:     if not batting_card:
1884:         return extracted
1885:     resolved = scoreboard.resolve_name(name)
1886:     card_key = (scoreboard._find_card_key(resolved, batting_card)
1887:                 if resolved else None)
1888:     batter_names = set()
1889:     for row in extracted.get("batters") or []:
1890:         raw = (row.get("name") or "").strip()
1891:         if raw:
1892:             batter_names.add(raw.upper())
1893:             row_resolved = scoreboard.resolve_name(raw)
1894:             if row_resolved:
1895:                 batter_names.add(row_resolved.upper())
1896:     is_active_batter = (
1897:         card_key is not None
1898:         and batting_card.get(card_key, {}).get("status") == "batting")
1899:     is_batter_row_name = (
1900:         name.upper() in batter_names
1901:         or (card_key is not None and card_key.upper() in batter_names))
1902:     has_complete_figures = (
1903:         bowler.get("wickets") is not None
1904:         and bowler.get("runs") is not None
1905:         and bowler.get("overs") is not None)
1906:     if is_active_batter or is_batter_row_name or (
1907:             card_key is not None and not has_complete_figures):
1908:         log.warn(
1909:             f"  [BOWLER-BATTER-GATE] bowler stripped — "
1910:             f"name={name!r} resolved_batter={card_key!r} "
1911:             f"complete_figures={has_complete_figures}")
1912:         extracted.pop("bowler", None)
1913:         extracted.pop("bowler_name", None)
1914:         extracted.pop("bowler_figures", None)
1915:     return extracted
