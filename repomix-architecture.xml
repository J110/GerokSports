1594: def _assign_stats_by_history(b1, b2, name1, name2,
1595:                              pair_a, pair_b, scoreboard):
1596:     """Assign two stat pairs to two players using scoreboard history."""
1597:     prev1 = _get_previous_runs(name1, scoreboard)
1598:     prev2 = _get_previous_runs(name2, scoreboard)
1599: 
1600:     if prev1 is not None and prev2 is not None:
1601:         diff_a1 = abs(pair_a[0] - prev1)
1602:         diff_b1 = abs(pair_b[0] - prev1)
1603:         diff_a2 = abs(pair_a[0] - prev2)
1604:         diff_b2 = abs(pair_b[0] - prev2)
1605: 
1606:         if (diff_a1 + diff_b2) <= (diff_b1 + diff_a2):
1607:             b1["runs"], b1["balls"] = pair_a
1608:             b2["runs"], b2["balls"] = pair_b
1609:         else:
1610:             b1["runs"], b1["balls"] = pair_b
1611:             b2["runs"], b2["balls"] = pair_a
1612:     else:
1613:         b1["runs"], b1["balls"] = pair_a
1614:         b2["runs"], b2["balls"] = pair_b
