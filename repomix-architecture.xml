3860:     def update_this_over(self, broadcast: list):
3861:         """Update this-over from the broadcast indicator — sole source of
3862:         ball-by-ball data. The broadcast shows cumulative results like
3863:         ['.', '4', '1'] after 3 balls. Always trust broadcast over any
3864:         local state."""
3865:         if not broadcast:
3866:             return
3867: 
3868:         # Normalise all entries to strings (extractor may send ints)
3869:         broadcast = [str(x) for x in broadcast]
3870: 
3871:         if broadcast == self.this_over:
3872:             return
3873: 
3874:         if len(broadcast) < len(self.this_over) and len(self.this_over) > 6:
3875:             log.info(f"[THIS-OVER] Broadcast shorter "
3876:                      f"({len(self.this_over)}→{len(broadcast)}) "
3877:                      f"— new over, resetting")
3878:             self.this_over = broadcast
3879:         elif len(broadcast) >= len(self.this_over):
3880:             self.this_over = broadcast
3881: 
3882:         if len(self.this_over) > 12:
3883:             log.info(f"[THIS-OVER] {len(self.this_over)} entries — "
3884:                      f"missed reset, trimming to last 6")
3885:             self.this_over = self.this_over[-6:]
