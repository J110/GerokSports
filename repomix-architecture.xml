 889:     def get_sleep_time(self) -> float:
 890:         # Over-end burst always wins (last-ball-of-over coverage).
 891:         if self.in_burst:
 892:             return 0.0
 893:         if self.ad_detected:
 894:             self.ad_detected = False
 895:             self.over_complete = False
 896:             return 25.0
 897:         # Phase-driven cadence (Phase 3, 2026-04-19): when Scout has
 898:         # tagged the last frame with a frame_phase, that tag is the
 899:         # most informative signal we have — use the phase map
 900:         # directly.  Falls through to camera_view logic when phase
 901:         # is missing (frames recorded before the phase prompt).
 902:         if self.last_frame_phase is not None:
 903:             interval = self.PHASE_FREQUENCY.get(
 904:                 self.last_frame_phase)
 905:             if interval is not None:
 906:                 return interval
 907:         # ── back-compat: camera_view-driven cadence ──────────────
 908:         # Active-play burst: Scout tagged the last frame as live
 909:         # cricket → densely sample so the tagged buffer has enough
 910:         # bowlers_end frames at the moment of delivery detection.
 911:         if self.last_camera_view in self._ACTIVE_PLAY_VIEWS:
 912:             return self.ACTIVE_PLAY_INTERVAL
 913:         # Active-play tail: we just saw live cricket within the
 914:         # last ACTIVE_TAIL_HOLD seconds.  Stay fast — a dot ball's
 915:         # broadcast cut-away (closeup of the bowler walking back,
 916:         # replay of the shot) lasts ~3-5s before the strip
 917:         # repaints with the new overs.  Polling at 0.5s through
 918:         # this window means we catch the strip tick within ~1s
 919:         # of it appearing instead of waiting 2.5s.
 920:         if time.time() < self._active_tail_until:
 921:             return self.ACTIVE_PLAY_INTERVAL
 922:         if self.last_camera_view in self._DEAD_TIME_VIEWS:
 923:             return self.DEAD_TIME_INTERVAL
 924:         return self.DEFAULT_INTERVAL
