3127:     def sync_fow_to_wickets(self):
3128:         """Ensure FOW list length matches actual wickets count.
3129: 
3130:         Immutability principle: confirmed FOW entries are PERMANENT.
3131:         We will only ever ADD placeholders for wickets we know
3132:         happened but missed the details of (e.g. mid-innings join).
3133:         We will NEVER trim, even if the wickets counter regresses —
3134:         because a wickets-counter regression is itself a bug
3135:         (the only way wickets go down is an innings change, which
3136:         runs `start_new_innings` and clears FOW explicitly), and
3137:         deleting a confirmed FOW entry to "make the math work" with
3138:         a corrupt wickets counter is the wrong direction. Log loudly
3139:         instead so the underlying mis-read is visible.
3140:         """
3141:         wk = int(self._inn.get("wickets") or 0)
3142:         if len(self.fall_of_wickets) > wk:
3143:             log.info(
3144:                 f"[FOW] Length {len(self.fall_of_wickets)} > "
3145:                 f"wickets counter {wk} — keeping all FOW entries "
3146:                 f"(immutable). Wickets counter likely regressed.")
3147:         # Seeding policy:
3148:         #  * gap == 1 AND we already have ≥1 confirmed FOW: a fresh
3149:         #    wicket likely just fell — current striker / score / overs
3150:         #    are reasonable best-effort guesses that the dismissal
3151:         #    graphic will upgrade in seconds.
3152:         #  * gap > 1, or this is cold-start (no prior FOW): we are
3153:         #    back-filling wickets that fell in the unobserved past.
3154:         #    Current striker/score/overs are NOT correct for those
3155:         #    historical events — seeding them produces nonsense like
3156:         #    "46/1, 46/2, 46/3 (Stubbs, 5.2)" three times for wickets
3157:         #    that actually fell at different scores in different overs.
3158:         #    Use "unknown" placeholders instead; broadcast graphics
3159:         #    (or the scorecard summary on innings break) will upgrade
3160:         #    them as data arrives.
3161:         # === No-fabrication rule ===
3162:         # Every placeholder we add here is for a wicket we did NOT
3163:         # witness end-to-end through the ball-event path.  Mark them
3164:         # `_unwitnessed: True` so the UI can render an honest
3165:         # "W{n} — details unavailable" instead of guessing, and so
3166:         # `_add_fow` can distinguish placeholders that are safe to
3167:         # upgrade (unwitnessed) from confirmed entries that must
3168:         # never be rewritten by the regular wicket-detection path.
3169:         #
3170:         # Previously the "fresh wicket" branch (gap == 1, mid-game)
3171:         # seeded a placeholder with `current_striker` as the
3172:         # dismissed batter and force-marked them OUT in the batting
3173:         # card.  That was the source of the Jofra-Archer→Vaibhav-
3174:         # Sooryavanshi flip on 2026-04-19: striker state lagged the
3175:         # broadcast by one rotation, so the wrong batter was named
3176:         # in the placeholder, marked OUT in the card, and later when
3177:         # the real dismissal graphic surfaced the rewrite path
3178:         # tripped because the existing entry's batter was now flagged
3179:         # `status="out"` but the new entry's batter was on a
3180:         # different team / never batted.  Removing the seed (and
3181:         # hence the side-effect on the batting card) eliminates the
3182:         # whole class of bugs at the cost of ~2-5 frames where the
3183:         # UI shows "details unavailable" before the real wicket
3184:         # event populates the slot via `_add_fow`.
3185:         while len(self.fall_of_wickets) < wk:
3186:             missing_wk = len(self.fall_of_wickets) + 1
3187:             self.fall_of_wickets.append(
3188:                 Scoreboard.make_fow_placeholder(missing_wk))
3189:             log.info(f"[FOW] Placeholder W{missing_wk}: _unwitnessed "
3190:                      f"(no fabrication — awaiting real wicket event "
3191:                      f"or CB scrape enrichment)")
