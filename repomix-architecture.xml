 566:     def finalize_match(self, reason: str) -> dict | None:
 567:         """Mark match as terminated on a physics condition.
 568: 
 569:         Called exactly once when innings-2 physics resolve:
 570:           - "target_reached": chase completed, batting team won
 571:           - "all_out": chasing team bowled out
 572:           - "overs_exhausted": 20 overs used without reaching target
 573: 
 574:         Idempotent — subsequent calls are no-ops and return the
 575:         previously-computed result.
 576:         """
 577:         if self.match_complete:
 578:             return self.match_result
 579:         self.match_complete = True
 580:         self.match_end_reason = reason
 581:         self.match_result = self._compute_result(reason)
 582:         log.info(
 583:             f"[MATCH-COMPLETE] reason={reason} "
 584:             f"result={self.match_result}")
 585:         return self.match_result
 586: 
 587:     def _compute_result(self, reason: str) -> dict:
 588:         """Build a human-readable match result dict.
 589: 
 590:         Structure:
 591:           winner: str — team name
 592:           margin: str — e.g. "by 4 wickets" or "by 23 runs"
 593:           balls_remaining: int | None — only set on target_reached
 594:           reason: str — the physics condition that terminated the match
 595:         """
 596:         inn2 = self._inn if self.current_innings == 2 else None
 597:         if inn2 is None:
 598:             return {"winner": None, "margin": None,
 599:                     "balls_remaining": None, "reason": reason}
 600:         try:
 601:             score = int(inn2.get("score") or 0)
 602:         except (ValueError, TypeError):
 603:             score = 0
 604:         try:
 605:             wkts = int(inn2.get("wickets") or 0)
 606:         except (ValueError, TypeError):
 607:             wkts = 0
 608:         try:
 609:             overs_f = float(inn2.get("overs") or 0.0)
 610:         except (ValueError, TypeError):
 611:             overs_f = 0.0
 612:         try:
 613:             target = int(inn2.get("target") or 0)
 614:         except (ValueError, TypeError):
 615:             target = 0
 616: 
 617:         batting = self.batting_team
 618:         bowling = self.bowling_team
 619: 
 620:         if reason == "target_reached":
 621:             whole = int(overs_f)
 622:             partial = round((overs_f - whole) * 10)
 623:             balls_bowled = whole * 6 + max(0, partial)
 624:             balls_remaining = max(0, 120 - balls_bowled)
 625:             wickets_left = max(0, 10 - wkts)
 626:             return {
 627:                 "winner": batting,
 628:                 "margin": (
 629:                     f"by {wickets_left} wicket"
 630:                     f"{'s' if wickets_left != 1 else ''}"),
 631:                 "balls_remaining": balls_remaining,
 632:                 "reason": reason,
 633:             }
 634:         elif reason in ("all_out", "overs_exhausted"):
 635:             if target > 0:
 636:                 runs = target - 1 - score
 637:                 runs = max(0, runs)
 638:             else:
 639:                 runs = None
 640:             # Tie handling: if the chasing side ends on exactly
 641:             # target-1 (== team 1 total), scores are level. In T20 a
 642:             # super-over resolves it; absent that signal, the correct
 643:             # terminal label is "tied", not a 0-run win.
 644:             if runs == 0:
 645:                 return {
 646:                     "winner": None,
 647:                     "margin": "tied",
 648:                     "balls_remaining": None,
 649:                     "reason": reason,
 650:                 }
 651:             return {
 652:                 "winner": bowling,
 653:                 "margin": (
 654:                     f"by {runs} run{'s' if (runs or 0) != 1 else ''}"
 655:                     if runs is not None else None),
 656:                 "balls_remaining": None,
 657:                 "reason": reason,
 658:             }
 659:         return {"winner": None, "margin": None,
 660:                 "balls_remaining": None, "reason": reason}
