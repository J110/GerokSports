2118:                 "bat1": {
2119:                     "name": _bat1_out, "runs": self.bat1_runs,
2120:                     "balls": self.bat1_balls, "sr": self.bat1_sr,
2121:                 },
2122:                 "bat2": {
2123:                     "name": _bat2_out, "runs": self.bat2_runs,
2124:                     "balls": self.bat2_balls, "sr": self.bat2_sr,
2125:                 },
2126:                 "bowler": {
2127:                     "name": _bowler_out,
2128:                     "wickets": self.bowler_wickets,
2129:                     "runs": self.bowler_runs,
2130:                     "overs": self.bowler_overs,
2131:                     "economy": self.bowler_economy,
2132:                 },
2133:                 "partnership": {
