 790:     # Name resolution — broadcast names → canonical squad names
 791:     # ------------------------------------------------------------------
 792: 
 793:     _VOWEL_VARIANTS = {
 794:         "OO": "U", "U": "OO",
 795:         "EE": "I", "I": "EE",
 796:         "TH": "T", "T": "TH",
 797:         "V": "W", "W": "V",
 798:     }
 799: 
 800:     def _build_name_lookup(self, all_players: list[str]):
 801:         """Build lookup table mapping broadcast variants to canonical names."""
 802:         self._name_lookup = {}
 803:         for full in all_players:
 804:             parts = full.strip().split()
 805:             if not parts:
 806:                 continue
 807:             up = full.upper().strip()
 808:             self._name_lookup[up] = full
 809: 
 810:             if len(parts) >= 2:
 811:                 last = parts[-1].upper()
 812:                 first = parts[0].upper()
 813:                 self._name_lookup[last] = full
 814:                 self._name_lookup[f"{first[0]} {last}"] = full
 815:                 self._name_lookup[f"{first[0]}. {last}"] = full
 816:                 self._name_lookup[f"{first[0]}{last}"] = full
 817: 
 818:                 if len(parts) == 3:
 819:                     middle = parts[1].upper()
 820:                     self._name_lookup[f"{first[0]} {middle[0]} {last}"] = full
 821: 
 822:                 for old, new in self._VOWEL_VARIANTS.items():
 823:                     variant = last.replace(old, new)
 824:                     if variant != last:
 825:                         self._name_lookup[variant] = full
 826:                         if len(parts) >= 2:
 827:                             self._name_lookup[
 828:                                 f"{first[0]} {variant}"] = full
 829: 
 830:         self._add_unique_prefixes(all_players)
 831:         self._add_unique_first_names(all_players)
 832: 
 833:     def _add_unique_first_names(self, all_players: list[str]):
 834:         """Add first-name-only lookup if the first name is unique."""
 835:         first_name_map: dict[str, list[str]] = {}
 836:         for full in all_players:
 837:             parts = full.strip().split()
 838:             if len(parts) >= 2:
 839:                 first = parts[0].upper()
 840:                 first_name_map.setdefault(first, []).append(full)
 841:         for first, names in first_name_map.items():
 842:             if len(set(names)) == 1 and first not in self._name_lookup:
 843:                 self._name_lookup[first] = names[0]
 844: 
 845:     def _add_unique_prefixes(self, all_players: list[str]):
 846:         """Add 3/4-letter surname prefixes only if unique across squads."""
 847:         prefix_candidates: dict[str, list[str]] = {}
 848:         for full in all_players:
 849:             parts = full.strip().split()
 850:             if not parts:
 851:                 continue
 852:             last = parts[-1].upper()
 853:             surnames = {last}
 854:             for old, new in self._VOWEL_VARIANTS.items():
 855:                 variant = last.replace(old, new)
 856:                 if variant != last:
 857:                     surnames.add(variant)
 858:             for sn in surnames:
 859:                 if len(sn) >= 5:
 860:                     prefix_candidates.setdefault(sn[:3], []).append(full)
 861:                     prefix_candidates.setdefault(sn[:4], []).append(full)
 862: 
 863:         for prefix, names in prefix_candidates.items():
 864:             if len(set(names)) == 1 and prefix not in self._name_lookup:
 865:                 self._name_lookup[prefix] = names[0]
 866: 
 867:     @staticmethod
 868:     def _name_similarity(a: str, b: str) -> float:
 869:         """Similarity ratio handling insertions/deletions properly."""
 870:         if not a or not b:
 871:             return 0.0
 872:         return SequenceMatcher(None, a, b).ratio()
 873: 
 874:     def resolve_name(self, name: str) -> str | None:
 875:         """Resolve a broadcast name to a canonical squad name."""
 876:         if not name:
 877:             return None
 878:         clean = name.upper().strip()
 879: 
 880:         if clean in self._name_lookup:
 881:             return self._name_lookup[clean]
 882: 
 883:         # Exact match in cards
 884:         if name in self.batting_card or name in self.bowling_card:
 885:             return name
 886: 
 887:         # Fuzzy: surname match, initial+surname
 888:         for canonical in list(self.batting_card) + list(self.bowling_card):
 889:             canonical_parts = canonical.upper().split()
 890:             if clean in canonical_parts:
 891:                 return canonical
 892:             name_parts = clean.split()
 893:             if len(name_parts) == 2 and len(name_parts[0]) <= 2:
 894:                 initial, surname = name_parts
 895:                 if surname in canonical_parts and \
 896:                         canonical.upper().startswith(initial):
 897:                     return canonical
 898: 
 899:         # Single initial (e.g. "M" from scorer) — try "M <surname>" combos
 900:         if len(clean) <= 2:
 901:             for key, canonical in self._name_lookup.items():
 902:                 if key.startswith(clean + " ") and len(key.split()) == 2:
 903:                     self._name_lookup[clean] = canonical
 904:                     log.info(f"[NAME] Single initial '{clean}' → "
 905:                              f"'{canonical}' (via '{key}')")
 906:                     return canonical
 907: 
 908:         log.info(f"[NAME] Exact miss for '{clean}', trying fuzzy "
 909:                  f"({len(self._name_lookup)} keys)...")
 910: 
 911:         best_match = None
 912:         best_score = 0.0
 913:         for key, canonical in self._name_lookup.items():
 914:             if len(key) < 4 and len(clean) > 4:
 915:                 continue
 916:             score = self._name_similarity(clean, key)
 917:             if score > best_score and score >= 0.75:
 918:                 best_score = score
 919:                 best_match = canonical
 920:         if best_match:
 921:             self._name_lookup[clean] = best_match
 922:             log.info(f"Fuzzy matched '{name}' → '{best_match}' "
 923:                      f"({best_score:.0%})")
 924:             return best_match
 925: 
 926:         near = sorted(
 927:             [(k, self._name_similarity(clean, k))
 928:              for k in self._name_lookup if len(k) >= 4],
 929:             key=lambda x: -x[1])[:3]
 930:         log.warn(f"No match for '{clean}'. Closest: "
 931:                  f"{[(k, f'{s:.2f}') for k, s in near]}")
 932: 
 933:         return None
 934: 
 935:     def resolve_name_split(self, raw_name: str) -> list[str]:
 936:         """Resolve a name, splitting merged names if needed.
 937: 
 938:         "Prashant Dube" where full→Prashant Veer (fuzzy) but
 939:         surname "Dube"→Shivam Dube → split into two players.
 940:         Returns list of 1 or 2 canonical names.
 941:         """
 942:         if not raw_name:
 943:             return []
 944:         parts = raw_name.strip().split()
 945: 
 946:         if len(parts) == 2:
 947:             full_match = self.resolve_name(raw_name)
 948:             surname_match = self.resolve_name(parts[1])
 949:             firstname_match = self.resolve_name(parts[0])
 950: 
 951:             if (full_match and surname_match
 952:                     and full_match != surname_match
 953:                     and firstname_match
 954:                     and firstname_match != surname_match):
 955:                 log.info(f"[NAME] Merged names: '{raw_name}' → "
 956:                          f"'{firstname_match}' + '{surname_match}'")
 957:                 return [firstname_match, surname_match]
 958: 
 959:             if full_match:
 960:                 return [full_match]
 961: 
 962:         resolved = self.resolve_name(raw_name)
 963:         return [resolved] if resolved else []
 964: 
