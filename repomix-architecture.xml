 970: # Maximum overs / score for a single T20 innings, used as sanity
 971: # bounds for the innings-1 final-state latch.  T20 caps at 20 overs;
 972: # a 350-run innings would shatter the IPL record by ~85 (max in IPL
 973: # history is 287/3 by SRH on 2024-03-27).  Anything above these
 974: # thresholds is an extractor hallucination (e.g. F921 on 2026-04-25
 975: # read 639-4 (76.5) from a partly-tornoff broadcast graphic).
 976: # Without these bounds the latch's max-wins logic locks out
 977: # subsequent legitimate finals — see backlog "P0: Innings-1-final
 978: # latch poisoned".
 979: _INNINGS_TOTAL_MAX_OVERS = 20.0
 980: _INNINGS_TOTAL_MAX_SCORE = 350
