 666:     def setup_innings(self, batting_team: str, bowling_team: str,
 667:                       batting_squad: list[str], bowling_squad: list[str],
 668:                       squad_roles: dict[str, str] | None = None,
 669:                       batting_xi: list[str] | None = None,
 670:                       bowling_xi: list[str] | None = None,
 671:                       player_styles: dict[str, dict] | None = None):
 672:         """Pre-build scorecards with all players. Stats start at null.
 673: 
 674:         squad_roles maps canonical name → role string
 675:         (e.g. "bowler", "bat_allrounder", "bowl_allrounder").
 676:         batting_xi / bowling_xi: the playing XI names (subset of squad).
 677:         player_styles maps canonical name → {batting_style, bowling_style}
 678:         (from player_enrichment.enrich_squad_styles).
 679:         """
 680:         self.batting_team = batting_team
 681:         self.bowling_team = bowling_team
 682:         if squad_roles:
 683:             self._squad_roles.update(squad_roles)
 684:         if player_styles:
 685:             self._player_styles.update(player_styles)
 686: 
 687:         _bat_xi_set = set(batting_xi) if batting_xi else set()
 688:         _bowl_xi_set = set(bowling_xi) if bowling_xi else set()
 689: 
 690:         self.batting_card = {}
 691:         for name in batting_squad:
 692:             st = self._player_styles.get(name) or {}
 693:             self.batting_card[name] = {
 694:                 "runs": None, "balls": None,
 695:                 "fours": None, "sixes": None, "sr": None,
 696:                 "status": "yet_to_bat", "dismissal": None,
 697:                 "position": len(self.batting_card) + 1,
 698:                 "is_playing_xi": name in _bat_xi_set if _bat_xi_set else True,
 699:                 "batting_style": st.get("batting_style", "unknown"),
 700:                 "bowling_style": st.get("bowling_style", "unknown"),
 701:             }
 702: 
 703:         self.bowling_card = {}
 704:         for name in bowling_squad:
 705:             st = self._player_styles.get(name) or {}
 706:             self.bowling_card[name] = {
 707:                 "overs": None, "maidens": None,
 708:                 "runs": None, "wickets": None, "econ": None,
 709:                 "position": len(self.bowling_card) + 1,
 710:                 "is_playing_xi": name in _bowl_xi_set if _bowl_xi_set else True,
 711:                 "batting_style": st.get("batting_style", "unknown"),
 712:                 "bowling_style": st.get("bowling_style", "unknown"),
 713:             }
 714: 
 715:         self._dismissed_inferred = False
 716:         self._build_name_lookup(batting_squad + bowling_squad)
 717: 
 718:         self._inn["batting_team"] = batting_team
 719:         self._inn["bowling_team"] = bowling_team
 720: 
 721:         log.info(f"Scorecards built: {batting_team} ({len(batting_squad)} bat) "
 722:                  f"vs {bowling_team} ({len(bowling_squad)} bowl)")
