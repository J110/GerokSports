4440:     def _assert_payload_invariants(payload):
4441:         """Log-only invariant checks on the WS payload shape.
4442: 
4443:         Flags regressions where:
4444:           (a) striker is not None but doesn't match any batting_card name
4445:               (the exact bug Issue 1 introduced — raw scout surname in
4446:               striker, canonical name in card → no batter highlighted).
4447:           (b) FOW placeholder has batter=None/unknown but
4448:               _unwitnessed is missing or False (Issue 4 — dual
4449:               placeholder paths with inconsistent flag).
4450: 
4451:         Fires loudly to the log so monitoring catches regressions.
4452:         """
4453:         try:
4454:             sc = payload.get("scorecard") or {}
4455:             striker = sc.get("striker")
4456:             # Only check when batting_card is present in THIS payload.
4457:             # SM-driven broadcasts don't carry a full batting_card (the
4458:             # UI preserves it via deepMerge from the prior build_full
4459:             # frame), so absence is normal, not a regression.
4460:             if striker and "batting_card" in payload:
4461:                 card_names = {
4462:                     b.get("name") for b in (payload.get("batting_card") or [])
4463:                 }
4464:                 if card_names and striker not in card_names:
4465:                     log.warn(
4466:                         f"  [INVARIANT] striker='{striker}' not in "
4467:                         f"batting_card names="
4468:                         f"{sorted(n for n in card_names if n)}"
4469:                     )
4470:             # (c) 2026-04-21 — striker/non_striker must not name a
4471:             # batter with status=="out" (dismissed).  If WS hygiene
4472:             # is functioning this invariant never fires; it's a
4473:             # canary for future regressions in the striker-clear
4474:             # path after wickets.
4475:             if "batting_card" in payload:
4476:                 _out_set = {
4477:                     b.get("name") for b in (payload.get("batting_card") or [])
4478:                     if b.get("status") == "out"
4479:                 }
4480:                 for _slot in ("striker", "non_striker"):
4481:                     _nm = sc.get(_slot)
4482:                     if _nm and _nm in _out_set:
4483:                         log.warn(
4484:                             f"  [INVARIANT] {_slot}='{_nm}' is "
4485:                             f"dismissed in batting_card")
4486:             for fow in (payload.get("fall_of_wickets") or []):
4487:                 batter = fow.get("batter")
4488:                 is_placeholder = (batter is None
4489:                                   or (isinstance(batter, str)
4490:                                       and batter.lower() in {"unknown", "?"}))
4491:                 if is_placeholder and not fow.get("_unwitnessed"):
4492:                     log.warn(
4493:                         f"  [INVARIANT] FOW placeholder missing "
4494:                         f"_unwitnessed=True: {fow}"
4495:                     )
4496:         except Exception:
4497:             pass
