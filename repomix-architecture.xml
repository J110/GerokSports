 109: class InlineCommentary:
 110:     """Generates commentary inline within the pipeline loop for logging."""
 111: 
 112:     def __init__(self):
 113:         self.groq = _AsyncGroq(api_key=_GROQ_KEY)
 114:         self.context = ContextBuilder()
 115:         self.detector = MomentDetector()
 116:         self._prev_state: dict | None = None
 117:         self.clients: set = set()
 118:         self.history: list[dict] = []
 119:         # Telemetry so a silent stall can never repeat. Increment on
 120:         # every caught exception in generate() and log the running
 121:         # total alongside the error message — 1 counter visible in the
 122:         # log line, no external metrics backend needed.
 123:         self._error_count: int = 0
 124:         # Fix 3 telemetry — running tally of gather-level exceptions
 125:         # swallowed by `return_exceptions=True`. Previously invisible.
 126:         self._llm_exc_count: int = 0
 127:         # Fix 1 telemetry — running tally of dicts returned by
 128:         # _call_llm that were shaped as errors (text=="[error: ...]")
 129:         # or empty, which previously survived isinstance(result,dict)
 130:         # and got broadcast as-is or dropped silently at later stages.
 131:         self._llm_invalid_count: int = 0
