2644:         _CONSENSUS_N = 3
2645:         _cur_bowler = self._inn.get("current_bowler")
2646:         _prev_over_bowler = self._prev_over_bowler
2647:         _bowler_changed = False
2648:         if name == _cur_bowler:
2649:             self._pending_bowler_name = None
2650:             self._pending_bowler_count = 0
