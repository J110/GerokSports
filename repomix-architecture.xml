1001:     def force_cold_start_recalibration(self, reason: str = "") -> None:
1002:         """Drop the current WARM lock and re-enter COLD_START.
1003: 
1004:         Called externally when the pipeline detects that the WARM
1005:         baseline is stuck (e.g. many consecutive tracker-POISON blocks
1006:         with a consistent alternative reading).  The normal stale-
1007:         rejection recovery at line ~710 only fires for cricket-rules
1008:         rejections inside `on_frame`, which never trigger when the
1009:         pipeline's own POISON guard has already stripped the frame
1010:         before it reached us.  This method is the escape hatch for
1011:         that scenario.
1012: 
1013:         Preserves innings, target, and innings_history so the match
1014:         context isn't lost.  All per-innings counters, the warm
1015:         snapshot, and the cold-start candidate are cleared so the
1016:         next good read can seed a fresh candidate.
1017:         """
1018:         prev_state = (f"{self.score}/{self.wickets} ({self.overs}) "
1019:                       f"mode={self.mode}")
1020:         self._last_warm_state = self._snapshot() if self.score is not None else None
1021:         self.mode = "COLD_START"
1022:         self.cold_candidate = None
1023:         self.cold_candidate_streak = 0
1024:         self.cold_frames = 0
1025:         self._stale_reject_count = 0
1026:         self._deferred_score = 0
1027:         self._deferred_frames = 0
1028:         log.info(f"[SM] FORCE_COLD_START_RECALIBRATION: was {prev_state} "
1029:                  f"→ COLD_START (reason={reason or 'external'})")
1030: 
1031:     def _detect_innings_change(self, card: dict, frame: FrameInput) -> bool:
1032:         """Detect innings change and re-enter COLD_START if confirmed."""
1033:         if self.innings >= 2:
1034:             return False
1035: 
1036:         changed = False
1037:         reason = None
1038: 
1039:         # Target appearing for the first time
1040:         if frame.broadcast_target and not self.target:
1041:             changed = True
1042:             reason = "target_appeared"
1043: 
1044:         # Batting team changed
1045:         if (frame.broadcast_team and self.batting_team
1046:                 and frame.broadcast_team.upper() != self.batting_team.upper()):
1047:             changed = True
1048:             reason = reason or "batting_team_changed"
1049: 
1050:         # Score dropping to 0 with wickets 0 while we had significant progress
1051:         s = card.get("score", 0)
1052:         w = card.get("wickets", 0)
1053:         if (s == 0 and w == 0
1054:                 and self.score is not None and self.score > 20
1055:                 and self.wickets is not None):
1056:             changed = True
1057:             reason = reason or "score_reset_from_progress"
1058: 
1059:         # Wickets regression: wickets only go up within an innings, so
1060:         # any strict regression by >1 is structurally impossible without
1061:         # either (a) an innings transition, or (b) OCR corruption. The
1062:         # >1 tolerance filters single-frame misreads (e.g. 6→5) while
1063:         # catching real resets (e.g. 6→0 or 6→1 on new innings).
1064:         if (w is not None and self.wickets is not None
1065:                 and self.wickets >= 2 and w < self.wickets - 1):
1066:             changed = True
1067:             reason = reason or "wickets_regressed"
1068: 
1069:         if not changed:
1070:             return False
1071: 
1072:         log.info(f"[INNINGS-TRANSITION-TELEMETRY] source=score_manager "
1073:                  f"reason={reason} "
1074:                  f"prev={self.score}/{self.wickets} ({self.overs}) "
1075:                  f"prev_team={self.batting_team} "
1076:                  f"cand={s}/{w} cand_team={frame.broadcast_team} "
1077:                  f"cand_target={frame.broadcast_target}")
1078:         log.info(f"[SM] INNINGS CHANGE detected  "
1079:                  f"inn1: {self.score}/{self.wickets} ({self.overs})  "
1080:                  f"team was={self.batting_team}, now={frame.broadcast_team}")
1081: 
1082:         # Archive innings 1
1083:         self.innings_history.append({
1084:             "innings": self.innings,
1085:             "score": self.score,
1086:             "wickets": self.wickets,
1087:             "overs": self.overs,
1088:             "fow_list": list(self.fow_list),
1089:             "over_history": dict(self.over_history),
1090:             "batting_team": self.batting_team,
1091:         })
1092: 
1093:         # Reset state for innings 2 via canonical setter (Fix 16).
1094:         self.set_innings_2(target=frame.broadcast_target,
1095:                            batting_team=frame.broadcast_team,
1096:                            reason=reason,
1097:                            archive=False)
1098: 
1099:         return True
1100: 
1101:     def set_innings_2(self, target: int | None = None,
1102:                       batting_team: str | None = None,
1103:                       reason: str = "set_innings_2",
1104:                       archive: bool = True) -> None:
1105:         """Canonical innings-2 transition (Fix 16, 2026-04-26).
1106: 
1107:         Replaces the historical four-callsite divergence where
1108:         only `_handle_innings_change` archived + reset cached
1109:         scalars (`bat1_runs`, `bat2_runs`, `bowler_*`,
1110:         `this_over`, `over_history`, `partnership_*`,
1111:         `extras_*`, `fow_list`, `pending_extra`,
1112:         `pending_wicket`, etc.).  The other three callsites
1113:         (`_accept_update` line 707, `_update_misc` line 1171,
1114:         `_update_supplements` line 1273) left those scalars
1115:         intact, leaking innings-1 state into innings-2 displays.
1116:         Now all four route through this method.
1117: 
1118:         `archive=True` archives the current innings into
1119:         `innings_history` before the reset (use when the caller
1120:         has not already done so).  `archive=False` skips the
1121:         archive step (for `_handle_innings_change` which
1122:         already archived).
1123:         """
1124:         if self.innings == 2:
1125:             # Idempotent — innings-2 already active.
1126:             return
1127:         if archive:
1128:             log.info(
1129:                 f"[SM-INNINGS-2-RESET] reason={reason}: "
1130:                 f"archiving innings 1 ({self.score}/"
1131:                 f"{self.wickets} ({self.overs}) "
1132:                 f"team={self.batting_team}) and resetting "
1133:                 f"all per-innings cached scalars.  target="
1134:                 f"{target} new_batting_team={batting_team}.")
1135:             self.innings_history.append({
1136:                 "innings": self.innings,
1137:                 "score": self.score,
1138:                 "wickets": self.wickets,
1139:                 "overs": self.overs,
1140:                 "fow_list": list(self.fow_list),
1141:                 "over_history": dict(self.over_history),
1142:                 "batting_team": self.batting_team,
1143:             })
1144:         else:
1145:             log.info(
1146:                 f"[SM-INNINGS-2-RESET] reason={reason}: "
1147:                 f"resetting all per-innings cached scalars "
1148:                 f"(archive already performed by caller).  "
1149:                 f"target={target} new_batting_team="
1150:                 f"{batting_team}.")
1151:         shadow = self.shadow
1152:         history = self.innings_history
1153:         self.__init__(shadow=shadow)
1154:         self.innings_history = history
1155:         self.innings = 2
1156:         if target is not None:
1157:             self.target = target
1158:         if batting_team is not None:
1159:             self.batting_team = batting_team
1160:         self.mode = "COLD_START"
1161: 
