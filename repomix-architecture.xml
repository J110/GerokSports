3928:     def _card_internally_consistent(extracted: dict) -> tuple[bool, str]:
3929:         """Check that batters and bowler can plausibly co-exist on the
3930:         same delivery, given the squad rosters.
3931: 
3932:         Returns (ok, reason). When ok is False, the caller should treat
3933:         the frame as poisoned. When ok is True with reason='incomplete'
3934:         the card just hasn't given us enough data to rule it out — let
3935:         downstream consensus handle it.
3936:         """
3937:         batters = [b.get("name", "")
3938:                    for b in (extracted.get("batters") or [])
3939:                    if b.get("name")]
3940:         bowler_obj = extracted.get("bowler")
3941:         bowler = (bowler_obj.get("name", "")
3942:                   if isinstance(bowler_obj, dict) else "")
3943: 
3944:         bat_teams = {t for t in (_find_player_team(b) for b in batters)
3945:                      if t}
3946:         bowl_team = _find_player_team(bowler) if bowler else None
3947: 
3948:         # Need at least one resolved batter AND a resolved bowler to make
3949:         # any judgement. Otherwise: incomplete, defer to consensus.
3950:         if not bat_teams or not bowl_team:
3951:             return True, "incomplete"
3952: 
3953:         if len(bat_teams) > 1:
3954:             return False, (
3955:                 f"batters span multiple teams {sorted(bat_teams)} — "
3956:                 f"impossible (batters must be on one team)")
3957: 
3958:         bat_team = next(iter(bat_teams))
3959:         if bowl_team == bat_team:
3960:             return False, (
3961:                 f"bowler ({bowler}) on same team as batters "
3962:                 f"({batters}) — both on {bat_team}, impossible")
3963: 
3964:         return True, "ok"
