3529:     def validate_state_consistency(self):
3530:         """Enforce hard invariants after every update cycle."""
3531:         score = self._inn.get("score") or 0
3532:         wickets = self._inn.get("wickets") or 0
3533: 
3534:         # --- Invariant 1: batter runs can never exceed team score ---
3535:         if score:
3536:             total_batter_runs = sum(
3537:                 card.get("runs", 0) or 0
3538:                 for card in self.batting_card.values()
3539:                 if card.get("status") in ("batting", "out")
3540:             )
3541: 
3542:             # Fix 18 Layer 2 (bat-runs reconciler detection,
3543:             # 2026-04-26): observability diagnostic firing on
3544:             # smaller divergences (>+5) than the cap-reset
3545:             # threshold (>+10).  Detection-only — surfaces the
3546:             # divergence for postmortem before it grows to the
3547:             # cap threshold.  Counts per match into
3548:             # `_L2_RECONCILER_FIRES` for the analyzer.
3549:             if total_batter_runs > score + self._L2_RECONCILER_THRESHOLD:
3550:                 log.warn(
3551:                     f"[BAT-SUM-RECONCILER] divergence detected: "
3552:                     f"bat_sum={total_batter_runs} > score+{self._L2_RECONCILER_THRESHOLD}"
3553:                     f"={score + self._L2_RECONCILER_THRESHOLD} "
3554:                     f"(excess={total_batter_runs - score}).  "
3555:                     f"Layer 2 detection-only — Layer 3 cap-reset "
3556:                     f"engages at +{self._L3_CAP_RESET_THRESHOLD}.")
3557:                 if not hasattr(self, "_L2_RECONCILER_FIRES"):
3558:                     self._L2_RECONCILER_FIRES = 0
3559:                 self._L2_RECONCILER_FIRES += 1
3560: 
3561:             if total_batter_runs > score + self._L3_CAP_RESET_THRESHOLD:
3562:                 log.warn(f"[INVARIANT] Batter total {total_batter_runs} > "
3563:                          f"score {score}+10. Capping batters.")
3564:                 # Fix 18 Layer 3 (cap-reset Path C hybrid,
3565:                 # 2026-04-26): the legacy reset only fired when an
3566:                 # *individual* batter's runs > score.  In split-
3567:                 # phantom cases (Brevis +1, Dube +22 on top of
3568:                 # score 30) neither individual batter exceeds
3569:                 # score, so no reset fired (199 cap warnings, 0
3570:                 # resets in the CSK-vs-GT 31-min window).  Path C
3571:                 # hybrid: identify the most-recently-advanced
3572:                 # batter (by frame in `_last_runs_advance`) and
3573:                 # reset that one.  The most recent advance is the
3574:                 # most likely phantom because legitimate scoring
3575:                 # advances are bounded by ball cadence; phantom
3576:                 # OCR jitter advances are unbounded.  Iterative:
3577:                 # after each reset, recompute and continue while
3578:                 # over-cap (max 2 iterations, matching the active
3579:                 # batter count).
3580:                 _l3_iter = 0
3581:                 while (_l3_iter < 2
3582:                        and total_batter_runs > score
3583:                        + self._L3_CAP_RESET_THRESHOLD):
3584:                     _l3_iter += 1
3585:                     # Pick most-recent advance among active batters
3586:                     _active_advance = [
3587:                         (n, self._last_runs_advance.get(n, {}))
3588:                         for n, c in self.batting_card.items()
3589:                         if c.get("status") == "batting"
3590:                     ]
3591:                     _active_advance = [
3592:                         (n, a) for n, a in _active_advance
3593:                         if a.get("frame") is not None]
3594:                     _active_advance.sort(
3595:                         key=lambda x: x[1].get("frame", -1),
3596:                         reverse=True)
3597:                     if not _active_advance:
3598:                         # Fall back to legacy per-batter check.
3599:                         for name, card in self.batting_card.items():
3600:                             if card.get("status") == "batting":
3601:                                 runs = card.get("runs", 0) or 0
3602:                                 if runs > score:
3603:                                     card["runs"] = None
3604:                                     card["balls"] = None
3605:                                     self._tracker.force_set(
3606:                                         f"bat:{name}:runs", None)
3607:                                     self._tracker.force_set(
3608:                                         f"bat:{name}:balls", None)
3609:                                     log.warn(
3610:                                         f"[INVARIANT] {name} "
3611:                                         f"runs {runs} > score "
3612:                                         f"{score} — reset "
3613:                                         f"(legacy per-batter)")
3614:                         break
3615:                     _victim, _advance = _active_advance[0]
3616:                     _runs_before = (
3617:                         self.batting_card[_victim].get("runs"))
3618:                     self.batting_card[_victim]["runs"] = None
3619:                     self.batting_card[_victim]["balls"] = None
3620:                     self._tracker.force_set(
3621:                         f"bat:{_victim}:runs", None)
3622:                     self._tracker.force_set(
3623:                         f"bat:{_victim}:balls", None)
3624:                     self._last_runs_advance.pop(_victim, None)
3625:                     log.warn(
3626:                         f"[CAP-RESET-LAST-ADVANCE] iter={_l3_iter} "
3627:                         f"reset '{_victim}' (runs was "
3628:                         f"{_runs_before}, last advance at frame "
3629:                         f"{_advance.get('frame')} "
3630:                         f"{_advance.get('from')}→"
3631:                         f"{_advance.get('to')}).  "
3632:                         f"bat_sum was {total_batter_runs} > "
3633:                         f"score+{self._L3_CAP_RESET_THRESHOLD}; "
3634:                         f"Path C hybrid (Fix 18 Layer 3).")
3635:                     if not hasattr(self, "_L3_CAP_RESET_FIRES"):
3636:                         self._L3_CAP_RESET_FIRES = 0
3637:                     self._L3_CAP_RESET_FIRES += 1
3638:                     # Recompute total for next iteration.
3639:                     total_batter_runs = sum(
3640:                         c.get("runs", 0) or 0
3641:                         for c in self.batting_card.values()
3642:                         if c.get("status") in ("batting", "out"))
3643: 
3644:         # --- Invariant 2: no FOW-witnessed dismissals in active set ---
3645:         # Fix 2 (2026-04-25, P0-A): defense-in-depth against the F339
3646:         # resurrection class.  Even if some other code path bypasses
3647:         # `update_batter`'s un-dismiss guard (Fix 1), this post-hoc
3648:         # check demotes any batter back to "out" if FOW carries a
3649:         # witnessed entry for them.  Option A: just demote, no
3650:         # replacement inference — leaving a "vacancy" (one active
3651:         # batter) is a separate problem the existing code already
3652:         # handles, and inferring a replacement from squad position
3653:         # could itself be wrong.
3654:         active = [n for n, c in self.batting_card.items()
3655:                   if c["status"] == "batting"]
3656:         for name in active:
3657:             if self._is_witnessed_dismissal(name):
3658:                 log.warn(f"[INVARIANT] Demoting resurrected batter "
3659:                          f"'{name}' (witnessed FOW entry) — restoring "
3660:                          f"out status")
3661:                 self.batting_card[name]["status"] = "out"
3662:                 # Preserve dismissal record by recovering it from FOW
3663:                 # if the entry was wiped by the un-dismiss path.
3664:                 if not self.batting_card[name].get("dismissal"):
3665:                     fow = next(
3666:                         (f for f in self.fall_of_wickets
3667:                          if f.get("batter") == name and f.get("_witnessed")),
3668:                         None,
3669:                     )
3670:                     if fow:
3671:                         self.batting_card[name]["dismissal"] = {
3672:                             "how": fow.get("how"),
3673:                             "bowler": fow.get("bowler"),
3674:                             "fielder": fow.get("fielder"),
3675:                         }
3676: 
3677:         # --- Invariant 3: max 2 active batters ---
3678:         # Fix 3 (2026-04-25, P0-A): prefer FOW-witnessed dismissals
3679:         # over squad position when deactivating excess actives.  The
3680:         # legacy position-based sort would deactivate the lower-order
3681:         # batter (e.g. Rana, pos 5) when the *resurrected* one
3682:         # (Pathum, pos 2) was the actual culprit.  Most violations
3683:         # should be caught by Invariant 2 above; if a violation
3684:         # survives, FOW-resurrected first / position fallback is the
3685:         # right ordering.
3686:         active = [n for n, c in self.batting_card.items()
3687:                   if c["status"] == "batting"]
3688:         if len(active) > 2:
3689:             log.warn(f"[INVARIANT] {len(active)} active batters: {active}")
3690:             fow_resurrected = [n for n in active
3691:                                if self._is_witnessed_dismissal(n)]
3692:             if fow_resurrected:
3693:                 for name in fow_resurrected[:len(active) - 2]:
3694:                     self.batting_card[name]["status"] = "out"
3695:                     log.warn(f"[INVARIANT] Demoting resurrected batter "
3696:                              f"'{name}' from active set "
3697:                              f"(FOW-witnessed dismissal)")
3698:                 active = [n for n, c in self.batting_card.items()
3699:                           if c["status"] == "batting"]
3700: 
3701:             if len(active) > 2:
3702:                 # No (more) FOW resurrections — fall back to position.
3703:                 # This branch should not normally fire: if max-2 is
3704:                 # violated, at least one active should be FOW-witnessed.
3705:                 log.warn(f"[INVARIANT] Falling back to position-based "
3706:                          f"deactivation; no FOW match in active set "
3707:                          f"{active} (anomaly)")
3708:                 sorted_by_pos = sorted(
3709:                     active,
3710:                     key=lambda n: self.batting_card[n].get("position", 99))
3711:                 for name in sorted_by_pos[2:]:
3712:                     self.batting_card[name]["status"] = "yet_to_bat"
3713:                     log.warn(f"[INVARIANT] Deactivated {name} "
3714:                              f"(pos {self.batting_card[name].get('position')})")
3715: 
3716:         # --- Invariant 4: bowler wickets can never exceed team wickets ---
3717:         if wickets:
3718:             for name, card in self.bowling_card.items():
3719:                 bw = card.get("wickets")
3720:                 if bw is not None and int(bw) > int(wickets):
3721:                     log.warn(f"[INVARIANT] {name} has {bw} wickets but "
3722:                              f"team only lost {wickets} — capping")
3723:                     card["wickets"] = int(wickets)
3724:                     self._tracker.force_set(
3725:                         f"bowl:{name}:wickets", int(wickets))
