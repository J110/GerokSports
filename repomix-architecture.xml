1494: def _resolve_for_split(token: str, name_lookup: dict, scoreboard) -> str | None:
1495:     """Resolve a token to a squad member using lookup + fuzzy scoreboard match."""
1496:     hit = _resolve_to_squad(token, name_lookup)
1497:     if hit:
1498:         return hit
1499:     if scoreboard:
1500:         return scoreboard.resolve_name(token)
1501:     return None
