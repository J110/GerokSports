2735:                     and _w is not None and 0 <= _w <= 10
2736:                     and _o is not None and 0.0 <= _o <= 4.0
2737:                     and (_r > 0 or _w > 0 or _o > 0)):
2738:                 seed_r, seed_w = _r, _w
2739:                 seed_o = str(overs)
2740:                 from_scout = True
