1188: def _parse_this_over_from_scout(scout_text: str) -> list[str] | None:
1189:     """Try to extract this-over tokens from Scout's raw text."""
1190:     m = _THIS_OVER_RE.search(scout_text)
1191:     if not m:
1192:         for line in scout_text.split("\n"):
1193:             low = line.lower().strip()
1194:             if any(k in low for k in ("this over", "current over")):
1195:                 tokens = _THIS_OVER_TOKEN_RE.findall(line)
1196:                 if tokens:
1197:                     return tokens
1198:         return None
1199:     tokens = _THIS_OVER_TOKEN_RE.findall(m.group(1))
1200:     return tokens if tokens else None
