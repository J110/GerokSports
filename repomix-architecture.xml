 736: class AdaptiveSleep:
 737:     """Event-driven sleep with burst mode at X.5 overs.
 738: 
 739:     Normal: 1s between frames during play, 25s during over-break ads.
 740:     Burst:  0s (back-to-back) for ~8s after the 5th ball of an over,
 741:             maximising the chance of reading the score before ads cut in.
 742: 
 743:     Active-play burst (Phase 2, 2026-04-18): when Scout's last frame
 744:     was tagged ``camera_view == "bowlers_end"`` (or ``side_on``), the
 745:     broadcast is showing live cricket — drop the cadence to ~0.5s so
 746:     we densely populate BallAnalyzer's tagged buffer with delivery
 747:     frames.  When Scout tags a dead-time view (replay/graphic/ad/
 748:     closeup) we relax the cadence up to ~2.5s.
 749: 
 750:     Phase-driven cadence (Phase 3, 2026-04-19): Scout's prompt now
 751:     also returns ``frame_phase`` (release / flight / shot / post_shot
 752:     / runup / between_play / ...).  Phases have very different
 753:     information density: release/flight/shot are 1-2 s windows that
 754:     contain ALL the classification data; runup is a 3-5 s walk that
 755:     changes nothing frame-to-frame.  When ``frame_phase`` is set we
 756:     use a per-phase interval map instead of the single 0.5 s active-
 757:     play bucket.  Camera-view logic stays as the fallback for back-
 758:     compat (frames recorded before the phase prompt rolled out have
 759:     phase=None).
 760:     """
 761: 
 762:     BURST_DURATION = 8.0
 763: 
 764:     # Active-play cadences (seconds between Scout calls).
 765:     ACTIVE_PLAY_INTERVAL = 0.5    # bowlers_end / side_on
 766:     DEAD_TIME_INTERVAL = 2.5      # replay / graphic / ad / other
 767:     DEFAULT_INTERVAL = 1.0        # closeup / unknown — middle ground
 768: 
 769:     _ACTIVE_PLAY_VIEWS = ("bowlers_end", "side_on")
 770:     _DEAD_TIME_VIEWS = ("replay", "graphic", "ad", "other")
 771: 
 772:     # Phase-driven cadence map.  Scout's reported `frame_phase`
 773:     # selects the next-frame interval directly.
 774:     #   * release/flight/shot @ 0.4 s — max burst, the 2-second
 775:     #     window where length/line/shot data lives.  Scout's avg
 776:     #     response is ~800 ms, so the effective rate is ~1 call/s
 777:     #     (Path A from the 2026-04-19 design notes).  If frame
 778:     #     density turns out to be insufficient we'll pipeline Scout
 779:     #     calls during bursts (Path B).
 780:     #   * post_shot @ 0.6 s — fielder reaction is useful for shot
 781:     #     direction / boundary calls.
 782:     #   * fielder_reaction @ 0.8 s — trajectory confirmation.
 783:     #   * runup @ 1.5 s — bowler walking, nothing changes.
 784:     #   * between_play @ 2.0 s — dead time.
 785:     #   * replay/graphic @ 3.0 s — broadcast intermission.
 786:     #   * advertisement @ 8.0 s — long quiet wait for end.
 787:     PHASE_FREQUENCY: dict[str, float] = {
 788:         "runup":            1.5,
 789:         "release":          0.4,
 790:         "flight":           0.4,
 791:         "shot":             0.4,
 792:         "post_shot":        0.6,
 793:         "fielder_reaction": 0.8,
 794:         "between_play":     2.0,
 795:         "replay":           3.0,
 796:         "graphic":          3.0,
 797:         "advertisement":    8.0,
 798:         "other":            2.0,
 799:     }
