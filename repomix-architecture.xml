2396: class StateRecoveryAggregator:
2397:     """Telemetry-first multi-guard state-recovery consensus detector.
2398: 
2399:     Architectural contract:
2400:     - Every guard that detects a stale-reference deadlock eventually
2401:       needs release semantics, but a single guard family is too noisy
2402:       to mutate state safely.
2403:     - Require two independent guard families plus candidate-internal
2404:       coherence so persistent OCR/stat-graphic noise does not become a
2405:       recovery path.
2406:     - Phase 1 is telemetry-only. Phase 2 must not mutate until
2407:       ScoreManager's Fix-16 scalar surface is reset together with
2408:       cold-start re-entry; `force_cold_start_recalibration()` alone is
2409:       insufficient.
2410:     """
2411: 
2412:     def __init__(self, threshold: int = 5,
2413:                  min_guard_families: int = 2,
2414:                  telemetry_only: bool = True):
2415:         self.threshold = threshold
2416:         self.min_guard_families = min_guard_families
2417:         self.telemetry_only = telemetry_only
2418:         self.reset()
2419: 
2420:     def reset(self, reason: str | None = None) -> None:
2421:         self._sig: str | None = None
2422:         self._count = 0
2423:         self._start_frame: int | None = None
2424:         self._last_frame: int | None = None
2425:         self._families: set[str] = set()
2426:         self._candidate: dict = {}
2427:         self._coherence_checks: dict = {}
2428:         self._current: dict = {}
2429:         self._proposed_reset: set[str] = set()
2430:         self._last_reset_reason = reason
2431: 
2432:     def observe(self, frame: int, family: str, candidate: dict | None,
2433:                 *, current: dict | None = None,
2434:                 proposed_reset: list[str] | None = None,
2435:                 suppressed: bool = False) -> dict | None:
2436:         if suppressed:
2437:             self.reset("suppressed_window")
2438:             return None
2439:         if not candidate or candidate.get("single_batter_field_only"):
2440:             return None
2441:         coherent, coherence = self._check_coherence(candidate)
2442:         if not coherent:
2443:             self.reset("incoherent_candidate")
2444:             return None
2445: 
2446:         sig = self._signature(candidate)
2447:         if sig != self._sig:
2448:             self._sig = sig
2449:             self._count = 1
2450:             self._start_frame = frame
2451:             self._last_frame = frame
2452:             self._families = {family}
2453:             self._candidate = dict(candidate)
2454:             self._coherence_checks = coherence
2455:             self._current = dict(current or {})
2456:             self._proposed_reset = set(proposed_reset or [])
2457:             return None
2458: 
2459:         if frame != self._last_frame:
2460:             self._count += 1
2461:             self._last_frame = frame
2462:         self._families.add(family)
2463:         self._current = dict(current or self._current or {})
2464:         self._proposed_reset.update(proposed_reset or [])
2465: 
2466:         if (self._count >= self.threshold
2467:                 and len(self._families) >= self.min_guard_families):
2468:             event = {
2469:                 "sig": self._sig[:12],
2470:                 "guards": sorted(self._families),
2471:                 "frames": self._count,
2472:                 "candidate": dict(self._candidate),
2473:                 "current": dict(self._current),
2474:                 "proposed_reset": sorted(self._proposed_reset),
2475:                 "coherence": dict(self._coherence_checks),
2476:                 "threshold_frames": self._threshold_frames(),
2477:                 "reason": "stale_reference_state",
2478:                 "telemetry_only": self.telemetry_only,
2479:             }
2480:             self.reset("candidate_emitted")
2481:             return event
2482:         return None
2483: 
2484:     def _signature(self, candidate: dict) -> str:
2485:         return hashlib.sha1(_sr_json(candidate).encode("utf-8")).hexdigest()
2486: 
2487:     def _threshold_frames(self) -> dict:
2488:         start = self._start_frame
2489:         if start is None:
2490:             return {"n3": None, "n5": None, "n8": None}
2491:         return {
2492:             "n3": start + 2 if self._count >= 3 else None,
2493:             "n5": start + 4 if self._count >= 5 else None,
2494:             "n8": start + 7 if self._count >= 8 else None,
2495:         }
2496: 
2497:     def _check_coherence(self, candidate: dict) -> tuple[bool, dict]:
2498:         score = candidate.get("score")
2499:         wickets = candidate.get("wickets")
2500:         overs = candidate.get("overs")
2501:         checks = {
2502:             "score_non_negative": True,
2503:             "wickets_t20": True,
2504:             "overs_t20": True,
2505:             "active_batters_max_two": True,
2506:             "batters_known_not_out": True,
2507:             "bat_sum_within_score": True,
2508:         }
2509:         if score is not None and int(score) < 0:
2510:             checks["score_non_negative"] = False
2511:         if wickets is not None and not (0 <= int(wickets) <= 10):
2512:             checks["wickets_t20"] = False
2513:         if overs is not None and not (0 <= float(overs) <= 20):
2514:             checks["overs_t20"] = False
2515: 
2516:         batters = candidate.get("batters") or []
2517:         if len(candidate.get("active_batters") or []) > 2:
2518:             checks["active_batters_max_two"] = False
2519:         for batter in batters:
2520:             if not batter.get("name"):
2521:                 checks["batters_known_not_out"] = False
2522:             if (batter.get("status") == "out"
2523:                     and not batter.get("status_update")):
2524:                 checks["batters_known_not_out"] = False
2525: 
2526:         bat_sum = candidate.get("bat_sum")
2527:         if score is not None and bat_sum is not None:
2528:             if int(bat_sum) > int(score) + 12:
2529:                 checks["bat_sum_within_score"] = False
2530:         return all(checks.values()), checks
2531: 
