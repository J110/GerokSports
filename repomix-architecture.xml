2714:             # Issue B fix (2026-04-21): prefer scout-text figures over
2715:             # hard-coded zeros when the bowler is entering with an
2716:             # already-accumulated spell (impact sub, mid-match join).
2717:             # Example: Madushanka enters over 12 and Scout reads
2718:             # "Madushanka 1-24 (3)" — seeding at 0-0(0.0) would lose
2719:             # his 24 runs, and subsequent monotonic-increase consensus
2720:             # would block recovery.  Seed with the scout values when
2721:             # they pass sanity (non-negative, ≤ 250 runs, ≤ 10
2722:             # wickets, overs in [0.0, 4.0]).
2723:             seed_r, seed_w, seed_o = 0, 0, "0.0"
2724:             from_scout = False
2725:             try:
2726:                 _r = int(new_r) if new_r is not None else None
2727:                 _w = int(new_w) if new_w is not None else None
2728:             except (TypeError, ValueError):
2729:                 _r, _w = None, None
2730:             try:
2731:                 _o = float(overs) if overs is not None else None
2732:             except (TypeError, ValueError):
2733:                 _o = None
