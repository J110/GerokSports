2150: def _project_active_batters(state: dict,
2151:                             score_mgr,
2152:                             scoreboard,
2153:                             canon_fn) -> list:
2154:     """Project striker / non_striker into the WS payload `state`.
2155: 
2156:     SM is the sole authority for striker / non_striker when in live mode
2157:     (S1/S18 cutover, 2026-04-21).  This helper applies the canonical
2158:     SM cutover write, then — if SM has cleared a slot to None during a
2159:     mid-wicket-transition catch-up gap — falls back to `sb._inn`
2160:     *provided* the value is currently in `active_batting` (i.e. not a
2161:     stale dismissed-batter leftover from before the wicket cleared).
2162: 
2163:     Active-batting check is the safeguard against leaking dismissed
2164:     names: when scout has detected a wicket and flipped a player's
2165:     `batting_card[name].status` to "out", the player is excluded from
2166:     `_active` and thus never surfaced via fallback even if `sb._inn`
2167:     still holds them for a frame or two before its own update lands.
2168: 
2169:     Strengthened by Fix 5 (striker self-collision guard, same 2026-04-25
2170:     inter-match bundle, `scoreboard.py:update_batter`): `sb._inn` is
2171:     invariant-protected against `striker == non_striker`, so this
2172:     fallback can't surface a collided pair to the WS payload.  The
2173:     `_other_slot` check below provides defence-in-depth for the
2174:     payload-level analogue (one slot already SM-resolved, the other
2175:     SM-null and falling back to a value matching the SM-resolved one).
2176: 
2177:     Args:
2178:         state: payload state dict, mutated in place
2179:         score_mgr: live ScoreManager instance (caller must gate on
2180:             `not score_mgr.shadow`)
2181:         scoreboard: live Scoreboard instance providing `_inn` and
2182:             `batting_card`
2183:         canon_fn: name canonicalizer (typically `_canon_player_name`),
2184:             called for both SM and sb._inn values for consistency
2185: 
2186:     Returns:
2187:         list of `(slot, sb_val)` tuples for each fallback that fired,
2188:         for telemetry / logging.  Empty list when no fallback was
2189:         needed (the common case once SM has caught up).
2190:     """
2191:     state["striker"] = canon_fn(score_mgr.striker)
2192:     state["non_striker"] = canon_fn(score_mgr.non_striker)
2193: 
2194:     _bc = scoreboard.batting_card or {}
2195:     _sb = scoreboard._inn or {}
2196:     _events = []
2197:     for _slot in ("striker", "non_striker"):
2198:         if state.get(_slot) is not None:
2199:             continue
2200:         _sb_val = _sb.get(_slot)
2201:         if not _sb_val:
2202:             continue
2203:         _card_key = (scoreboard.resolve_name(_sb_val)
2204:                      if hasattr(scoreboard, "resolve_name") else _sb_val)
2205:         _card = _bc.get(_card_key)
2206:         if not _card or _card.get("status") != "batting":
2207:             continue
2208:         _other_slot = "non_striker" if _slot == "striker" else "striker"
2209:         if _card_key == state.get(_other_slot):
2210:             continue
2211:         state[_slot] = canon_fn(_card_key)
2212:         _events.append((_slot, _card_key))
2213:     return _events
2214: 
