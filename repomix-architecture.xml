 866:     def on_camera_view(self, view: str | None) -> None:
 867:         """Record Scout's latest camera_view; drives the next sleep."""
 868:         self.last_camera_view = view
 869:         # Extend the active-tail window every time we see a live
 870:         # cricket frame.  This keeps cadence tight through the
 871:         # 1-3 frame dead-time blip that follows almost every ball.
 872:         if view in self._ACTIVE_PLAY_VIEWS:
 873:             self._active_tail_until = (
