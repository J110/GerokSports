1943: def filter_info_panel_contamination(extracted: dict, vision_desc: str,
1944:                                     scoreboard) -> dict:
1945:     """When vision mentions a stats info panel, strip the bowler field
1946:     from extracted (score/wickets stay — ConsistentReadTracker bounds
1947:     those).
1948: 
1949:     Pre-Fix-8 (2026-04-26 inter-match bundle): this function detected
1950:     info-panel content via `_INFO_PANEL_KEYWORDS` but only logged it,
1951:     leaving the tracker to bound score/wicket reads.  That worked for
1952:     score/wickets (the tracker rejects impossible jumps) but bowler
1953:     updates flow through a different SM path that the tracker does NOT
1954:     gate.
1955: 
1956:     F619 DC vs PBKS (2026-04-25 16:02:04, P1 in `docs/backlog.md`):
1957:     a "YUZVENDRA CHAHAL IPL CAREER MATCHES 181 WICKETS 225 ECONOMY
1958:     8.0" stats overlay with the broadcast strip still partially
1959:     visible was extracted as `bowler="YUZVENDRA CHAHAL"` and committed
1960:     to SM, even though Marco Jansen was bowling the over and Chahal
1961:     hadn't been introduced yet.  The dead-time skip on
1962:     `camera_view == "graphic"` should have caught this, but
1963:     `vision.last_camera_view` lags scout response arrival by 1-2
1964:     frames, so F619 ran with the previous frame's `bowlers_end` tag.
1965: 
1966:     Fix: content-based gate that doesn't depend on camera_view tag
1967:     timing.  When the vision description contains an `_INFO_PANEL_
1968:     KEYWORDS` marker (career / season / head-to-head / projected-
1969:     score stats markers), strip `bowler`, `bowler_name`, and
1970:     `bowler_figures` from `extracted`.  Why bowler-only:
1971:     (a) bowler ingest bypasses the tracker (score does not — the
1972:         tracker's consistency layer is sufficient)
1973:     (b) bowler is sourced fresh from the broadcast strip on every
1974:         active-play frame; dropping it from one stats-overlay frame
1975:         loses no data, just delays bowler-change pickup by ~1-2 s
1976:     (c) name-dropping a FUTURE bowler in a stats overlay is a
1977:         documented bug pattern (F619, F643 in the
1978:         `pipeline-2026-04-25-153247-dc-pbks-v5.log` trace) — the
1979:         original BOWLER-STALE defense (shipped 2026-04-25) only
1980:         guards against stale-bowler reads, not future-bowler ones
1981: 
1982:     Telemetry: emits `[INFO-PANEL-GATE]` log line when a strip fires,
1983:     so post-deploy monitoring can count how often graphics with
1984:     bowler-name overlays are caught.  Negative-firing in the steady
1985:     state (most frames have no info-panel keywords) — a sustained
1986:     high rate would suggest the keyword list needs broadening.
1987:     """
1988:     if not vision_desc or not scoreboard or not scoreboard._inn:
1989:         return extracted
1990:     upper = vision_desc.upper()
1991:     _matched_keyword = next(
1992:         (kw for kw in _INFO_PANEL_KEYWORDS if kw in upper), None)
1993:     if not _matched_keyword:
1994:         return extracted
1995:     if extracted.get("bowler") or extracted.get("bowler_name"):
1996:         _bw = extracted.get("bowler") or {}
1997:         _bw_name = (_bw.get("name") if isinstance(_bw, dict)
1998:                     else _bw) or extracted.get("bowler_name")
1999:         log.warn(
2000:             f"  [INFO-PANEL-GATE] bowler stripped — "
2001:             f"name={_bw_name!r} panel_keyword={_matched_keyword!r}")
2002:         extracted.pop("bowler", None)
2003:         extracted.pop("bowler_name", None)
2004:         extracted.pop("bowler_figures", None)
2005:     else:
2006:         log.info(
2007:             f"  [INFO PANEL] Detected (keyword={_matched_keyword!r}) "
2008:             f"— no bowler in extracted, tracker will bound values")
2009:     return extracted
