3902:     def on_new_over(self, completed_over: int):
3903:         """Archive the completed over and reset this_over.
3904: 
3905:         Sets _bowler_must_change flag — same bowler can't bowl
3906:         consecutive overs in limited-overs cricket.
3907:         """
3908:         bowler = self._inn.get("current_bowler")
3909:         archived: dict = {
3910:             "broadcast_balls": self.this_over.copy() if self.this_over else [],
3911:             "bowler": bowler,
3912:         }
3913: 
3914:         if bowler and bowler in self.bowling_card:
3915:             bc = self.bowling_card[bowler]
3916:             archived["bowler_figures"] = {
3917:                 "overs": bc.get("overs"),
3918:                 "runs": bc.get("runs"),
3919:                 "wickets": bc.get("wickets"),
3920:             }
3921: 
3922:         # Immutable: first archive of a given over slot wins. A second
3923:         # call for the same `completed_over` is treated as a duplicate
3924:         # archive attempt (e.g. the over rollover misfired and then
3925:         # re-fired on the next sane reading) — keep the original.
3926:         if completed_over in self.over_history:
3927:             log.info(
3928:                 f"[ARCHIVE] Over {completed_over} already archived "
3929:                 f"({self.over_history[completed_over]}). Refusing "
3930:                 f"second archive payload {archived}.")
3931:         else:
3932:             self.over_history[completed_over] = archived
3933: 
3934:         self._bowler_must_change = True
3935:         self._bowler_locked = False
3936:         self._prev_over_bowler = bowler
3937: 
3938:         if self.this_over:
3939:             over_runs = sum(int(x) for x in self.this_over
3940:                            if isinstance(x, str) and x.isdigit())
3941:             wkts = sum(1 for x in self.this_over if x == "W")
3942:             log.info(f"Over {completed_over} complete: "
3943:                      f"{self.this_over} = {over_runs} runs, "
3944:                      f"{wkts} wickets (by {bowler or '?'})")
3945:         else:
3946:             log.info(f"Over {completed_over} complete: "
3947:                      f"no ball data (by {bowler or '?'})")
3948:         # Reset per-over extras counter at over boundary; innings total
3949:         # and extras log are preserved for parity diagnostics.
3950:         if self.extras.get("this_over"):
3951:             log.info(f"[EXTRA] over {completed_over} closed with "
3952:                      f"{self.extras['this_over']} extra(s) — "
3953:                      f"resetting per-over counter")
3954:         self.extras["this_over"] = 0
3955:         self.this_over = []
