1438: def clean_bowler_entry(bowler: dict) -> dict:
1439:     """Strip standard bowling figures from name: 'MUKESH 2-8 (1.5)' → name='MUKESH'.
1440:     Handles O-M-R-W (4-field) format and W-R(O) / W/R(O) formats."""
1441:     name = bowler.get("name", "")
1442:     if not name:
1443:         return bowler
1444: 
1445:     full_fig = re.search(r'(\d+\.?\d*)-(\d+)-(\d+)-(\d+)', name)
1446:     if full_fig:
1447:         parsed = parse_bowling_figures(full_fig.group(0))
1448:         if parsed:
1449:             for k, v in parsed.items():
1450:                 if bowler.get(k) is None or bowler.get(k) in (0, "0"):
1451:                     bowler[k] = v
1452:         cleaned = name[:full_fig.start()].strip()
1453:         if cleaned:
1454:             bowler["name"] = cleaned
1455:         return bowler
1456: 
1457:     fig_match = re.search(r'(\d+)\s*[-/]\s*(\d+)\s*\((\d+\.?\d*)\)', name)
1458:     if fig_match:
1459:         parsed = parse_bowling_figures(fig_match.group(0))
1460:         if parsed:
1461:             for k, v in parsed.items():
1462:                 if bowler.get(k) is None or bowler.get(k) in (0, "0"):
1463:                     bowler[k] = v
1464:         cleaned = re.sub(r'\s*\d+\s*[-/]\s*\d+\s*\(\d+\.?\d*\)\s*$', '', name).strip()
1465:     else:
1466:         cleaned = re.sub(r'[\s\d()./,-]+$', '', name).strip()
1467:     if cleaned:
1468:         bowler["name"] = cleaned
1469:     return bowler
