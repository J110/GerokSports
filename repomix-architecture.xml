3957:     def record_speed(self, bowler_name: str, speed_kph: float) -> bool:
3958:         """Track bowling speed for a bowler with role-based validation."""
3959:         if not bowler_name or not speed_kph:
3960:             return False
3961:         if speed_kph < 60 or speed_kph > 170:
3962:             return False
3963: 
3964:         role = self._get_bowler_role(bowler_name)
3965: 
3966:         # Squad role overrides everything
3967:         if role == "spin" and speed_kph > 105:
3968:             log.info(f"[SPEED] {speed_kph}kph rejected — "
3969:                      f"{bowler_name} is a spinner (squad)")
3970:             return False
3971:         if role == "pace" and speed_kph < 100:
3972:             log.info(f"[SPEED] {speed_kph}kph rejected — "
3973:                      f"{bowler_name} is a pacer (squad)")
3974:             return False
3975: 
3976:         # First-reading classifier only when squad has no role
3977:         if bowler_name not in self.bowler_speeds:
3978:             self.bowler_speeds[bowler_name] = []
3979:             if role == "":
3980:                 if speed_kph < 100:
3981:                     self.bowler_type[bowler_name] = "spin"
3982:                 else:
3983:                     self.bowler_type[bowler_name] = "pace"
3984:             else:
3985:                 self.bowler_type[bowler_name] = role
3986:         else:
3987:             btype = self.bowler_type.get(bowler_name)
3988:             if btype == "spin" and speed_kph > 105:
3989:                 log.info(f"[SPEED] {speed_kph}kph rejected — {bowler_name} "
3990:                          f"classified as spinner")
3991:                 return False
3992:             if btype == "pace" and speed_kph < 85:
3993:                 log.info(f"[SPEED] {speed_kph}kph rejected — {bowler_name} "
3994:                          f"classified as pacer")
3995:                 return False
