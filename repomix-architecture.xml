2121:     # Boundary accumulator — derive fours/sixes from ball events (P1-5)
2122:     # ------------------------------------------------------------------
2123:     def accumulate_boundary(self, striker_name: str | None,
2124:                             kind: str) -> bool:
2125:         """Increment striker's fours/sixes counter from a ball event.
2126: 
2127:         Called from the main pipeline when a ball event with
2128:         ``type == "FOUR"`` or ``"SIX"`` fires. The ball-event type
2129:         already encodes "the ball reached the boundary" (as distinct
2130:         from "4/6 runs were scored"), which gives us the right edge-
2131:         case behaviour for free:
2132: 
2133:           * Normal FOUR (type=FOUR, runs=4)       → increments
2134:           * Wide-four (type=EXTRA, runs=5)        → NOT called
2135:           * Overthrow-six (type=SIX, runs=6)      → increments
2136:           * All-run four (type=4_RUNS, runs=4)    → NOT called
2137:           * Bye four (type=EXTRA, runs=4)         → NOT called
2138: 
2139:         Rejects quietly (returns False + logs) when:
2140:           * striker_name is None / empty
2141:           * batting_card has no entry for striker (squad mismatch)
2142:           * card entry's status != "batting" (dismissed/not-yet-in)
2143:           * resulting 4*fours+6*sixes would exceed the striker's
2144:             currently-tracked runs (cricket invariant). Strip reads
2145:             usually converge within the next frame or two, so a
2146:             spurious reject here is self-healing.
2147:         """
2148:         if not striker_name or kind not in ("four", "six"):
2149:             self._bdy_skip("bad_input")
2150:             return False
2151:         card = self.batting_card.get(striker_name) if self.batting_card else None
2152:         if not card:
2153:             log.info(
2154:                 f"  [BDY-ACC] Skip {kind} for striker='{striker_name}'"
2155:                 f" — not in batting_card")
2156:             self._bdy_skip("not_in_card")
2157:             return False
2158:         if card.get("status") != "batting":
2159:             log.info(
2160:                 f"  [BDY-ACC] Skip {kind} for striker='{striker_name}'"
2161:                 f" — card.status={card.get('status')!r}")
2162:             self._bdy_skip(f"status_{card.get('status')}")
2163:             return False
2164: 
2165:         cur_f = int(card.get("fours") or 0)
2166:         cur_s = int(card.get("sixes") or 0)
2167:         new_f = cur_f + (1 if kind == "four" else 0)
2168:         new_s = cur_s + (1 if kind == "six" else 0)
2169: 
2170:         cur_r = card.get("runs")
2171:         if cur_r is not None and (4 * new_f + 6 * new_s) > int(cur_r):
2172:             # Invariant violation — runs hasn't caught up yet (or the
2173:             # striker is wrong). Skip; the next frame will re-fire
2174:             # only if a genuine FOUR/SIX event lands again, which
2175:             # only happens on the next boundary.
2176:             #
2177:             # Expected to fire occasionally (race between ball-event
2178:             # and strip run-total consensus). Monitor the
2179:             # invariant-skip rate post-deploy via _bdy_skip_counts;
2180:             # if it's <5% of boundary events, Option A (accept the
2181:             # occasional miss) is fine. If it's >5%, revisit with
2182:             # Option B (queue-and-retry).
2183:             log.info(
2184:                 f"  [BDY-ACC] Skip {kind} for '{striker_name}' — "
2185:                 f"would violate 4f+6s<=runs "
2186:                 f"(new {new_f}/{new_s} vs runs={cur_r})")
2187:             self._bdy_skip("invariant")
2188:             return False
2189: 
2190:         card["fours"] = new_f
2191:         card["sixes"] = new_s
2192:         log.info(
2193:             f"  [BDY-ACC] {striker_name} {kind.upper()} → "
2194:             f"fours={new_f} sixes={new_s} "
2195:             f"(runs={cur_r})")
2196:         return True
2197: 
2198:     def _bdy_skip(self, reason: str) -> None:
2199:         """Reason-tagged counter for boundary-accumulator skips.
2200: 
2201:         Buckets: `not_in_card`, `status_<x>`, `invariant`, `bad_input`.
2202:         Lets post-deploy monitoring distinguish the invariant race
2203:         (expected, self-healing) from the other classes (genuine
2204:         striker/card issues that the upstream WS-SCRUB should be
2205:         catching too).
2206:         """
2207:         counts = getattr(self, "_bdy_skip_counts", None)
2208:         if counts is None:
2209:             counts = {}
2210:             self._bdy_skip_counts = counts
2211:         counts[reason] = counts.get(reason, 0) + 1
