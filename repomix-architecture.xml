3765:     def check_toss_in_vision(vision_desc: str):
3766:         """Detect toss result from vision text. Highest priority for
3767:         team assignment — once captured, teams are locked forever."""
3768:         nonlocal toss_captured, toss_winner_name, toss_decision_str
3769:         nonlocal team_locked, team_lock_frame, team_confirm_count
3770:         if toss_captured or not vision_desc:
3771:             return
3772:         upper = vision_desc.upper()
3773: 
3774:         m = re.search(
3775:             r'(\w[\w\s]*?)\s+WON\s+(?:THE\s+)?TOSS\s+'
3776:             r'(?:AND\s+)?(?:CHOSE|ELECTED|OPTED)\s+TO\s+'
3777:             r'(BAT|BOWL|FIELD|BATTING|BOWLING|FIELDING)',
3778:             upper)
3779:         if not m:
3780:             m = re.search(
3781:                 r'(\w[\w\s]*?)\s+WON\s+(?:THE\s+)?TOSS\s*'
3782:                 r'(?:&|AND)?\s*(BAT|BOWL|FIELD)\s*(?:FIRST)?',
3783:                 upper)
3784:         if not m:
3785:             m = re.search(
3786:                 r'TOSS\s*:\s*(\w[\w\s]*?)\s*,\s*'
3787:                 r'(?:ELECTED|CHOSE|OPTED)\s+TO\s+(BAT|BOWL|FIELD)',
3788:                 upper)
3789:         if not m:
3790:             m = re.search(
3791:                 r'(\w[\w\s]*?)\s+(?:CHOSE|ELECTED)\s+TO\s+'
3792:                 r'(BAT|BOWL|FIELD)',
3793:                 upper)
3794:         if not m:
3795:             return
3796: 
3797:         winner_raw = m.group(1).strip()
3798:         decision = m.group(2).strip()
3799:         winner = _resolve_team_variant(winner_raw)
3800:         if not winner:
3801:             log.info(f"[TOSS] Can't resolve '{winner_raw}' to a team")
3802:             return
3803:         other = [t for t in team_names if t != winner][0]
3804:         if decision in ("BOWL", "FIELD", "BOWLING", "FIELDING"):
3805:             bat, bowl = other, winner
3806:         else:
3807:             bat, bowl = winner, other
3808:         toss_captured = True
3809:         toss_winner_name = winner
3810:         toss_decision_str = decision.lower()
3811:         log.info(f"[TOSS] {winner} won, chose to {toss_decision_str}. "
3812:                  f"{bat} bats, {bowl} bowls — LOCKED")
3813:         assign_teams(bat, bowl, innings=1)
3814:         team_locked = True
3815:         team_lock_frame = frame_count if frame_count else 0
3816:         team_confirm_count = 99
