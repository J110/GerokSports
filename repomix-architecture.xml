 236:     def _validate_commentary_names(
 237:             self, text: str, ws_payload: dict) -> list[str]:
 238:         """Return list of foreign player names found in `text`.
 239:         Empty list = clean. Caller decides whether to drop, regen,
 240:         or just log."""
 241:         if not text:
 242:             return []
 243:         allowed = self._allowed_name_set(ws_payload)
 244:         known = self._known_player_set(ws_payload)
 245:         if not known:
 246:             return []
 247:         # Capitalised tokens (heuristic for proper nouns)
 248:         toks = set(re.findall(r"\b[A-Z][a-zA-Z']{2,}\b", text))
 249:         foreign: list[str] = []
 250:         for tok in toks:
 251:             tl = tok.lower()
 252:             if tl in known and tl not in allowed:
 253:                 foreign.append(tok)
 254:         return foreign
