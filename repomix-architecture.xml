2535:     tag = ("STATE-RECOVERY-OVERRIDE" if actual
2536:            else "STATE-RECOVERY-OVERRIDE-CANDIDATE")
2537:     return (
2538:         f"  [{tag}] sig={event.get('sig')} "
2539:         f"guards={','.join(event.get('guards') or [])} "
2540:         f"frames={event.get('frames')} "
2541:         f"candidate_json={_sr_json(event.get('candidate') or {})} "
2542:         f"current_json={_sr_json(event.get('current') or {})} "
2543:         f"coherence_json={_sr_json(event.get('coherence') or {})} "
2544:         f"thresholds_json={_sr_json(event.get('threshold_frames') or {})} "
2545:         f"proposed_reset={','.join(event.get('proposed_reset') or []) or '-'} "
2546:         f"reason={event.get('reason', 'unknown')} "
2547:         f"telemetry_only={str(event.get('telemetry_only', True)).lower()}"
