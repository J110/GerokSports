 876:     def on_frame_phase(self, phase: str | None) -> None:
 877:         """Record Scout's latest frame_phase; drives per-phase cadence.
 878: 
 879:         Action phases (release/flight/shot/post_shot) also extend the
 880:         active-tail window so a late-cycle cut-away (closeup, replay)
 881:         doesn't immediately drop us back to dead-time cadence and miss
 882:         the strip tick to the new score.
 883:         """
 884:         self.last_frame_phase = phase
 885:         if phase in ("release", "flight", "shot", "post_shot"):
 886:             self._active_tail_until = (
 887:                 time.time() + self.ACTIVE_TAIL_HOLD)
