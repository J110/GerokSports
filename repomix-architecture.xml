4052:     def get_this_over_for_display(self) -> list[str]:
4053:         """Return this-over trimmed to match the overs sub-ball count.
4054: 
4055:         If overs shows X.3, there should be at most 3 legal balls in
4056:         this-over (plus any extras like wd/nb). Excess legal balls from
4057:         a previous over or false detections are trimmed from the front,
4058:         keeping the most recent balls.
4059:         """
4060:         overs_raw = self._inn.get("overs") or "0"
4061:         try:
4062:             overs = float(overs_raw)
4063:         except (ValueError, TypeError):
4064:             return list(self.this_over)
4065: 
4066:         balls_this_over = round((overs % 1) * 10)
4067:         if balls_this_over == 0:
4068:             return list(self.this_over)
4069: 
4070:         display = list(self.this_over)
4071: 
4072:         legal = [x for x in display if str(x).lower() not in ("wd", "nb")]
4073:         extras = [x for x in display if str(x).lower() in ("wd", "nb")]
4074: 
4075:         if len(legal) > balls_this_over:
4076:             legal = legal[-balls_this_over:]
4077:             display = extras + legal
4078:             log.info(f"[THIS-OVER] Trimmed to {balls_this_over} "
4079:                      f"legal balls: {display}")
4080: 
4081:         return display
