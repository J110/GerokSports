 473:     def set_innings_2(self, target: int | None = None):
 474:         """Switch to innings 2 with full state reset.
 475: 
 476:         Resets all CV trackers, batter/bowler trackers, extras,
 477:         this-over, etc. Does NOT touch teams or cards — the caller
 478:         must call setup_innings() / assign_teams() to set the
 479:         correct batting/bowling sides and rebuild cards.
 480: 
 481:         Bug #14: idempotent. Previously this method early-returned if
 482:         `current_innings` was already 2, which meant any caller who
 483:         had set `current_innings = 2` directly (e.g. via assign_teams
 484:         or a broadcast target detection) bypassed every reset below.
 485:         Result: innings 1's fall_of_wickets, extras, this_over etc.
 486:         leaked into innings 2.
 487:         New behaviour: a one-shot guard `_innings2_reset_done` ensures
 488:         the resets run exactly once per actual innings transition,
 489:         regardless of which call path got there first. Subsequent
 490:         invocations are no-ops (except for refreshing `target`).
 491:         """
 492:         # Match-complete guard (Fix B, 2026-04-22): once innings 2 has
 493:         # terminated on physics conditions (target/all_out/overs),
 494:         # refuse any further innings transitions. This prevents a
 495:         # spurious target-re-detection frame from re-entering the
 496:         # innings-2 reset path and clearing terminal result data.
 497:         if self.match_complete:
 498:             log.info(
 499:                 f"[MATCH-COMPLETE] set_innings_2 refused — match "
 500:                 f"already resolved ({self.match_end_reason}).")
 501:             return
 502: 
 503:         if target:
 504:             self._inn["target"] = target
 505: 
 506:         if getattr(self, "_innings2_reset_done", False):
 507:             return
 508: 
 509:         self._innings2_reset_done = True
 510: 
 511:         self.innings[2] = self._blank()
 512:         self.current_innings = 2
 513:         if target:
 514:             self._inn["target"] = target
 515: 
 516:         self._tracker = ConsistentReadTracker()
 517:         self._dismissed_recovery = {}
 518:         self._dismiss_attempt_count = {}
 519:         self._extractor_batter_names = set()
 520:         # Gate for _auto_dismiss_for_new_batter (Issue D, 2026-04-21):
 521:         # wickets-counter value at which we last fired an auto-dismiss.
 522:         # Auto-dismiss is blocked until the counter advances beyond
 523:         # this, which guarantees at least one real wicket event has
 524:         # occurred since the last phantom-batter proposal.
 525:         self._last_autodismiss_wickets = 0
 526:         # Fix #1 (2026-04-23): new innings starts at wickets=0 with
 527:         # no prior confirmations — reset the zero-streak counter so
 528:         # the seed rearms correctly for the innings-2 cold start.
 529:         self._wickets_confirmed_frames_at_zero = 0
 530:         # Fix #3 (2026-04-23): fresh innings ⇒ rotation state is
 531:         # irrelevant; clear any pending rejection counters.
 532:         self._rotation_rejection_count = {}
 533:         # Per-batter streak of "missing from extractor" frames; used
 534:         # to require at least 2 consecutive misses before believing a
 535:         # dismissal signal.
 536:         self._missing_batter_streak: dict[str, int] = {}
 537:         # Layer 4 (Fix 12): clear runs-rejection-streak state so an
 538:         # innings-1 stuck-window doesn't leak into innings-2 (different
 539:         # batter pool, different name keys, but defensive hygiene).
 540:         self._runs_reject_streak = {}
 541:         # Fix 18 (2026-04-26): innings hygiene for Layer 3 cap-
 542:         # reset tracking.  Different batters in innings 2 must
 543:         # not inherit innings-1 advance frames.
 544:         self._last_runs_advance = {}
 545:         self.extras = self._blank_extras()
 546:         self.this_over = []
 547:         self.over_history = {}
 548:         self.bowler_speeds = {}
 549:         self._last_over_num = None
 550:         self._bowler_must_change = False
 551:         self._prev_over_bowler = None
 552:         self._bowler_locked = False
 553:         self._bowler_lock_frame = 0
 554:         self.fall_of_wickets = []
 555:         self.partnerships = []
 556:         self.current_partnership = None
 557:         self._dismissed_inferred = False
 558: 
 559:         log.info(f"[INNINGS] Set to 2. Target: {target}. "
 560:                  f"All trackers reset.")
 561: 
