3871:     # === FIX 1: cross-team consistency check (cold start) ===
3872:     # Reject internally inconsistent scorecards before they can poison
3873:     # team assignment. A real T20 frame can never show "Player X batting
3874:     # for KKR while Player Y bowls for KKR" — the bowler is on the
3875:     # opposing team. The hallucinated F17 pre-match graphic in the
3876:     # KKR-vs-RR bug had Jadeja (an RR player) listed as a KKR bowler,
3877:     # which is squad-level impossible. Use the squad rosters (already
3878:     # scraped) as the authority; toss is *not* used.
3879:     #
3880:     # Returns True when the card is consistent OR has too little info to
3881:     # judge (incomplete data falls through to the existing consensus
3882:     # path). Returns False only when squad data definitively proves the
3883:     # card is fictional.
3884:     _UPPER_TO_TEAM: dict[str, str] = {}
3885:     for _tname, _plist in squads.items():
3886:         for _p in _plist:
3887:             up = _p.upper().strip()
3888:             _UPPER_TO_TEAM[up] = _tname
3889:             for _part in up.split():
3890:                 if len(_part) >= 4:
3891:                     # First-match wins; ambiguous surnames (e.g. shared
3892:                     # last names across teams) silently fall back to
3893:                     # "unknown" via the conflict check below.
3894:                     if _part in _UPPER_TO_TEAM and \
3895:                             _UPPER_TO_TEAM[_part] != _tname:
3896:                         _UPPER_TO_TEAM[_part] = "__AMBIGUOUS__"
3897:                     else:
3898:                         _UPPER_TO_TEAM.setdefault(_part, _tname)
