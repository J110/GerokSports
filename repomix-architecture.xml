4296:     def _consume_dismissal_hint(frame_num: int) -> str | None:
4297:         """Pop the most recent in-window hint, if any."""
4298:         nonlocal _recent_dismissal_hints
4299:         _cutoff = frame_num - _DISMISSAL_HINT_WINDOW
4300:         _in_window = [h for h in _recent_dismissal_hints if h["frame"] >= _cutoff]
4301:         if not _in_window:
4302:             return None
4303:         # Most recent wins
4304:         _hit = sorted(_in_window, key=lambda h: h["frame"])[-1]
4305:         # Clear the window — this hint belongs to THIS wicket only.
4306:         _recent_dismissal_hints = []
4307:         return _hit["mode"]
