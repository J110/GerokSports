 801:     def __init__(self):
 802:         self.over_complete = False
 803:         self.ad_detected = False
 804:         self._burst_until: float = 0.0
 805:         # Last Scout camera_view tag — drives active-play cadence.
 806:         self.last_camera_view: str | None = None
 807:         # Last Scout frame_phase tag — drives per-phase cadence
 808:         # (Phase 3, 2026-04-19) when present.
 809:         self.last_frame_phase: str | None = None
 810:         # Post-active-play "tail" window: the broadcast routinely
 811:         # cuts away the moment the bowler releases (closeup of
 812:         # the bowler, replay of the shot, crowd reaction) so the
 813:         # next 1-3 frames after a `bowlers_end` are tagged dead-
 814:         # time. Without this tail we relax the cadence to 2.5s
 815:         # immediately, missing the short window when the strip
 816:         # ticks to the new overs.  Holding 0.5s polling for ~5s
 817:         # past every active-play frame catches the dot-ball strip
 818:         # update without ballooning Groq spend (the tail expires
 819:         # when the broadcast settles into a true ad / replay).
 820:         self._active_tail_until: float = 0.0
 821:         self.ACTIVE_TAIL_HOLD = 5.0  # seconds
