1808: def normalize_extracted_batters(extracted: dict, scoreboard=None) -> dict:
1809:     """Canonicalize batter rows and drop surname-only ghost fragments."""
1810:     batters = extracted.get("batters")
1811:     if not batters or not isinstance(batters, list) or scoreboard is None:
1812:         return extracted
1813:     batting_card = getattr(scoreboard, "batting_card", None) or {}
1814:     if not batting_card:
1815:         return extracted
1816: 
1817:     resolved_rows = []
1818:     for row in batters:
1819:         if not isinstance(row, dict):
1820:             continue
1821:         raw = (row.get("name") or "").strip()
1822:         if not raw:
1823:             continue
1824:         resolved = scoreboard.resolve_name(raw)
1825:         card_key = (scoreboard._find_card_key(resolved, batting_card)
1826:                     if resolved else None)
1827:         resolved_rows.append((row, raw, card_key))
1828: 
1829:     canonical_by_raw = {
1830:         raw.upper(): card_key for _, raw, card_key in resolved_rows if card_key
1831:     }
1832:     cleaned: list[dict] = []
1833:     by_key: dict[str, dict] = {}
1834:     for row, raw, card_key in resolved_rows:
1835:         raw_upper = raw.upper()
1836:         parts = raw_upper.split()
1837:         no_stats = not _entry_has_score_stats(row)
1838:         if len(parts) == 1 and no_stats:
1839:             token = parts[0]
1840:             sibling_key = next(
1841:                 (key for other_raw, key in canonical_by_raw.items()
1842:                  if other_raw != raw_upper
1843:                  and token in key.upper().split()[1:]),
1844:                 None)
1845:             if sibling_key:
1846:                 log.warn(
1847:                     f"  [BATTER-NORMALIZE] dropping surname ghost "
1848:                     f"{raw!r} paired with {sibling_key!r}")
1849:                 continue
1850:         if card_key:
1851:             row["name"] = card_key
1852:             existing = by_key.get(card_key)
1853:             if existing is None:
1854:                 by_key[card_key] = row
1855:                 cleaned.append(row)
1856:             else:
1857:                 if (_entry_has_score_stats(row)
1858:                         and not _entry_has_score_stats(existing)):
1859:                     existing.update(row)
1860:                 if existing.get("striker") is None and row.get("striker") is not None:
1861:                     existing["striker"] = row.get("striker")
1862:                 log.warn(
1863:                     f"  [BATTER-NORMALIZE] merged duplicate row "
1864:                     f"{raw!r} into {card_key!r}")
1865:         else:
1866:             cleaned.append(row)
1867:     extracted["batters"] = cleaned
1868:     return extracted
