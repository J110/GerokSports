3245:     def dismiss_batter(self, name: str, how: str | None = None,
3246:                        bowler: str | None = None, fielder: str | None = None,
3247:                        frame: int = 0) -> bool:
3248:         resolved = self.resolve_name(name)
3249:         if resolved is None:
3250:             log.warn(f"Dismiss: '{name}' not in any squad")
3251:             return False
3252:         card_key = self._find_card_key(resolved, self.batting_card)
3253:         if card_key is None:
3254:             log.warn(f"Dismiss: '{name}' not in batting card"
3255:                      f" (resolved: {resolved})")
3256:             return False
3257:         name = card_key
3258: 
3259:         entry = self.batting_card[name]
3260:         if entry["status"] != "batting":
3261:             self._dismiss_attempt_count[name] = \
3262:                 self._dismiss_attempt_count.get(name, 0) + 1
3263:             ct = self._dismiss_attempt_count[name]
3264:             if ct <= 3:
3265:                 log.warn(f"Dismiss: {name} status is "
3266:                          f"'{entry['status']}', not batting")
3267:             # After 3 failed attempts, silently suppress to reduce log noise
3268:             return False
3269: 
3270:         entry["status"] = "out"
3271:         entry["dismissal"] = {"how": how, "bowler": bowler, "fielder": fielder}
3272: 
3273:         score = self._inn.get("score", 0) or 0
3274:         overs = self._inn.get("overs", "0")
3275:         wk = self._inn.get("wickets") or 0
3276: 
3277:         self._add_fow(wk, name, score, overs, how=how, bowler=bowler)
3278: 
3279:         log.info(f"DISMISSED: {name} {entry['runs']}({entry['balls']}) "
3280:                  f"— {how or '?'} | FOW {wk}/{score} ({overs})")
3281: 
3282:         if self._inn.get("striker") == name:
3283:             self._inn["striker"] = None
3284:         if self._inn.get("non_striker") == name:
3285:             self._inn["non_striker"] = None
3286: 
3287:         return True
