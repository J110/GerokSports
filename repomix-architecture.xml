1378: def clean_batter_entry(batter: dict) -> dict:
1379:     """Strip stats embedded in name: 'TILAK 9(4)' → name='TILAK', runs=9, balls=4."""
1380:     name = batter.get("name", "")
1381:     if not name:
1382:         return batter
1383:     batter["_raw_name"] = name
1384:     stat_match = re.search(r'(\d+)\s*\((\d+)\)', name)
1385:     if stat_match:
1386:         if batter.get("runs") is None or batter.get("runs") == 0:
1387:             batter["runs"] = int(stat_match.group(1))
1388:         if batter.get("balls") is None or batter.get("balls") == 0:
1389:             batter["balls"] = int(stat_match.group(2))
1390:     cleaned = re.sub(r'\s*\d+\s*\(?\d*\)?\s*$', '', name).strip()
1391:     if cleaned:
1392:         batter["name"] = cleaned
1393:     return batter
