 457:     def _blank_extras() -> dict:
 458:         return {
 459:             "wides": 0, "no_balls": 0, "byes": 0,
 460:             "leg_byes": 0, "penalties": 0, "total": 0,
 461:             # Per-over counter (zero on over rollover) — surfaces in
 462:             # the UI / parity monitor for live drift detection.
 463:             "this_over": 0,
 464:             # Bounded chronological log of recent extras for diagnostics
 465:             # (matches Cricbuzz's "Wd / Nb" detail row).
 466:             "log": [],
 467:         }
