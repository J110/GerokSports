1918: def apply_all_out_authority(scoreboard, text: str | None,
1919:                             frame: int = 0) -> bool:
1920:     """Promote W9 to all-out when final-wicket/innings-break evidence appears."""
1921:     if scoreboard is None:
1922:         return False
1923:     try:
1924:         cur_w = int((scoreboard._inn or {}).get("wickets") or 0)
1925:     except (TypeError, ValueError):
1926:         return False
1927:     if cur_w != 9:
1928:         return False
1929:     upper = (text or "").upper()
1930:     final_wicket_terms = (
1931:         "ALL OUT", "ALL-OUT", "INNINGS BREAK", "END OF INNINGS",
1932:         "INNINGS ENDS", "INNINGS ENDED", "BOWLED", "CAUGHT",
1933:         "LBW", "RUN OUT", "STUMPED", "WICKET",
1934:     )
1935:     matched = next((term for term in final_wicket_terms if term in upper),
1936:                    None)
1937:     if not matched:
1938:         return False
1939:     return scoreboard.accept_all_out_authority(
1940:         source=f"{matched.lower()} evidence", frame=frame)
