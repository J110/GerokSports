1504: def split_merged_batters(batters: list[dict], name_lookup: dict,
1505:                          scoreboard) -> list[dict]:
1506:     """Split merged batter names like 'SURYAKUMAR ROHIT' using squad lookup.
1507:     Uses scoreboard history to assign stats to the right player.
1508:     Also detects merged adjacent names like 'PRASHANT DUBE' where
1509:     each part resolves to a different squad member."""
1510:     result = []
1511:     for batter in batters:
1512:         raw_name = batter.get("name", "")
1513:         name_only = re.sub(r'[\d()*>]+', ' ', raw_name).strip()
1514:         name_only = re.sub(r'\s+', ' ', name_only)
1515:         words = name_only.upper().strip().split()
1516:         if len(words) < 2:
1517:             result.append(batter)
1518:             continue
1519: 
1520:         # Use resolve_name_split if scoreboard available — detects
1521:         # merged names like "Prashant Dube" → Prashant Veer + Shivam Dube
1522:         if scoreboard and scoreboard.batting_card:
1523:             split_names = scoreboard.resolve_name_split(name_only)
1524:             if len(split_names) == 2:
1525:                 raw = batter.get("_raw_name", raw_name)
1526:                 pairs = _extract_stat_pairs(raw)
1527: 
1528:                 b1 = {"name": words[0], "runs": None, "balls": None,
1529:                        "striker": batter.get("striker")}
1530:                 b2 = {"name": " ".join(words[1:]), "runs": None,
1531:                        "balls": None, "striker": None}
1532: 
1533:                 if len(pairs) >= 2:
1534:                     _assign_stats_by_history(
1535:                         b1, b2, split_names[0], split_names[1],
1536:                         pairs[0], pairs[1], scoreboard)
1537:                 elif len(pairs) == 1:
1538:                     b1["runs"], b1["balls"] = pairs[0]
1539:                 elif batter.get("runs") is not None:
1540:                     b1["runs"] = batter.get("runs")
1541:                     b1["balls"] = batter.get("balls")
1542: 
1543:                 log.info(f"  [SPLIT] Merged names: '{raw_name}' → "
1544:                          f"'{split_names[0]}' + '{split_names[1]}'")
1545:                 result.append(b1)
1546:                 result.append(b2)
1547:                 continue
1548:             elif len(split_names) == 1:
1549:                 result.append(batter)
1550:                 continue
1551: 
1552:         # Fallback: don't split if the full name resolves to a squad member
1553:         full_match = _resolve_for_split(name_only, name_lookup, scoreboard)
1554:         if full_match:
1555:             result.append(batter)
1556:             continue
1557: 
1558:         split_found = False
1559:         for i in range(1, len(words)):
1560:             left = " ".join(words[:i])
1561:             right = " ".join(words[i:])
1562:             left_match = _resolve_for_split(left, name_lookup, scoreboard)
1563:             right_match = _resolve_for_split(right, name_lookup, scoreboard)
1564:             if left_match and right_match and left_match != right_match:
1565:                 raw = batter.get("_raw_name", raw_name)
1566:                 pairs = _extract_stat_pairs(raw)
1567: 
1568:                 b1 = {"name": left, "runs": None, "balls": None,
1569:                        "striker": batter.get("striker")}
1570:                 b2 = {"name": right, "runs": None, "balls": None,
1571:                        "striker": None}
1572: 
1573:                 if len(pairs) >= 2:
1574:                     _assign_stats_by_history(
1575:                         b1, b2, left_match, right_match,
1576:                         pairs[0], pairs[1], scoreboard)
1577:                 elif len(pairs) == 1:
1578:                     b1["runs"], b1["balls"] = pairs[0]
1579:                 elif batter.get("runs") is not None:
1580:                     b1["runs"] = batter.get("runs")
1581:                     b1["balls"] = batter.get("balls")
1582: 
1583:                 log.info(f"  [SPLIT] '{raw_name}' → '{left}' + '{right}'")
1584:                 result.append(b1)
1585:                 result.append(b2)
1586:                 split_found = True
1587:                 break
1588: 
1589:         if not split_found:
1590:             result.append(batter)
1591:     return result
