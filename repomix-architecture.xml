3831:     def record_extra(self, extra_type: str, runs: int = 1):
3832:         """Record an extra (wide, no_ball, bye, leg_bye)."""
3833:         key_map = {
3834:             "wide": "wides", "no_ball": "no_balls",
3835:             "bye": "byes", "leg_bye": "leg_byes",
3836:             "penalty": "penalties",
3837:         }
3838:         key = key_map.get(extra_type)
3839:         if key:
3840:             self.extras[key] += runs
3841:             self.extras["total"] += runs
3842:             self.extras["this_over"] = (self.extras.get("this_over", 0)
3843:                                         or 0) + 1
3844:             entry = {
3845:                 "over": self._inn.get("overs"),
3846:                 "type": extra_type,
3847:                 "runs": runs,
3848:                 "this_over_after": list(self.this_over),
3849:             }
3850:             log_list = self.extras.setdefault("log", [])
3851:             log_list.append(entry)
3852:             if len(log_list) > 50:
3853:                 self.extras["log"] = log_list[-50:]
3854:             log.info(f"[EXTRA] {extra_type} +{runs} at "
3855:                      f"{self._inn.get('overs')}o  "
3856:                      f"this_over_extras={self.extras['this_over']}  "
3857:                      f"innings_total={self.extras['total']}  "
3858:                      f"this_over_now={self.this_over}")
