3818:     def detect_team_from_players(extracted: dict):
3819:         """Fallback: determine batting team from which squad the
3820:         extracted batter names belong to."""
3821:         if batting_team is not None:
3822:             return
3823:         batter_names = []
3824:         for b in (extracted.get("batters") or []):
3825:             n = b.get("name", "").upper().strip()
3826:             if n and not _is_placeholder(n):
3827:                 batter_names.append(n)
3828:         if len(batter_names) < 2:
3829:             return
3830: 
3831:         def _squad_set(team_key):
3832:             """Build a set of full names + individual parts for matching."""
3833:             names = set()
3834:             for p in squads.get(team_key, []):
3835:                 up = p.upper()
3836:                 names.add(up)
3837:                 for part in up.split():
3838:                     if len(part) >= 4:
3839:                         names.add(part)
3840:             return names
3841: 
3842:         team_a_squad = _squad_set(team_names[0])
3843:         team_b_squad = (_squad_set(team_names[1])
3844:                         if len(team_names) > 1 else set())
3845: 
3846:         def _matches(n, squad):
3847:             if any(n in s or s in n for s in squad):
3848:                 return True
3849:             # Try last token of broadcast name (e.g. "M MARSH" → "MARSH")
3850:             parts = n.split()
3851:             if len(parts) > 1 and len(parts[-1]) >= 4:
3852:                 return parts[-1] in squad
3853:             return False
3854: 
3855:         a_hits = sum(1 for n in batter_names if _matches(n, team_a_squad))
3856:         b_hits = sum(1 for n in batter_names if _matches(n, team_b_squad))
3857: 
3858:         if a_hits >= 2 and a_hits > b_hits:
3859:             bat = team_names[0]
3860:             bowl = team_names[1] if len(team_names) > 1 else "?"
3861:             log.info(f"[TEAM] Detected from players: {batter_names} "
3862:                      f"→ {bat} batting ({a_hits} matches)")
3863:             assign_teams(bat, bowl)
3864:         elif b_hits >= 2 and b_hits > a_hits:
3865:             bat = team_names[1]
3866:             bowl = team_names[0]
3867:             log.info(f"[TEAM] Detected from players: {batter_names} "
3868:                      f"→ {bat} batting ({b_hits} matches)")
3869:             assign_teams(bat, bowl)
