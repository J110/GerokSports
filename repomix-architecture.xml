 531: # ── WebSocket broadcast ────────────────────────────────────────
 532: _ws_clients: set = set()
 533: 
 534: # Per-client send timeout. Without this, one slow client (network
 535: # congestion, paused tab) hangs broadcast_state and starves the event
 536: # loop's ability to accept new handshakes — which is exactly what the
 537: # parity monitor was hitting ("timed out during opening handshake").
 538: _WS_SEND_TIMEOUT_S = 0.75
 539: 
 540: # Fix 17 Path D (cold-start WS broadcast gate, 2026-04-26):
 541: # don't push state to WS clients until first committed cold-start
 542: # consensus completes (batting_team set AND non-zero score
 543: # committed).  Closes the F6→F104 bad-UX window where the UI
 544: # showed `LSG 0/0` for ~3 minutes despite the broadcast clearly
 545: # showing `KKR 28/3`.  After the gate opens, all subsequent
 546: # frames pass through unchanged.  Safety timeout: 90s wallclock
 547: # (matches POISON-STREAK release threshold) so the UI never
 548: # hangs indefinitely if cold-start consensus fails to converge
 549: # (e.g. a never-actually-started match).
 550: _ws_cold_start_gate_open: bool = False
 551: _ws_cold_start_gate_first_attempt_ts: float | None = None
 552: _WS_COLD_START_GATE_TIMEOUT_S: float = 90.0
 553: 
 554: 
 555: def _ws_cold_start_gate_check(payload: dict) -> bool:
 556:     """Return True if the WS broadcast should be allowed through.
 557: 
 558:     Gate-open conditions (any one suffices):
 559:       (a) `batting_team` set on payload (cold-start has resolved
 560:           *which* team is batting; suppressing further would
 561:           block legitimate zero-state windows like innings-2
 562:           first ball and between-over pauses).
 563:       (b) Safety timeout (90s since first broadcast attempt) —
 564:           ensures the UI never hangs even if team detection
 565:           fails to converge.
 566:       (c) Already-open: once opened, the gate stays open for the
 567:           rest of the session.
 568: 
 569:     Hotfix 2026-04-26: original `_team and _score_i >= 1`
 570:     requirement was too strict and held the gate closed for the
 571:     full 90s timeout on every restart that came up during a
 572:     legitimate zero-score window (innings-2 first ball, mid-
 573:     match restart catching a between-overs graphic, etc.).
 574:     """
 575:     global _ws_cold_start_gate_open
 576:     global _ws_cold_start_gate_first_attempt_ts
 577:     if _ws_cold_start_gate_open:
 578:         return True
 579:     _now = time.time()
 580:     if _ws_cold_start_gate_first_attempt_ts is None:
 581:         _ws_cold_start_gate_first_attempt_ts = _now
 582:     # Canonical payload places score/batting_team under
 583:     # `payload["scorecard"]`, but a few legacy callsites broadcast a
 584:     # flat shape during cold-start.  Accept both.
 585:     _scorecard = payload.get("scorecard") or {}
 586:     _team = (payload.get("batting_team")
 587:              or _scorecard.get("batting_team"))
