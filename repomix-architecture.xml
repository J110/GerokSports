 256:     async def generate(
 257:             self, ws_payload: dict,
 258:             ball_event_hint: dict | None = None) -> dict[str, dict]:
 259:         """Generate commentary for all triggered personas. Returns {name: {text, latency_ms}}.
 260: 
 261:         `ball_event_hint` (Fix 2): when supplied by the caller, this
 262:         authoritative BED-derived event is used instead of InlineCommentary's
 263:         narrower `_detect_ball` (which required overs to advance by exactly
 264:         1 legal ball and therefore silently skipped every wide / no-ball —
 265:         Mode B of the 2026-04-24 investigation). When None, the previous
 266:         self-detection path is preserved so any legacy caller keeps working
 267:         without a signature update.
 268:         """
 269:         # Single try/finally wraps the entire body so _prev_state is
 270:         # ALWAYS advanced, even on exception. Previously the success
 271:         # path was the only place prev_state advanced; a NameError in
 272:         # format_for_prompt caused the detector to re-fire the same
 273:         # ball_event on every subsequent frame, crash again, and never
 274:         # advance — permanent commentary blackout after one bug.
 275:         try:
 276:             return await self._generate_inner(ws_payload, ball_event_hint)
 277:         except Exception as e:
 278:             self._error_count += 1
 279:             log.error(
 280:                 f"  [COMM] Error (#{self._error_count}): {e}",
 281:                 exc_info=True)
 282:             return {}
 283:         finally:
 284:             self._prev_state = ws_payload
 285: 
 286:     async def _generate_inner(
 287:             self, ws_payload: dict,
 288:             ball_event_hint: dict | None = None) -> dict[str, dict]:
 289:         # Fix 2: prefer the authoritative BED-produced event. Run the
 290:         # eligibility filter on it so MULTI_BALL (certain=False) and
 291:         # any unknown future type doesn't accidentally drive wire/
 292:         # storyteller. Fall back to self-detection only when the
 293:         # caller supplied no hint — preserves legacy behaviour.
 294:         if ball_event_hint is not None:
 295:             ball_event = (
 296:                 ball_event_hint
 297:                 if self._is_commentary_eligible_event(ball_event_hint)
 298:                 else None)
 299:         else:
 300:             ball_event = self._detect_ball(ws_payload)
 301: 
 302:         over_change = self._detect_over_change(ws_payload)
 303: 
 304:         if not ball_event and not over_change:
 305:             return {}
 306: 
 307:         triggers = self.detector.classify(ws_payload, ball_event, over_change)
 308:         if not triggers:
 309:             return {}
 310: 
 311:         if ball_event:
 312:             ctx = self.context.build_ball_context(ws_payload, ball_event)
 313:         elif over_change:
 314:             ctx = self.context.build_over_context(ws_payload, over_change)
 315:         else:
 316:             ctx = self.context.build_ball_context(ws_payload, {"type": "UPDATE"})
 317: 
 318:         di = ws_payload.get("delivery_info")
 319:         if di:
 320:             ctx["delivery_length"] = di.get("length")
 321:             ctx["delivery_line"] = di.get("line")
 322:             ctx["delivery_angle"] = di.get("bowling_angle")
 323:             ctx["delivery_shot_type"] = di.get("shot_type")
 324:             dir_info = di.get("shot_direction")
 325:             if dir_info and isinstance(dir_info, dict):
 326:                 ctx["delivery_shot_direction"] = dir_info.get("side")
 327:             ctx["delivery_shot_elevation"] = di.get("shot_elevation")
 328: 
 329:         if ws_payload.get("speed_kph"):
 330:             ctx["speed_kph"] = ws_payload["speed_kph"]
 331: 
 332:         prompt_text = self.context.format_for_prompt(ctx)
 333: 
 334:         results: dict[str, dict] = {}
 335:         tasks = {}
 336:         for name in triggers:
 337:             if (name == "wire"
 338:                     and ws_payload.get("_wire_override")):
 339:                 _wo = {"text": ws_payload["_wire_override"],
 340:                        "latency_ms": 0}
 341:                 results["wire"] = _wo
 342:                 self.context.recent_commentary.append(_wo["text"][:100])
 343:                 _wo_entry = {
 344:                     "persona": "wire",
 345:                     "text": _wo["text"],
 346:                     "timestamp": time.time(),
 347:                     "over": ws_payload.get("scorecard", {}).get("overs", "?"),
 348:                     "score": (
 349:                         f"{ws_payload.get('scorecard', {}).get('score', 0)}/"
 350:                         f"{ws_payload.get('scorecard', {}).get('wickets', 0)}"
 351:                     ),
 352:                     "latency_ms": 0,
 353:                 }
 354:                 self.history.append(_wo_entry)
 355:                 await self._broadcast(_wo_entry)
 356:                 continue
 357:             persona = PERSONALITIES[name]
 358:             tasks[name] = self._call_llm(name, persona, prompt_text)
 359: 
 360:         gathered = await asyncio.gather(*tasks.values(), return_exceptions=True)
 361:         for name, result in zip(tasks.keys(), gathered):
 362:             # Fix 3 — surface gather-level exceptions instead of
 363:             # silently dropping them via the isinstance() filter.
 364:             # Mode A of the 2026-04-24 investigation was
 365:             # indistinguishable in logs from "no ball event" because
 366:             # both tasks raised on cold-start Groq calls and both
 367:             # exceptions vanished here. Now each is logged with task
 368:             # name and exception type for post-deploy triage.
 369:             if isinstance(result, Exception):
 370:                 self._llm_exc_count += 1
 371:                 try:
 372:                     log.warning(
 373:                         f"  [COMM-LLM-EXC] {name} raised "
 374:                         f"(#{self._llm_exc_count}): "
 375:                         f"{type(result).__name__}: {result}")
 376:                 except Exception:
 377:                     pass
 378:                 continue
 379:             if not isinstance(result, dict):
 380:                 try:
 381:                     log.warning(
 382:                         f"  [COMM-LLM-BAD] {name} returned non-dict "
 383:                         f"({type(result).__name__})")
 384:                 except Exception:
 385:                     pass
 386:                 continue
 387: 
 388:             # Fix 1 — flag error-shaped / empty dicts returned by
 389:             # _call_llm so Groq failures are attributable without
 390:             # requiring source-level instrumentation. Together with
 391:             # Fix 3 this covers every failure mode between "task
 392:             # invoked" and "result accepted into payload".
 393:             _text = (result.get("text") or "").strip()
 394:             if _text.startswith("[error:") or not _text:
 395:                 self._llm_invalid_count += 1
 396:                 try:
 397:                     log.warning(
 398:                         f"  [COMM-LLM-INVALID] {name} produced "
 399:                         f"error-shaped or empty text "
 400:                         f"(#{self._llm_invalid_count}): "
 401:                         f"text={_text[:120]!r}")
 402:                 except Exception:
 403:                     pass
 404:                 continue
 405: 
 406:             if isinstance(result, dict):
 407:                 # S3 safety net: drop generations that name a player
 408:                 # who isn't actually on the field for this ball.
 409:                 # Real fix is correct context; this catches the rest.
 410:                 _foreign = self._validate_commentary_names(
 411:                     result.get("text", ""), ws_payload)
 412:                 if _foreign:
 413:                     try:
 414:                         log.warning(
 415:                             f"  [COMM-ALLOWLIST] {name} dropped: "
 416:                             f"foreign names {_foreign} | "
 417:                             f"text={result.get('text', '')[:120]!r}")
 418:                     except Exception:
 419:                         pass
 420:                     # Don't broadcast a hallucinated line. Let the
 421:                     # next ball's commentary be the user-visible
 422:                     # output for this persona.
 423:                     continue
 424:                 results[name] = result
 425:                 self.context.recent_commentary.append(result["text"][:100])
 426:                 entry = {
 427:                     "persona": name,
 428:                     "text": result["text"],
 429:                     "timestamp": time.time(),
 430:                     "over": ws_payload.get("scorecard", {}).get("overs", "?"),
 431:                     "score": (
 432:                         f"{ws_payload.get('scorecard', {}).get('score', 0)}/"
 433:                         f"{ws_payload.get('scorecard', {}).get('wickets', 0)}"),
 434:                     "latency_ms": result["latency_ms"],
 435:                 }
 436:                 self.history.append(entry)
 437:                 await self._broadcast(entry)
 438: 
 439:         return results
 440: 
 441:     async def _call_llm(self, name: str, persona: dict,
 442:                         prompt_text: str) -> dict:
 443:         config = persona["config"]
 444:         t0 = time.time()
 445:         try:
 446:             response = await self.groq.chat.completions.create(
 447:                 model=config["model"],
 448:                 temperature=config["temperature"],
 449:                 max_tokens=config["max_tokens"],
 450:                 messages=[
 451:                     {"role": "system", "content": persona["system"]},
 452:                     {"role": "user", "content": prompt_text},
 453:                 ],
 454:             )
 455:             text = response.choices[0].message.content.strip()
 456:             if name in _PERSONAS_TO_STRIP:
 457:                 text = _FIELDING_STRIP_RE.sub('', text)
 458:                 text = re.sub(r'\s{2,}', ' ', text).strip()
 459:             ms = int((time.time() - t0) * 1000)
 460:             return {"text": text, "latency_ms": ms}
 461:         except Exception as e:
 462:             ms = int((time.time() - t0) * 1000)
 463:             return {"text": f"[error: {e}]", "latency_ms": ms}
 464: 
 465:     async def _broadcast(self, entry: dict):
 466:         import json as _json
 467:         payload = _json.dumps({"type": "commentary", "entry": entry})
 468:         dead = []
 469:         for client in self.clients:
 470:             try:
 471:                 await client.send(payload)
 472:             except Exception:
 473:                 dead.append(client)
 474:         for c in dead:
 475:             self.clients.discard(c)
 476: 
 477: 
 478: # ── S1 monitoring: log every write to scoreboard._inn["striker"]
 479: #    or ["non_striker"] from outside scoreboard.py. With SM as the
 480: #    sole UI authority, ANY external write here is suspicious — most
 481: #    are legacy paths that should have been removed during cutover.
 482: #    Their captured caller frames let us delete them one by one.
 483: _STRIKER_KEYS = ("striker", "non_striker")
 484: 
 485: 
 486: class _StrikerLoggingDict(dict):
 487:     """Drop-in dict that logs writes to striker/non_striker keys."""
 488: 
 489:     def __setitem__(self, key, value):
 490:         if key in _STRIKER_KEYS:
 491:             old = self.get(key)
 492:             if old != value:
 493:                 import inspect as _insp
 494:                 caller = "?"
 495:                 stk = _insp.stack()
 496:                 for fr in stk[1:8]:
 497:                     fn = os.path.basename(fr.filename or "")
 498:                     # Skip scoreboard.py internals — those writes are
 499:                     # legitimate (Scoreboard owns its dict). We only
 500:                     # want to surface external writers.
 501:                     if fn == "scoreboard.py" or not fn:
 502:                         continue
 503:                     if fr.function == "__setitem__":
 504:                         continue
 505:                     caller = (f"{fn}:{fr.lineno} "
 506:                               f"({fr.function})")
 507:                     break
 508:                 try:
 509:                     log.info(
 510:                         f"  [STRIKER-WRITE] {caller}: "
 511:                         f"{key} {old}->{value}")
 512:                 except Exception:
 513:                     pass
 514:         super().__setitem__(key, value)
 515: 
