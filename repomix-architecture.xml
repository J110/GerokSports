1243: def extract_broadcast_data(scout_text: str, cache: dict) -> dict:
1244:     """Extract all deterministic data from Scout's raw text in one pass.
1245: 
1246:     Per-frame values are always returned. Session-level values (venue,
1247:     match_info, team_abbr) are set in ``cache`` once and reused.
1248:     Returns a dict of per-frame extracted values.
1249:     """
1250:     result: dict = {}
1251:     if not scout_text:
1252:         return result
1253: 
1254:     # ── Per-frame: speed ────────────────────────────────────────────
1255:     m = _RE_SPEED.search(scout_text)
1256:     if m:
1257:         try:
1258:             result["speed_kph"] = float(m.group(1))
1259:         except (ValueError, TypeError):
1260:             pass
1261: 
1262:     # ── Per-frame: striker indicator (* or >) ───────────────────────
1263:     m = _RE_STRIKER.search(scout_text)
1264:     if m:
1265:         result["striker_broadcast"] = m.group(1).strip()
1266: 
1267:     # ── Per-frame: fours/sixes counts ───────────────────────────────
1268:     m = _RE_FOURS.search(scout_text)
1269:     if m:
1270:         result["fours"] = int(m.group(1))
1271:     m = _RE_SIXES.search(scout_text)
1272:     if m:
1273:         result["sixes"] = int(m.group(1))
1274: 
1275:     # ── Per-frame: extras from info panel ───────────────────────────
1276:     m = _RE_EXTRAS_PANEL.search(scout_text)
1277:     if m:
1278:         result["extras_total"] = int(m.group(1))
1279:         result["extras_detail"] = m.group(2).strip()
1280: 
1281:     # ── Per-frame: current delivery extra type (e.g. "EXTRA: WD") ──
1282:     m = _RE_EXTRA_TYPE.search(scout_text)
1283:     if m:
1284:         raw = m.group(1).strip().upper().replace(" ", "")
1285:         if raw in ("WD", "WIDE"):
1286:             result["broadcast_extra"] = "WD"
1287:         elif raw in ("NB", "NOBALL"):
1288:             result["broadcast_extra"] = "NB"
1289: 
1290:     # ── Per-frame: dismissal mode keyword (BOWLED/CAUGHT/LBW etc.) ─
1291:     m = _RE_DISMISSAL_MODE.search(scout_text)
1292:     if m:
1293:         raw = m.group(1).strip().upper().replace(" ", "_")
1294:         mode_map = {
1295:             "BOWLED": "bowled", "CAUGHT": "caught",
1296:             "LBW": "lbw", "STUMPED": "stumped",
1297:             "RUNOUT": "run_out", "RUN_OUT": "run_out",
1298:             "HIT_WICKET": "hit_wicket",
1299:             "RETIRED_HURT": "retired_hurt",
1300:             "RETIRED_OUT": "retired_out",
1301:         }
1302:         mode = mode_map.get(raw)
1303:         if mode:
1304:             result["dismissal_mode"] = mode
1305: 
1306:     # ── Per-frame: this-over from info panel ────────────────────────
1307:     this_over = _parse_this_over_from_scout(scout_text)
1308:     if this_over:
1309:         result["this_over_broadcast"] = this_over
1310: 
1311:     # ── Cache-once: target ──────────────────────────────────────────
1312:     if not cache.get("target"):
1313:         m = _RE_TARGET.search(scout_text)
1314:         if m:
1315:             try:
1316:                 val = int(m.group(1))
1317:                 if val > 50:
1318:                     cache["target"] = val
1319:                     result["target"] = val
1320:                     log.info(f"  [BROADCAST] Target extracted: {val}")
1321:             except (ValueError, TypeError):
1322:                 pass
1323:     if not cache.get("target"):
1324:         m = _RE_TO_WIN.search(scout_text)
1325:         if m:
1326:             try:
1327:                 runs_needed = int(m.group(1))
1328:                 balls_rem = int(m.group(2))
1329:                 if runs_needed >= 10:
1330:                     result["runs_needed"] = runs_needed
1331:                     result["balls_remaining_chase"] = balls_rem
1332:                     log.info(f"  [BROADCAST] Chase: {runs_needed} "
1333:                              f"from {balls_rem} balls")
1334:             except (ValueError, TypeError):
1335:                 pass
1336: 
1337:     # ── Cache-once: venue ───────────────────────────────────────────
1338:     if not cache.get("venue"):
1339:         for pat in _VENUE_PATTERNS:
1340:             m = pat.search(scout_text)
1341:             if m:
1342:                 cache["venue"] = m.group(1).strip().rstrip(".,;:")
1343:                 log.info(f"  [BROADCAST] Venue: {cache['venue']}")
1344:                 break
1345: 
1346:     # ── Cache-once: match info ──────────────────────────────────────
1347:     if not cache.get("match_info"):
1348:         for pat in _MATCH_INFO_PATTERNS:
1349:             m = pat.search(scout_text)
1350:             if m:
1351:                 cache["match_info"] = m.group(1).strip()
1352:                 log.info(f"  [BROADCAST] Match: {cache['match_info']}")
1353:                 break
1354: 
1355:     # ── Cache-once: team abbreviation ───────────────────────────────
1356:     if not cache.get("team_abbr"):
1357:         m = _RE_TEAM_ABBR.search(scout_text)
1358:         if m:
1359:             cache["team_abbr"] = m.group(1)
1360: 
1361:     return result
