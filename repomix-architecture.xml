2116: class ScoreJumpGuard:
2117:     def __init__(self):
2118:         self._pending_score: int | None = None
2119:         self._pending_count = 0
2120: 
2121:     def check(self, old_score: int | None, new_score: int) -> bool:
2122:         if old_score is None or old_score == 0:
2123:             self._reset()
2124:             return True
2125:         jump = new_score - old_score
2126:         if jump <= 7:
2127:             self._reset()
2128:             return True
2129:         if jump < 0:
2130:             self._reset()
2131:             return False
2132:         if self._pending_score == new_score:
2133:             self._pending_count += 1
2134:             if self._pending_count >= 2:
2135:                 log.info(f"Score jump {old_score}→{new_score} CONFIRMED")
2136:                 self._reset()
2137:                 return True
2138:             log.info(f"Score jump {old_score}→{new_score} HOLD ({self._pending_count}/2)")
2139:             return False
2140:         log.info(f"Score jump {old_score}→{new_score} (+{jump}) HOLDING")
2141:         self._pending_score = new_score
2142:         self._pending_count = 1
2143:         return False
2144: 
2145:     def _reset(self):
2146:         self._pending_score = None
2147:         self._pending_count = 0
