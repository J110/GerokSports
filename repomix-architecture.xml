 133:     @staticmethod
 134:     def _is_commentary_eligible_event(event: dict | None) -> bool:
 135:         """Fix 2 filter — decide whether a BED-authored ball_event
 136:         should drive commentary. Keeps MULTI_BALL (`certain=False`)
 137:         and anything outside the known set from accidentally firing
 138:         wire/storyteller."""
 139:         if not event:
 140:             return False
 141:         if event.get("type") not in _COMMENTARY_ELIGIBLE_BALL_TYPES:
 142:             return False
 143:         # Defensive: reject any listed type that arrived with
 144:         # certain=False (shouldn't happen with current BED but cheap
 145:         # to guard).
 146:         if event.get("certain") is False:
 147:             return False
 148:         return True
