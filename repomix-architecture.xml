1355:     def _mirror_team_delta_to_bowler(self, field, old_v, new_v,
1356:                                      frame: int) -> None:
1357:         """Apply a team score/overs delta to the current bowler.
1358: 
1359:         Cricket scoring attributes every team run (except byes / leg-
1360:         byes) and every legal delivery to the bowler on the day. The
1361:         broadcast bowling-card overlay refreshes 1-2 frames after the
1362:         team strip, leaving the UI showing stale figures until then.
1363:         Mirroring the delta here keeps bowler stats live without
1364:         waiting for the broadcast LLM read.
1365: 
1366:         OVER-BOUNDARY GUARD: the same bowler cannot bowl two
1367:         consecutive overs (cricket rule). When team overs cross from
1368:         ``X.0 → X.1`` (the first ball of the next over), the run /
1369:         ball belongs to a DIFFERENT bowler whose name we don't know
1370:         yet (broadcast bowler-card refresh lags by 1-2 frames).
1371:         Skipping the mirror in that case prevents poisoning the
1372:         outgoing bowler's figures with the new bowler's deliveries.
1373:         """
1374:         cb_name = self._inn.get("current_bowler") if self._inn else None
1375:         if not cb_name or cb_name not in self.bowling_card:
1376:             return
1377:         entry = self.bowling_card[cb_name]
1378:         # Cold-start guard: if the team's prior state is None, this
1379:         # is the FIRST broadcast read (pipeline just started, joined
1380:         # mid-match). We're not actually observing ball-by-ball
1381:         # increments here — the bowler stats from the broadcast strip
1382:         # are what they are, don't blindly add the team total to them.
1383:         if old_v is None or self._inn.get("overs") is None:
1384:             return
1385:         # Fix #2 (2026-04-23): defer when Scout is actively reading.
1386:         # If update_bowler() fired within the last 2 frames Scout is
1387:         # supplying authoritative figures — let those commit instead
1388:         # of auto-incrementing, which otherwise races ahead (bumping
1389:         # recorded overs 0.4 → 0.5) and then causes Scout's 0.4 read
1390:         # to be rejected as stale on the same frame.
1391:         _scout_gap = frame - self._last_bowler_scout_frame
1392:         if 0 <= _scout_gap < 2:
1393:             log.info(
1394:                 f"[BOWLER-AUTO] {field} delta deferred — Scout "
1395:                 f"active (last bowler read {_scout_gap} frame(s) "
1396:                 f"ago); letting broadcast supply authoritative value")
1397:             return
1398:         # Determine current team-overs context (for over-boundary check).
1399:         # _inn["overs"] holds the value AT THE MOMENT this set() was
1400:         # invoked — for a "score" delta, overs has not yet been bumped
1401:         # for the same broadcast read, so reading it gives the OLD
1402:         # team overs. For an "overs" delta, old_v is the same OLD
1403:         # value. Both paths can use _team_balls_part_of(_inn overs).
1404:         try:
1405:             _team_overs_now = (str(self._inn.get("overs") or "0.0")
1406:                                .split(".") + ["0"])[:2]
1407:             _team_balls_in_over = int(_team_overs_now[1])
1408:         except (ValueError, TypeError):
1409:             _team_balls_in_over = -1
1410:         if field == "score":
1411:             # If team overs ends in .0, the run we're about to add
1412:             # corresponds to ball-1 of a brand-new over → new bowler.
1413:             # Skip the auto-mirror; the broadcast bowler card will
1414:             # catch up within 1-2 frames and we'll get the correct
1415:             # name to credit.
1416:             if _team_balls_in_over == 0:
1417:                 log.info(
1418:                     f"[BOWLER-AUTO] runs delta deferred — team at "
1419:                     f"over boundary ({self._inn.get('overs')}); "
1420:                     f"new bowler will be confirmed by broadcast")
1421:                 return
1422:             try:
1423:                 delta = int(new_v) - int(old_v or 0)
1424:             except (ValueError, TypeError):
1425:                 return
1426:             # Sanity guard: more than 6 runs in a single set() call
1427:             # is almost always a cold-start big jump, not a single
1428:             # delivery. Skip — broadcast bowler card will sync.
1429:             if delta <= 0 or delta > 6:
1430:                 return
1431:             cur_r = int(entry.get("runs") or 0)
1432:             entry["runs"] = cur_r + delta
1433:             self._tracker.force_set(
1434:                 f"bowl:{cb_name}:runs", entry["runs"])
1435:             log.info(
1436:                 f"[BOWLER-AUTO] {cb_name} runs {cur_r} → "
1437:                 f"{entry['runs']} (+{delta} from team score)")
1438:         elif field == "overs":
1439:             try:
1440:                 old_w_s, old_b_s = (str(old_v or "0.0").split(".")
1441:                                     + ["0"])[:2]
1442:                 new_w_s, new_b_s = (str(new_v).split(".")
1443:                                     + ["0"])[:2]
1444:                 old_balls_total = int(old_w_s) * 6 + int(old_b_s)
1445:                 new_balls_total = int(new_w_s) * 6 + int(new_b_s)
1446:             except (ValueError, TypeError):
1447:                 return
1448:             balls_delta = new_balls_total - old_balls_total
1449:             # Sanity guard: more than 1 ball in a single delta is
1450:             # either dead-time skip or cold-start jump → don't auto-
1451:             # mirror, let the broadcast bowler card take over.
1452:             if balls_delta <= 0 or balls_delta > 1:
1453:                 return
1454:             # Over-boundary skip: if old overs ends in ".0" then the
1455:             # NEW ball(s) belong to the next over → different bowler.
1456:             # Skip auto-attribution (broadcast confirms within 1-2
1457:             # frames). Special case: if old=X.5 → new=X+1.0 we DO want
1458:             # to attribute (that's the 6th and final ball of over X+1
1459:             # by the current bowler).
1460:             if int(old_b_s) == 0 and int(old_w_s) > 0:
1461:                 log.info(
1462:                     f"[BOWLER-AUTO] overs delta deferred — old="
1463:                     f"{old_v} is end-of-over, new ball belongs to "
1464:                     f"a different bowler")
1465:                 return
1466:             try:
1467:                 cur_w_s, cur_b_s = (str(entry.get("overs") or "0.0")
1468:                                     .split(".") + ["0"])[:2]
1469:                 cur_total = int(cur_w_s) * 6 + int(cur_b_s)
1470:             except (ValueError, TypeError):
1471:                 cur_total = 0
1472:             new_total = cur_total + balls_delta
1473:             new_w = new_total // 6
1474:             new_b = new_total % 6
1475:             new_overs_str = f"{new_w}.{new_b}"
1476:             entry["overs"] = new_overs_str
1477:             self._tracker.force_set(
1478:                 f"bowl:{cb_name}:overs", new_overs_str)
1479:             log.info(
1480:                 f"[BOWLER-AUTO] {cb_name} overs "
1481:                 f"{cur_w_s}.{cur_b_s} → {new_overs_str} "
1482:                 f"(+{balls_delta} balls from team overs)")
