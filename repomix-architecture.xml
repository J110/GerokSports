2012: def clean_extracted(extracted: dict, name_lookup: dict | None = None,
2013:                     scoreboard=None, vision_desc: str | None = None) -> dict:
2014:     """Preprocess extractor output: strip stats, filter placeholders, split merges."""
2015:     if extracted.get("batters"):
2016:         cleaned = []
2017:         for b in extracted["batters"]:
2018:             b["name"] = clean_player_name(b.get("name", ""))
2019:             clean_batter_entry(b)
2020:             if not _is_placeholder(b.get("name", "")):
2021:                 cleaned.append(b)
2022:         extracted["batters"] = cleaned
2023: 
2024:     comms_frame = _has_commentary_context(vision_desc)
2025:     stat_panel = _is_stat_panel(vision_desc)
2026: 
2027:     bw = extracted.get("bowler")
2028:     if bw and isinstance(bw, dict):
2029:         bw["name"] = clean_player_name(bw.get("name", ""))
2030:         clean_bowler_entry(bw)
2031:         # Sanity: if wickets > runs and wickets > 5, they're swapped
2032:         bw_w = bw.get("wickets")
2033:         bw_r = bw.get("runs")
2034:         if (bw_w is not None and bw_r is not None
2035:                 and int(bw_w) > int(bw_r) and int(bw_w) > 5):
2036:             bw["wickets"], bw["runs"] = bw_r, bw_w
2037:         bw_name = bw.get("name", "")
2038:         if _is_placeholder(bw_name):
2039:             extracted["bowler"] = None
2040:         elif _is_bowling_type_name(bw_name):
2041:             log.info(f"[GUARD] '{bw_name}' is a bowling type, not a name")
2042:             extracted["bowler"] = None
2043:         elif stat_panel and scoreboard:
2044:             resolved = scoreboard.resolve_name(bw_name)
2045:             if not resolved:
2046:                 log.info(f"[GUARD] '{bw_name}' from stat panel — dropping")
2047:                 extracted["bowler"] = None
2048:         elif comms_frame and scoreboard:
2049:             resolved = scoreboard.resolve_name(bw_name)
2050:             if not resolved:
2051:                 log.info(f"[GUARD] Bowler '{bw_name}' likely "
2052:                          f"commentator — dropping")
2053:                 extracted["bowler"] = None
2054: 
2055:     if extracted.get("bowlers") and isinstance(extracted["bowlers"], list):
2056:         cleaned_bowlers = []
2057:         for b in extracted["bowlers"]:
