 969:     def set(self, field: str, value, frame: int) -> bool:
 970:         if value is None:
 971:             return False
 972: 
 973:         old = self._inn.get(field)
 974: 
 975:         if field == "score":
 976:             try:
 977:                 v = int(value)
 978:             except (ValueError, TypeError):
 979:                 return False
 980:             # Absolute T20 ceiling — no team has ever passed 287 in
 981:             # men's T20Is.  720 was way too loose for a T20 pipeline
 982:             # and let OCR garbage (e.g. "446" misread of an overlay
 983:             # number) through to the headline.
 984:             if v < 0 or v > 320:
 985:                 log.warn(f"Score rejected: absolute {v} > 320")
 986:                 return False
 987:             # Chase-aware ceiling: in 2nd innings, the score can equal
 988:             # target on the winning ball but never exceed target by more
 989:             # than a small OCR-jitter buffer.  Rejects e.g. 446/2 when
 990:             # the chase target is 181.
 991:             if self.current_innings >= 2:
 992:                 tgt = self._inn.get("target")
 993:                 if tgt is not None and v > int(tgt) + 4:
 994:                     log.warn(f"Score rejected: chase {v} > "
 995:                              f"target {tgt} + 4")
 996:                     return False
 997:             # Per-update jump guard: even after a long ad break,
