 699: def _strip_has_text_band(strip: np.ndarray) -> bool:
 700:     """Pre-Scout gate: does the bottom strip contain a broadcast
 701:     scoreboard text bar?
 702: 
 703:     Scoreboard bars have high-contrast text (white/bright glyphs on
 704:     a solid dark band) which produces strong **horizontal luminance
 705:     gradients** from the vertical strokes of each character.
 706:     Closeup shots of faces/uniforms, crowd, grass, or fade-outs lack
 707:     this text-like signature.
 708: 
 709:     Calibrated on the 2026-04-21 SRH-vs-DC live session (n=210 scout
 710:     frames, 28 FRAME_POISONED):
 711:       - valid scoreboards  : grad_mean = 11.6 ± 3.4
 712:       - poisoned closeups  : grad_mean =  3.7 ± 3.5
 713:       - advertisements     : grad_mean =  3.8 ± 2.7
 714: 
 715:     A single-metric gate of ``grad_mean >= 6.0`` skips ~84% of
 716:     poisoned frames and ~67% of full-screen ads while keeping ~91%
 717:     of valid strips.  The main loop wraps this with a force-through
 718:     safety valve so the ~9% false-skip rate cannot starve the
 719:     pipeline if the heuristic is wrong on an unusual broadcast
 720:     graphic.
 721:     """
 722:     if strip is None or strip.size == 0:
 723:         return False
 724:     gray = (cv2.cvtColor(strip, cv2.COLOR_BGR2GRAY)
 725:             if len(strip.shape) == 3 else strip)
 726:     std = float(np.std(gray))
 727:     # Near-uniform regions (blank fade, pure sky) can never be a strip.
 728:     if std < 10.0:
 729:         return False
 730:     # Primary signal: horizontal gradient density from text glyphs.
 731:     gx = cv2.Sobel(gray, cv2.CV_32F, 1, 0, ksize=3)
 732:     grad_mean = float(np.mean(np.abs(gx)))
 733:     return grad_mean >= 6.0
