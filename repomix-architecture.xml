2658:             #   (a) over just rolled and we expect a new bowler
2659:             #       (_bowler_must_change) — accept on 1st sighting
2660:             #       provided the new name != previous over's bowler.
2661:             #   (b) normal play — require N consecutive reads.
2662:             _accept = False
2663:             if (self._bowler_must_change
2664:                     and (not _prev_over_bowler
2665:                          or name != _prev_over_bowler)):
2666:                 _accept = True
2667:             elif self._bowler_team_over_consensus(
2668:                     _cur_bowler, name, overs, self._pending_bowler_count):
2669:                 log.warn(
2670:                     f"  [BOWLER-TEAM-OVER-CONSENSUS] accepting {name!r} "
2671:                     f"after {self._pending_bowler_count} reads — "
2672:                     f"candidate overs {overs} matches team over "
2673:                     f"{self._inn.get('overs')} while current_bowler "
2674:                     f"{_cur_bowler!r} is inconsistent")
2675:                 _accept = True
2676:             elif self._pending_bowler_count >= _CONSENSUS_N:
2677:                 _accept = True
2678:             if _accept:
2679:                 log.info(
2680:                     f"[BOWLER OVERRIDE] {_cur_bowler} → {name} "
2681:                     f"(reads={self._pending_bowler_count}, "
2682:                     f"must_change={self._bowler_must_change})")
2683:                 self._inn["current_bowler"] = name
2684:                 self._tracker.force_set("current_bowler", name)
2685:                 self._pending_bowler_name = None
2686:                 self._pending_bowler_count = 0
2687:                 self._bowler_must_change = False
2688:                 _bowler_changed = True
