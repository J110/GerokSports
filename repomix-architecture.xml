 144:                 "overs_balls": new_overs_balls,
 145:             }
 146:             return new_runs, new_wickets, new_overs_balls
 147:         old_r = existing.get("runs") or 0
 148: 
 149:         # First non-zero reading — accept unconditionally
 150:         # (bowler may have been bowling before we joined)
 151:         if old_r == 0 and new_runs is not None and new_runs > 0:
 152:             existing["runs"] = new_runs
 153:             existing["wickets"] = new_wickets
 154:             existing["overs_balls"] = new_overs_balls
 155:             return new_runs, new_wickets, new_overs_balls
 156: 
 157:         mmb = self._max_missed_balls()
 158:         max_r_inc = 7 * mmb
 159:         if new_runs is not None:
 160:             r_delta = new_runs - old_r
 161:             if r_delta < 0 or r_delta > max_r_inc:
 162:                 new_runs = old_r
 163:             if self.score is not None and new_runs > self.score:
 164:                 new_runs = old_r
