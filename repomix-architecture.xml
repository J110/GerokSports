4283:     def _record_dismissal_hint(frame_num: int, mode: str, source: str):
4284:         nonlocal _recent_dismissal_hints
4285:         _recent_dismissal_hints.append({
4286:             "frame": frame_num,
4287:             "mode": mode,
4288:             "source": source,
4289:         })
4290:         # Trim to window
4291:         _cutoff = frame_num - _DISMISSAL_HINT_WINDOW
4292:         _recent_dismissal_hints = [
4293:             h for h in _recent_dismissal_hints if h["frame"] >= _cutoff
4294:         ]
