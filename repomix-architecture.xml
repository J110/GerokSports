3887:     def over_just_changed(self) -> bool:
3888:         """Check if the over number changed since last check."""
3889:         overs_str = self._inn.get("overs") or "0.0"
3890:         try:
3891:             over_num = int(str(overs_str).split(".")[0])
3892:         except (ValueError, TypeError):
3893:             return False
3894:         if self._last_over_num is None:
3895:             self._last_over_num = over_num
3896:             return False
3897:         if over_num != self._last_over_num:
3898:             self._last_over_num = over_num
3899:             return True
3900:         return False
