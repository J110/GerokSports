2228:     def _bowler_team_over_consensus(
2229:             self, current_bowler: str | None, candidate: str,
2230:             candidate_overs: str | None, read_count: int) -> bool:
2231:         """Use team-over physics to accelerate stale-bowler recovery."""
2232:         if not current_bowler or candidate == current_bowler:
2233:             return False
2234:         if candidate_overs is None or read_count < 2:
2235:             return False
2236:         team_balls = self._team_balls_seen()
2237:         team_ball_in_over = team_balls % 6
2238:         if team_ball_in_over == 0:
2239:             return False
2240:         candidate_ball = self._overs_to_balls(candidate_overs) % 6
2241:         current_overs = (
2242:             self.bowling_card.get(current_bowler, {}).get("overs"))
2243:         current_ball = self._overs_to_balls(current_overs) % 6
2244:         if candidate_ball != team_ball_in_over:
2245:             return False
2246:         if current_overs is None:
2247:             return True
2248:         return current_ball != team_ball_in_over
