2135:                              if self.partnership_known else None),
2136:                     "balls": (self.partnership_balls
2137:                               if self.partnership_known else None),
2138:                 },
2139:             },
2140:             "match": {
2141:                 "target": self.target,
2142:                 "runs_required": ((self.target - self.score)
2143:                                   if self.target and self.score is not None
2144:                                   else None),
2145:                 "balls_remaining": self.balls_remaining,
2146:                 "required_rate": self.required_run_rate,
2147:                 "innings": self.innings,
2148:                 "phase": self.match_phase,
2149:                 "venue": self.venue,
2150:                 "match_info": self.match_info,
2151:             },
2152:             "this_over": self.this_over,
2153:             "over_history": self.over_history,
2154:             "completed_over": self.completed_over,
2155:             "completed_over_runs": self.completed_over_runs,
2156:             "fow_count": len(self.fow_list),
2157:             "fow_list": self.fow_list,
2158:             "extras": {
2159:                 "innings_total": self.innings_extras,
2160:                 "this_over": self.this_over_extras,
2161:                 "log_tail": self.extras_log[-5:],
