1646:     def update_batter(self, name: str, runs: int | None = None,
1647:                       balls: int | None = None, fours: int | None = None,
1648:                       sixes: int | None = None, striker: bool | None = None,
1649:                       frame: int = 0) -> bool:
1650:         resolved = self.resolve_name(name)
1651:         if resolved is None:
1652:             log.warn(f"Batter '{name}' not in any squad")
1653:             return False
1654: 
1655:         # Guard: reject if player is in the bowling squad (opposition)
1656:         bowl_key = self._find_card_key(resolved, self.bowling_card)
1657:         if bowl_key is not None:
1658:             log.warn(f"Batter '{name}' is in bowling squad "
1659:                      f"(opposition) — rejecting")
1660:             return False
1661: 
1662:         card_key = self._find_card_key(resolved, self.batting_card)
1663:         if card_key is None:
1664:             log.warn(f"Batter '{name}' not in batting card"
1665:                      f" (resolved: {resolved})")
1666:             return False
1667:         name = card_key
1668: 
1669:         entry = self.batting_card[name]
1670: 
1671:         if entry["status"] == "out":
1672:             # Fix 1 (2026-04-25, P0-A active-batter invariants).
1673:             # Refuse to un-dismiss a batter that FOW has witnessed as
1674:             # actually out.  The un-dismiss path was originally added
1675:             # for *auto-dismiss-of-wrong-batter* recovery (placeholder
1676:             # FOW, no `_witnessed`), but during DC vs PBKS F339 it
1677:             # also resurrected Pathum Nissanka — a witnessed dismissal
1678:             # — when Scout misread a phase-economy graphic as a live
1679:             # batter strip.  Witnessed FOW is the canonical "this
1680:             # batter is out" record and overrides repeated strip reads.
1681:             if self._is_witnessed_dismissal(name):
1682:                 log.warn(f"[INVARIANT] Refusing to un-dismiss '{name}' "
1683:                          f"— witnessed FOW entry exists "
1684:                          f"(strip read suppressed)")
1685:                 return False
1686:             self._dismissed_recovery.setdefault(name, 0)
1687:             self._dismissed_recovery[name] += 1
1688:             count = self._dismissed_recovery[name]
1689:             # Bug fix: lowered consensus from 3 → 2 frames so a
1690:             # wrongly-dismissed batter (auto-dismiss picked the wrong
1691:             # member of the pair on a wicket) gets back on the UI in
1692:             # ~10s instead of 30+s. The un-dismiss carries the same
1693:             # safety as before — un-dismissing also auto-deactivates
1694:             # the OTHER batter who is no longer showing on the strip
1695:             # (the actual dismissee), keeping pair size at 2.
1696:             if count < 2:
1697:                 log.warn(f"Batter {name} dismissed but seen again "
1698:                          f"({count}/2) — waiting for consensus")
1699:                 return False
1700:             log.info(f"[UN-DISMISS] {name} appeared on strip for "
1701:                      f"{count} consecutive frames — reactivating "
1702:                      f"(likely auto-dismiss of wrong batter)")
1703:             entry["status"] = "batting"
1704:             entry["dismissal"] = None
1705:             self._dismissed_recovery.pop(name, None)
1706:             # If 2 batters already active, auto-dismiss one
1707:             active = [k for k, v in self.batting_card.items()
1708:                       if v["status"] == "batting"]
1709:             if len(active) > 2:
1710:                 # Deactivate the one NOT in extractor output
1711:                 for a in active:
1712:                     if a != name and (self.batting_card[a].get("runs") is None
1713:                                      or self.batting_card[a].get("runs") == 0):
1714:                         self.batting_card[a]["status"] = "yet_to_bat"
1715:                         self.batting_card[a]["runs"] = None
1716:                         self.batting_card[a]["balls"] = None
1717:                         log.info(f"[UN-DISMISS] Deactivated {a} to make "
1718:                                  f"room for {name}")
1719:                         break
1720: 
1721:         active = [k for k, v in self.batting_card.items()
1722:                   if v["status"] == "batting"]
1723: 
1724:         was_yet_to_bat = entry["status"] == "yet_to_bat"
1725:         admitted_from_live_pair = False
1726:         if entry["status"] == "yet_to_bat":
1727:             if len(active) >= 2 and name not in active:
1728:                 wk = int(self._inn.get("wickets") or 0)
1729:                 try:
1730:                     ov_f = float(self._inn.get("overs") or "0")
1731:                 except (ValueError, TypeError):
1732:                     ov_f = 0.0
1733:                 if wk == 0 and ov_f < 2.0:
1734:                     replaced = False
1735:                     for a in active:
1736:                         ae = self.batting_card[a]
1737:                         if (ae.get("runs") or 0) == 0 and \
1738:                                 (ae.get("balls") or 0) <= 1:
1739:                             ae["status"] = "yet_to_bat"
1740:                             ae["runs"] = None
1741:                             ae["balls"] = None
1742:                             self._tracker.force_set(f"bat:{a}:runs", None)
1743:                             self._tracker.force_set(f"bat:{a}:balls", None)
1744:                             log.warn(f"Deactivated {a} (0(0) at 0 wkt "
1745:                                      f"— likely wrong initial activation)")
1746:                             replaced = True
1747:                             break
1748:                     if not replaced:
1749:                         log.warn(f"Batter '{name}' rejected — 2 active "
1750:                                  f"with stats: {active}")
1751:                         return False
1752:                 elif wk > 0 and self._extractor_batter_names:
1753:                     dismissed = self._auto_dismiss_for_new_batter(
1754:                         active, name)
1755:                     if not dismissed:
1756:                         log.warn(f"Batter '{name}' rejected — 2 batters "
1757:                                  f"already active: {active}")
1758:                         return False
1759:                     admitted_from_live_pair = True
1760:                 else:
1761:                     log.warn(f"Batter '{name}' rejected — 2 batters "
1762:                              f"already active: {active}")
1763:                     return False
1764:             elif len(active) >= 1 and int(self._inn.get("wickets") or 0) > 0:
1765:                 admitted_from_live_pair = True
1766:             entry["status"] = "batting"
1767:             entry["runs"] = 0
1768:             entry["balls"] = 0
1769:             if admitted_from_live_pair:
1770:                 self._fresh_batter_admission[name] = {
1771:                     "frame": frame,
1772:                     "team_balls": self._team_balls_seen(),
1773:                 }
1774:             log.info(f"Batter activated: {name}")
1775: 
1776:         old_str = f"{entry['runs']}({entry['balls']})"
1777: 
1778:         if runs is not None or balls is not None:
1779:             try:
1780:                 new_r = int(runs) if runs is not None else None
1781:                 new_b = int(balls) if balls is not None else None
1782:             except (ValueError, TypeError):
1783:                 new_r, new_b = None, None
1784:             cur_r = entry.get("runs")
1785:             cur_b = entry.get("balls")
1786:             fresh_meta = self._fresh_batter_admission.get(name)
1787:             if (fresh_meta and new_b is not None
1788:                     and (cur_b is None or int(cur_b) <= 2)):
1789:                 admitted_at = fresh_meta.get("team_balls")
1790:                 now_balls = self._team_balls_seen()
1791:                 try:
1792:                     balls_since_admit = max(
1793:                         0, int(now_balls) - int(admitted_at))
1794:                 except (TypeError, ValueError):
1795:                     balls_since_admit = 0
1796:                 max_fresh_balls = max(3, balls_since_admit + 3)
1797:                 if int(new_b) > max_fresh_balls:
1798:                     log.warn(
1799:                         f"[NEW-BATTER-BALLS-GATE] {name}: proposed "
1800:                         f"{new_r}({new_b}) exceeds fresh-admission "
1801:                         f"ceiling {max_fresh_balls} balls "
1802:                         f"(since_admit={balls_since_admit}); "
1803:                         f"dropping row")
1804:                     new_r = None
1805:                     new_b = None
1806:                     self._last_row_rejected_frame = frame
1807:             elif fresh_meta and new_b is not None and int(new_b) > 2:
1808:                 self._fresh_batter_admission.pop(name, None)
1809:             # CLONE GUARD: if the proposed (runs, balls) tuple exactly
1810:             # matches the OTHER active batter's current stats, reject
1811:             # the update. This is almost always the LLM reading the
1812:             # wrong row of the strip and copying batter A's line into
1813:             # batter B's slot. Allowing it produces the symptom where
1814:             # both batters show identical stats (e.g. both 12(8)) which
1815:             # is impossible unless they really did face the same number
1816:             # of balls AND scored the same — extraordinarily rare and
1817:             # the broadcast will re-confirm on subsequent frames.
1818:             #
1819:             # We DO allow the clone if either:
1820:             #   - the new tuple is (0, 0) — fresh activation, common.
1821:             #   - the new tuple matches what THIS entry already has —
1822:             #     idempotent re-write, no harm.
1823:             # Otherwise defer until the broadcast strip confirms.
1824:             if (new_r is not None and new_b is not None
1825:                     and not (new_r == 0 and new_b == 0)
1826:                     and not (cur_r == new_r and cur_b == new_b)):
1827:                 _other_match = None
1828:                 for _other_name, _other_entry in self.batting_card.items():
1829:                     if _other_name == name:
1830:                         continue
1831:                     if _other_entry.get("status") != "batting":
1832:                         continue
1833:                     _o_r = _other_entry.get("runs")
1834:                     _o_b = _other_entry.get("balls")
1835:                     if (_o_r is not None and _o_b is not None
1836:                             and int(_o_r) == new_r
1837:                             and int(_o_b) == new_b
1838:                             and not (int(_o_r) == 0 and int(_o_b) == 0)):
1839:                         _other_match = _other_name
1840:                         break
1841:                 if _other_match is not None:
1842:                     log.warn(
1843:                         f"[CLONE-REJECT] {name}: proposed "
1844:                         f"{new_r}({new_b}) is identical to "
1845:                         f"{_other_match}'s current line — likely a "
1846:                         f"misread row of the batting strip. Keeping "
1847:                         f"existing {cur_r}({cur_b}); awaiting "
1848:                         f"broadcast re-confirmation.")
1849:                     new_r = None
1850:                     new_b = None
1851:                     self._last_row_rejected_frame = frame
1852:             # === Runs-monotonic guard (detection layer) ===
1853:             # Two clauses below detect runs regressions that almost
1854:             # always indicate row-misread phantoms.  Both null both
1855:             # fields (whole-row invalidation).  The Layer 4 release
1856:             # block right after captures consecutive rejections of
1857:             # the same value so a real truth-lock-in window can be
1858:             # broken via consensus.  See `__init__` doc on
1859:             # `_runs_reject_streak`.
1860:             _runs_regression_rejected = False
1861:             _runs_regression_value: int | None = None
1862:             _runs_regression_balls: int | None = None
1863:             if (new_r is not None and new_r == 0
1864:                     and cur_r is not None and int(cur_r) > 5):
1865:                 _runs_regression_rejected = True
1866:                 _runs_regression_value = 0
1867:                 _runs_regression_balls = (
1868:                     int(new_b) if new_b is not None else None)
1869:                 log.warn(f"Batter '{name}' runs regression "
1870:                          f"{cur_r}→0 rejected — dropping balls "
1871:                          f"{new_b} too (whole-row invalidation)")
1872:                 new_r = None
1873:                 new_b = None
1874:                 self._last_row_rejected_frame = frame
1875:             elif (new_r is not None and cur_r is not None
1876:                     and int(cur_r) - int(new_r) > 5):
1877:                 _runs_regression_rejected = True
1878:                 _runs_regression_value = int(new_r)
1879:                 _runs_regression_balls = (
1880:                     int(new_b) if new_b is not None else None)
1881:                 log.warn(f"Batter '{name}' runs regression "
1882:                          f"{cur_r}→{new_r} (-{int(cur_r) - int(new_r)}) "
1883:                          f"rejected — dropping balls {new_b} too "
1884:                          f"(whole-row invalidation)")
1885:                 new_r = None
1886:                 new_b = None
1887:                 self._last_row_rejected_frame = frame
1888: 
1889:             # === Layer 4 (Fix 12, 2026-04-26): rejection-consensus
1890:             # release on the runs-monotonic guard. ===
1891:             #
1892:             # Mirrors POISON-STREAK at `test_pipeline.py:6246`.  When
1893:             # the same proposed runs value is rejected
1894:             # `_RUNS_REJECT_RELEASE_N` times consecutively for this
1895:             # batter, the held `cur_r` is almost certainly a stale
1896:             # phantom (the truth-stream has been knocking on the door
1897:             # without being let in).  Release: force-set the tracker
1898:             # baseline to the rejected value so the legitimate stream
1899:             # can commit; balls counterpart force-set too if it was
1900:             # present in the rejected row.  Streak is per-batter and
1901:             # field-specific to runs (balls has its own guard).
1902:             #
1903:             # Reset semantics:
1904:             #   * different rejected value → restart counter at 1
1905:             #     (the held lock-in target is no longer constant)
1906:             #   * legitimate acceptance (no rejection this frame for
1907:             #     this batter) → drop the entry entirely (the
1908:             #     phantom window has closed naturally)
1909:             #
1910:             # Idempotent: post-release the streak is reset, so the
1911:             # next rejection (if any) starts a fresh count.  No
1912:             # double-release.
1913:             if _runs_regression_rejected:
1914:                 _streak = self._runs_reject_streak.setdefault(
1915:                     name, {"value": None, "count": 0})
1916:                 if _streak["value"] == _runs_regression_value:
1917:                     _streak["count"] += 1
1918:                 else:
1919:                     _streak["value"] = _runs_regression_value
1920:                     _streak["count"] = 1
1921:                 log.info(
1922:                     f"  [RUNS-REJECT-STREAK] {name}="
1923:                     f"{_runs_regression_value} streak="
1924:                     f"{_streak['count']}/"
1925:                     f"{self._RUNS_REJECT_RELEASE_N} "
1926:                     f"(cur={cur_r} held)")
1927:                 if _streak["count"] >= self._RUNS_REJECT_RELEASE_N:
1928:                     log.warn(
1929:                         f"  [RUNS-REJECT-RELEASE] {name}: "
1930:                         f"{_streak['count']} consecutive "
1931:                         f"rejections of runs="
1932:                         f"{_runs_regression_value} "
1933:                         f"(cur={cur_r}) — accepting as new "
1934:                         f"truth (current value is stale "
1935:                         f"phantom). force_set bat:{name}:runs"
1936:                         f"{', balls' if _runs_regression_balls is not None else ''}.")
1937:                     try:
1938:                         self._tracker.force_set(
1939:                             f"bat:{name}:runs",
1940:                             _runs_regression_value)
1941:                         entry["runs"] = _runs_regression_value
1942:                         if _runs_regression_balls is not None:
1943:                             self._tracker.force_set(
1944:                                 f"bat:{name}:balls",
1945:                                 _runs_regression_balls)
1946:                             entry["balls"] = _runs_regression_balls
1947:                     except Exception as _e:  # noqa: BLE001
1948:                         log.debug(
1949:                             f"  [RUNS-REJECT-RELEASE] "
1950:                             f"force_set swallowed: {_e}")
1951:                     _streak["value"] = None
1952:                     _streak["count"] = 0
1953:                     # Truth row was right after all — clear the
1954:                     # row-rejected flag so downstream broadcast-
1955:                     # indicator striker updates aren't suppressed
1956:                     # on this frame for the wrong reason.
1957:                     self._last_row_rejected_frame = -1
1958:             elif new_r is not None:
1959:                 # Legitimate runs observation for this batter on
1960:                 # this frame — phantom window closed, drop the
1961:                 # streak entry so a future unrelated rejection
1962:                 # starts a clean counter.
1963:                 self._runs_reject_streak.pop(name, None)
1964:             # Reject balls decreasing — but tolerate a small (-2)
1965:             # broadcast correction. The pipeline routinely over-counts
1966:             # balls by 1-2 because an inferred event lands a frame
1967:             # before the broadcast strip updates, OR the LLM occasionally
