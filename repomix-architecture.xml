2216: def enforce_ws_slot_invariant(state: dict,
2217:                               scoreboard,
2218:                               canon_fn) -> bool:
2219:     """Ensure WS striker/non_striker never name the same active player."""
2220:     striker = state.get("striker")
2221:     non_striker = state.get("non_striker")
2222:     if not striker or not non_striker or striker != non_striker:
2223:         return False
2224:     bc = getattr(scoreboard, "batting_card", None) or {}
2225:     active = [name for name, card in bc.items()
2226:               if card and card.get("status") == "batting"]
2227:     duplicate = striker
2228:     alternate = next((name for name in active if name != duplicate), None)
2229:     if alternate:
2230:         state["non_striker"] = canon_fn(alternate)
2231:         log.warn(
2232:             f"  [WS-SLOT-INVARIANT] duplicate slots {duplicate!r}; "
2233:             f"rebuilt non_striker={alternate!r} from active card")
2234:     else:
2235:         state["non_striker"] = None
2236:         log.warn(
2237:             f"  [WS-SLOT-INVARIANT] duplicate slots {duplicate!r}; "
2238:             f"cleared non_striker (no alternate active batter)")
2239:     return True
