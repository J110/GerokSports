2551: def apply_scorer_decision(scoreboard, decision, frame, jump_guard,
2552:                           batting_team=None, extracted=None,
2553:                           frame_type: str | None = None,
2554:                           score_mgr=None):
2555:     changes = []
2556: 
2557:     # GRAPHIC frames (career/comparison overlays) regularly leak
2558:     # career-stat numbers into the scorer's batter/bowler updates
2559:     # ("Klaasen 44(18) v Noor in T20s" — those are vs-bowler career
2560:     # numbers, not the live match). Hard-strip any
2561:     # batter/bowler/score updates from a GRAPHIC frame; only innings-
2562:     # change signals are allowed through.
2563:     if frame_type == "GRAPHIC":
2564:         for k in ("batter_updates", "bowler_update", "bowlers",
2565:                   "score_update", "extras_update"):
2566:             decision.pop(k, None)
2567: 
2568:     if decision.get("innings_change"):
2569:         old_score = scoreboard._inn.get("score") or 0
2570:         score_up = decision.get("score_update", {})
2571:         new_score = score_up.get("to") if isinstance(score_up, dict) else None
2572:         if new_score is not None and int(new_score) >= int(old_score):
2573:             log.info(f"  [GUARD] Innings change rejected — score increased "
2574:                      f"({old_score} → {new_score})")
2575:             decision["innings_change"] = False
2576:         else:
2577:             log.info(f"  [SCORER] Innings change signalled — "
2578:                      f"deferring to target detection logic")
2579:             changes.append("INNINGS CHANGE (deferred)")
2580:             return changes
2581: 
2582:     if not batting_team:
2583:         log.info("  No batting team set — skipping all updates")
2584:         return changes
2585: 
2586:     batter_ups = decision.get("batter_updates", {})
