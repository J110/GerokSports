3235:         regression — see backlog P0 "SCORER doesn't enforce active-
3236:         batter invariants").
3237:         """
3238:         for f in self.fall_of_wickets:
3239:             if (f.get("batter") == name
3240:                     and f.get("_witnessed")
3241:                     and not f.get("_unwitnessed")):
3242:                 return True
