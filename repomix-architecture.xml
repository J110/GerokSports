3731:     def get_cache_dict(self, frame: int) -> dict:
3732:         """Serialise essential state for on-disk caching."""
3733:         return {
3734:             "score": self._inn.get("score"),
3735:             "wickets": self._inn.get("wickets"),
3736:             "overs": self._inn.get("overs"),
3737:             "run_rate": self._inn.get("run_rate"),
3738:             "target": self._inn.get("target"),
3739:             "batting_team": self.batting_team,
3740:             "bowling_team": self.bowling_team,
3741:             "innings": self.current_innings,
3742:             "striker": self._inn.get("striker"),
3743:             "non_striker": self._inn.get("non_striker"),
3744:             "current_bowler": self._inn.get("current_bowler"),
3745:             "batting_card": {
3746:                 k: {kk: vv for kk, vv in v.items()}
3747:                 for k, v in self.batting_card.items()
3748:                 if v.get("status") in ("batting", "out")
3749:             },
3750:             "bowling_card": {
3751:                 k: {kk: vv for kk, vv in v.items()}
3752:                 for k, v in self.bowling_card.items()
3753:                 if v.get("overs") and float(v.get("overs", "0") or "0") > 0
3754:             },
3755:             "fall_of_wickets": self.fall_of_wickets[:],
3756:             "over_history": {str(k): v for k, v in self.over_history.items()},
3757:             "frame": frame,
3758:             "saved_at": time.time(),
3759:         }
