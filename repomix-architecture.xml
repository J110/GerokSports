2033:                              if total_balls > 0 else 0)
2034: 
2035:         if self.target and self.score is not None and self.overs:
2036:             balls_left = 120 - (int(self.overs) * 6
2037:                                 + round((self.overs % 1) * 10))
2038:             self.balls_remaining = max(balls_left, 0)
2039:             runs_left = self.target - self.score
2040:             self.required_run_rate = (
2041:                 round(runs_left / balls_left * 6, 2) if balls_left > 0
2042:                 else 999)
2043: 
2044:         if self.overs is not None:
2045:             o = int(self.overs)
2046:             if o < 6:
2047:                 self.match_phase = "powerplay"
2048:             elif o < 15:
2049:                 self.match_phase = "middle"
2050:             else:
2051:                 self.match_phase = "death"
