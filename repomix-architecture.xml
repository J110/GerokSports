1065: def _validate_overs(ext_overs: float | None,
1066:                     broadcast_this_over: list[str] | None,
1067:                     confirmed_overs: float | None = None) -> float | None:
1068:     """Cross-validate extractor overs against this-over token count.
1069: 
1070:     The this_over display (e.g. ['.', '4', '1']) provides an independent
1071:     ball count.  When the extractor misreads decimals (0.1 → 1.0), the
1072:     token count catches it.
1073: 
1074:     Three correction patterns we handle:
1075: 
1076:     1.  ``ball_from_overs == ball_from_tokens`` — extractor agrees with
1077:         the strip; pass through.
1078: 
1079:     2.  ``ext_overs`` is at a whole boundary (X.0) but tokens > 0 —
1080:         we just rolled into a new over but Scout briefly reads the
1081:         previous over's circles. Correct to (X-1).N (the closing balls
1082:         of the previous over).
1083: 
1084:     3.  Digit-swap. Extractor reads ``N.0`` (or any value whose
1085:         integer part >> the previous confirmed integer part) but the
1086:         token count says we're only N balls into an over. The truth
1087:         is ``(prev_int).N`` — i.e. the digits got swapped (0.3 → 3.0).
1088:         Detected when ``int(ext_overs)`` is significantly ahead of
1089:         ``confirmed_overs``'s integer part. Without ``confirmed_overs``
1090:         we cannot distinguish digit-swap from a legitimate over jump
1091:         and fall back to the (X-1).N rule.
1092:     """
1093:     if ext_overs is None or broadcast_this_over is None:
1094:         return ext_overs
1095:     if len(broadcast_this_over) == 0:
1096:         return ext_overs
1097: 
1098:     ball_from_overs = round((ext_overs % 1) * 10)
1099:     ball_from_tokens = len(broadcast_this_over)
1100: 
1101:     if ball_from_tokens > 6:
1102:         # Defence against multi-over recap strips leaking through. We
1103:         # cannot trust this_over's count to validate overs if Scout
1104:         # gave us the 18-token last-3-overs ribbon.
1105:         return ext_overs
1106: 
1107:     if ball_from_overs == ball_from_tokens:
1108:         return ext_overs
1109: 
1110:     ext_int = int(ext_overs)
1111: 
1112:     # Digit-swap detection. If we have a prior confirmed overs reading,
1113:     # an extractor jump from (prev_int).x to (much bigger int).0 with a
1114:     # token count matching the SMALL value is almost certainly a digit
1115:     # swap. Example: prev=0.2, ext=3.0, tokens=3 → real value is 0.3.
1116:     if (confirmed_overs is not None
1117:             and ball_from_overs == 0
1118:             and ball_from_tokens > 0):
1119:         conf_int = int(confirmed_overs)
1120:         if ext_int > conf_int + 1:
1121:             corrected = float(f"{conf_int}.{ball_from_tokens}")
1122:             log.info(
1123:                 f"  [OVERS FIX] digit-swap: extractor={ext_overs} "
1124:                 f"vs confirmed={confirmed_overs} + "
1125:                 f"this_over_tokens={ball_from_tokens} → {corrected}")
1126:             return corrected
1127: 
1128:     if ball_from_overs == 0 and ball_from_tokens > 0:
1129:         corrected = float(f"{max(0, ext_int - 1)}.{ball_from_tokens}")
1130:     else:
1131:         corrected = float(f"{ext_int}.{ball_from_tokens}")
1132: 
1133:     # Guard against regressing below confirmed overs.  A poisoned scout
1134:     # frame can produce stale / misparsed this_over tokens (e.g. reading
1135:     # "w w w 4 6" from a replay graphic) whose count contradicts the
1136:     # confirmed extractor overs.  Applying the "X-1.N" correction in that
1137:     # case pushes ext_overs BACKWARDS past the true live overs — which in
1138:     # turn trips ScoreManager's overs-regression guard and sends it into
1139:     # COLD_START, losing any real ball events that arrive during the
1140:     # 3-frame re-warmup.  This was the root cause of the live LSG-vs-RR
1141:     # F121→F122 failure where the SIX at 9.1 never reached the UI's
1142:     # this_over (diverged from over_mgr's correctly-observed sequence).
1143:     # If our "correction" would roll overs backward past a value we've
1144:     # already confirmed, trust the confirmed value and skip the fix.
1145:     if confirmed_overs is not None and corrected < confirmed_overs:
1146:         log.info(
1147:             f"  [OVERS FIX] SKIP regression: computed={corrected} "
1148:             f"< confirmed={confirmed_overs} (tokens={ball_from_tokens} "
1149:             f"likely stale/poisoned) — keeping ext_overs={ext_overs}")
1150:         return ext_overs
1151: 
1152:     log.info(f"  [OVERS FIX] extractor={ext_overs} "
1153:              f"this_over_tokens={ball_from_tokens} → {corrected}")
1154:     return corrected
