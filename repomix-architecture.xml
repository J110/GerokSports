  23: class LiveMatchTracker:
  24:     """Physics-based bounding for live cricket match data.
  25: 
  26:     Between consecutive frames in a live broadcast:
  27:     - Max 1 ball per ~15s, pipeline captures every ~4s
  28:     - Max 7 runs per ball (6 + no-ball)
  29:     - Max 1 wicket per ball
  30:     - Overs advance by at most 0.1 per ball
  31: 
  32:     After ad breaks (missed frames), allow slightly larger jumps.
  33:     """
  34: 
  35:     WARMUP_FRAMES = 5  # first N scoreboard frames: allow large corrections
  36: 
  37:     def __init__(self):
  38:         self.score: int | None = None
  39:         self.wickets: int | None = None
  40:         self.overs_balls: int | None = None  # stored as total balls
  41:         self.frames_since_scoreboard: int = 0
  42:         self._active_mmb: int = 1
  43:         self._scoreboard_count: int = 0
  44:         self.batters: dict[str, dict] = {}   # name -> {runs, balls}
  45:         self.bowlers: dict[str, dict] = {}   # name -> {runs, wickets, overs_balls}
  46: 
  47:     def _max_missed_balls(self) -> int:
  48:         """Return cached mmb for the current scoreboard frame's update window."""
  49:         return self._active_mmb
  50: 
  51:     def on_non_scoreboard_frame(self):
  52:         self.frames_since_scoreboard += 1
  53: 
  54:     def on_scoreboard_frame(self):
  55:         self._scoreboard_count += 1
  56:         if self._scoreboard_count <= self.WARMUP_FRAMES:
  57:             self._active_mmb = 120  # accept anything during warmup
  58:         else:
  59:             self._active_mmb = max(1, self.frames_since_scoreboard // 3)
  60:         self.frames_since_scoreboard = 0
  61:         return self._active_mmb
  62: 
  63:     def update_score(self, new_score: int | None) -> int | None:
  64:         if new_score is None:
  65:             return self.score
  66:         if self.score is None:
  67:             self.score = new_score
  68:             return new_score
  69:         mmb = self._max_missed_balls()
  70:         delta = new_score - self.score
  71:         max_jump = 7 * mmb
  72:         if delta < 0:
  73:             return self.score  # reject decrease
  74:         if delta > max_jump:
  75:             return self.score  # reject contamination
  76:         self.score = new_score
  77:         return new_score
