3250: def _archive_old_debug_frames(
3251:     src_dir: str = DEBUG_FRAMES_DIR,
3252:     archive_root: str = DEBUG_FRAMES_ARCHIVE_DIR,
3253:     *,
3254:     keep_last_n: int = DEBUG_FRAMES_ARCHIVE_KEEP,
3255:     session_id: str | None = None,
3256: ) -> int:
3257:     """Move existing `*.jpg` frames from ``src_dir`` into a dated subdir
3258:     under ``archive_root`` and enforce a retention cap on the archive.
3259: 
3260:     Returns the number of frames archived (0 if the source dir does not
3261:     exist or is empty).  No-ops on a fresh start where the live
3262:     capture dir is empty — there is nothing to preserve and we don't
3263:     leave behind empty session dirs.
3264: 
3265:     The session subdir is named ``YYYY-MM-DD_HHMMSS`` so dirs sort
3266:     chronologically; ``_enforce_retention_policy`` removes the oldest
3267:     sessions beyond ``keep_last_n``.
3268: 
3269:     Used as a drop-in replacement for the prior
3270:     ``glob('debug_frames/*.jpg') + os.remove`` cleanup at the top of
3271:     ``run_test()``.  Tests inject ``src_dir`` / ``archive_root`` /
3272:     ``session_id`` to make the behaviour deterministic.
3273:     """
3274:     import glob as _glob
3275:     import shutil as _shutil
3276:     from datetime import datetime as _dt
3277: 
3278:     if not os.path.isdir(src_dir):
3279:         return 0
3280:     existing = sorted(_glob.glob(os.path.join(src_dir, "*.jpg")))
3281:     if not existing:
3282:         return 0
3283: 
3284:     sid = session_id or _dt.now().strftime("%Y-%m-%d_%H%M%S")
3285:     dest = os.path.join(archive_root, sid)
3286:     os.makedirs(dest, exist_ok=True)
3287: 
3288:     moved = 0
3289:     for path in existing:
3290:         try:
3291:             _shutil.move(path, dest)
3292:             moved += 1
3293:         except Exception as e:
3294:             log.warning(
3295:                 f"[CLEANUP] Failed to archive {path} -> {dest}: {e}; "
3296:                 f"removing instead"
3297:             )
3298:             try:
3299:                 os.remove(path)
3300:             except Exception:
3301:                 pass
3302: 
3303:     log.info(
3304:         f"[CLEANUP] Archived {moved} frames to {dest} "
3305:         f"(was {len(existing)} in {src_dir})"
3306:     )
3307:     _enforce_archive_retention(archive_root, keep_last_n=keep_last_n)
3308:     return moved
3309: 
3310: 
3311: def _enforce_archive_retention(
3312:     archive_root: str = DEBUG_FRAMES_ARCHIVE_DIR,
3313:     *,
3314:     keep_last_n: int = DEBUG_FRAMES_ARCHIVE_KEEP,
3315: ) -> int:
3316:     """Delete the oldest session subdirs in ``archive_root`` until at
3317:     most ``keep_last_n`` remain.  Returns the number of session dirs
3318:     removed.  Subdirs are sorted lexicographically (which matches
3319:     chronological order given the ``YYYY-MM-DD_HHMMSS`` session-id
3320:     format), so the oldest are always at the front of the list.
3321: 
3322:     Non-directory entries are ignored.  Errors during removal are
3323:     logged but don't propagate — a transient FS hiccup shouldn't
3324:     crash pipeline startup.
3325:     """
3326:     import shutil as _shutil
3327: 
3328:     if not os.path.isdir(archive_root):
3329:         return 0
3330:     entries = sorted(
3331:         e for e in os.listdir(archive_root)
3332:         if os.path.isdir(os.path.join(archive_root, e))
3333:     )
3334:     removed = 0
3335:     while len(entries) > keep_last_n:
3336:         oldest = entries.pop(0)
3337:         target = os.path.join(archive_root, oldest)
3338:         try:
3339:             _shutil.rmtree(target)
3340:             removed += 1
3341:             log.info(f"[CLEANUP] Removed old archive: {target}")
3342:         except Exception as e:
3343:             log.warning(f"[CLEANUP] Failed to prune {target}: {e}")
3344:     return removed
