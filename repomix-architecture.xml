 208:         # COLD_START so real ball events on the NEXT frame don't get lost
 209:         # to a phantom cold-start window.  Tracks (best_seen, streak).
 210:         self._overs_regress_streak: int = 0
 211:         self._overs_regress_from: float | None = None
 212:         self._OVERS_REGRESS_THRESHOLD: int = 2
 213: 
 214:         # Innings history (for archiving at innings change)
 215:         self.innings_history: list[dict] = []
 216: 
 217:     # ------------------------------------------------------------------
 218:     # Public API
 219:     # ------------------------------------------------------------------
 220: 
 221:     def on_frame(self, frame: FrameInput) -> dict | None:
 222:         """Called every frame. Returns UI payload dict or None."""
 223:         self.recent_frames.append(frame)
 224:         if len(self.recent_frames) > 5:
 225:             self.recent_frames.pop(0)
 226: 
 227:         if frame.drs_state == "IN_PROGRESS":
 228:             return None
 229: 
 230:         card = self._build_scorecard(frame)
 231:         if card is None:
 232:             self.frames_since_event += 1
 233:             resolved = self._try_resolve_pending(frame)
 234:             if resolved:
 235:                 return self._build_payload(resolved)
 236:             return None
 237: 
 238:         if not self._is_valid(card):
 239:             return None
 240: 
 241:         if self.mode == "COLD_START":
 242:             return self._handle_cold_start(card, frame)
 243:         else:
 244:             return self._handle_warm(card, frame)
 245: 
 246:     def stop(self):
 247:         self.__init__(shadow=self.shadow)
 248: 
 249:     def start(self):
 250:         self.__init__(shadow=self.shadow)
