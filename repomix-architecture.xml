 252:     # ------------------------------------------------------------------
 253:     # Build scorecard from frame data
 254:     # ------------------------------------------------------------------
 255: 
 256:     def _build_scorecard(self, frame: FrameInput) -> dict | None:
 257:         card: dict[str, Any] = {}
 258: 
 259:         if frame.ext_score is not None:
 260:             card["score"] = frame.ext_score
 261:         if frame.ext_wickets is not None:
 262:             card["wickets"] = frame.ext_wickets
 263:         if frame.ext_overs is not None:
 264:             card["overs"] = frame.ext_overs
 265: 
 266:         # Fallback: parse scorer changes
 267:         if "score" not in card:
 268:             for c in frame.scorer_changes:
 269:                 if c.startswith("score→"):
 270:                     try:
 271:                         card["score"] = int(c.split("→")[1].split("(")[0])
 272:                     except (ValueError, IndexError):
 273:                         pass
 274:         if "wickets" not in card:
 275:             for c in frame.scorer_changes:
 276:                 if c.startswith("wickets→"):
 277:                     try:
 278:                         card["wickets"] = int(c.split("→")[1])
 279:                     except (ValueError, IndexError):
 280:                         pass
 281:         if "overs" not in card:
 282:             for c in frame.scorer_changes:
 283:                 if c.startswith("overs→"):
 284:                     try:
 285:                         card["overs"] = float(c.split("→")[1])
 286:                     except (ValueError, IndexError):
 287:                         pass
 288: 
 289:         if "score" not in card:
 290:             return None
 291: 
 292:         # Batters
 293:         card["bat1_name"] = frame.ext_bat1_name
 294:         card["bat1_runs"] = frame.ext_bat1_runs
 295:         card["bat1_balls"] = frame.ext_bat1_balls
 296:         card["bat2_name"] = frame.ext_bat2_name
 297:         card["bat2_runs"] = frame.ext_bat2_runs
 298:         card["bat2_balls"] = frame.ext_bat2_balls
 299: 
 300:         # Scorer may have resolved full names
 301:         for c in frame.scorer_changes:
 302:             if c.startswith("bat:"):
 303:                 name_stats = c[4:]
 304:                 eq = name_stats.find("=")
 305:                 if eq > 0:
 306:                     full_name = name_stats[:eq]
 307:                     if (card["bat1_name"]
 308:                             and card["bat1_name"].lower() in full_name.lower()):
 309:                         card["bat1_name"] = full_name
 310:                     elif (card["bat2_name"]
 311:                             and card["bat2_name"].lower() in full_name.lower()):
 312:                         card["bat2_name"] = full_name
 313: 
 314:         # Bowler
 315:         card["bowler_name"] = frame.ext_bowler_name
 316:         card["bowler_wickets"] = frame.ext_bowler_wickets
 317:         card["bowler_runs"] = frame.ext_bowler_runs
 318:         card["bowler_overs"] = frame.ext_bowler_overs
 319: 
 320:         for c in frame.scorer_changes:
 321:             if c.startswith("bowl:"):
 322:                 full_name = c[5:]
 323:                 if (card["bowler_name"]
 324:                         and card["bowler_name"].lower() in full_name.lower()):
 325:                     card["bowler_name"] = full_name
 326: 
 327:         # Broadcast supplements
 328:         card["speed_kph"] = frame.speed_kph
 329:         card["broadcast_extra"] = frame.broadcast_extra
 330:         card["broadcast_striker"] = frame.broadcast_striker
 331:         card["broadcast_this_over"] = frame.broadcast_this_over
 332:         card["action_text"] = frame.action_text
 333: 
 334:         # === Canonicalize all names at the single entry point ===
 335:         # Issue 1 fix (2026-04-21): SM previously stored whatever raw
 336:         # scout surname the extractor emitted ("N RANA", "Rahul"), then
 337:         # downstream code compared these against canonical batting_card
 338:         # keys ("Nitish Rana", "KL Rahul") and always missed — producing
 339:         # a UI where no batter is ever marked as the striker.  Normalize
 340:         # here so self.bat1_name, self.striker etc. carry canonical
 341:         # squad keys throughout.  If the scoreboard can't resolve a
 342:         # name we keep the raw value (SM's consensus/validation layers
 343:         # need something to key on) but the downstream output boundary
 344:         # layer in build_full_payload does a second canonicalize pass
 345:         # as defense in depth.
 346:         for _k in ("bat1_name", "bat2_name", "bowler_name",
 347:                    "broadcast_striker"):
 348:             _raw = card.get(_k)
 349:             if _raw:
 350:                 _canon = self._canonicalize_name(_raw, _k)
 351:                 if _canon:
 352:                     card[_k] = _canon
 353: 
 354:         return card
 355: 
 356:     def _make_fow_placeholder(self, wicket_number: int) -> dict:
 357:         """Create an FOW placeholder entry in the canonical shape.
 358: 
 359:         Issue 4 fix (2026-04-21): SM's three placeholder sites used a
 360:         minimal `{"score": "?", "overs": "?"}` shape that diverged from
 361:         Scoreboard's `{batter: None, _unwitnessed: True, ...}`.  The UI
 362:         rendered SM placeholders as confirmed wickets with garbage
 363:         values.  Delegate to the Scoreboard factory when available so
 364:         both pipelines produce identical placeholder rows.
 365:         """
 366:         if self.scoreboard is not None:
 367:             try:
 368:                 return self.scoreboard.make_fow_placeholder(wicket_number)
 369:             except Exception:
 370:                 pass
 371:         return {
 372:             "wicket": int(wicket_number),
 373:             "batter": None,
 374:             "score": None,
 375:             "overs": None,
 376:             "bowler": None,
 377:             "_unwitnessed": True,
 378:         }
 379: 
 380:     def _canonicalize_name(self, raw: str | None,
 381:                            slot: str = "") -> str | None:
 382:         """Resolve a raw scout name to its canonical squad key.
 383: 
 384:         Returns canonical name when resolvable, None when not (so the
 385:         caller can decide whether to fall back to raw or drop the
 386:         update).  Deliberately conservative: only returns a canonical
 387:         name when both resolve_name() and _find_card_key() succeed,
 388:         matched against the appropriate card (batting for bat/striker
 389:         slots, bowling for bowler slot).
 390:         """
 391:         if not raw or not self.scoreboard:
 392:             return None
 393:         try:
 394:             resolved = self.scoreboard.resolve_name(raw)
 395:             if not resolved:
 396:                 return None
 397:             card_dict = (
 398:                 self.scoreboard.bowling_card
 399:                 if slot.startswith("bowler")
 400:                 else self.scoreboard.batting_card
 401:             )
 402:             if not card_dict:
 403:                 return None
 404:             key = self.scoreboard._find_card_key(resolved, card_dict)
 405:             return key
 406:         except Exception:
 407:             return None
 408: 
 409:     # ------------------------------------------------------------------
 410:     # Validation
 411:     # ------------------------------------------------------------------
 412: 
 413:     def _is_valid(self, card: dict) -> bool:
 414:         s = card.get("score")
 415:         w = card.get("wickets")
 416:         o = card.get("overs")
 417: 
 418:         if s is not None and s < 0:
 419:             return False
 420:         if w is not None and (w < 0 or w > 10):
 421:             return False
 422: 
 423:         if o is not None:
 424:             ball = round((o % 1) * 10)
 425:             if ball > 5:
 426:                 return False
 427:             if o > 20.0:
 428:                 return False
 429: 
 430:         # Reject stale 0-0(0.0) when match is already running
 431:         if (s == 0 and w == 0 and o is not None and o == 0.0
 432:                 and self.overs is not None and self.overs > 1.0):
 433:             return False
 434: 
 435:         # Batter runs can't exceed team score
 436:         for key in ("bat1_runs", "bat2_runs"):
 437:             r = card.get(key)
 438:             if r is not None and s is not None and r > s:
 439:                 return False
 440: 
 441:         return True
 442: 
 443:     # ------------------------------------------------------------------
 444:     # Cold start
 445:     # ------------------------------------------------------------------
 446: 
 447:     def _handle_cold_start(self, card: dict, frame: FrameInput) -> dict | None:
 448:         self.cold_frames += 1
 449: 
 450:         # Cold-start requires the minimum viable scorecard (score, wickets,
 451:         # overs all present). Without this guard, a frame that only reads
 452:         # the score field would seed `cold_candidate` with overs=None, and
 453:         # 3 such matching frames would trigger COLD_START → WARM with
 454:         # overs=None — which then crashes `_apply_event` at the first
 455:         # `int(card["overs"])` call. We do NOT reset the existing
 456:         # candidate streak on an incomplete read; we just skip this frame
 457:         # so the next more-complete frame can extend (or flip) the
 458:         # candidate normally.
 459:         if (card.get("score") is None
 460:                 or card.get("wickets") is None
 461:                 or card.get("overs") is None):
 462:             return None
 463: 
 464:         if self._false_zero_cold_start(card, frame):
 465:             self.cold_candidate = None
 466:             self.cold_candidate_streak = 0
 467:             log.info(
 468:                 f"[SM] cold-start zero candidate rejected as contextual "
 469:                 f"graphic: scout={frame.scout_text[:80]!r}")
 470:             return None
 471: 
 472:         if self.cold_candidate is None:
 473:             self.cold_candidate = card
 474:             self.cold_candidate_streak = 1
 475:             log.info(
 476:                 f"[SM] cold-start candidate seeded "
 477:                 f"{card.get('score')}/{card.get('wickets')} "
 478:                 f"({card.get('overs')}) — streak 1/"
 479:                 f"{self.COLD_START_CONSENSUS_FRAMES}")
 480:             return None
 481: 
 482:         consensus = (
 483:             self.cold_candidate.get("score") == card.get("score")
 484:             and self.cold_candidate.get("wickets") == card.get("wickets")
 485:             and abs((self.cold_candidate.get("overs") or 0)
 486:                     - (card.get("overs") or 0)) < 0.05
 487:         )
 488: 
 489:         if not consensus:
 490:             log.info(
 491:                 f"[SM] cold-start candidate flipped "
 492:                 f"{self.cold_candidate.get('score')}/"
 493:                 f"{self.cold_candidate.get('wickets')} "
 494:                 f"({self.cold_candidate.get('overs')}) → "
 495:                 f"{card.get('score')}/{card.get('wickets')} "
 496:                 f"({card.get('overs')}) — streak reset to 1/"
 497:                 f"{self.COLD_START_CONSENSUS_FRAMES}")
 498:             self.cold_candidate = card
 499:             self.cold_candidate_streak = 1
 500:             max_f = (COLD_MAX_FRAMES_WITH_REF if self._last_warm_state
 501:                      else COLD_MAX_FRAMES)
 502:             if self.cold_frames >= max_f:
 503:                 # Even on the give-up path, never adopt a card that
 504:                 # violates absolute / chase / overs ceilings.
 505:                 abs_check = validate_absolute(
 506:                     score=card.get("score"),
 507:                     wickets=card.get("wickets"),
 508:                     overs=card.get("overs"),
 509:                     target=self.target, innings=self.innings)
 510:                 if not abs_check.ok:
 511:                     log.info(f"[SM] cold-start give-up REJECT "
 512:                              f"({abs_check.reject_reason})")
 513:                     return None
 514:                 self._last_warm_state = None
 515:                 self._accept_initial(card, frame)
 516:                 self.mode = "WARM"
 517:                 log.info(f"[SM] COLD_START → WARM (max frames, ref cleared)  "
 518:                          f"{self.score}/{self.wickets} ({self.overs})")
 519:                 return self._build_payload()
 520:             return None
 521: 
 522:         # Bump streak — this frame agrees with the candidate.
 523:         self.cold_candidate_streak += 1
 524:         if self.cold_candidate_streak < self.COLD_START_CONSENSUS_FRAMES:
 525:             log.info(
 526:                 f"[SM] cold-start consensus building "
 527:                 f"{card.get('score')}/{card.get('wickets')} "
 528:                 f"({card.get('overs')}) — streak "
 529:                 f"{self.cold_candidate_streak}/"
 530:                 f"{self.COLD_START_CONSENSUS_FRAMES}")
 531:             return None
 532: 
 533:         if not self._cold_start_plausible(card):
 534:             self.cold_candidate = card
 535:             self.cold_candidate_streak = 1
 536:             if self.cold_frames >= COLD_MAX_FRAMES_WITH_REF:
 537:                 # Same escape-hatch absolute guard as above — refuse to
 538:                 # adopt a chase-impossible / >320 / >20-over card even
 539:                 # when the consensus mechanism has timed out.
 540:                 abs_check = validate_absolute(
 541:                     score=card.get("score"),
 542:                     wickets=card.get("wickets"),
 543:                     overs=card.get("overs"),
 544:                     target=self.target, innings=self.innings)
 545:                 if not abs_check.ok:
 546:                     log.info(f"[SM] cold-start give-up REJECT "
 547:                              f"({abs_check.reject_reason})")
 548:                     return None
 549:                 self._last_warm_state = None
 550:                 self._accept_initial(card, frame)
 551:                 self.mode = "WARM"
 552:                 log.info(f"[SM] COLD_START → WARM (max frames, ref cleared)  "
 553:                          f"{self.score}/{self.wickets} ({self.overs})")
 554:                 return self._build_payload()
 555:             return None
 556: 
 557:         self._last_warm_state = None
 558:         self._accept_initial(card, frame)
 559:         self.mode = "WARM"
 560:         log.info(
 561:             f"[SM] COLD_START → WARM (consensus "
 562:             f"{self.cold_candidate_streak}/"
 563:             f"{self.COLD_START_CONSENSUS_FRAMES})  "
 564:             f"{self.score}/{self.wickets} ({self.overs})")
 565:         return self._build_payload()
 566: 
 567:     def _cold_start_plausible(self, card: dict) -> bool:
 568:         """Check if a cold-start candidate is plausible.
 569: 
 570:         Two regimes:
 571:           - Pure cold start (no `_last_warm_state`, e.g. fresh pipeline
 572:             boot mid-innings): only absolute / chase / overs ceilings
 573:             apply.  Whatever scorecard the broadcast shows is adopted
 574:             once consensus is reached.
 575:           - Stale recovery (we had a WARM state and re-entered
 576:             COLD_START): the candidate must be a legal cricket diff
 577:             from the last warm state.
 578:         """
 579:         cs = card.get("score")
 580:         co = card.get("overs")
 581:         cw = card.get("wickets")
 582: 
 583:         # Always enforce absolute / chase / overs ceilings — even a
 584:         # fresh cold-start scorecard like 446/2 is impossible.
 585:         abs_check = validate_absolute(
 586:             score=cs, wickets=cw, overs=co,
 587:             target=self.target, innings=self.innings)
 588:         if not abs_check.ok:
 589:             log.info(f"[SM] cold-start reject ({abs_check.reject_reason})")
 590:             return False
 591: 
 592:         ref = self._last_warm_state
 593:         if ref is None:
 594:             return True
 595: 
 596:         rs = ref.get("score", 0) or 0
 597:         ro = ref.get("overs", 0) or 0
 598:         rw = ref.get("wickets", 0) or 0
 599:         cs_v = cs or 0
 600:         co_v = co or 0
 601:         cw_v = cw or 0
 602: 
 603:         d_score = cs_v - rs
 604:         d_balls = self._overs_to_balls(co_v) - self._overs_to_balls(ro)
 605:         d_wickets = cw_v - rw
 606: 
 607:         # Stale-recovery diff must be a legal cricket transition.
 608:         # Striker / bowler deltas unavailable across a re-entry — pass
 609:         # None and rely on team-level invariants.
 610:         diff = Diff(
 611:             d_score=d_score, d_balts=d_balls, d_wkt=d_wickets,
 612:             d_str_runs=None, d_str_balls=None,
 613:             d_bwl_runs=None, d_bwl_wkt=None, d_bwl_balls=None)
 614:         result = validate_diff(
 615:             diff,
 616:             new_score=cs_v, new_wickets=cw_v, new_overs=co_v,
 617:             target=self.target, innings=self.innings)
 618:         if not result.ok:
 619:             log.info(
 620:                 f"[SM] cold-start reject ({result.reject_reason})  "
 621:                 f"ref={rs}/{rw}({ro}) → cand={cs_v}/{cw_v}({co_v})")
 622:             return False
 623:         return True
 624: 
 625:     def _false_zero_cold_start(self, card: dict,
 626:                                frame: FrameInput) -> bool:
 627:         """Reject 0-0 cold-start cards that came from mid-match graphics."""
 628:         if not (card.get("score") == 0
 629:                 and card.get("wickets") == 0
 630:                 and float(card.get("overs") or 0.0) == 0.0):
 631:             return False
 632:         text = (frame.scout_text or frame.action_text or "").upper()
 633:         graphic_keywords = (
 634:             "DRS", "REVIEW", "ULTRAEDGE", "ULTRA EDGE", "SNICKO",
 635:             "BALL TRACKING", "HAWK", "FULL SCORECARD", "SCORECARD",
 636:             "INTERVIEW", "IMPACT PLAYER", "PLAYER PROFILE",
 637:         )
 638:         has_mid_match_graphic = any(k in text for k in graphic_keywords)
 639:         has_player_shape = bool(card.get("bat1_name") and card.get("bat2_name"))
 640:         has_bowler_shape = bool(card.get("bowler_name"))
 641:         return has_mid_match_graphic and not (
 642:             has_player_shape and has_bowler_shape)
 643: 
 644:     def _accept_initial(self, card: dict, frame: FrameInput) -> None:
 645:         """Adopt a cold-start scorecard into WARM state.
 646: 
 647:         Called for both:
 648:           (a) FRESH initialisation (pipeline boot — `self.score is None`)
 649:           (b) RE-ENTRY into WARM after stale recovery
 650:               (`self.score is not None` — we had a prior warm state).
 651: 
 652:         On RE-ENTRY this method MUST preserve historical fields the
 653:         broadcast doesn't re-derive: confirmed FOW entries, observed
 654:         balls in `this_over`, the running partnership.  Wiping them
 655:         causes the symptoms we saw on 2026-04-17:
 656:           - this-over `[., ?, ?, ?, 1]` (observed dot lost on re-init)
 657:           - partnership=1/1 mid-over (running counter zeroed)
 658:           - duplicate Buttler@95/9.1 entries in FOW (placeholder list
 659:             re-built, then a later wicket event appended again)
 660:         """
 661:         is_reentry = self.score is not None
 662: 
 663:         self.score = card.get("score")
 664:         self.wickets = card.get("wickets")
 665:         self.overs = card.get("overs")
 666: 
 667:         # Dismissed-batter resurrection guard (2026-04-23, WS-PROJECTION
 668:         # investigation).  The same scrub already runs in
 669:         # `_update_batters` (warm path) but was missing here in the
 670:         # re-init path.  Live probe of MI-vs-CSK inn1 (F59 Sharma
 671:         # wicket → F162+ WS-PROJECTION-GAP) showed SM.non_striker stuck
 672:         # on 'Kartik Sharma' for 170+ frames after her dismissal: a
 673:         # stale broadcast strip still listed "Kartik 18(19)" post-
 674:         # wicket, SM re-entered COLD_START, _init_from_card accepted
 675:         # bat2_name=Sharma from that read, and lines 655-656 propagated
 676:         # her into self.non_striker.  Payload override wrote Sharma,
 677:         # WS-HYGIENE stripped her as out → UI lost non_striker.  Drop
 678:         # any card batter the scoreboard already marks dismissed before
 679:         # we assign to bat1/bat2.
 680:         if self.scoreboard is not None:
 681:             for _key in ("bat1_name", "bat2_name"):
 682:                 _nm = card.get(_key)
 683:                 if not _nm:
 684:                     continue
 685:                 _sc_card = (self.scoreboard.batting_card or {}).get(_nm)
 686:                 if _sc_card and _sc_card.get("status") == "out":
 687:                     log.warn(
 688:                         f"[SM] init: dropping {_key}='{_nm}' — "
 689:                         f"scoreboard shows status=out (stale strip "
 690:                         f"read of dismissed batter resurrected in "
 691:                         f"re-init)")
 692:                     card[_key] = None
 693:                     card.pop(_key.replace("_name", "_runs"), None)
 694:                     card.pop(_key.replace("_name", "_balls"), None)
 695: 
 696:         self.bat1_name = card.get("bat1_name")
 697:         self.bat1_runs = card.get("bat1_runs")
 698:         self.bat1_balls = card.get("bat1_balls")
 699:         self.bat2_name = card.get("bat2_name")
 700:         self.bat2_runs = card.get("bat2_runs")
 701:         self.bat2_balls = card.get("bat2_balls")
 702: 
 703:         self.bowler_name = card.get("bowler_name")
 704:         self.bowler_wickets = card.get("bowler_wickets")
 705:         self.bowler_runs = card.get("bowler_runs")
 706:         self.bowler_overs = card.get("bowler_overs")
 707: 
 708:         # Striker identification
 709:         if card.get("broadcast_striker"):
 710:             ind = card["broadcast_striker"].lower()
 711:             if self.bat1_name and ind in self.bat1_name.lower():
 712:                 self.striker = self.bat1_name
 713:                 self.non_striker = self.bat2_name
 714:             elif self.bat2_name and ind in self.bat2_name.lower():
 715:                 self.striker = self.bat2_name
 716:                 self.non_striker = self.bat1_name
 717:             else:
 718:                 self.striker = self.bat1_name
 719:                 self.non_striker = self.bat2_name
 720:         else:
 721:             self.striker = self.bat1_name
 722:             self.non_striker = self.bat2_name
 723: 
 724:         # Match context
 725:         self.batting_team = frame.broadcast_team
 726:         self.target = frame.broadcast_target
 727:         self.venue = frame.broadcast_venue
 728:         self.match_info = frame.broadcast_match_info
 729:         if self.target:
 730:             self.innings = 2
 731: 
 732:         # ── History-preserving init ───────────────────────────────────
 733:         target_wkts = self.wickets or 0
 734:         if not is_reentry:
 735:             # Fresh pipeline boot — start with placeholder rows for
 736:             # any wickets that fell before we joined.  Issue 4 fix:
 737:             # use the Scoreboard factory so placeholders carry
 738:             # `_unwitnessed: True` (UI can then render them honestly).
 739:             self.fow_list = [
 740:                 self._make_fow_placeholder(_i + 1)
 741:                 for _i in range(target_wkts)
 742:             ]
 743:         else:
 744:             # Re-entry: never shrink, never overwrite.  Pad with
 745:             # placeholders only if the broadcast says more wickets
 746:             # have fallen since we last had warm state.
 747:             while len(self.fow_list) < target_wkts:
 748:                 self.fow_list.append(
 749:                     self._make_fow_placeholder(len(self.fow_list) + 1))
 750:             if len(self.fow_list) > target_wkts:
 751:                 # Confirmed history outranks a wickets read that
 752:                 # shrank.  Preserve all entries; the diff layer will
 753:                 # reject the regression on the next frame.
 754:                 log.warn(
 755:                     f"[SM] re-WARM: card wickets {target_wkts} < "
 756:                     f"confirmed FOW history {len(self.fow_list)} — "
 757:                     f"keeping history intact")
 758: 
 759:         mid_innings_boot = (
 760:             not is_reentry
 761:             and ((self.wickets or 0) > 0
 762:                  or float(self.overs or 0.0) >= 1.0))
 763: 
 764:         if not is_reentry:
 765:             # Fresh init — seed this_over only for true early joins. A
 766:             # mid-innings recovery waits for observed post-recovery balls.
 767:             if self.overs and not mid_innings_boot:
 768:                 balls = round((self.overs % 1) * 10)
 769:                 if balls > 0:
 770:                     self.this_over = ["?"] * balls
 771:                     self.this_over_src = ["bcast"] * balls
 772:         else:
 773:             # Re-entry: keep observed balls (`obs` source) intact.
 774:             # Pad with placeholders only if the new ball count exceeds
 775:             # what we had; never truncate (truncation would lose the
 776:             # observation that was already recorded).
 777:             if self.overs:
 778:                 balls = round((self.overs % 1) * 10)
 779:                 while len(self.this_over) < balls:
 780:                     self.this_over.append("?")
 781:                     self.this_over_src.append("bcast")
 782: 
 783:         if not is_reentry:
 784:             self.partnership_runs = 0
 785:             self.partnership_balls = 0
 786:             self.partnership_known = not mid_innings_boot
 787:         # On re-entry, leave partnership counters as they were.  We
 788:         # don't know the true value but the running total we had is a
 789:         # far better estimate than zero, and subsequent ball events
 790:         # will accumulate forward correctly.
 791: 
 792:         if card.get("speed_kph"):
 793:             self.last_speed = card["speed_kph"]
 794: 
 795:         self._recompute()
 796: 
