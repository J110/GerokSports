1208:     re.IGNORECASE)
1209: _RE_STRIKER = re.compile(r'[>*]\s*([A-Z][A-Za-z\s\'-]+?)\s+\d+\s*\(\d+\)')
1210: _RE_FOURS = re.compile(r'FOURS?\s*[:\s]+(\d+)', re.IGNORECASE)
1211: _RE_SIXES = re.compile(r'SIXES?\s*[:\s]+(\d+)', re.IGNORECASE)
1212: _RE_EXTRAS_PANEL = re.compile(
1213:     r'EXTRA(?:S)?:\s*(\d+)\s*\(([^)]*)\)', re.IGNORECASE)
1214: _RE_EXTRA_TYPE = re.compile(
1215:     r'EXTRA:\s*(WD|NB|Wd|Nb|Wide|No\s*Ball|WIDE|NO\s*BALL)',
1216:     re.IGNORECASE)
1217: _RE_DISMISSAL_MODE = re.compile(
1218:     r'\b(BOWLED|CAUGHT|LBW|STUMPED|RUN\s*OUT|HIT\s*WICKET|'
1219:     r'RETIRED\s*HURT|RETIRED\s*OUT)\b',
1220:     re.IGNORECASE)
1221: _RE_TEAM_ABBR = re.compile(
1222:     r'\b(MI|CSK|RCB|KKR|SRH|RR|DC|PBKS|LSG|GT|NZ|WI|AUS|IND|ENG|SA|PAK|SL|BAN|AFG|IRE|ZIM|SCO|NAM)\s+\d')
1223: _VENUE_PATTERNS = [
1224:     re.compile(r'LIVE\s+FROM\s+(.+?)(?:\||\n|$)', re.IGNORECASE),
1225:     re.compile(r'VENUE:\s*(.+?)(?:\||\n|$)', re.IGNORECASE),
1226:     re.compile(r'(?:at|AT)\s+(?:the\s+)?(.+?'
1227:                r'(?:Stadium|Ground|Cricket|Oval|Park|Gardens|'
1228:                r'Chinnaswamy|Wankhede|Eden|Chepauk|Feroz Shah|'
1229:                r'Narendra Modi|Arun Jaitley|Sawai Mansingh|'
1230:                r'Rajiv Gandhi|Uppal|Brabourne|DY Patil))',
1231:                re.IGNORECASE),
1232: ]
1233: _MATCH_INFO_PATTERNS = [
1234:     re.compile(r'(\d+(?:st|nd|rd|th)\s+Match)', re.IGNORECASE),
1235:     re.compile(r'(MATCH\s+\d+)', re.IGNORECASE),
1236:     re.compile(r'(#\w+v\w+)', re.IGNORECASE),
1237:     re.compile(r'((?:FIRST|SECOND|THIRD|FOURTH|FIFTH)\s+T20I)',
