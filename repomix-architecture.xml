1488:     def _find_card_key(self, resolved: str, card: dict) -> str | None:
1489:         """Find the exact key in a card that matches the resolved name."""
1490:         if resolved in card:
1491:             return resolved
1492:         for key in card:
1493:             if self.resolve_name(key) == resolved:
1494:                 return key
1495:         return None
1496: 
1497:     def set_extractor_batters(self, names: set[str]):
1498:         """Store current extractor batter names for auto-dismiss logic."""
1499:         self._extractor_batter_names = names
1500: 
1501:     def _auto_dismiss_for_new_batter(self, active: list[str],
1502:                                      new_batter: str) -> str | None:
1503:         """When wickets > 0 and a new batter appears but 2 are active,
1504:         auto-dismiss the active batter NOT in the extractor output.
1505: 
1506:         Only fires when exactly ONE active batter is missing from the
1507:         extractor output (set difference = dismissed batter). If both
1508:         active batters appear in the extractor (broadcast still showing
1509:         the outgoing batter momentarily), returns None so the caller
1510:         retries on the next frame.
1511: 
1512:         Gate (2026-04-21, Issue D): the wicket counter MUST have
1513:         advanced since the last auto-dismiss we fired.  Without this
1514:         gate, any extractor hallucination of a third batter (e.g. a
1515:         replay graphic overlay, a career-stats panel, or a Scout
1516:         misread of a career summary) would fire a dismissal against
1517:         whichever active batter happened to be missing from the
1518:         current frame's extractor output.  The wicket counter is the
1519:         only deterministic signal that a real dismissal occurred;
1520:         without a tick, no auto-dismiss may fire.
1521:         """
1522:         ext = self._extractor_batter_names
1523:         if not ext:
1524:             return None
1525: 
1526:         def _in_ext(name: str) -> bool:
1527:             n_up = name.upper()
1528:             return any(n_up in e or e in n_up for e in ext)
1529: 
1530:         missing = [a for a in active if not _in_ext(a)]
1531: 
1532:         # --- wicket-tick gate -------------------------------------
1533:         try:
1534:             _cur_wk = int(self._inn.get("wickets") or 0)
1535:         except (TypeError, ValueError):
1536:             _cur_wk = 0
1537:         _last_dismiss_wk = getattr(self, "_last_autodismiss_wickets", 0)
1538:         if _cur_wk <= _last_dismiss_wk:
1539:             # Path 2 (P0-B, 2026-04-25): witnessed-FOW re-assertion
1540:             # bypass.  The gate's intent is to block phantom NEW
1541:             # wickets from extractor hallucinations.  When upstream
1542:             # state corruption resurrects a witnessed-FOW dismissed
1543:             # batter into the active set (live evidence: DC vs PBKS
1544:             # F339 → F832 deadlock, 1330 consecutive WS-SCRUB
1545:             # rejections of Nitish Rana), this gate compounds the
1546:             # corruption by refusing to re-apply the canonical
1547:             # dismissal — we appear to "already have dismissed someone
1548:             # at this wicket count" because the resurrected batter
1549:             # was originally dismissed at exactly this count.
1550:             #
1551:             # FOW is canonical: re-asserting a witnessed dismissal
1552:             # creates no new wicket, just enforces one that already
1553:             # happened.  Bypass the gate when exactly one active is
1554:             # both (a) missing from extractor and (b) carries a
1555:             # witnessed FOW entry.  Do NOT bump
1556:             # `_last_autodismiss_wickets` (no new wicket occurred)
1557:             # and do NOT call `_add_fow` (entry already exists; the
1558:             # immutable witnessed-rule would refuse the rewrite
1559:             # anyway).
1560:             #
1561:             # Composes with P0-A as defense-in-depth at a fourth
1562:             # choke point.  P0-A (Fix 1+2+3) prevents resurrection at
1563:             # update_batter and validate_state_consistency; this fix
1564:             # ensures the auto-dismiss replacement path also recovers
1565:             # cleanly if any future code path re-introduces resurrection.
1566:             _bypass_candidates = [a for a in missing
1567:                                   if self._is_witnessed_dismissal(a)]
1568:             if len(_bypass_candidates) == 1:
1569:                 _name = _bypass_candidates[0]
1570:                 log.warn(
1571:                     f"[INVARIANT] Re-asserting witnessed dismissal of "
1572:                     f"'{_name}' (wicket-tick gate bypassed — FOW "
1573:                     f"canonical, _cur_wk={_cur_wk} == "
1574:                     f"_last_dismiss_wk={_last_dismiss_wk}). "
1575:                     f"New batter '{new_batter}' will replace.")
1576:                 self.batting_card[_name]["status"] = "out"
1577:                 self._missing_batter_streak = {}
1578:                 return _name
1579:             log.info(
1580:                 f"[DISMISS] Blocked — wickets counter has not advanced "
1581:                 f"since last auto-dismiss (cur={_cur_wk}, "
1582:                 f"last_dismiss_at={_last_dismiss_wk}). New batter "
1583:                 f"'{new_batter}' is almost certainly an extractor "
1584:                 f"hallucination (replay/comparison overlay) rather than "
1585:                 f"a real arrival at the crease.")
1586:             return None
1587: 
1588:         if len(missing) != 1:
1589:             if missing:
1590:                 log.info(f"[DISMISS] Multiple batters missing from "
1591:                          f"extractor ({missing}) — ambiguous, skipping")
1592:             else:
1593:                 log.info(f"[DISMISS] Both active batters in extractor "
1594:                          f"output — broadcast hasn't settled, deferring")
1595:             return None
1596: 
1597:         # --- missing-streak gate ----------------------------------
1598:         # The "missing from extractor" signal is noisy: a single
1599:         # closeup / replay / graphic frame routinely drops one batter.
1600:         # Require the candidate to be missing for ≥ 2 consecutive
1601:         # frames before acting on the signal.
1602:         _streak = getattr(self, "_missing_batter_streak", {})
1603:         candidate = missing[0]
1604:         _streak = {k: v for k, v in _streak.items() if k in active}
1605:         _streak[candidate] = _streak.get(candidate, 0) + 1
1606:         self._missing_batter_streak = _streak
1607:         if _streak[candidate] < 2:
1608:             log.info(
1609:                 f"[DISMISS] '{candidate}' missing from extractor "
1610:                 f"(streak={_streak[candidate]}/2) — deferring one frame "
1611:                 f"to rule out a single-frame closeup/overlay drop.")
1612:             return None
1613: 
1614:         dismissed = missing[0]
1615:         self._last_autodismiss_wickets = _cur_wk
1616:         self._missing_batter_streak = {}
1617:         # === S17: prefer the structured dismissal hint piped in from
1618:         # the pipeline (action-text scan or broadcast graphic) over
1619:         # the generic "inferred" placeholder. The hint is a single
1620:         # one-shot — clear after consuming so the next wicket gets a
1621:         # fresh signal and we don't paint a stale "stumped" onto an
1622:         # actually-bowled wicket. ===
1623:         _hint = getattr(self, "pending_dismissal_hint", None)
1624:         _hint_bowler = getattr(self, "pending_dismissal_bowler", None)
1625:         if _hint:
1626:             self.batting_card[dismissed]["dismissal"] = _hint
1627:             self.pending_dismissal_hint = None
1628:         else:
1629:             self.batting_card[dismissed]["dismissal"] = (
1630:                 "inferred (replaced by new batter)")
1631:         if _hint_bowler:
1632:             self.batting_card[dismissed]["dismissal_bowler"] = _hint_bowler
1633:             self.pending_dismissal_bowler = None
1634:         self.batting_card[dismissed]["status"] = "out"
1635:         wk = self._inn.get("wickets")
1636:         self._add_fow(wk, dismissed,
1637:                        self._inn.get("score"),
1638:                        self._inn.get("overs"),
1639:                        how=_hint,
1640:                        bowler=_hint_bowler or self._inn.get("current_bowler"))
1641:         log.info(f"[WICKET] Auto-dismissed {dismissed} — "
1642:                  f"not in extractor output, {new_batter} replacing"
1643:                  + (f" (kind={_hint!r})" if _hint else ""))
1644:         return dismissed
