 684: def _strip_has_scoreboard(strip: np.ndarray) -> bool:
 685:     """Quick local check: does the bottom strip look like it has a
 686:     scoreboard? Scoreboard strips have high-contrast text on a solid
 687:     bar. Full-screen ads don't have this pattern at the very bottom."""
 688:     if strip is None or strip.size == 0:
 689:         return False
 690:     gray = cv2.cvtColor(strip, cv2.COLOR_BGR2GRAY) if len(strip.shape) == 3 else strip
 691:     std = float(np.std(gray))
 692:     # Scoreboard bars: solid background + bright text → std 25-80
 693:     # Full-screen ads: varied content all the way down → std > 40 OR < 10
 694:     # We check: if the strip has moderate contrast typical of a
 695:     # scoreboard bar, the frame likely still has cricket info.
 696:     return 15.0 < std < 85.0
