3748:     def _resolve_team_variant(name: str) -> str | None:
3749:         """Resolve a team name/abbreviation to canonical team name."""
3750:         if not name:
3751:             return None
3752:         up = name.upper().strip()
3753:         for tn in team_names:
3754:             if up == tn.upper():
3755:                 return tn
3756:         if up in team_a_variants:
3757:             return team_names[0]
3758:         if up in team_b_variants:
3759:             return team_names[1] if len(team_names) > 1 else None
3760:         for tn in team_names:
3761:             if up in tn.upper() or tn.upper() in up:
3762:                 return tn
3763:         return None
