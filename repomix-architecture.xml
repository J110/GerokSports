3761:     def restore_from_cache(self, cached: dict):
3762:         """Restore state from a previously saved cache dict."""
3763:         inn = self._inn
3764:         for field in ("score", "wickets", "overs", "run_rate",
3765:                       "target", "striker", "non_striker", "current_bowler"):
3766:             if cached.get(field) is not None:
3767:                 inn[field] = cached[field]
3768: 
3769:         if cached.get("score") is not None:
3770:             self._tracker.force_set("score", int(cached["score"]))
3771:         if cached.get("overs") is not None:
3772:             self._tracker.force_set("overs", str(cached["overs"]))
3773:         if cached.get("wickets") is not None:
3774:             self._tracker.force_set("wickets", int(cached["wickets"]))
3775: 
3776:         for name, card_data in (cached.get("batting_card") or {}).items():
3777:             if name in self.batting_card:
3778:                 # Restore batting stats but mark dismissed players as
3779:                 # yet_to_bat so the strip can re-confirm who's actually in.
3780:                 # This prevents stale dismissed lists from blocking
3781:                 # players who are visibly batting after a restart.
3782:                 if card_data.get("status") == "out":
3783:                     card_data = dict(card_data)
3784:                     card_data["status"] = "yet_to_bat"
3785:                     card_data["dismissal"] = None
3786:                     card_data["runs"] = None
3787:                     card_data["balls"] = None
3788:                 self.batting_card[name].update(card_data)
3789:                 if card_data.get("status") == "batting":
3790:                     r = int(card_data["runs"]) if card_data.get("runs") is not None else None
3791:                     b = int(card_data["balls"]) if card_data.get("balls") is not None else None
3792:                     if r is not None:
3793:                         self._tracker.force_set(f"bat:{name}:runs", r)
3794:                     if b is not None:
3795:                         self._tracker.force_set(f"bat:{name}:balls", b)
3796: 
3797:         # Reset dismissed recovery counters and FOW on restore
3798:         self._dismissed_recovery = {}
3799:         self._dismissed_inferred = False
3800:         # After a restore, any wickets already on the scoreboard were
3801:         # witnessed BEFORE we joined — we can't fire auto-dismiss for
3802:         # them.  Seed the gate at the current wicket count so only
3803:         # NEW wickets (post-restore) can trigger auto-dismissal.
3804:         try:
3805:             self._last_autodismiss_wickets = int(
3806:                 self._inn.get("wickets") or 0)
3807:         except (TypeError, ValueError):
3808:             self._last_autodismiss_wickets = 0
3809:         # Fix #1 (2026-04-23): the cache confirms prior wicket state;
3810:         # prime the zero-streak past the seed threshold so a
3811:         # subsequent 0→1 transition on this session is recognised as
3812:         # a real live event, not a cold-start historical seed.
3813:         self._wickets_confirmed_frames_at_zero = max(
3814:             self._wickets_confirmed_frames_at_zero, 2)
3815:         self._missing_batter_streak = {}
3816: 
3817:         for name, card_data in (cached.get("bowling_card") or {}).items():
3818:             if name in self.bowling_card:
3819:                 self.bowling_card[name].update(card_data)
3820: 
3821:         self.fall_of_wickets = cached.get("fall_of_wickets", [])
3822: 
3823:         log.info(f"[CACHE] Restored: {cached.get('score')}-"
3824:                  f"{cached.get('wickets')} ({cached.get('overs')}) "
3825:                  f"from frame {cached.get('frame')}")
