ce_file": "/Users/anmolmohan/Projects/SportsComm/files/cricket_rules.py", "source_location": "L114"}, {"id": "files_cricket_rules_rationale_122", "label": "1, 2, or 3 runs off the bat (legal delivery).", "file_type": "rationale", "source_file": "/Users/anmolmohan/Projects/SportsComm/files/cricket_rules.py", "source_location": "L122"}, {"id": "files_cricket_rules_rationale_140", "label": "5 runs off the bat (rare \u2014 usually involves overthrows).", "file_type": "rationale", "source_file": "/Users/anmolmohan/Projects/SportsComm/files/cricket_rules.py", "source_location": "L140"}, {"id": "files_cricket_rules_rationale_155", "label": "Overthrows: 7-10 runs on a single legal ball.", "file_type": "rationale", "source_file": "/Users/anmolmohan/Projects/SportsComm/files/cricket_rules.py", "source_location": "L155"}, {"id": "files_cricket_rules_rationale_167", "label": "Byes / leg-byes: 1-4 runs, legal ball, no batter or bowler credit.", "file_type": "rationale", "source_file": "/Users/anmolmohan/Projects/SportsComm/files/cricket_rules.py", "source_location": "L167"}, {"id": "files_cricket_rules_rationale_176", "label": "Wide: 1-5 runs (1 penalty + 0-4 actual runs), not a legal ball.", "file_type": "rationale", "source_file": "/Users/anmolmohan/Projects/SportsComm/files/cricket_rules.py", "source_location": "L176"}, {"id": "files_cricket_rules_rationale_186", "label": "No-ball, batter didn't make contact (or got a single off pads).", "file_type": "rationale", "source_file": "/Users/anmolmohan/Projects/SportsComm/files/cricket_rules.py", "source_location": "L186"}, {"id": "files_cricket_rules_rationale_195", "label": "No-ball + bat runs (1-6).  \u0394score = 1 (penalty) + bat runs.", "file_type": "rationale", "source_file": "/Users/anmolmohan/Projects/SportsComm/files/cricket_rules.py", "source_location": "L195"}, {"id": "files_cricket_rules_rationale_207", "label": "No-ball + byes / leg-byes (1-4).  Bowler only charged the 1 penalty.", "file_type": "rationale", "source_fi