# CricketMind Environment Variables

# Gemini Flash API (replaces Moondream for vision — free tier: 1500 req/day)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Ollama (Mistral 7B for commentary — the only model on GPU)
OLLAMA_URL=http://localhost:11434
COMMENTARY_MODEL=mistral:7b
