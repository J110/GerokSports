923: def get_batter_phase(batter_stats: dict) -> dict:
924:     runs = batter_stats.get("runs") or 0
925:     balls = batter_stats.get("balls") or 0
926: 
927:     if balls == 0:
928:         return {"phase": "new_batter", "sr": 0, "runs": runs, "balls": balls}
929: 
930:     sr = round((runs / balls) * 100, 1)
931: 
932:     if balls <= 5:
933:         phase = "just_in"
934:     elif sr > 180:
935:         phase = "on_fire"
936:     elif sr > 140:
937:         phase = "aggressive"
938:     elif sr > 100:
939:         phase = "steady"
940:     elif sr > 70:
941:         phase = "anchoring"
942:     else:
943:         phase = "struggling"
944: 
945:     return {"phase": phase, "sr": sr, "runs": runs, "balls": balls}
