 970:                         f"[OVER-DEFER] Rollover {self._last_over_int} "
 971:                         f"→ {new_int} deferred "
 972:                         f"({self._rollover_defer_count}/"
 973:                         f"{ROLLOVER_MAX_DEFER_FRAMES}): "
 974:                         f"this_over has {_legal_count}/6 legal balls "
 975:                         f"— waiting for the closing-ball event to "
