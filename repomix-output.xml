 286: def analyze(log_path: Path, window_min: int = 5) -> Snapshot:
 287:     snap = Snapshot(log_path=str(log_path))
 288:     if not log_path.exists():
 289:         snap.notable_anomalies.append(f"log not found: {log_path}")
 290:         return snap
 291: 
 292:     day_anchor = datetime.fromtimestamp(log_path.stat().st_mtime).replace(
 293:         hour=0, minute=0, second=0, microsecond=0)
 294:     last_ts: datetime | None = None
 295:     first_ts: datetime | None = None
 296:     states: list[str] = []
 297:     for raw in log_path.read_text(errors="replace").splitlines():
 298:         line = strip_ansi(raw)
 299:         ts = parse_ts(line, day_anchor)
 300:         if ts:
 301:             if first_ts is None:
 302:                 first_ts = ts
 303:             last_ts = ts
 304: 
 305:         if m := SCOUT.search(line):
 306:             _tag, _ms, cam, phase = m.groups()
 307:             snap.cam_total[cam] += 1
 308:             snap.phase_total[phase] += 1
 309:             snap.cam_phase_xtab[(cam, phase)] += 1
 310: 
 311:         if "SCOREBOARD — #" in line:
 312:             snap.frames_scoreboard += 1
 313: 
 314:         if "GRAPHIC — #" in line:
 315:             snap.frames_graphic += 1
 316: 
 317:         if "FRAME_POISONED" in line:
 318:             snap.frame_poisoned_count += 1
 319:             mp = re.search(r"FRAME_POISONED:(\w+)", line)
 320:             if mp:
 321:                 snap.frame_poisoned_reasons[mp.group(1)] += 1
 322: 
 323:         if VISION_TO.search(line):
 324:             snap.vision_timeouts += 1
 325: 
 326:         if "[BOWLER-STALE] Rejecting" in line:
 327:             snap.bowler_stale_rejects += 1
 328:             mn = re.search(r"Rejecting '([^']+)'", line)
 329:             if mn:
 330:                 snap.bowler_stale_targets[mn.group(1)] += 1
 331:             mfig = re.search(
 332:                 r"proposed (\S+) exactly matches recorded (\S+)", line)
 333:             mframe = re.search(r"\[(\d{2}:\d{2}:\d{2})\s+(F\d+)", line)
 334:             if mn and mframe:
 335:                 snap.bowler_stale_events.append({
 336:                     "ts": mframe.group(1),
 337:                     "frame": mframe.group(2),
 338:                     "target": mn.group(1),
 339:                     "proposed": mfig.group(1) if mfig else None,
 340:                     "recorded": mfig.group(2) if mfig else None,
 341:                 })
 342:         if "[FIELD-MONITOR] Field unchanged" in line:
 343:             snap.field_monitor_warns += 1
 344:         # BOARD-line bowler-strip-read tracking.  Format example:
 345:         # "[20:08:39 F425 BOARD] INFO: Pat Cummins: 0/20 (2) -> 0/20 (2.1) [F425]"
 346:         # i.e. <name>: <w>/<r> (<ov>) -> <w>/<r> (<ov>) [F##].  Any
 347:         # line where old != new is an active write event triggered
 348:         # by Scout's broadcast read.  We use these as proxies for
 349:         # "bowler-strip read events" — the interval distribution
 350:         # informs the BOWLER-STALE freshness-window threshold.
 351:         mboard_bowl = re.search(
 352:             r"\[(\d{2}:\d{2}:\d{2})\s+(F\d+)\s+BOARD\]\s+INFO:\s+"
 353:             r"([A-Z][\w. '-]+?):\s+"
 354:             r"(\d+/\d+\s*\([\d.]+\))\s+->\s+(\d+/\d+\s*\([\d.]+\))",
 355:             line)
 356:         if mboard_bowl:
 357:             old_v = mboard_bowl.group(4)
 358:             new_v = mboard_bowl.group(5)
 359:             if old_v != new_v:
 360:                 snap.bowler_strip_reads.append({
 361:                     "ts": mboard_bowl.group(1),
 362:                     "frame": mboard_bowl.group(2),
 363:                     "frame_int": int(mboard_bowl.group(2)[1:]),
 364:                     "name": mboard_bowl.group(3).strip(),
 365:                     "from": old_v,
 366:                     "to": new_v,
 367:                 })
 368: 
 369:         if m := INVARIANT.search(line):
 370:             msg = (m.group(1) or m.group(2) or "").strip()
