1138:     def initialize_mid_over(self, overs: str | None) -> None:
1139:         """Pre-fill `?` placeholders for cold-start mid-over joins.
1140: 
1141:         ONLY runs when we're truly cold (no `_last_over_int` recorded
1142:         yet). After the first over transition, this is a no-op —
1143:         otherwise it would re-inject phantom `?` placeholders into a
1144:         freshly-cleared `this_over` (post over-transition), and then
1145:         the next `on_ball_event.append(...)` would slot the real ball
1146:         AFTER the phantoms, downgrading observed positions to `?`.
1147:         """
1148:         if self._last_over_int is not None:
1149:             return
1150:         balls = round((float(overs or "0") % 1) * 10)
1151:         if balls > 0 and not self.this_over:
1152:             self.this_over = ["?"] * balls
1153:             self.this_over_sources = ["bcast"] * balls
1154:             log.info(f"Joined at {overs}, pre-filled {balls} balls as '?'")
1155: 
1156:     def get_display(self, overs: str | None) -> list[str]:
1157:         # Time-based fallback for the held completed over — clear if
1158:         # the hold window has elapsed even when no other signal came.
1159:         if (self._pending_clear and self._pending_clear_at is not None
1160:                 and time.monotonic() - self._pending_clear_at
1161:                 > COMPLETED_OVER_HOLD_S):
1162:             self._consume_pending_clear(
1163:                 f"hold-window {COMPLETED_OVER_HOLD_S:.0f}s elapsed (display)")
1164: 
1165:         # Always return the full observed sequence (incl. extras like
1166:         # Wd / Nb). Once a ball has been observed and appended, it is
1167:         # PERMANENT for the duration of this over — never trimmed,
1168:         # never re-ordered. The broadcast frequently shows 7-9 circles
1169:         # for an over (6 legal + N wides + N no-balls), and our UI
1170:         # must mirror that.
1171:         #
1172:         # LENGTH FLOOR (issue #7): if team_overs reports more legal
1173:         # balls than this_over contains, pad with `?` placeholders so
1174:         # the UI never shows fewer balls than the broadcast says have
1175:         # been bowled. Wides/no-balls (Wd, Nb tokens) don't count
1176:         # against the legal floor — they're "extra" circles.
1177:         if not overs:
1178:             if self.this_over:
1179:                 self._log_count_mismatch(overs, len(self.this_over))
1180:             return self.this_over[:]
1181:         sub = round((float(overs) % 1) * 10)
1182:         if self._pending_clear:
1183:             return self.this_over[:]
1184:         if sub == 0:
1185:             return self.this_over[:]
1186:         legal_n = sum(
1187:             1 for x in self.this_over
1188:             if str(x).lower() not in ("wd", "nb")
1189:             and not str(x).lower().startswith("wd")
1190:             and not str(x).lower().startswith("nb"))
1191:         if legal_n < sub:
1192:             # Pad with '?' placeholders so the UI ribbon length always
1193:             # matches what the broadcast says has been bowled. The
1194:             # placeholders are subsequently fillable by
1195:             # `on_broadcast_override` (which only writes into '?'
1196:             # slots) or get upgraded by future ball events.
1197:             missing = sub - legal_n
1198:             for _ in range(missing):
1199:                 self.this_over.append("?")
1200:                 self.this_over_sources.append("bcast")
1201:             log.info(
1202:                 f"[FLOOR] Padded {missing} '?' placeholders to "
1203:                 f"this_over (team_overs={overs} expects {sub} legal, "
1204:                 f"observed only {legal_n}) — new={self.this_over}")
1205:             self._log_count_mismatch(overs, sub)
1206:         elif legal_n > sub:
1207:             self._log_count_mismatch(overs, legal_n)
1208:         return self.this_over[:]
