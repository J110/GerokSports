  1: """Squad scraper — parse Cricbuzz squad pages with BeautifulSoup.
  2: 
  3: Extracts both teams, playing XI, bench/impact subs, roles, captain, keeper.
  4: Builds name lookup table and empty scorecards.
  5: 
  6: Cricbuzz structure:
  7:   Team A (left):  <a> tags with 'border-r-2' in class
  8:   Team B (right): <a> tags with 'justify-end' in class
  9:   Playing XI first, then bench (separated by section headers)
 10:   Player text: "Name(C)Role" e.g. "Rovman Powell(C)Batter"
 11: """
 12: from __future__ import annotations
 13: 
 14: import re
 15: 
 16: import httpx
 17: from bs4 import BeautifulSoup
 18: 
 19: from eyes.cricket_logger import CricketLogger
 20: 
 21: log = CricketLogger("SQUAD")
 22: 
 23: ROLES = [
 24:     "Batting Allrounder",
 25:     "Bowling Allrounder",
 26:     "WK-Batter",
 27:     "Batter",
 28:     "Bowler",
 29: ]
 30: 
 31: ROLE_PATTERN = re.compile(
 32:     r"(Batting Allrounder|Bowling Allrounder|WK-Batter|Batter|Bowler)$"
 33: )
 34: 
 35: STAFF_PATTERN = re.compile(
 36:     r"(Head [Cc]oach|Head of|Assistant [Cc]oach|Team Manager|Manager|"
 37:     r"Physiotherapist|Physio|Analyst|Batting [Cc]oach|Bowling [Cc]oach|"
 38:     r"Fielding [Cc]oach|Wicket-?keeping [Cc]oach|Spin [Cc]oaching?|"
 39:     r"Fast Bowling [Cc]oach|Lead Assistant|Selector|Trainer|Director|"
 40:     r"Mentor|Support Staff|Spin Bowling [Cc]oach|Strategic Advisor|"
 41:     r"Consultant|Performance [Cc]oach|Video Analyst|"
 42:     r"Scouting|Scout|Strength|Doctor|Medical)",
 43:     re.IGNORECASE,
 44: )
 45: 
 46: 
 47: def _parse_player_text(text: str) -> dict:
 48:     """Parse 'Rovman Powell(C)Batter' into structured player data."""
 49:     text = text.strip()
 50: 
 51:     captain = "(C)" in text or "(C &" in text or "(C/" in text
 52:     keeper = "(WK)" in text or "& WK)" in text or "C/WK)" in text
 53:     text = re.sub(r"\(C\s*[&/]\s*WK\)", "", text)
 54:     text = text.replace("(C)", "").replace("(WK)", "").replace("(C/WK)", "")
 55:     text = text.strip()
 56: 
 57:     role = "unknown"
 58:     name = text
 59:     m = ROLE_PATTERN.search(text)
 60:     if m:
 61:         role = m.group(1)
 62:         name = text[:m.start()].strip()
 63: 
 64:     role_map = {
 65:         "Batter": "batter",
 66:         "Bowler": "bowler",
 67:         "Batting Allrounder": "bat_allrounder",
 68:         "Bowling Allrounder": "bowl_allrounder",
 69:         "WK-Batter": "wk_batter",
 70:     }
 71:     role = role_map.get(role, role)
 72: 
 73:     return {
 74:         "name": name,
 75:         "role": role,
 76:         "captain": captain,
 77:         "keeper": keeper or role == "wk_batter",
 78:     }
 79: 
 80: 
 81: def _is_team_a(classes: list[str]) -> bool:
 82:     return "border-r-2" in classes
 83: 
 84: 
 85: def _is_team_b(classes: list[str]) -> bool:
 86:     return "justify-end" in classes
 87: 
 88: 
 89: def _is_section_start(classes: list[str]) -> bool:
 90:     return "border-t" in classes
 91: 
 92: 
 93: async def scrape_cricbuzz_squads(url: str) -> dict | None:
 94:     """Scrape a Cricbuzz squad page and return structured data.
 95: 
 96:     Returns:
 97:     {
 98:         "team_a": {"name": "WI", "full_name": "West Indies",
 99:                    "playing_xi": [...], "bench": [...]},
100:         "team_b": {"name": "ENG", "full_name": "England",
101:                    "playing_xi": [...], "bench": [...]},
102:         "venue": "...", "format": "T20"
103:     }
104:     """
105:     log.info(f"Fetching: {url}")
106: 
107:     try:
108:         async with httpx.AsyncClient(timeout=15.0, follow_redirects=True) as client:
109:             resp = await client.get(url, headers={
110:                 "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) "
111:                               "AppleWebKit/537.36 (KHTML, like Gecko) "
112:                               "Chrome/120.0.0.0 Safari/537.36",
113:                 "Accept": "text/html,application/xhtml+xml",
114:             })
115:             resp.raise_for_status()
116:     except Exception as e:
117:         log.error(f"Failed to fetch URL: {e}")
118:         return None
119: 
120:     soup = BeautifulSoup(resp.text, "lxml")
121: 
122:     # Extract team names from h1 tags or page title
123:     team_names = _extract_team_names(soup, url)
124: 
125:     # Find all player links (both teams, both sections)
126:     player_links = soup.find_all(
127:         "a", href=lambda h: h and "/profiles/" in h,
128:         class_=lambda c: c and ("border-r-2" in c or "justify-end" in c)
129:     )
130: 
131:     if not player_links:
132:         log.error("No player links found — page structure may have changed")
133:         return None
134: 
135:     # Split into teams and sections
136:     team_a_xi, team_a_bench = [], []
137:     team_b_xi, team_b_bench = [], []
138: 
139:     a_section = "xi"
140:     b_section = "xi"
141: 
142:     for link in player_links:
143:         classes = link.get("class", [])
144:         text = link.get_text(strip=True)
145:         player = _parse_player_text(text)
146: 
147:         is_a = _is_team_a(classes)
148:         is_b = _is_team_b(classes)
149:         starts_section = _is_section_start(classes)
150: 
151:         # Filter out coaching staff (their text has no player role)
152:         # Also catches concatenated name+role like "NameHead of Scouting"
153:         if STAFF_PATTERN.search(text):
154:             continue
155:         if player.get("role") == "unknown" and STAFF_PATTERN.search(player.get("name", "")):
156:             continue
157: 
158:         # Tag impact subs
159:         if "bg-cbAntiFlash" in classes:
160:             player["impact_sub"] = True  # subbed INTO XI
161:         elif "bg-pink-50" in classes:
162:             player["impact_sub"] = True  # subbed OUT of XI
163:             player["subbed_out"] = True
164: 
165:         if is_a:
166:             if starts_section and team_a_xi:
167:                 a_section = "bench"
168:             if a_section == "xi":
169:                 team_a_xi.append(player)
170:             else:
171:                 team_a_bench.append(player)
172: 
173:         elif is_b:
174:             if starts_section and team_b_xi:
175:                 b_section = "bench"
176:             if b_section == "xi":
177:                 team_b_xi.append(player)
178:             else:
179:                 team_b_bench.append(player)
180: 
181:     # Extract venue from page
182:     venue = _extract_venue(soup)
183:     fmt = _extract_format(url)
184: 
185:     result = {
186:         "team_a": {
187:             "name": team_names[0] if team_names else "Team A",
188:             "full_name": team_names[0] if team_names else "Team A",
189:             "playing_xi": team_a_xi,
190:             "bench": team_a_bench,
191:         },
192:         "team_b": {
193:             "name": team_names[1] if len(team_names) > 1 else "Team B",
194:             "full_name": team_names[1] if len(team_names) > 1 else "Team B",
195:             "playing_xi": team_b_xi,
196:             "bench": team_b_bench,
197:         },
198:         "venue": venue,
199:         "format": fmt,
200:     }
201: 
202:     _log_squads(result)
203:     return result
204: 
205: 
206: def _extract_team_names(soup: BeautifulSoup, url: str) -> list[str]:
207:     """Extract team abbreviations from the page."""
208:     # Try page title first: "West Indies vs England, 5th T20I..."
209:     title = soup.find("title")
210:     if title:
211:         title_text = title.get_text(strip=True)
212:         # "Cricket match squads | West Indies vs England, 5th T20I..."
213:         if " vs " in title_text:
214:             parts = title_text.split("|")[-1].strip() if "|" in title_text else title_text
215:             vs_part = parts.split(",")[0].strip()
216:             if " vs " in vs_part:
217:                 teams = vs_part.split(" vs ")
218:                 return [t.strip() for t in teams[:2]]
219: 
220:     # Fallback: parse from URL slug "wi-vs-eng-5th-t20i..."
221:     slug = url.rstrip("/").split("/")[-1]
222:     if "-vs-" in slug:
223:         parts = slug.split("-vs-")
224:         a = parts[0].split("/")[-1].upper()
225:         b = parts[1].split("-")[0].upper()
226:         return [a, b]
227: 
228:     return []
229: 
230: 
231: def _extract_venue(soup: BeautifulSoup) -> str | None:
232:     """Try to find venue info on the page."""
233:     for text_elem in soup.find_all(string=re.compile(r"Stadium|Ground|Oval|Park|Arena")):
234:         parent = text_elem.parent
235:         if parent:
236:             full = parent.get_text(strip=True)
237:             if len(full) < 120:
238:                 return full
239:     return None
240: 
241: 
242: def _extract_format(url: str) -> str:
243:     slug = url.lower()
244:     if "t20" in slug:
245:         return "T20"
246:     if "odi" in slug or "one-day" in slug:
247:         return "ODI"
248:     if "test" in slug:
249:         return "Test"
250:     if "ipl" in slug or "premier-league" in slug:
251:         return "T20"
252:     return "T20"
253: 
254: 
255: def _log_squads(data: dict):
256:     for key in ("team_a", "team_b"):
257:         team = data[key]
258:         xi = team["playing_xi"]
259:         bench = team["bench"]
260:         log.info(f"  {team['name']}: {len(xi)} XI + {len(bench)} bench")
261:         for p in xi:
262:             tags = []
263:             if p["captain"]:
264:                 tags.append("C")
265:             if p["keeper"]:
266:                 tags.append("WK")
267:             tag_str = f" ({','.join(tags)})" if tags else ""
268:             log.info(f"    {p['name']}{tag_str} — {p['role']}")
269:         for p in bench:
270:             log.info(f"    [bench] {p['name']} — {p['role']}")
271: 
272: 
273: # ------------------------------------------------------------------
274: # Name lookup table
275: # ------------------------------------------------------------------
276: 
277: def build_name_lookup(players: list[str]) -> dict[str, str]:
278:     """Map every broadcast variant to the canonical full name."""
279:     lookup: dict[str, str] = {}
280:     for full in players:
281:         parts = full.strip().split()
282:         if not parts:
283:             continue
284:         up = full.upper().strip()
285:         lookup[up] = full
286: 
287:         if len(parts) >= 2:
288:             last = parts[-1].upper()
289:             first = parts[0].upper()
290:             lookup[last] = full
291:             lookup[f"{first[0]} {last}"] = full
292:             lookup[f"{first[0]}. {last}"] = full
293:             lookup[f"{last} {first[0]}"] = full
294: 
295:             if len(parts) == 3:
296:                 middle = parts[1].upper()
297:                 lookup[f"{first[0]} {middle[0]} {last}"] = full
298:                 lookup[f"{middle} {last}"] = full
299: 
300:     return lookup
301: 
302: 
303: def resolve_name(broadcast_name: str, lookup: dict[str, str]) -> str | None:
304:     """Resolve a broadcast name against the lookup table."""
305:     up = broadcast_name.upper().strip()
306:     for suffix in ("(C)", "(WK)", "(C/WK)", "(IMP)", "(WK/C)"):
307:         up = up.replace(suffix, "").strip()
308:     if up in lookup:
309:         return lookup[up]
310:     for key, canonical in lookup.items():
311:         if len(up) >= 4 and len(key) >= 4:
312:             if key.startswith(up) or up.startswith(key):
313:                 return canonical
314:     return None
315: 
316: 
317: def try_split_merged(broadcast_name: str, lookup: dict[str, str]) -> list[str] | None:
318:     """Try to split 'KING POWELL' into two known players."""
319:     up = broadcast_name.upper().strip()
320:     words = up.split()
321:     if len(words) < 2:
322:         return None
323:     for i in range(1, len(words)):
324:         left = " ".join(words[:i])
325:         right = " ".join(words[i:])
326:         left_match = resolve_name(left, lookup)
327:         right_match = resolve_name(right, lookup)
328:         if left_match and right_match and left_match != right_match:
329:             return [left_match, right_match]
330:     return None
331: 
332: 
333: # ------------------------------------------------------------------
334: # Convert scraped data to pipeline format
335: # ------------------------------------------------------------------
336: 
337: def squads_to_pipeline_format(data: dict) -> tuple[dict, dict[str, list[str]]]:
338:     """Convert scraped data to the format main.py expects.
339: 
340:     Returns: (raw_data, {"TeamA": [names], "TeamB": [names]})
341:     """
342:     squads: dict[str, list[str]] = {}
343: 
344:     for key in ("team_a", "team_b"):
345:         team = data[key]
346:         name = team["name"]
347:         xi_names = [p["name"] for p in team["playing_xi"]]
348:         bench_names = [p["name"] for p in team["bench"]]
349:         squads[name] = xi_names + bench_names
350: 
351:     return data, squads
352: 
353: 
354: def format_squad_roles(data: dict, team_key: str) -> str:
355:     """Format squad with positions and roles for the scorer prompt.
356: 
357:     e.g. '1. Brandon King — batter'
358:          '2. Johnson Charles — wk_batter (WK)'
359:          '6. Rovman Powell — batter (C)'
360:     """
361:     team = data.get(team_key, {})
362:     lines: list[str] = []
363:     for i, p in enumerate(team.get("playing_xi", []), 1):
364:         tags = []
365:         if p.get("captain"):
366:             tags.append("C")
367:         if p.get("keeper"):
368:             tags.append("WK")
369:         tag_str = f" ({','.join(tags)})" if tags else ""
370:         lines.append(f"  {i:2}. {p['name']} — {p['role']}{tag_str}")
371:     for p in team.get("bench", []):
372:         lines.append(f"  sub. {p['name']} — {p['role']}")
373:     return "\n".join(lines) if lines else "  (unknown)"
</file>

<file path="files/eyes/squads.py">
  1: """Squad loading — fetch any URL, use LLM to extract squads.
  2: 
  3: User pastes a URL (Cricbuzz, ESPNcricinfo, IPL official, anything).
  4: System fetches the page, feeds text to an LLM agent, gets structured
  5: squad data back. Works with any cricket site.
  6: """
  7: from __future__ import annotations
  8: 
  9: import json
 10: 
 11: import httpx
 12: from bs4 import BeautifulSoup
 13: 
 14: from eyes.config import GROQ_API_KEY, GROQ_PRIMARY_MODEL
 15: from eyes.cricket_logger import CricketLogger
 16: 
 17: log = CricketLogger("SQUAD")
 18: 
 19: GROQ_BASE_URL = "https://api.groq.com/openai/v1"
 20: 
 21: SQUAD_PROMPT = """\
 22: You are extracting cricket match squad information from a webpage.
 23: 
 24: PAGE CONTENT:
 25: {page_text}
 26: 
 27: Extract the following into JSON:
 28: {{
 29:   "team_a": {{
 30:     "name": "<full team name>",
 31:     "short": "<abbreviation like CSK, MI, ENG, WI>",
 32:     "playing_xi": ["Full Player Name", ...],
 33:     "impact_subs": ["Full Player Name", ...]
 34:   }},
 35:   "team_b": {{
 36:     "name": "<full team name>",
 37:     "short": "<abbreviation>",
 38:     "playing_xi": ["Full Player Name", ...],
 39:     "impact_subs": ["Full Player Name", ...]
 40:   }},
 41:   "toss": {{
 42:     "winner": "<team name>",
 43:     "decision": "bat|bowl"
 44:   }},
 45:   "venue": "<stadium name, city>",
 46:   "format": "T20|ODI|Test"
 47: }}
 48: 
 49: Rules:
 50: - Extract FULL player names (first + last), not just surnames.
 51: - playing_xi should have exactly 11 players per team.
 52: - impact_subs are extras beyond the XI (0-5 per team). Omit if none.
 53: - If toss info not available, set toss to null.
 54: - If any field isn't on the page, set it to null.
 55: - JSON only. No explanation.\
 56: """
 57: 
 58: 
 59: async def scrape_squads_from_url(url: str) -> dict | None:
 60:     """Fetch any URL, extract text, use LLM to get squad data."""
 61:     log.info(f"Fetching: {url}")
 62: 
 63:     try:
 64:         async with httpx.AsyncClient(timeout=20.0, follow_redirects=True) as client:
 65:             resp = await client.get(url, headers={
 66:                 "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) "
 67:                               "AppleWebKit/537.36 (KHTML, like Gecko) "
 68:                               "Chrome/120.0.0.0 Safari/537.36",
 69:                 "Accept": "text/html,application/xhtml+xml",
 70:             })
 71:             resp.raise_for_status()
 72:             html = resp.text
 73: 
 74:     except Exception as e:
 75:         log.error(f"Failed to fetch URL: {e}")
 76:         return None
 77: 
 78:     soup = BeautifulSoup(html, "lxml")
 79:     for tag in soup(["script", "style", "nav", "footer", "header", "iframe"]):
 80:         tag.decompose()
 81:     page_text = soup.get_text("\n", strip=True)
 82: 
 83:     # Truncate to fit in LLM context — keep first ~6000 chars
 84:     # which should cover squads, toss, venue on any cricket site
 85:     if len(page_text) > 6000:
 86:         page_text = page_text[:6000]
 87: 
 88:     log.info(f"Page text: {len(page_text)} chars. Sending to LLM...")
 89: 
 90:     prompt = SQUAD_PROMPT.format(page_text=page_text)
 91: 
 92:     try:
 93:         async with httpx.AsyncClient(timeout=30.0) as client:
 94:             resp = await client.post(
 95:                 f"{GROQ_BASE_URL}/chat/completions",
 96:                 json={
 97:                     "model": GROQ_PRIMARY_MODEL,
 98:                     "max_tokens": 800,
 99:                     "temperature": 0,
100:                     "messages": [{"role": "user", "content": prompt}],
101:                 },
102:                 headers={
103:                     "Authorization": f"Bearer {GROQ_API_KEY}",
104:                     "Content-Type": "application/json",
105:                 },
106:             )
107:             resp.raise_for_status()
108:             raw = resp.json()["choices"][0]["message"]["content"]
109:             return _parse_json(raw)
110: 
111:     except Exception as e:
112:         log.error(f"LLM squad extraction failed: {e}")
113:         return None
114: 
115: 
116: def _parse_json(raw: str) -> dict | None:
117:     text = raw.strip()
118:     if text.startswith("```"):
119:         lines = text.split("\n")
120:         text = "\n".join(lines[1:])
121:         if "```" in text:
122:             text = text[:text.index("```")]
123:         text = text.strip()
124:     try:
125:         return json.loads(text)
126:     except json.JSONDecodeError:
127:         start = text.find("{")
128:         end = text.rfind("}") + 1
129:         if start >= 0 and end > start:
130:             try:
131:                 return json.loads(text[start:end])
132:             except json.JSONDecodeError:
133:                 pass
134:         log.error(f"JSON parse failed: {text[:300]}")
135:         return None
136: 
137: 
138: def build_name_lookup(players: list[str]) -> dict[str, str]:
139:     """Map every plausible broadcast variant to the canonical full name."""
140:     lookup: dict[str, str] = {}
141:     for full in players:
142:         parts = full.strip().split()
143:         if not parts:
144:             continue
145:         up = full.upper().strip()
146:         lookup[up] = full
147: 
148:         if len(parts) >= 2:
149:             last = parts[-1].upper()
150:             first = parts[0].upper()
151:             lookup[last] = full
152:             lookup[f"{first[0]} {last}"] = full
153:             lookup[f"{first[0]}. {last}"] = full
154:             lookup[f"{last} {first[0]}"] = full
155:             lookup[f"{first} {last}"] = full
156: 
157:             if len(parts) == 3:
158:                 middle = parts[1].upper()
159:                 lookup[f"{first[0]} {middle[0]} {last}"] = full
160:                 lookup[f"{middle} {last}"] = full
161: 
162:     return lookup
163: 
164: 
165: def resolve_name(broadcast_name: str, lookup: dict[str, str]) -> str | None:
166:     """Resolve a broadcast name against the lookup table."""
167:     up = broadcast_name.upper().strip()
168:     for suffix in ("(C)", "(WK)", "(C/WK)", "(IMP)", "(WK/C)"):
169:         up = up.replace(suffix, "").strip()
170:     if up in lookup:
171:         return lookup[up]
172:     for key, canonical in lookup.items():
173:         if len(up) >= 4 and len(key) >= 4:
174:             if key.startswith(up) or up.startswith(key):
175:                 return canonical
176:     return None
177: 
178: 
179: def try_split_merged(broadcast_name: str, lookup: dict[str, str]) -> list[str] | None:
180:     """Try to split 'KING POWELL' into two known players."""
181:     up = broadcast_name.upper().strip()
182:     words = up.split()
183:     if len(words) < 2:
184:         return None
185:     for i in range(1, len(words)):
186:         left = " ".join(words[:i])
187:         right = " ".join(words[i:])
188:         left_match = resolve_name(left, lookup)
189:         right_match = resolve_name(right, lookup)
190:         if left_match and right_match and left_match != right_match:
191:             return [left_match, right_match]
192:     return None
193: 
194: 
195: async def load_squads_from_url(url: str) -> tuple[dict | None, dict[str, list[str]]]:
196:     """Fetch URL, extract squads via LLM, return (raw_data, squads_dict).
197: 
198:     squads_dict: {"Team A": ["Player 1", ...], "Team B": [...]}
199:     """
200:     data = await scrape_squads_from_url(url)
201:     if not data:
202:         return None, {}
203: 
204:     squads: dict[str, list[str]] = {}
205:     for key in ("team_a", "team_b"):
206:         team = data.get(key, {})
207:         if not team:
208:             continue
209:         name = team.get("short") or team.get("name", "Unknown")
210:         xi = team.get("playing_xi", [])
211:         subs = team.get("impact_subs", [])
212:         all_players = xi + (subs or [])
213:         if all_players:
214:             squads[name] = all_players
215:             log.info(f"  {name}: {len(xi)} XI + {len(subs or [])} subs")
216:             for p in all_players:
217:                 log.info(f"    - {p}")
218: 
219:     return data, squads
</file>

<file path="files/eyes/this_over.py">
   1: """ThisOverManager — single source of truth for ball-by-ball this-over data.
   2: 
   3: Local ball events are PRIMARY. Broadcast override only fills gaps.
   4: 
   5: Over transitions are a TWO-STAGE process:
   6:   1. The closing ball of an over (or an overs integer increment) marks
   7:      the over as "completed" — but the display KEEPS showing it.
   8:   2. The next over's display only resets when one of the following
   9:      happens: a new ball event arrives (real first ball of the next
  10:      over), the broadcast publishes a new over with the first ball
  11:      filled, or a time-based fallback elapses (~12s — enough for the
  12:      next bowler to walk to their mark).
  13: 
  14: This avoids two bugs:
  15:   (a) the "leaked closing ball" issue — clearing immediately at the
  16:       integer boundary then having a stale broadcast override
  17:       repopulate `this_over` with the previous over's tokens
  18:       ("4 . _ _ _ _" appearing as ball 1 of the new over).
  19:   (b) UX whiplash where the just-completed over disappears before
  20:       the user has a chance to read it.
  21: """
  22: from __future__ import annotations
  23: 
  24: import time
  25: 
  26: from eyes.cricket_logger import CricketLogger
  27: 
  28: log = CricketLogger("OVER")
  29: 
  30: # Hold completed over visible for this long if no new ball/over is
  31: # observed. Tunes the gap between overs (between-over breaks in T20
  32: # are ~40-60s, but new bowler's first delivery usually lands within
  33: # 30s; 12s is enough to read the closing ball cleanly while still
  34: # guaranteeing the display catches up before ball 2 of the next over).
  35: COMPLETED_OVER_HOLD_S = 3.0
  36: 
  37: # Cricket invariant: a single over cannot exceed 6 legal deliveries
  38: # plus extras (wides + no-balls). Realistically extras-per-over caps at
  39: # ~3 even on bad days; anything beyond 9 tokens is the broadcast's
  40: # multi-over recap ribbon (which IPL/PL graphics frequently flash —
  41: # showing the LAST 3 OVERS as one wide strip during between-overs
  42: # breaks). If Scout reads that strip and feeds it to us as
  43: # "this_over_broadcast", we must reject it: we cannot tell which 6
  44: # of the 18 tokens belong to the current over.
  45: #
  46: # Tokens that originated from real, observed ball events
  47: # (`on_ball_event`) are NEVER subject to this cap — they are ground
  48: # truth. The cap only governs broadcast-sourced (vision-derived)
  49: # wholesale acceptance.
  50: MAX_THIS_OVER_LEN = 9
  51: 
  52: # Hard upper bound on observed (`on_ball_event`-sourced) tokens in a
  53: # single over. If we ever exceed this with real events, it means
  54: # `check_over_change` failed to fire at the over boundary (e.g. Scout
  55: # briefly misread overs to a wrong value, or the broadcast strip
  56: # refresh lagged). Past this point we refuse to extend the list — the
  57: # UI is better served by a stable too-short over than an ever-growing
  58: # multi-over blob.
  59: MAX_OBSERVED_THIS_OVER_LEN = 12
  60: 
  61: # Bug (2026-04-20): the last ball of the over was often missing from
  62: # `this_over`. Root cause: `_inn.overs` can advance to "X+1.0" via a
  63: # direct/SM write path in the same frame where `_tracker.overs` is
  64: # still at "X.5", so the BallEventDetector (which reads from the
  65: # tracker) doesn't fire the closing-ball event. Then
  66: # `check_over_change("X+1.0")` archives `this_over` with only 5
  67: # observed legal balls, the 6-token state never materialises, and
  68: # the hold-window expires with the 5-ball ribbon being the last
  69: # state the UI ever sees.
  70: #
  71: # Fix: when `check_over_change` is asked to roll over while
  72: # `this_over` has fewer than 6 legal balls, defer the rollover for
  73: # up to ROLLOVER_MAX_DEFER_FRAMES frames. In the deferred frames
  74: # the tracker usually catches up, BallEventDetector fires the
  75: # closing ball, and on_ball_event appends it (growing the ribbon
  76: # to 6 legal). The next check_over_change call then archives
  77: # cleanly. If the detector still hasn't fired after the grace
  78: # window, archive with whatever we have (current behaviour) — the
  79: # UI is better served by eventual progress than an infinite hold.
  80: ROLLOVER_MAX_DEFER_FRAMES = 2
  81: 
  82: 
  83: class ThisOverManager:
  84: 
  85:     def __init__(self):
  86:         self.this_over: list[str] = []
  87:         self.this_over_sources: list[str] = []  # "obs" or "bcast" per ball
  88:         self.over_history: dict[int, dict] = {}
  89:         self._last_over_int: int | None = None
  90:         self._over_start_score: int | None = None
  91:         self._last_ball_event: dict | None = None
  92:         # Pending-clear bookkeeping (see module docstring).
  93:         # When set, `this_over` is the JUST-COMPLETED over and we are
  94:         # waiting for the new over to actually start before resetting.
  95:         self._pending_clear: bool = False
  96:         self._pending_clear_at: float | None = None
  97:         self._pending_clear_over_int: int | None = None
  98:         # Bowler that bowled the held over. Used to flush the held
  99:         # over the moment the broadcast confirms a different bowler
 100:         # is now bowling — cricket forbids consecutive overs by the
 101:         # same bowler, so a confirmed-different bowler is a definitive
 102:         # "the new over has started" signal.
 103:         self._held_over_bowler: str | None = None
 104:         # SCORE-GATED MUTATION GUARD. `this_over` is the on-screen
 105:         # ball ribbon and the user's hard rule is "linked to score
 106:         # alone". A new circle (legal ball, wide, no-ball, wicket)
 107:         # can ONLY appear after the team score advances OR the team
 108:         # overs advance — both are score-state changes the BallEvent
 109:         # detector picks up. The broadcast strip ("Wd Wd 1 .") flips
 110:         # every frame as the LLM re-reads it and historically was
 111:         # allowed to mutate this_over on its own; that produced the
 112:         # "flicker to 1 then back to Wd" the user keeps seeing. Track
 113:         # the score at which the last mutation happened and refuse
 114:         # broadcast-driven writes until score moves again.
 115:         self._last_mutation_score: int | None = None
 116:         self._last_mutation_overs: str | None = None
 117:         # Bug #12: cache the last bowler we observed bowling THIS over.
 118:         # `current_bowler` from the broadcast strip is frequently None
 119:         # for 1-3 frames around an over boundary (the strip clears
 120:         # while the new bowler walks up). Without a cache, the over
 121:         # archive locks in `bowler=None` permanently.
 122:         self._current_over_bowler: str | None = None
 123:         # Defer counter for the short-over rollover guard (see
 124:         # ROLLOVER_MAX_DEFER_FRAMES docstring). Reset to 0 whenever we
 125:         # actually archive an over so each rollover gets a fresh budget.
 126:         self._rollover_defer_count: int = 0
 127: 
 128:     def reset(self) -> None:
 129:         """Wipe all state for a fresh innings (Bug #14).
 130: 
 131:         Without this, over_history from innings 1 leaks into the
 132:         Recent Overs panel of innings 2, and `_last_over_int`
 133:         retained from innings 1 (e.g. 19) blocks check_over_change
 134:         from firing for innings 2's overs (0..N) since they appear
 135:         to go backwards.
 136:         """
 137:         self.this_over = []
 138:         self.this_over_sources = []
 139:         self.over_history = {}
 140:         self._last_over_int = None
 141:         self._over_start_score = None
 142:         self._last_ball_event = None
 143:         self._pending_clear = False
 144:         self._pending_clear_at = None
 145:         self._pending_clear_over_int = None
 146:         self._current_over_bowler = None
 147:         self._held_over_bowler = None
 148:         self._rollover_defer_count = 0
 149:         log.info("[OVER] Manager reset for new innings")
 150: 
 151:     def resync_to_over(self, overs: str | float | None,
 152:                        reason: str = "recovery") -> None:
 153:         """Clear stale current-over state and align cursor to team overs."""
 154:         if overs is None:
 155:             return
 156:         try:
 157:             over_int = int(float(overs))
 158:         except (TypeError, ValueError):
 159:             return
 160:         self.this_over = []
 161:         self.this_over_sources = []
 162:         self._last_over_int = over_int
 163:         self._over_start_score = None
 164:         self._last_ball_event = None
 165:         self._pending_clear = False
 166:         self._pending_clear_at = None
 167:         self._pending_clear_over_int = None
 168:         self._current_over_bowler = None
 169:         self._held_over_bowler = None
 170:         self._rollover_defer_count = 0
 171:         log.info(
 172:             f"[OVER-RESYNC] Cursor aligned to over {over_int} "
 173:             f"from team_overs={overs!r} ({reason}); cleared current tokens")
 174: 
 175:     def _consume_pending_clear(self, reason: str) -> None:
 176:         """Reset display to start of the new over.
 177: 
 178:         Called when there's evidence the next over has actually
 179:         started: a new ball event, a broadcast showing fresh tokens,
 180:         a fractional overs advance, or the hold-window timeout.
 181:         """
 182:         if not self._pending_clear:
 183:             return
 184:         log.info(
 185:             f"Completed over flushed ({reason}): "
 186:             f"{self.this_over} → []")
 187:         self.this_over = []
 188:         self.this_over_sources = []
 189:         self._pending_clear = False
 190:         self._pending_clear_at = None
 191:         self._pending_clear_over_int = None
 192:         self._held_over_bowler = None
 193: 
 194:     def on_ball_event(self, event: dict | None,
 195:                       score: int | None = None) -> None:
 196:         if event is None:
 197:             return
 198:         # Score-gated mutation marker: every ball event was triggered
 199:         # by a score (or overs) state change upstream, so any append
 200:         # below MUST advance `_last_mutation_score` to the new score.
 201:         # That unlocks the next broadcast-driven gap-fill while the
 202:         # CURRENT score still locks out broadcast flicker.
 203:         if score is not None:
 204:             try:
 205:                 self._last_mutation_score = int(score)
 206:             except (ValueError, TypeError):
 207:                 pass
 208: 
 209:         # Determine which over this event LOGICALLY belongs to.
 210:         #
 211:         # Per cricket convention the team-overs counter ticks to "X.0"
 212:         # only AFTER the 6th legal ball of over X-1. So an event whose
 213:         # `over` field reads "6.0" was actually bowled DURING over 5
 214:         # (it IS the 6th ball of over 5). An event reading "6.1" is
 215:         # the 1st ball of over 6.
 216:         #
 217:         # This matters for the held-over flush. BallEventDetector
 218:         # operates on per-frame deltas; it can produce a queued legal
 219:         # event one frame late (the wide/legal-decomposition path
 220:         # appends `legal_event` to `_event_queue` and emits the EXTRA
 221:         # first). When that queued event finally fires, the team-overs
 222:         # reading at queue-emit time is whatever the latest frame
 223:         # carried — which is "6.0" or even "6.1" if the broadcast was
 224:         # ahead. Without the fractional-aware mapping below the held
 225:         # completed over (5) gets flushed and the late ball is shown
 226:         # as ball 1 of over 6 — exactly the visible "last ball bleeds
 227:         # into next over" bug.
 228:         ev_over_logical: int | None = None
 229:         ev_over_str = event.get("over") if isinstance(event, dict) else None
 230:         if ev_over_str is not None:
 231:             try:
 232:                 _v = float(ev_over_str)
 233:                 _v_int = int(_v)
 234:                 _v_frac = round((_v % 1) * 10)
 235:                 if _v_frac == 0 and _v_int > 0:
 236:                     # "X.0" → 6th ball of over X-1
 237:                     ev_over_logical = _v_int - 1
 238:                 else:
 239:                     ev_over_logical = _v_int
 240:             except (ValueError, TypeError):
 241:                 ev_over_logical = None
 242: 
 243:         # Late ball event for the just-completed (held) over.
 244:         # Append to the held this_over and update the held over's
 245:         # archive. Do NOT flush.
 246:         #
 247:         # Two ways an event can be identified as "late":
 248:         #
 249:         #   (a) Its `over` field decodes to the held over (e.g. "6.0"
 250:         #       → over 5).  Reliable when the broadcast strip stayed
 251:         #       at "X.0" while the score updated.
 252:         #
 253:         #   (b) Cricket-rules fallback: if the held over does not yet
 254:         #       contain 6 legal balls, the next ball MUST belong to it
 255:         #       — the new over cannot start until the old bowler has
 256:         #       bowled 6 legal deliveries.  This catches the case
 257:         #       where the team-overs string already advanced to "X.1"
 258:         #       by the time the late delta materialised, so the
 259:         #       event's own `over` field reads "X.1" and (a) misses.
 260:         #       Without this fallback the late ball gets attributed
 261:         #       to ball-1 of the new over and bleeds into it.
 262:         if self._pending_clear:
 263:             held_int = self._pending_clear_over_int
 264:             held_legal = 0
 265:             archived = (self.over_history.get(held_int) if held_int is not None
 266:                         else None)
 267:             if archived and isinstance(archived.get("balls"), list):
 268:                 held_legal = sum(
 269:                     1 for x in archived["balls"]
 270:                     if str(x).lower() not in ("wd", "nb")
 271:                     and not str(x).lower().startswith("wd")
 272:                     and not str(x).lower().startswith("nb"))
 273:             late_by_overs = (held_int is not None
 274:                              and ev_over_logical is not None
 275:                              and ev_over_logical == held_int)
 276:             late_by_count = (held_int is not None and held_legal < 6)
 277:             if late_by_overs or late_by_count:
 278:                 if late_by_count and not late_by_overs:
 279:                     log.info(
 280:                         f"Late ball routed to held over {held_int} by "
 281:                         f"cricket-rules fallback: held has {held_legal} "
 282:                         f"legal balls (< 6), event over="
 283:                         f"{event.get('over') if isinstance(event, dict) else '?'}")
 284:                 self._append_to_held_and_rearchive(event)
 285:                 return
 286: 
 287:         # First real ball of the new over → flush the held completed
 288:         # over now (don't wait for the timeout). Synthesised boundary
 289:         # balls injected by check_over_change set
 290:         # _last_ball_event but they're attributed to the OLD over
 291:         # (over=f"{old_int}.6"); they don't belong to the new over,
 292:         # so don't flush on those.
 293:         if self._pending_clear:
 294:             self._consume_pending_clear("ball event in new over")
 295: 
 296:         # Defence-in-depth cap on observed extensions. If we ever try
 297:         # to append a 13th token to this_over via real ball events,
 298:         # something upstream is broken — `check_over_change` should
 299:         # have fired and reset us at the over boundary. Refuse the
 300:         # append rather than letting the list grow without bound;
 301:         # that's the visible bug ("12-circle this over").
 302:         # DRS_WIDE replaces the last token (no length growth) — allow
 303:         # it through so an in-flight DRS can still correct the last
 304:         # ball. Everything else is blocked.
 305:         _drs_replace = (isinstance(event, dict)
 306:                         and event.get("type") == "DRS_WIDE")
 307:         if (not _drs_replace
 308:                 and len(self.this_over) >= MAX_OBSERVED_THIS_OVER_LEN):
 309:             log.info(
 310:                 f"on_ball_event refused: this_over already has "
 311:                 f"{len(self.this_over)} tokens "
 312:                 f"(>= MAX_OBSERVED_THIS_OVER_LEN). "
 313:                 f"Likely missed over rollover — event dropped: "
 314:                 f"{event}")
 315:             return
 316: 
 317:         # Bug #12: capture the bowler attached to this ball event. The
 318:         # bowler who bowled this delivery is, by definition, the bowler
 319:         # of the current over — which is exactly what over_history
 320:         # needs at archive time. Trust this over the live-strip
 321:         # `current_bowler` (which can flip to the next bowler as soon
 322:         # as the broadcast graphic refreshes).
 323:         #
 324:         # FIRST-WRITE-WINS for the over bowler: once we've recorded a
 325:         # non-None bowler for this over, never overwrite it from a
 326:         # later event.  Critical at the over boundary — the broadcast
 327:         # frequently flips its bowler-strip to the NEXT over's bowler
 328:         # in the very same frame that the last ball of the current
 329:         # over lands.  Without first-write-wins the late ball event
 330:         # carries the wrong bowler (next-over-bowler) and that's what
 331:         # gets archived for the just-completed over.  Cricket never
 332:         # permits the same bowler to bowl consecutive overs, so once
 333:         # we've seen a bowler for an over, that's the one.  The
 334:         # next-over rollover (`check_over_change`) clears the cache.
 335:         _ev_bowler = event.get("bowler") if isinstance(event, dict) else None
 336:         if _ev_bowler and not self._current_over_bowler:
 337:             self._current_over_bowler = _ev_bowler
 338: 
 339:         self._append_event_token(event)
 340: 
 341:     def _append_to_held_and_rearchive(self, event: dict) -> None:
 342:         """Append a late ball event to the just-completed (held) over.
 343: 
 344:         Triggered when `on_ball_event` receives an event whose logical
 345:         over matches `_pending_clear_over_int`. The event was bowled
 346:         DURING the held over but reached us after the over rollover
 347:         (typical cause: BallEventDetector's wide-decomposition queues
 348:         the legal delivery for the next frame). We must not flush the
 349:         hold — the token belongs at the END of the held this_over,
 350:         not at the start of the new over.
 351:         """
 352:         held_int = self._pending_clear_over_int
 353:         # Defence-in-depth: at most 12 tokens for a single over even
 354:         # when extras pile up.
 355:         if len(self.this_over) >= MAX_OBSERVED_THIS_OVER_LEN:
 356:             log.info(
 357:                 f"Late ball for held over {held_int} REFUSED: "
 358:                 f"this_over already has {len(self.this_over)} tokens "
 359:                 f"(>= MAX_OBSERVED_THIS_OVER_LEN). Dropped: {event}")
 360:             return
 361: 
 362:         before = list(self.this_over)
 363:         self._append_event_token(event)
 364: 
 365:         # The held over was already archived to over_history at the
 366:         # boundary. The late append changes its contents — we must
 367:         # rewrite that one entry. This is the ONLY sanctioned
 368:         # in-place mutation of over_history (first-write-wins still
 369:         # applies to every other path); the over has not been
 370:         # finalised on the user-facing display yet (the hold window
 371:         # is still open).
 372:         if held_int is not None:
 373:             existing = self.over_history.get(held_int)
 374:             archive_payload = {
 375:                 "balls": self.this_over.copy(),
 376:                 "bowler": (existing.get("bowler") if existing
 377:                            else self._current_over_bowler),
 378:                 "runs": sum(int(x) for x in self.this_over
 379:                             if isinstance(x, str) and x.isdigit()),
 380:                 "wickets": sum(1 for x in self.this_over if x == "W"),
 381:             }
 382:             self.over_history[held_int] = archive_payload
 383:             log.info(
 384:                 f"Late ball appended to held over {held_int}: "
 385:                 f"{before} → {self.this_over} (event over="
 386:                 f"{event.get('over') if isinstance(event, dict) else '?'})")
 387:         else:
 388:             log.info(
 389:                 f"Late ball appended to held over (no over_int): "
 390:                 f"{before} → {self.this_over}")
 391: 
 392:     def _append_event_token(self, event: dict) -> None:
 393:         """Append the token for `event` to `self.this_over`.
 394: 
 395:         Extracted from `on_ball_event` so the late-event-for-held-over
 396:         path can reuse the exact same per-event token logic without
 397:         re-running the flush/cap guards (those are decided by the
 398:         caller).
 399:         """
 400:         # NOTE: type-specific dispatches MUST come before the generic
 401:         # `event.get("certain")` branch — an EXTRA event also carries
 402:         # `certain: True` and would otherwise be appended as a digit
 403:         # (the run count) instead of the "Wd"/"Nb" token. Same risk
 404:         # applies to MULTI_BALL and DRS_* events; keep them above.
 405:         _ev_type = event.get("type")
 406:         if _ev_type == "WICKET_LATE":
 407:             # Broadcast wickets reading lagged the overs reading by
 408:             # 1 frame: we already appended a DOT/run for the wicket
 409:             # ball — replace it with 'W' instead of inserting a
 410:             # phantom new ball. Handled BEFORE the generic certain
 411:             # branch so the existing DOT/N token is upgraded
 412:             # in place rather than a second 'W' appended.
 413:             if self.this_over:
 414:                 removed = self.this_over.pop()
 415:                 if self.this_over_sources:
 416:                     self.this_over_sources.pop()
 417:                 log.info(f"Late wicket: replaced last token "
 418:                          f"'{removed}' → 'W'")
 419:             self.this_over.append("W")
 420:             self.this_over_sources.append("obs")
 421:         elif _ev_type == "EXTRA":
 422:             extra_type = event.get("extra_type", "wide_or_noball")
 423:             if "no_ball" in extra_type:
 424:                 token = "Nb"
 425:             else:
 426:                 token = "Wd"
 427:             runs = event.get("runs", 1)
 428:             if runs > 1:
 429:                 token = f"{token}+{runs - 1}"
 430:             self.this_over.append(token)
 431:             self.this_over_sources.append("obs")
 432:             log.info(f"Extra detected — added '{token}' ({extra_type})")
 433:         elif _ev_type == "DRS_WIDE":
 434:             if self.this_over:
 435:                 removed = self.this_over.pop()
 436:                 if self.this_over_sources:
 437:                     self.this_over_sources.pop()
 438:                 log.info(f"DRS wide: replaced '{removed}' → 'wd'")
 439:             self.this_over.append("wd")
 440:             self.this_over_sources.append("obs")
 441:         elif _ev_type == "DRS_NOT_OUT":
 442:             log.info("DRS not-out — no this-over change")
 443:         elif event.get("certain"):
 444:             t = _ev_type
 445:             if t == "WICKET":
 446:                 self.this_over.append("W")
 447:             elif t == "DOT":
 448:                 self.this_over.append(".")
 449:             elif t == "FOUR":
 450:                 self.this_over.append("4")
 451:             elif t == "SIX":
 452:                 self.this_over.append("6")
 453:             else:
 454:                 r = event.get("runs", 0)
 455:                 if event.get("extras_type") == "leg_bye_or_bye":
 456:                     self.this_over.append(f"{r}lb")
 457:                 else:
 458:                     self.this_over.append(str(r) if r > 0 else ".")
 459:             self.this_over_sources.append("obs")
 460:         elif event.get("type") == "MULTI_BALL":
 461:             missed = event.get("balls_missed", 0)
 462:             total_r = event.get("total_runs", 0)
 463:             # Cap at 6 — we can only have 6 legal deliveries in
 464:             # the current over; anything beyond means overs were
 465:             # skipped and check_over_change will handle the reset.
 466:             capped = min(missed, 6 - len(self.this_over))
 467:             capped = max(capped, 0)
 468:             for _ in range(capped):
 469:                 self.this_over.append("?")
 470:                 self.this_over_sources.append("obs")
 471:             log.info(f"Missed {missed} balls (+{total_r} runs) — "
 472:                      f"added {capped} placeholders (capped from {missed})")
 473: 
 474:     def pop_last_extra(self, reason: str = "") -> bool:
 475:         """Remove the trailing token if it's an EXTRA (Wd/Nb/+N).
 476: 
 477:         Defense-in-depth for retracted phantom extras: the EXTRA-IMMEDIATE
 478:         path can fire on a single misread frame (broadcast WD strip
 479:         flickers, or score-digit OCR jitters +1).  When a downstream
 480:         consumer (the unsupported-score-spike guard, or a confirmed
 481:         score regression in the next frame) determines the EXTRA was
 482:         not real, this method peels it off `this_over` so the UI's
 483:         pill doesn't carry a phantom Wd/Nb token until the over rolls.
 484: 
 485:         Only pops EXTRA tokens (Wd, Nb, Wd+N, Nb+N).  Refuses to pop
 486:         legal-ball tokens ('.', '1'-'6', 'W') because those are not
 487:         the bug class we're guarding against and a wrongful pop here
 488:         would silently delete a real delivery.
 489: 
 490:         Returns True if a pop happened.
 491:         """
 492:         if not self.this_over:
 493:             return False
 494:         last = self.this_over[-1]
 495:         is_extra = (
 496:             isinstance(last, str)
 497:             and (last.startswith("Wd") or last.startswith("Nb")
 498:                  or last.startswith("wd") or last.startswith("nb")))
 499:         if not is_extra:
 500:             log.info(
 501:                 f"[ROLLBACK] refused — last token '{last}' is not an "
 502:                 f"EXTRA (only Wd/Nb may be rolled back). reason={reason}")
 503:             return False
 504:         removed = self.this_over.pop()
 505:         if self.this_over_sources:
 506:             self.this_over_sources.pop()
 507:         log.info(
 508:             f"[ROLLBACK] popped extra token '{removed}' from this_over "
 509:             f"(now={self.this_over}). reason={reason}")
 510:         return True
 511: 
 512:     def on_broadcast_override(self, data: list | None,
 513:                               score: int | None = None) -> None:
 514:         """Use broadcast data to fill gaps — never overwrite observed.
 515: 
 516:         Immutability principle: confirmed history is permanent. The
 517:         broadcast is permitted to FILL `?` placeholders and (only via
 518:         an explicit DRS event from `on_ball_event`) to overwrite the
 519:         LAST token. It cannot:
 520:           * Overwrite any non-`?` token that isn't the last
 521:           * Extend `this_over` beyond its current length
 522:           * Re-seed a non-empty `this_over`
 523: 
 524:         SCORE-GATED MUTATION (the user's hard rule): the broadcast
 525:         strip flips every frame as the LLM re-reads it; that's the
 526:         flicker root cause. `this_over` mutates ONLY when score
 527:         advances. Until score moves past `_last_mutation_score`, all
 528:         broadcast writes are refused — even gap-fills — so the strip
 529:         cannot mutate the displayed circles between balls.
 530: 
 531:         Cold-start (no prior mutation recorded) is exempt so the
 532:         initial join still gets a sensible mid-over fill.
 533:         """
 534:         if not data:
 535:             return
 536: 
 537:         if (self._last_mutation_score is not None
 538:                 and score is not None
 539:                 and int(score) <= int(self._last_mutation_score)):
 540:             log.info(
 541:                 f"Broadcast {data} ignored — score "
 542:                 f"{score} has not advanced past last mutation "
 543:                 f"({self._last_mutation_score}); this_over is "
 544:                 f"score-gated.")
 545:             return
 546: 
 547:         broadcast = self._merge_broadcast(
 548:             [str(x).lower().strip() for x in data])
 549: 
 550:         # Token-alphabet validation.  The broadcast `THIS OVER:`
 551:         # field is occasionally polluted by adjacent strip
 552:         # overlays (most often the per-ball-speed track that
 553:         # sits directly above the run-track on production
 554:         # graphics).  Scout reads both as text and OCR doesn't
 555:         # reliably distinguish `THIS OVER:` from `SPEED:`.
 556:         # Without this gate the pipeline ingests speed numbers
 557:         # as run-tokens, archiving nonsense overs like
 558:         # `[139, 148, 143, 147, 145, 140] = 862 runs`
 559:         # (RR-vs-SRH 2026-04-25 F2461; class active
 560:         # intermittently since 2026-04-16).  A single illegal
 561:         # token is a strong signal that the whole strip was
 562:         # misread, so reject the entire list rather than try
 563:         # to filter — partial acceptance leaves us with a
 564:         # silently truncated over and the same UX bug surface.
 565:         _illegal = [t for t in broadcast
 566:                     if not self._is_legal_run_token(t)]
 567:         if _illegal:
 568:             log.warn(
 569:                 f"[TOKEN-VALIDATE] Rejecting broadcast tokens "
 570:                 f"{broadcast} — illegal token(s) {_illegal} "
 571:                 f"outside cricket-scorecard alphabet (likely "
 572:                 f"speed-track misread or adjacent-strip OCR "
 573:                 f"pollution)")
 574:             return
 575: 
 576:         # Multi-over recap rejection. The broadcast frequently shows
 577:         # the LAST 3 OVERS as one wide ribbon during between-overs
 578:         # breaks ("18-token strip"). Scout reads that as "this_over"
 579:         # and we cannot tell which 6 belong to the current over —
 580:         # reject wholesale. on_broadcast_override is only allowed to
 581:         # touch the current over.
 582:         if len(broadcast) > MAX_THIS_OVER_LEN:
 583:             log.info(
 584:                 f"Broadcast {broadcast} ({len(broadcast)} tokens) "
 585:                 f"exceeds MAX_THIS_OVER_LEN={MAX_THIS_OVER_LEN} — "
 586:                 f"rejected as multi-over recap strip")
 587:             return
 588: 
 589:         # While holding a just-completed over, ignore broadcast updates
 590:         # that match the held over (Scout is still reading the
 591:         # previous-over strip during the between-overs gap). Only
 592:         # accept a broadcast that's clearly the NEW over (much
 593:         # shorter — 0 or 1 token) which signals the next over has
 594:         # started on the broadcast.
 595:         if self._pending_clear:
 596:             held = [x for x in self.this_over
 597:                     if str(x).lower() not in ("wd", "nb")]
 598:             if len(broadcast) >= len(held) - 1:
 599:                 # Same-length-or-larger broadcast while holding =>
 600:                 # almost certainly the stale previous-over strip.
 601:                 log.info(
 602:                     f"Broadcast {broadcast} ignored "
 603:                     f"(holding completed over {self.this_over})")
 604:                 return
 605:             # Broadcast is shorter than the held over — new over has
 606:             # started on the strip. Flush and accept.
 607:             self._consume_pending_clear("broadcast shows new over")
 608: 
 609:         # Empty local → accept broadcast wholesale, BUT only on cold
 610:         # start (we're joining mid-innings and have no observations
 611:         # of our own). Once we're warm (_last_over_int set), local
 612:         # being empty means we just transitioned overs and are
 613:         # waiting for the next ball event — accepting a broadcast
 614:         # full of '?' tokens (Scout misread) would freeze phantom
 615:         # placeholders into the new over. Filter '?' tokens out of
 616:         # the wholesale accept to keep observations clean.
 617:         if not self.this_over:
 618:             cold = self._last_over_int is None
 619:             if cold:
 620:                 self.this_over = broadcast
 621:                 self.this_over_sources = ["bcast"] * len(broadcast)
 622:                 log.info(
 623:                     f"Broadcast fill (cold-start, empty local): "
 624:                     f"{self.this_over}")
 625:                 return
 626:             # Warm-mode wholesale accept: only if the broadcast has
 627:             # zero '?' tokens (otherwise wait for real ball events).
 628:             if any(t == "?" for t in broadcast):
 629:                 log.info(
 630:                     f"Broadcast {broadcast} has '?' tokens "
 631:                     f"(warm-mode, empty local) — ignoring, will "
 632:                     f"wait for ball events")
 633:                 return
 634:             self.this_over = broadcast
 635:             self.this_over_sources = ["bcast"] * len(broadcast)
 636:             log.info(
 637:                 f"Broadcast fill (warm, empty local, "
 638:                 f"clean tokens): {self.this_over}")
 639:             return
 640: 
 641:         # If broadcast is shorter but local has ? slots, still fill them
 642:         has_gaps = any(b == "?" for b in self.this_over)
 643:         if len(broadcast) < len(self.this_over) and not has_gaps:
 644:             log.info(f"Broadcast {broadcast} shorter than "
 645:                      f"local {self.this_over} (no gaps) — ignored")
 646:             return
 647: 
 648:         # Count observed (non-?) balls in local
 649:         obs_count = sum(1 for i, b in enumerate(self.this_over)
 650:                         if b != "?"
 651:                         and i < len(self.this_over_sources)
 652:                         and self.this_over_sources[i] == "obs")
 653: 
 654:         if obs_count == 0:
 655:             # All local is placeholder/bcast → safe to replace
 656:             self.this_over = broadcast
 657:             self.this_over_sources = ["bcast"] * len(broadcast)
 658:             log.info(f"Broadcast replaces all-placeholder local: "
 659:                      f"{self.this_over}")
 660:             return
 661: 
 662:         # Only fill ? positions within the existing range —
 663:         # never extend local from broadcast (new balls come only
 664:         # from on_ball_event or MULTI_BALL placeholders).
 665:         old = self.this_over[:]
 666:         merged = list(self.this_over)
 667:         merged_src = list(self.this_over_sources)
 668: 
 669:         filled = 0
 670:         for i in range(len(merged)):
 671:             if merged[i] == "?" and i < len(broadcast):
 672:                 merged[i] = broadcast[i]
 673:                 if i < len(merged_src):
 674:                     merged_src[i] = "bcast"
 675:                 filled += 1
 676: 
 677:         if filled > 0:
 678:             log.info(f"Broadcast filled {filled} gaps: {old} → {merged}")
 679:             self.this_over = merged
 680:             self.this_over_sources = merged_src
 681:         else:
 682:             log.info(f"Broadcast {broadcast} — no gaps to fill in "
 683:                      f"local {self.this_over}")
 684: 
 685:     def reorder_wicket_to_ball(self, ball_index_in_over: int) -> bool:
 686:         """Move the W token in `this_over` so it occupies the
 687:         N-th legal-ball position, where N = `ball_index_in_over`.
 688: 
 689:         Triggered from the FOW-upgrade callback: when a placeholder
 690:         FOW entry is upgraded with a real `overs="X.Y"`, we know
 691:         the wicket actually fell on the Y-th legal ball of over X.
 692:         Without reordering, `this_over` token order reflects
 693:         broadcast-detection time, which is misleading whenever the
 694:         wickets ticker animates faster than the score ticker (the
 695:         RR-vs-SRH 2026-04-25 inn-2 over-0 case: real chronological
 696:         order `[., ., ., Wd, 6, W]`, observed `[., ., ., Wd, W, 6]`
 697:         because the W graphic surfaced ~45 s before the boundary
 698:         score caught up).
 699: 
 700:         Legal-ball position counts only deliveries that consume a
 701:         ball: digit tokens (`.`, `0..7`), bye / leg-bye tokens
 702:         (`Nb`, `Nlb`), and `W`.  Extras-only tokens (`Wd`, `Nb`,
 703:         and compound forms `Wd+N` / `Nb+N`) do not advance the
 704:         legal-ball counter.
 705: 
 706:         Returns True if a reorder happened, False otherwise (no W
 707:         present, or W already at the correct legal-ball position).
 708:         """
 709:         try:
 710:             target = int(ball_index_in_over)
 711:         except (TypeError, ValueError):
 712:             return False
 713:         if target <= 0 or "W" not in self.this_over:
 714:             return False
 715: 
 716:         def _is_pure_extra(t: str) -> bool:
 717:             # Wides / no-balls (raw or compound) — do not consume a ball.
 718:             return (t == "Wd" or t == "Nb"
 719:                     or t.startswith("Wd+") or t.startswith("Nb+"))
 720: 
 721:         cur_w_idx = self.this_over.index("W")
 722:         # Current legal-ball position of W (1-indexed: a W with
 723:         # zero non-extra tokens before it is the 1st legal ball).
 724:         cur_legal_pos = sum(
 725:             1 for t in self.this_over[:cur_w_idx + 1]
 726:             if not _is_pure_extra(t))
 727: 
 728:         if cur_legal_pos == target:
 729:             return False  # already in the right place
 730: 
 731:         # Pop W (and matching source slot) from current position.
 732:         self.this_over.pop(cur_w_idx)
 733:         if cur_w_idx < len(self.this_over_sources):
 734:             popped_src = self.this_over_sources.pop(cur_w_idx)
 735:         else:
 736:             popped_src = "fow_upgrade"
 737: 
 738:         # Find the smallest insertion index where exactly
 739:         # `target - 1` legal balls precede W, so W itself becomes
 740:         # the target-th legal ball after insertion.  Iterating
 741:         # all candidate slots (0..len) is O(N²) on a 6-9 element
 742:         # list — fine for this hot path.
 743:         insert_at = len(self.this_over)
 744:         for cand in range(len(self.this_over) + 1):
 745:             legal_before = sum(
 746:                 1 for t in self.this_over[:cand]
 747:                 if not _is_pure_extra(t))
 748:             if legal_before == target - 1:
 749:                 insert_at = cand
 750:                 break
 751: 
 752:         self.this_over.insert(insert_at, "W")
 753:         if insert_at <= len(self.this_over_sources):
 754:             self.this_over_sources.insert(insert_at, popped_src)
 755:         else:
 756:             self.this_over_sources.append(popped_src)
 757: 
 758:         log.info(
 759:             f"[FOW-REORDER] W repositioned from legal-ball "
 760:             f"{cur_legal_pos} → {target} (FOW upgrade): "
 761:             f"this_over={self.this_over}")
 762:         return True
