4237:     # === S17: dismissal-hint ring buffer ===
4238:     # The wicket frame itself often carries no dismissal_mode in the
4239:     # broadcast strip — the "BOWLED b. Narine" graphic can fire 1-3
4240:     # frames BEFORE the score updates to W+1, and the action LLM has
4241:     # already described the dismissal in plain English ("walking off
4242:     # after getting stumped"). When the WICKET event finally fires we
4243:     # scan this buffer for the most recent hint, so the FOW entry +
4244:     # `dismissal_mode` payload field carry the right kind. Five-frame
4245:     # window ≈ 2.5s at burst rate — wide enough to catch the broadcast
4246:     # graphic, narrow enough to not pick up the previous wicket.
4247:     # Was 5 — too short.  The extractor commonly takes 10-20 frames
4248:     # to surface a new batter after a wicket (broadcast cuts to slow-
4249:     # motion replays, dismissal graphics, crowd reactions before the
4250:     # incoming batter reaches the crease and the strip refreshes), so
4251:     # the hint aged out before `_auto_dismiss_for_new_batter` had a
4252:     # chance to consume it.  Verified on KKR-vs-RR W6 (Jadeja bowled
4253:     # Tyagi at F108, Archer first surfaced ~F125, FOW filed with
4254:     # generic "inferred (replaced by new batter)" instead of
4255:     # "bowled").  Each WICKET handler re-sets the hint with the
4256:     # current frame, so the stale-graphic risk that 5 was protecting
4257:     # against is bounded by "next confirmed wicket".
4258:     _DISMISSAL_HINT_WINDOW = 30
4259:     _recent_dismissal_hints: list[dict] = []  # [{frame, mode, source, fielder, bowler}]
4260:     _DISMISSAL_KEYWORDS = {
4261:         "stumped":  "stumped",
4262:         "stumping": "stumped",
4263:         "caught":   "caught",
4264:         "catches":  "caught",
4265:         "bowled":   "bowled",
4266:         "lbw":      "lbw",
4267:         "leg before": "lbw",
4268:         "run out":  "run out",
4269:         "run-out":  "run out",
