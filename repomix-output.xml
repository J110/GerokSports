 882:         # team_overs corrects back to 0.1 but the archive is locked.
 883:         # Detect: we recently archived over N (now _last_over_int
 884:         # > new_int) and the new reading sits at the over we JUST
 885:         # archived. Rewind: pull the archived balls back into
 886:         # this_over, drop the bad over_history entry, restore the
 887:         # pending-clear state.
 888:         if (self._last_over_int is not None
 889:                 and new_int < self._last_over_int
 890:                 and (self._last_over_int - 1) in self.over_history):
 891:             archived_int = self._last_over_int - 1
 892:             archived = self.over_history.get(archived_int)
