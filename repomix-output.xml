  23: class LiveMatchTracker:
  24:     """Physics-based bounding for live cricket match data.
  25: 
  26:     Between consecutive frames in a live broadcast:
  27:     - Max 1 ball per ~15s, pipeline captures every ~4s
  28:     - Max 7 runs per ball (6 + no-ball)
  29:     - Max 1 wicket per ball
  30:     - Overs advance by at most 0.1 per ball
  31: 
  32:     After ad breaks (missed frames), allow slightly larger jumps.
  33:     """
  34: 
  35:     WARMUP_FRAMES = 5  # first N scoreboard frames: allow large corrections
  36: 
  37:     def __init__(self):
  38:         self.score: int | None = None
  39:         self.wickets: int | None = None
  40:         self.overs_balls: int | None = None  # stored as total balls
  41:         self.frames_since_scoreboard: int = 0
  42:         self._active_mmb: int = 1
  43:         self._scoreboard_count: int = 0
  44:         self.batters: dict[str, dict] = {}   # name -> {runs, balls}
  45:         self.bowlers: dict[str, dict] = {}   # name -> {runs, wickets, overs_balls}
  46: 
  47:     def _max_missed_balls(self) -> int:
  48:         """Return cached mmb for the current scoreboard frame's update window."""
  49:         return self._active_mmb
  50: 
  51:     def on_non_scoreboard_frame(self):
  52:         self.frames_since_scoreboard += 1
  53: 
  54:     def on_scoreboard_frame(self):
  55:         self._scoreboard_count += 1
  56:         if self._scoreboard_count <= self.WARMUP_FRAMES:
  57:             self._active_mmb = 120  # accept anything during warmup
  58:         else:
  59:             self._active_mmb = max(1, self.frames_since_scoreboard // 3)
  60:         self.frames_since_scoreboard = 0
  61:         return self._active_mmb
  62: 
  63:     def update_score(self, new_score: int | None) -> int | None:
  64:         if new_score is None:
  65:             return self.score
  66:         if self.score is None:
  67:             self.score = new_score
  68:             return new_score
  69:         mmb = self._max_missed_balls()
  70:         delta = new_score - self.score
  71:         max_jump = 7 * mmb
  72:         if delta < 0:
  73:             return self.score  # reject decrease
  74:         if delta > max_jump:
  75:             return self.score  # reject contamination
  76:         self.score = new_score
  77:         return new_score
  78: 
  79:     def update_wickets(self, new_w: int | None) -> int | None:
  80:         if new_w is None:
  81:             return self.wickets
  82:         if self.wickets is None:
  83:             self.wickets = new_w
  84:             return new_w
  85:         mmb = self._max_missed_balls()
  86:         delta = new_w - self.wickets
  87:         if delta < 0:
  88:             return self.wickets
  89:         if delta > mmb:
  90:             return self.wickets
  91:         self.wickets = new_w
  92:         return new_w
  93: 
  94:     def update_overs(self, new_overs_balls: int | None) -> int | None:
  95:         if new_overs_balls is None:
  96:             return self.overs_balls
  97:         if self.overs_balls is None:
  98:             self.overs_balls = new_overs_balls
  99:             return new_overs_balls
 100:         mmb = self._max_missed_balls()
 101:         delta = new_overs_balls - self.overs_balls
 102:         if delta < 0:
 103:             return self.overs_balls
 104:         if delta > mmb:
 105:             return self.overs_balls
 106:         self.overs_balls = new_overs_balls
 107:         return new_overs_balls
 108: 
 109:     def update_batter(self, name: str, new_runs: int | None,
 110:                       new_balls: int | None) -> tuple[int | None, int | None]:
 111:         existing = self.batters.get(name)
 112:         if not existing:
 113:             self.batters[name] = {"runs": new_runs, "balls": new_balls}
 114:             return new_runs, new_balls
 115:         old_r = existing.get("runs") or 0
 116:         old_b = existing.get("balls") or 0
 117:         if new_runs is None:
 118:             new_runs = old_r
 119:         if new_balls is None:
 120:             new_balls = old_b
 121:         mmb = self._max_missed_balls()
 122:         max_balls_inc = max(1, mmb)
 123:         max_runs_inc = 6 * max_balls_inc
 124:         r_delta = new_runs - old_r
 125:         b_delta = new_balls - old_b
 126:         if r_delta < 0 or r_delta > max_runs_inc:
 127:             new_runs = old_r
 128:         if b_delta < 0 or b_delta > max_balls_inc:
 129:             new_balls = old_b
 130:         # Also: batter runs can't exceed team score
 131:         if self.score is not None and new_runs > self.score:
 132:             new_runs = old_r
 133:         existing["runs"] = new_runs
 134:         existing["balls"] = new_balls
 135:         return new_runs, new_balls
 136: 
 137:     def update_bowler(self, name: str, new_runs: int | None,
 138:                       new_wickets: int | None,
 139:                       new_overs_balls: int | None) -> tuple:
 140:         existing = self.bowlers.get(name)
 141:         if not existing:
 142:             self.bowlers[name] = {
 143:                 "runs": new_runs, "wickets": new_wickets,
 144:                 "overs_balls": new_overs_balls,
 145:             }
 146:             return new_runs, new_wickets, new_overs_balls
 147:         old_r = existing.get("runs") or 0
 148: 
 149:         # First non-zero reading — accept unconditionally
 150:         # (bowler may have been bowling before we joined)
 151:         if old_r == 0 and new_runs is not None and new_runs > 0:
 152:             existing["runs"] = new_runs
 153:             existing["wickets"] = new_wickets
 154:             existing["overs_balls"] = new_overs_balls
 155:             return new_runs, new_wickets, new_overs_balls
 156: 
 157:         mmb = self._max_missed_balls()
 158:         max_r_inc = 7 * mmb
 159:         if new_runs is not None:
 160:             r_delta = new_runs - old_r
 161:             if r_delta < 0 or r_delta > max_r_inc:
 162:                 new_runs = old_r
 163:             if self.score is not None and new_runs > self.score:
 164:                 new_runs = old_r
 165:         else:
 166:             new_runs = old_r
 167:         existing["runs"] = new_runs
 168:         existing["wickets"] = new_wickets
 169:         existing["overs_balls"] = new_overs_balls
 170:         return new_runs, new_wickets, new_overs_balls
 171: 
 172:     def reset(self):
 173:         self.score = None
 174:         self.wickets = None
 175:         self.overs_balls = None
 176:         self.frames_since_scoreboard = 0
 177:         self._active_mmb = 1
 178:         self._scoreboard_count = 0
 179:         self.batters = {}
 180:         self.bowlers = {}
