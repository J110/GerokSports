118: def _save_cache(raw_data: dict, styles: dict):
119:     p = _cache_path(raw_data)
120:     try:
121:         p.write_text(json.dumps(styles, indent=2))
122:         log.info(f"Saved styles to {p.name}")
123:     except Exception as e:  # noqa: BLE001
