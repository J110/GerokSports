231: def _extract_json_blob(raw: str) -> dict | None:
232:     if not raw:
233:         return None
234:     cleaned = raw.replace("```json", "").replace("```", "").strip()
235:     m = re.search(r"\{.*\}", cleaned, re.DOTALL)
236:     if not m:
237:         return None
238:     blob = m.group(0)
239:     try:
240:         parsed = json.loads(blob)
241:         return parsed if isinstance(parsed, dict) else None
242:     except json.JSONDecodeError:
243:         for i in range(len(blob), 0, -1):
244:             if blob[i - 1] == "}":
245:                 try:
246:                     parsed = json.loads(blob[:i])
247:                     return parsed if isinstance(parsed, dict) else None
248:                 except json.JSONDecodeError:
249:                     continue
250:     return None
