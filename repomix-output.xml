457: async def enrich_squad_styles(raw_data: dict,
458:                               use_cache: bool = True,
459:                               pass2_background: bool = False) -> dict:
460:     """Infer + verify styles for every player and merge into raw_data.
461: 
462:     Mutates `raw_data` in place and returns the styles dict for
463:     convenience.  Safe to call when GROQ_API_KEY is missing — in
464:     that case every player ends up with `unknown` styles and the rest
465:     of the pipeline continues.
466: 
467:     Modes:
468:     - ``pass2_background=False`` (default, legacy behaviour): runs Pass-1
469:       then Pass-2 inline and returns the final (Pass-2 if available, else
470:       Pass-1) styles. Caller blocks for the full ~3-300s budget. Cache is
471:       written with the final styles.
472:     - ``pass2_background=True``: runs Pass-1 inline and returns its styles
473:       immediately. Pass-2 is *not* started; the caller is expected to
474:       schedule :func:`enrich_squad_styles_pass2_async` as a background
475:       task once any downstream sinks (e.g. ``Scoreboard``) exist that
476:       should be retro-patched when Pass-2 finishes. No cache is written
477:       in this mode — Pass-2's completion handler owns cache writes so
478:       that a future restart still benefits from web-grounded styles.
479:     """
480:     players = _all_players(raw_data)
481:     if not players:
482:         log.warn("No players to enrich")
483:         return {}
484: 
485:     if use_cache:
486:         cached = _load_cache(raw_data)
487:         if cached:
488:             _merge_styles_into_raw(raw_data, cached)
489:             _log_styles(raw_data, tag="cache")
490:             return cached
491: 
492:     client = _make_client()
493:     if client is None:
494:         log.warn("Groq SDK unavailable — using unknown-style fallback")
495:         styles = _fallback_styles(players)
496:         _merge_styles_into_raw(raw_data, styles)
497:         return styles
498: 
499:     pass1 = await _run_pass1(client, raw_data, players)
500: 
501:     if pass2_background:
502:         # Caller will schedule Pass-2 separately. Merge Pass-1 now so the
503:         # pipeline can use it; Pass-2 will overwrite later via the
504:         # completion handler.
505:         _merge_styles_into_raw(raw_data, pass1)
506:         _log_styles(raw_data, tag="pass1")
507:         return pass1
508: 
509:     # Legacy synchronous path: run Pass-2 inline.
510:     pass2 = await _run_pass2(client, raw_data, pass1, players)
511:     final = pass2 if pass2 is not None else pass1
512: 
513:     _save_cache(raw_data, final)
514:     _merge_styles_into_raw(raw_data, final)
515:     _log_styles(raw_data, tag="final")
516:     return final
517: 
518: 
519: async def enrich_squad_styles_pass2_async(
520:         raw_data: dict,
521:         pass1_styles: dict,
522:         on_complete=None) -> dict | None:
523:     """Run Pass-2 enrichment in the background after Pass-1 already ran.
524: 
525:     Designed to be wrapped in :func:`asyncio.create_task` so the caller
526:     does not block on it. Mutates ``raw_data`` in place if Pass-2
527:     succeeds, writes the canonical cache, and (if ``on_complete`` is
528:     provided) invokes it with the final styles dict so downstream sinks
529:     (typically a ``Scoreboard`` whose ``batting_card``/``bowling_card``
530:     were populated using Pass-1) can be retroactively patched.
531: 
532:     On Pass-2 failure (LLM error, timeout, unparseable JSON) the function
533:     falls back to caching the Pass-1 styles so a restart-during-the-same
534:     match doesn't re-spend the LLM budget. The completion callback is
535:     NOT invoked in the failure case — there is nothing new to apply.
536:     """
537:     players = _all_players(raw_data)
538:     if not players:
539:         return None
540:     client = _make_client()
541:     if client is None:
542:         log.warn("Groq SDK unavailable — Pass-2 background skipped")
543:         return None
544:     try:
545:         pass2 = await _run_pass2(client, raw_data, pass1_styles, players)
546:     except Exception as e:  # noqa: BLE001
547:         log.error(f"Pass-2 background task crashed: {e}")
548:         pass2 = None
549: 
550:     if pass2 is None:
551:         # Cache Pass-1 so a restart during the same match still benefits
552:         # from at least the prior-knowledge guess.
553:         _save_cache(raw_data, pass1_styles)
554:         log.warn("Pass-2 background failed — cached Pass-1 as fallback")
555:         return None
556: 
557:     _save_cache(raw_data, pass2)
558:     _merge_styles_into_raw(raw_data, pass2)
559:     _log_styles(raw_data, tag="pass2-bg")
560:     if on_complete is not None:
561:         try:
562:             on_complete(pass2)
563:         except Exception as e:  # noqa: BLE001
564:             log.error(f"Pass-2 on_complete callback failed: {e}")
565:     return pass2
566: 
567: 
568: def _log_styles(raw_data: dict, tag: str = ""):
569:     prefix = f"[{tag}] " if tag else ""
570:     for key in ("team_a", "team_b"):
571:         team = raw_data.get(key) or {}
572:         name = team.get("name", key)
573:         xi = team.get("playing_xi") or []
574:         log.info(f"{prefix}{name} — styles:")
575:         for p in xi:
576:             bat = p.get("batting_style", "unknown")
577:             bowl = p.get("bowling_style", "unknown")
578:             log.info(f"{prefix}  {p['name']:<24} {bat:<4} | {bowl}")
579: 
580: 
581: # ── convenience view ────────────────────────────────────────────────
582: 
583: def build_styles_lookup(raw_data: dict) -> dict[str, dict]:
584:     """Return {player_name: {batting_style, bowling_style}} across
585:     both teams, both sections.  Useful for propagating into scorecard
586:     entries at innings setup time."""
587:     out: dict[str, dict] = {}
588:     for key in ("team_a", "team_b"):
589:         team = raw_data.get(key) or {}
590:         for section in ("playing_xi", "bench"):
591:             for p in team.get(section, []) or []:
592:                 name = p.get("name")
593:                 if not name:
594:                     continue
595:                 out[name] = {
596:                     "batting_style": p.get("batting_style", "unknown"),
597:                     "bowling_style": p.get("bowling_style", "unknown"),
598:                 }
