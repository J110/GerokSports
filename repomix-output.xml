112: def apply_scorer_decision(scoreboard: Scoreboard, decision: dict,
113:                           frame: int, jump_guard: ScoreJumpGuard,
114:                           batting_team: str | None = None) -> list[str]:
115:     changes: list[str] = []
116: 
117:     if decision.get("innings_change"):
118:         changes.append("INNINGS CHANGE")
119:         return changes
120: 
121:     if not batting_team:
122:         log.info("No batting team set — skipping all updates")
123:         return changes
124: 
125:     batter_ups = decision.get("batter_updates", {})
126:     batters_accepted = any(
127:         isinstance(u, dict) and u.get("accepted", True)
128:         for u in (batter_ups.values() if isinstance(batter_ups, dict) else [])
129:     )
130:     bowler_up = decision.get("bowler_update", {})
131:     bowler_accepted = any(
132:         isinstance(d, dict) and d.get("accepted", True)
133:         for d in (bowler_up.values() if isinstance(bowler_up, dict) else [])
134:     )
135:     if not batters_accepted and not bowler_accepted:
136:         log.info("No players from our match recognized — skipping score")
137:         return changes
138: 
139:     score_up = decision.get("score_update", {})
140:     if isinstance(score_up, dict) and score_up.get("accepted") and score_up.get("to") is not None:
141:         old = scoreboard._inn.get("score")
142:         new = score_up["to"]
143:         if jump_guard.check(old, int(new)):
144:             if scoreboard.set("score", new, frame):
145:                 changes.append(f"score: {old} -> {new}")
146: 
147:     overs_up = decision.get("overs_update", {})
148:     if isinstance(overs_up, dict) and overs_up.get("accepted") and overs_up.get("to") is not None:
149:         if scoreboard.set("overs", overs_up["to"], frame):
150:             changes.append(f"overs: {overs_up.get('from')} -> {overs_up['to']}")
151: 
152:     wickets_up = decision.get("wickets_update", {})
153:     if isinstance(wickets_up, dict) and wickets_up.get("accepted") and wickets_up.get("to") is not None:
154:         if scoreboard.set("wickets", wickets_up["to"], frame):
155:             changes.append(f"wickets: {wickets_up.get('from')} -> {wickets_up['to']}")
156: 
157:     dismissal = decision.get("dismissal")
158:     if dismissal:
159:         name = dismissal if isinstance(dismissal, str) else dismissal.get("batter", "")
160:         how = dismissal.get("how") if isinstance(dismissal, dict) else None
161:         bowler = dismissal.get("bowler") if isinstance(dismissal, dict) else None
162:         if name and scoreboard.dismiss_batter(name, how, bowler, frame=frame):
163:             changes.append(f"DISMISSED: {name}")
164: 
165:     batter_ups = decision.get("batter_updates", {})
166:     if isinstance(batter_ups, dict):
167:         for name, update in batter_ups.items():
168:             if not isinstance(update, dict) or not update.get("accepted", True):
169:                 continue
170:             if scoreboard.update_batter(name, runs=update.get("runs"),
171:                                         balls=update.get("balls"),
172:                                         striker=update.get("striker"),
173:                                         frame=frame):
174:                 changes.append(f"bat:{name}")
175: 
176:     bowler_up = decision.get("bowler_update", {})
177:     if isinstance(bowler_up, dict):
178:         for bname, bdata in bowler_up.items():
179:             if not isinstance(bdata, dict) or not bdata.get("accepted", True):
180:                 continue
181:             if scoreboard.update_bowler(bname, overs=bdata.get("overs"),
182:                                         runs=bdata.get("runs"),
183:                                         wickets=bdata.get("wickets"),
184:                                         frame=frame):
185:                 changes.append(f"bowl:{bname}")
186: 
187:     rejected = decision.get("rejected", {})
188:     if isinstance(rejected, dict):
189:         for field, reason in rejected.items():
190:             log.info(f"REJECTED {field}: {reason}")
191: 
192:     deferred = decision.get("deferred", {})
193:     if isinstance(deferred, dict):
194:         for field, reason in deferred.items():
195:             log.info(f"DEFERRED {field}: {reason}")
196: 
197:     return changes
