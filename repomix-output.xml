  1: """Vision — Single-provider Scout 17B cricket stream watcher.
  2: 
  3: Scout 17B (Groq): ONE call does tag + read.
  4:   max_tokens=600, ~1.0s, $0.09/match.
  5:   Outputs a 3-boolean classification line, then reads the strip.
  6: 
  7: Returns (frame_type, description, action_description).
  8: """
  9: from __future__ import annotations
 10: 
 11: import asyncio
 12: import base64
 13: import json
 14: import re
 15: import time
 16: 
 17: import cv2
 18: import numpy as np
 19: from groq import AsyncGroq
 20: 
 21: from eyes.config import GROQ_API_KEY, GROQ_PRIMARY_MODEL
 22: from eyes.cricket_logger import CricketLogger
 23: 
 24: log = CricketLogger("VISION")
 25: 
 26: VALID_FRAME_TYPES = {
 27:     "SCOREBOARD", "GRAPHIC", "CLOSEUP", "ADVERTISEMENT", "PREMATCH",
 28: }
 29: 
 30: _SCOUT_TIMEOUT = 5.0
 31: 
 32: # Fix #4 (2026-04-23): template-placeholder guard.
 33: # Scout's vision endpoint occasionally regurgitates the prompt
 34: # template verbatim — returning literal bracketed tokens like
 35: # "STRIP: [TEAM] [SCORE]-[WICKETS] ([OVERS]) | [BATTER1] ..."
 36: # instead of extracting real values from the broadcast.  When that
 37: # happens downstream parsers see "0-0" and template names, which
 38: # poisons the scorecard with null fields and corrupted state.
 39: #
 40: # Defense: after Scout returns, scan the description + action for
 41: # any of these bracketed markers.  If found, treat the frame as
 42: # UNKNOWN (skip downstream processing) and bump the rejection
 43: # counter for monitoring.  Grep pattern: `[SCOUT-REJECT]`.
 44: _TEMPLATE_MARKERS = re.compile(
 45:     r"\[(?:RUNS|BALLS|W|R|OVERS|SCORE|WICKETS|SR|WKT|"
 46:     r"NAME|TEAM|BATTER\d*|BOWLER)\]",
 47:     re.IGNORECASE,
 48: )
 49: 
 50: # ── Combined tag + read prompt ──────────────────────────────────────
 51: # 2026-04-19: extended the JSON tag with `frame_phase` and
 52: # `ball_position` fields.  Validation on 115 frames from 31 prior
 53: # confirmed deliveries:
 54: #   * 100% of deliveries get >= 1 release/flight/shot frame
 55: #   * 90% strip-parse rate (vs ~97% prior — within bounds)
 56: #   * Avg latency 808 ms (no regression vs 1.0 s baseline)
 57: # `frame_phase` lets `analyze_last_delivery` sample the moment of
 58: # action (release / flight / shot) instead of the post-delivery
 59: # camera dwell that biased the prior selection.
 60: #
 61: # 2026-04-24 (Part B, V5): STEP 1 rewritten from a single-example
 62: # anchor to three balanced examples (bowlers_end / closeup / graphic)
 63: # with an explicit "DO NOT copy the values" instruction.  Shadow run
 64: # (41 frames × 7 variants × 3 reps = 861 calls) showed:
 65: #   * Rulebook-only variants (V1–V3) did NOT shift bowlers_end
 66: #     precision (15.2% baseline → ±1pp across variants).  Scout was
 67: #     copying the STEP 1 example line byte-identically and ignoring
 68: #     the rulebook below.
 69: #   * V4 diagnostic (swap example camera_view "bowlers_end" → "other",
 70: #     single-character change, rulebook unchanged) caused Scout to
 71: #     emit "other" on 36/41 frames — proving the example block is the
 72: #     dominant control surface for camera_view output.
 73: #   * V5 (this prompt — three balanced examples + hardened rulebook
 74: #     for bowlers_end / release / flight / shot / closeup) doubled
 75: #     bowlers_end strict precision from 15.2% to 31.2% with 7 truth-
 76: #     improving shifts, 0 regressions, and 100% recall preserved on
 77: #     all 5 human-labeled bowlers_end frames.
 78: # The ≥90% precision target is NOT met — remaining FPs are geometric
 79: # ambiguity cases the model cannot resolve without either a stronger
 80: # vision model, a post-hoc verification call, or temperature>0
 81: # ensembling.  See docs/scout_shadow_run_v1_analysis.md,
 82: # docs/scout_corpus_v1.json, docs/scout_labeling_rubric_v1.md.
 83: SCOUT_PROMPT = """\
 84: You are reading a live IPL cricket broadcast frame.
 85: 
 86: STEP 1 — CLASSIFY. Output one JSON object on the FIRST line, nothing \
 87: before it.  Pick `camera_view` and `frame_phase` from the enums below \
 88: by looking at the ACTUAL frame.  Example JSON shapes for three \
 89: common broadcast contexts (these are format guides — DO NOT copy the \
 90: values, pick the value that matches the frame):
 91: 
 92: - During a delivery (camera behind bowler, pitch extends away): \
 93: {{"has_strip": true, "has_overlay_stats": false, "drs_review": false, \
 94: "camera_view": "bowlers_end", "frame_phase": "release", \
 95: "ball_position": null}}
 96: - During a player closeup (face/body fills frame): \
 97: {{"has_strip": true, "has_overlay_stats": false, "drs_review": false, \
 98: "camera_view": "closeup", "frame_phase": "between_play", \
 99: "ball_position": null}}
100: - During a full-screen broadcaster graphic (scorecard, partnership): \
101: {{"has_strip": false, "has_overlay_stats": true, "drs_review": false, \
102: "camera_view": "graphic", "frame_phase": "graphic", \
103: "ball_position": null}}
104: 
105: has_strip: Is the team score strip visible at the bottom?
106: has_overlay_stats: Are career/tournament/head-to-head stats shown as an \
107: OVERLAY on top of the live feed? (NOT the regular scoreboard strip)
108: drs_review: Is a DRS review decision being shown?
109: 
110: camera_view: ONE of these exact strings, describing the camera angle:
111:   - "bowlers_end": the standard wide shot down the pitch from BEHIND \
112:     the bowler.  REQUIRED: the pitch extends away from the camera \
113:     toward the far stumps.  The bowler or the batter (or both) is \
114:     typically visible — the bowler at or near the foreground, the \
115:     batter at the far crease (often small, in the upper half of the \
116:     frame).  If the camera is square to the pitch from the sideline \
117:     (third-man, fine-leg, square-leg), this is "side_on", not \
118:     "bowlers_end".  This is the only camera where a legal ball can \
119:     be delivered on-screen.
120:   - "side_on": square / side-on field camera (e.g. third-man or fine-\
121:     leg angle on a boundary chase).
122:   - "closeup": a player's face or upper body fills a substantial \
123:     portion of the frame (batter at the non-striker's end, bowler \
124:     walking back, fielder reaction, captain directing, coach, crowd \
125:     individual).  Use this tag whenever face/body is the visual \
126:     subject, EVEN IF the pitch, stumps, or fielders are partly \
127:     visible in the background.  A frame where the pitch does NOT \
128:     extend away from the camera toward the far stumps is almost \
129:     always closeup, not bowlers_end.
130:   - "replay": clearly a replay or slow-motion of an earlier moment \
131:     (replay logo, slow-mo motion blur, "REPLAY" badge).
132:   - "graphic": full-screen broadcaster graphic (full scorecard, \
133:     partnership graphic, statistical overlay, sponsor card).
134:   - "ad": commercial / advertisement break.
135:   - "other": pre-match presenter, post-match presentation, drinks \
136:     break, anything else.
137: 
138: frame_phase: ONE of these exact strings, describing the MOMENT of the \
139: delivery this frame shows.  Use the visual signature, not your guess:
140:   - "runup": Camera behind the bowler looking down the pitch.  The \
141:     bowler is walking or running toward the crease.  The ball is in \
142:     the bowler's hand.  The batter is at the far crease, often \
143:     taking guard.
144:   - "release": Camera BEHIND the bowler looking down the pitch.  \
145:     REQUIRED: the pitch extends away from the camera AND the bowler \
146:     is in delivery stride (front foot landing, arm coming through, \
147:     or arm at the top of the action).  The batter should be visible \
148:     at the far crease, though may be partially occluded by umpire or \
149:     non-striker.  If the bowler is not visible at all (full closeup \
150:     of the batter, umpire, fielder, or a replay), this is NOT \
151:     release.
152:   - "flight": Camera BEHIND the bowler looking down the pitch.  \
153:     REQUIRED: the pitch extends away from the camera AND the ball \
154:     has left the bowler's hand (the bowler is typically in follow-\
155:     through or has just exited the frame).  The batter should be \
156:     visible at the far crease preparing to play, though may be \
157:     partially occluded.  If the camera is not looking down the pitch \
158:     from behind the bowler's end, this is NOT flight.
159:   - "shot": Camera BEHIND the bowler (or a tight over-the-shoulder \
160:     angle from behind the stumps).  REQUIRED: the pitch extends away \
161:     from the camera AND the bat is in motion through the shot or \
162:     just after contact.  A batter close-up without the pitch \
163:     extending away is NOT "shot" — it is "closeup" or "post_shot".
164:   - "post_shot": The shot has been played.  Camera may still be on \
165:     bowler's end briefly, or has just cut to follow the ball.  The \
166:     batter has completed the shot motion.
167:   - "fielder_reaction": Camera has cut to a fielder running after \
168:     the ball, diving, catching, throwing, OR a celebration huddle \
169:     around the stumps after a wicket.  The pitch is no longer the \
170:     focus.
171:   - "replay": Slow-motion replay, spider-cam, close-up of ball/bat \
172:     contact, wagon wheel, hawkeye, stats overlay over live feed.
173:   - "between_play": Cricket visible but no delivery happening.  \
174:     Bowler walking back to mark, field change, drinks, batter \
175:     signalling for new bat, umpire discussion.
176:   - "graphic": Full-screen / near-full-screen broadcaster graphic.  \
177:     Score summary, partnership stats, player profile, sponsor.
178:   - "advertisement": Commercial break, no cricket content visible.
179:   - "other": none of the above.
180: 
181: ball_position: If you can clearly see the ball in flight as a small \
182: white object between the bowler's end and the batter, give its \
183: position as {{"x": 0.0..1.0, "y": 0.0..1.0}} where (0,0) is top-left.  \
184: Only set this for "release", "flight", or "shot" phases.  Otherwise \
185: return null.  Do NOT guess — if the ball is not clearly visible as a \
186: small object in flight, return null.
187: 
188: STEP 2 — READ THE STRIP (skip if has_strip is false).
189: Output the strip data in this exact format:
190: STRIP: [TEAM] [SCORE]-[WICKETS] ([OVERS]) | [BATTER1] [RUNS]([BALLS]) | \
191: [BATTER2] [RUNS]([BALLS]) | [BOWLER] [W]-[R] ([OVERS])
192: 
193: Example: STRIP: KKR 105-2 (11.3) | Green 45(32) | Raghuvanshi 4(5) | \
194: Siddharth 0-21 (2.3)
195: 
196: STEP 3 — REPORT OVERLAYS (skip if nothing visible):
197: INFO_PANEL: [career/tournament/head-to-head text]
198: SPEED: [number] (bowling speed in kph)
199: EXTRA: wide/no_ball/leg_bye/bye
200: THIS OVER: [ball-by-ball results]
201: FULL SCORECARD: [every batter/bowler row]
202: 
203: STEP 4 — ACTION (1 sentence):
204: What is happening? (delivery bowled, shot played, celebration, etc.)
205: 
206: RULES:
207: - JSON tag line MUST be first. Then strip. Then overlays. Then action.
208: - Report exact numbers from the strip. Don't guess or infer.
209: - * or > prefix on batter name = striker.
210: - If this is a pure ADVERTISEMENT with no strip: output the JSON with \
211: all false, then say "ADVERTISEMENT" and stop.
212: 
213: HINT FROM SCORER:
214: {vision_hint}\
215: """
216: 
217: 
218: class Vision:
219:     """Scout does everything: tag + read in one call."""
220: 
221:     # Allowed camera_view values — Scout occasionally returns close
222:     # variants ("bowler_end", "wide_shot"); we normalise.
223:     _CAMERA_VIEW_ALLOWED = {
224:         "bowlers_end", "side_on", "closeup", "replay",
225:         "graphic", "ad", "other",
226:     }
227:     # 2026-04-24 (Part B, V1): re-point wide_shot / wide to side_on.
228:     # An elevated square/side shot with the pitch visible off-axis is
229:     # a side_on frame in the consumer-aligned rubric (see rubric EC-6
230:     # in docs/scout_labeling_rubric_v1.md) — DWR opening a delivery
231:     # window on such a frame would expect pitch-receding geometry in
232:     # subsequent frames and would cut a broken clip.  A3 audit of 5
233:     # production sessions found zero emissions of "wide_shot" or
234:     # "wide" from Scout, so this change is defensive hygiene with no
235:     # observable traffic impact; it fires only if a future prompt
236:     # revision or model upgrade causes Scout to emit these aliases.
237:     _CAMERA_VIEW_ALIASES = {
238:         "bowler_end": "bowlers_end", "bowlers": "bowlers_end",
239:         "wide_shot": "side_on", "wide": "side_on",
240:         "side": "side_on", "sideon": "side_on",
241:         "close_up": "closeup", "close-up": "closeup",
242:         "replay_slow_mo": "replay", "slow_mo": "replay",
243:         "advertisement": "ad", "commercial": "ad",
244:         "fullscreen_graphic": "graphic", "scorecard_graphic": "graphic",
245:     }
246: 
247:     # 2026-04-19: phase tag describes the MOMENT of the delivery.
248:     # Used by BallAnalyzer to sample release / flight / shot frames
249:     # for VLM classification — solves the post-action-dwell bias of
250:     # the prior "last N bowlers_end frames" selection.
251:     _FRAME_PHASE_ALLOWED = {
252:         "runup", "release", "flight", "shot", "post_shot",
253:         "fielder_reaction", "replay", "between_play", "graphic",
254:         "advertisement", "other",
255:     }
256:     _FRAME_PHASE_ALIASES = {
257:         "delivery_release": "release", "ball_release": "release",
258:         "delivery_flight": "flight", "ball_flight": "flight",
259:         "shot_played": "shot", "batting_shot": "shot",
260:         "after_shot": "post_shot", "post-shot": "post_shot",
261:         "fielding": "fielder_reaction", "fielder": "fielder_reaction",
262:         "celebration": "fielder_reaction",
263:         "ad": "advertisement", "commercial": "advertisement",
264:         "between": "between_play", "no_play": "between_play",
265:     }
266: 
267:     def __init__(self):
268:         self._groq = AsyncGroq(
269:             api_key=GROQ_API_KEY, timeout=_SCOUT_TIMEOUT + 2)
270:         self.last_drs_flag: bool = False
271:         # Fix #4: cumulative count of frames where Scout returned a
272:         # prompt-template placeholder response.  Surfaced for monitoring;
273:         # rare (1-5/match) means the guard is doing its job silently,
274:         # frequent (10+/match) signals a Scout reliability issue.
275:         self.scout_template_rejection_count: int = 0
276:         # Last camera_view tag (set after every describe() call).  Read
277:         # by the main loop so the tag can be pushed into BallAnalyzer's
278:         # tagged-frame buffer for delivery analysis.
279:         self.last_camera_view: str | None = None
280:         # Last frame_phase tag — drives `analyze_last_delivery`'s
281:         # frame-selection so VLM classification sees release/flight/
282:         # shot frames instead of post-action dwell.
283:         self.last_frame_phase: str | None = None
284:         # Last ball_position {"x": float, "y": float} or None.  Not
285:         # used by capture pipeline yet; stored for future trajectory
286:         # inference.
287:         self.last_ball_position: dict | None = None
288: 
289:     async def describe(self, frame: np.ndarray,
290:                        vision_hint: str | None = None,
291:                        ) -> tuple[str, str, str | None]:
292:         """Returns (frame_type, description, action_description).
293: 
294:         Side-effect: sets ``self.last_camera_view`` to one of the
295:         allowed camera_view tags (bowlers_end / side_on / closeup /
296:         replay / graphic / ad / other) so the caller can stash the
297:         frame in BallAnalyzer's tagged buffer for delivery analysis.
298:         """
299:         image_b64 = self._encode(frame)
300:         hint = vision_hint or "None — first frame or no issues."
301:         prompt = SCOUT_PROMPT.format(vision_hint=hint)
302: 
303:         t0 = time.time()
304:         raw = await self._scout_call(image_b64, prompt)
305:         ms = (time.time() - t0) * 1000
306: 
307:         if not raw:
308:             log.info(f"[SCOUT] Empty response {ms:.0f}ms")
309:             self.last_camera_view = None
310:             return ("UNKNOWN", "", None)
311: 
312:         tag, frame_type = self._parse_tag(raw)
313:         description, action_desc = self._split_output(raw, frame_type)
314: 
315:         # Fix #4 (2026-04-23): template-placeholder guard.  If Scout
316:         # echoed the prompt template instead of parsing the broadcast,
317:         # reject the whole read — downstream parsers can't recover
318:         # from literal "[RUNS]" / "[BATTER1]" tokens and would write
319:         # corrupted state.  Check both description and action payload.
320:         _tmpl_hit = (
321:             (description and _TEMPLATE_MARKERS.search(description))
322:             or (action_desc and _TEMPLATE_MARKERS.search(action_desc))
323:         )
324:         if _tmpl_hit:
325:             self.scout_template_rejection_count += 1
326:             preview = (description or action_desc or "")[:200]
327:             log.warn(
328:                 f"[SCOUT-REJECT] Template placeholder detected "
329:                 f"(#{self.scout_template_rejection_count}): "
330:                 f"{preview!r}"
331:             )
332:             self.last_camera_view = None
333:             self.last_frame_phase = None
334:             self.last_ball_position = None
335:             self.last_drs_flag = False
336:             return ("UNKNOWN", "", None)
337: 
338:         has_digits = bool(re.search(r"\d{2,3}", raw))
339:         strip_flag = tag.get("has_strip", False) if tag else False
340:         overlay_flag = tag.get("has_overlay_stats", False) if tag else False
341:         drs_flag = tag.get("drs_review", False) if tag else False
342: 
343:         self.last_drs_flag = drs_flag
344:         self.last_camera_view = self._normalise_camera_view(
345:             tag.get("camera_view") if tag else None,
346:             frame_type=frame_type,
347:             has_strip=strip_flag,
348:             has_overlay=overlay_flag,
349:         )
350:         self.last_frame_phase = self._normalise_frame_phase(
351:             tag.get("frame_phase") if tag else None,
352:             camera_view=self.last_camera_view,
353:             frame_type=frame_type,
354:         )
355:         self.last_ball_position = self._normalise_ball_position(
356:             tag.get("ball_position") if tag else None,
357:             frame_phase=self.last_frame_phase,
358:         )
359: 
360:         log.info(f"[SCOUT] {frame_type} {ms:.0f}ms "
361:                  f"strip={strip_flag} overlay={overlay_flag} "
362:                  f"drs={drs_flag} cam={self.last_camera_view} "
363:                  f"phase={self.last_frame_phase} "
364:                  f"digits={has_digits} "
365:                  f"{len(raw)} chars")
366:         if not has_digits and frame_type != "ADVERTISEMENT":
367:             log.info(f"[SCOUT] Preview: {raw[:200]}")
368: 
369:         return (frame_type, description, action_desc)
370: 
371:     @classmethod
372:     def _normalise_camera_view(cls, raw: str | None, *,
373:                                 frame_type: str,
374:                                 has_strip: bool,
375:                                 has_overlay: bool) -> str | None:
376:         """Map Scout's camera_view to one of the allowed tags.
377: 
378:         IMPORTANT: frame_type overrides Scout's `camera_view` when the
379:         two conflict.  Empirical bug (2026-04-18): Scout sometimes
380:         returns ``camera_view="bowlers_end"`` on AD frames where the
381:         scoreboard strip is absent — without this guard we'd record
382:         an ad frame into BallAnalyzer's bowlers_end tagged buffer
383:         and poison delivery analysis.  Rule:
384: 
385:           - frame_type == ADVERTISEMENT  →  always "ad"
386:           - has_overlay and not has_strip →  always "graphic"
387:           - otherwise trust Scout's tag if it's in the allowed set
388:           - fall back to None
389:         """
390:         if frame_type == "ADVERTISEMENT":
391:             return "ad"
392:         if has_overlay and not has_strip:
393:             return "graphic"
394:         if isinstance(raw, str):
395:             v = raw.strip().lower().replace(" ", "_")
396:             v = cls._CAMERA_VIEW_ALIASES.get(v, v)
397:             if v in cls._CAMERA_VIEW_ALLOWED:
398:                 # When the strip ISN'T visible at all, an active-play
399:                 # tag (bowlers_end / side_on) doesn't make sense —
400:                 # Scout is hallucinating from the visual content
401:                 # only.  Demote to "other" so the tagged buffer
402:                 # doesn't pick it up as a delivery candidate.
403:                 if (not has_strip
404:                         and v in ("bowlers_end", "side_on")):
405:                     return "other"
406:                 return v
407:         return None
408: 
409:     @classmethod
410:     def _normalise_frame_phase(cls, raw: str | None, *,
411:                                 camera_view: str | None,
412:                                 frame_type: str) -> str | None:
413:         """Map Scout's frame_phase to one of the allowed tags.
414: 
415:         Cross-checks against camera_view: if Scout claims `release`
416:         on an `ad`-tagged frame, the phase tag is hallucinated —
417:         force it to `advertisement`.  Same for graphic / replay.
418:         """
419:         if frame_type == "ADVERTISEMENT" or camera_view == "ad":
420:             return "advertisement"
421:         if camera_view == "graphic":
422:             return "graphic"
423:         if camera_view == "replay":
424:             return "replay"
425:         if isinstance(raw, str):
426:             v = raw.strip().lower().replace(" ", "_")
427:             v = cls._FRAME_PHASE_ALIASES.get(v, v)
428:             if v in cls._FRAME_PHASE_ALLOWED:
429:                 return v
430:         return None
431: 
432:     @staticmethod
433:     def _normalise_ball_position(raw, *,
434:                                   frame_phase: str | None) -> dict | None:
435:         """Validate and clip ball_position to [0,1]x[0,1].
436: 
437:         Only meaningful for `release`, `flight`, `shot` phases.  Drop
438:         otherwise — Scout was instructed to return null but may still
439:         echo a stale value.
440:         """
441:         if frame_phase not in ("release", "flight", "shot"):
442:             return None
443:         if not isinstance(raw, dict):
444:             return None
445:         try:
446:             x = float(raw.get("x"))
447:             y = float(raw.get("y"))
448:         except (TypeError, ValueError):
449:             return None
450:         if not (0.0 <= x <= 1.0 and 0.0 <= y <= 1.0):
451:             return None
452:         return {"x": x, "y": y}
453: 
454:     # ------------------------------------------------------------------
455:     # Scout call — single Groq call, tag + read, 600 tokens
456:     # ------------------------------------------------------------------
457:     async def _scout_call(self, image_b64: str,
458:                           prompt: str) -> str | None:
459:         try:
460:             resp = await self._groq.chat.completions.create(
461:                 model=GROQ_PRIMARY_MODEL,
462:                 temperature=0,
463:                 max_tokens=600,
464:                 messages=[{
465:                     "role": "user",
466:                     "content": [
467:                         {"type": "image_url",
468:                          "image_url": {
469:                              "url": f"data:image/jpeg;base64,{image_b64}"}},
470:                         {"type": "text", "text": prompt},
471:                     ],
472:                 }],
473:             )
474:             content = resp.choices[0].message.content.strip()
475:             finish = resp.choices[0].finish_reason
476:             usage = resp.usage
477:             tokens = usage.completion_tokens if usage else "?"
478:             if finish != "stop":
479:                 log.info(f"[SCOUT] finish={finish} tokens={tokens}")
480:             return content
481:         except Exception as e:
482:             log.error(f"[SCOUT] Error: {e}")
483:             return None
484: 
485:     # ------------------------------------------------------------------
486:     # Parse the JSON tag line from Scout output
487:     # ------------------------------------------------------------------
488:     @staticmethod
489:     def _parse_tag(raw: str) -> tuple[dict | None, str]:
490:         """Extract the classification JSON and derive frame_type."""
491:         tag = None
492:         for line in raw.split("\n")[:5]:
493:             line = line.strip()
494:             if line.startswith("{") and "has_strip" in line:
495:                 try:
496:                     tag = json.loads(line)
497:                     break
498:                 except json.JSONDecodeError:
499:                     brace_end = line.rfind("}") + 1
500:                     if brace_end > 0:
501:                         try:
502:                             tag = json.loads(line[:brace_end])
503:                             break
504:                         except json.JSONDecodeError:
505:                             pass
506: 
507:         if not tag:
508:             upper = raw.upper()[:100]
509:             if "ADVERTISEMENT" in upper and "STRIP" not in upper:
510:                 return ({"has_strip": False, "has_overlay_stats": False,
511:                          "drs_review": False}, "ADVERTISEMENT")
512:             has_strip = bool(re.search(
513:                 r"STRIP:\s*[A-Z]{2,}\s+\d+", raw))
514:             return ({"has_strip": has_strip, "has_overlay_stats": False,
515:                      "drs_review": False},
516:                     "SCOREBOARD" if has_strip else "UNKNOWN")
517: 
518:         has_strip = tag.get("has_strip", False)
519:         has_overlay = tag.get("has_overlay_stats", False)
520:         drs = tag.get("drs_review", False)
521: 
522:         if drs:
523:             return (tag, "SCOREBOARD")
524:         if has_strip and has_overlay:
525:             return (tag, "GRAPHIC")
526:         if has_strip:
527:             return (tag, "SCOREBOARD")
528:         if has_overlay:
529:             return (tag, "GRAPHIC")
530:         return (tag, "ADVERTISEMENT")
