  1: """Frame-aware cricket logger with file output and SSE forwarding.
  2: 
  3: Every log line includes timestamp, frame number, and component name.
  4: Format: [09:15:23 F1234 COMPONENT] LEVEL: message
  5: 
  6: Three output destinations:
  7:   - Console: everything (color-coded)
  8:   - File: everything (logs/machine-1-{date}.log, rotated daily)
  9:   - Debug UI SSE: WARN and above (real-time in browser)
 10: """
 11: from __future__ import annotations
 12: 
 13: import asyncio
 14: import logging
 15: import os
 16: import time
 17: from datetime import datetime
 18: from logging.handlers import TimedRotatingFileHandler
 19: from pathlib import Path
 20: 
 21: # ANSI color codes for console output
 22: _COLORS = {
 23:     "INFO": "\033[37m",      # white
 24:     "WARN": "\033[33m",      # yellow
 25:     "ERROR": "\033[31m",     # red
 26:     "INSIGHT": "\033[93m",   # bright yellow / gold
 27:     "RESET": "\033[0m",
 28: }
 29: 
 30: # Global frame counter shared across all loggers
 31: _global_frame: int = 0
 32: 
 33: # SSE callback — set by debug_server at startup
 34: _sse_callback = None
 35: 
 36: 
 37: def set_global_frame(n: int):
 38:     global _global_frame
 39:     _global_frame = n
 40: 
 41: 
 42: def get_global_frame() -> int:
 43:     return _global_frame
 44: 
 45: 
 46: def set_sse_callback(callback):
 47:     """Register the SSE emit function from DebugUI so logs can stream to browser."""
 48:     global _sse_callback
 49:     _sse_callback = callback
 50: 
 51: 
 52: def _time_str() -> str:
 53:     return datetime.now().strftime("%H:%M:%S")
 54: 
 55: 
 56: def _emit_to_sse(component: str, level: str, message: str, frame: int):
 57:     """Forward WARN+ logs to the debug UI via SSE."""
 58:     if _sse_callback is None:
 59:         return
 60:     if level not in ("WARN", "ERROR", "INSIGHT"):
 61:         return
 62:     try:
 63:         data = {
 64:             "component": component,
 65:             "level": level,
 66:             "message": message,
 67:             "frame": frame,
 68:             "time": _time_str(),
 69:         }
 70:         loop = asyncio.get_event_loop()
 71:         if loop.is_running():
 72:             asyncio.ensure_future(_sse_callback("log", data))
 73:     except Exception:
 74:         pass
 75: 
 76: 
 77: # File handler — shared across all CricketLoggers
 78: _file_handler: logging.FileHandler | None = None
 79: 
 80: 
 81: def _ensure_file_handler() -> logging.FileHandler:
 82:     global _file_handler
 83:     if _file_handler is not None:
 84:         return _file_handler
 85: 
 86:     log_dir = Path("logs")
 87:     log_dir.mkdir(exist_ok=True)
 88:     date_str = datetime.now().strftime("%Y-%m-%d")
 89:     path = log_dir / f"machine-1-{date_str}.log"
 90: 
 91:     _file_handler = TimedRotatingFileHandler(
 92:         str(path), when="midnight", backupCount=7, encoding="utf-8"
 93:     )
 94:     _file_handler.setFormatter(logging.Formatter("%(message)s"))
 95:     _file_handler.setLevel(logging.DEBUG)
 96:     return _file_handler
 97: 
 98: 
 99: class CricketLogger:
100:     """Per-component logger with frame tracking.
101: 
102:     Usage:
103:         log = CricketLogger("LLM")
104:         log.info("Response in 2.3s, frame_type=live_play")
105:         log.warn("Consensus override: score [79, 73, 79] → 79")
106:         log.error("Timeout after 15s — skipping frame")
107:         log.insight("KHALEEL run-up 15% shorter since over 1")
108:     """
109: 
110:     def __init__(self, component: str):
111:         self.component = component
112:         self._frame: int | None = None  # per-instance override, else global
113: 
114:     def set_frame(self, n: int):
115:         self._frame = n
116: 
117:     @property
118:     def frame(self) -> int:
119:         return self._frame if self._frame is not None else _global_frame
120: 
121:     def info(self, msg: str):
122:         self._log("INFO", msg)
123: 
124:     def warn(self, msg: str):
125:         self._log("WARN", msg)
126: 
127:     def error(self, msg: str):
128:         self._log("ERROR", msg)
129: 
130:     def insight(self, msg: str):
131:         self._log("INSIGHT", msg)
132: 
133:     def _log(self, level: str, msg: str):
134:         ts = _time_str()
135:         f = self.frame
136:         line = f"[{ts} F{f} {self.component}] {level}: {msg}"
137: 
138:         # Console (color-coded)
139:         color = _COLORS.get(level, "")
140:         reset = _COLORS["RESET"]
141:         print(f"{color}{line}{reset}")
142: 
143:         # File
144:         try:
145:             handler = _ensure_file_handler()
146:             record = logging.LogRecord(
147:                 name=self.component, level=logging.INFO,
148:                 pathname="", lineno=0, msg=line, args=(), exc_info=None,
149:             )
150:             handler.emit(record)
151:         except Exception:
152:             pass
153: 
154:         # SSE (WARN+ only)
155:         _emit_to_sse(self.component, level, msg, f)
