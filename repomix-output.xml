1045:                     log.info(
1046:                         f"Over {self._last_over_int} reconcile: "
1047:                         f"score delta=+{_total_over_runs} but "
1048:                         f"this_over tracks {_tracked_runs} runs "
1049:                         f"({_missing:+d} missing). Tokens preserved "
1050:                         f"as observed; no synth at over boundary "
1051:                         f"(extras can never sit on the over-closing "
1052:                         f"ball).")
1053: 
1054:             # over_history is APPEND-ONLY / FIRST-WRITE-WINS. Once an
1055:             # over has been archived, that slot is immutable — no
1056:             # subsequent code path (re-archive, mid-innings restart,
