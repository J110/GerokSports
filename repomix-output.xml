166: def _merge_styles_into_raw(raw_data: dict, styles: dict):
167:     """Write batting_style / bowling_style onto each player dict."""
168:     for key in ("team_a", "team_b"):
169:         team = raw_data.get(key) or {}
170:         for section in ("playing_xi", "bench"):
171:             for p in team.get(section, []) or []:
172:                 name = p.get("name")
173:                 if not name:
174:                     continue
175:                 s = styles.get(name) or {}
176:                 p["batting_style"] = _clean_batting(
177:                     s.get("batting_style"))
178:                 p["bowling_style"] = _clean_bowling(
179:                     s.get("bowling_style"))
