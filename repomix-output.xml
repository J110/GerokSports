2652:             if name == self._pending_bowler_name:
2653:                 self._pending_bowler_count += 1
2654:             else:
2655:                 self._pending_bowler_name = name
2656:                 self._pending_bowler_count = 1
2657:             # Two paths to flip:
2658:             #   (a) over just rolled and we expect a new bowler
2659:             #       (_bowler_must_change) — accept on 1st sighting
2660:             #       provided the new name != previous over's bowler.
2661:             #   (b) normal play — require N consecutive reads.
2662:             _accept = False
2663:             if (self._bowler_must_change
2664:                     and (not _prev_over_bowler
2665:                          or name != _prev_over_bowler)):
2666:                 _accept = True
2667:             elif self._bowler_team_over_consensus(
2668:                     _cur_bowler, name, overs, self._pending_bowler_count):
2669:                 log.warn(
2670:                     f"  [BOWLER-TEAM-OVER-CONSENSUS] accepting {name!r} "
2671:                     f"after {self._pending_bowler_count} reads — "
2672:                     f"candidate overs {overs} matches team over "
2673:                     f"{self._inn.get('overs')} while current_bowler "
2674:                     f"{_cur_bowler!r} is inconsistent")
2675:                 _accept = True
2676:             elif self._pending_bowler_count >= _CONSENSUS_N:
2677:                 _accept = True
2678:             if _accept:
2679:                 log.info(
2680:                     f"[BOWLER OVERRIDE] {_cur_bowler} → {name} "
2681:                     f"(reads={self._pending_bowler_count}, "
2682:                     f"must_change={self._bowler_must_change})")
2683:                 self._inn["current_bowler"] = name
2684:                 self._tracker.force_set("current_bowler", name)
2685:                 self._pending_bowler_name = None
2686:                 self._pending_bowler_count = 0
2687:                 self._bowler_must_change = False
2688:                 _bowler_changed = True
2689:         # First-bowler bootstrap: if no current_bowler is set at all,
2690:         # accept this read immediately so cold-start populates the
2691:         # bowling card on frame 1.
2692:         _bootstrapped = False
2693:         if not _cur_bowler and not _bowler_changed:
2694:             self._inn["current_bowler"] = name
2695:             self._tracker.force_set("current_bowler", name)
2696:             _bootstrapped = True
2697: 
2698:         # === Issue 3 fix (2026-04-21): seed a freshly-promoted bowler's
2699:         # figures to 0-0(0.0) immediately, bypassing the tracker's
2700:         # 3-frame cold-start consensus.
2701:         #
2702:         # A bowler entering `current_bowler` via the must-change path
2703:         # has just started a new over, which in limited-overs cricket
2704:         # ALWAYS means 0-0(0.0) at ball 0 of their spell.  Without
2705:         # seeding, the tracker waits 3 identical reads of "0" before
2706:         # promoting to `confirmed`, which means entry["runs"] stays
2707:         # None for 3 frames and the UI shows a blank/"—" bowler line
2708:         # for ~3-5 seconds.
2709:         #
2710:         # Safe because we only seed when the card's figures are still
2711:         # unset (a returning 2nd-spell bowler keeps their accumulated
2712:         # figures — those entries are non-None).
2713:         if (_bowler_changed or _bootstrapped) and entry.get("runs") is None:
2714:             # Issue B fix (2026-04-21): prefer scout-text figures over
2715:             # hard-coded zeros when the bowler is entering with an
2716:             # already-accumulated spell (impact sub, mid-match join).
2717:             # Example: Madushanka enters over 12 and Scout reads
2718:             # "Madushanka 1-24 (3)" — seeding at 0-0(0.0) would lose
2719:             # his 24 runs, and subsequent monotonic-increase consensus
2720:             # would block recovery.  Seed with the scout values when
2721:             # they pass sanity (non-negative, ≤ 250 runs, ≤ 10
2722:             # wickets, overs in [0.0, 4.0]).
2723:             seed_r, seed_w, seed_o = 0, 0, "0.0"
2724:             from_scout = False
2725:             try:
2726:                 _r = int(new_r) if new_r is not None else None
2727:                 _w = int(new_w) if new_w is not None else None
2728:             except (TypeError, ValueError):
2729:                 _r, _w = None, None
2730:             try:
2731:                 _o = float(overs) if overs is not None else None
2732:             except (TypeError, ValueError):
2733:                 _o = None
2734:             if (_r is not None and 0 <= _r <= 250
2735:                     and _w is not None and 0 <= _w <= 10
2736:                     and _o is not None and 0.0 <= _o <= 4.0
2737:                     and (_r > 0 or _w > 0 or _o > 0)):
2738:                 seed_r, seed_w = _r, _w
2739:                 seed_o = str(overs)
2740:                 from_scout = True
2741:             entry["runs"] = seed_r
2742:             entry["wickets"] = seed_w
2743:             if entry.get("overs") is None or from_scout:
2744:                 entry["overs"] = seed_o
2745:             self._tracker.force_set(f"bowl:{name}:runs", seed_r)
2746:             self._tracker.force_set(f"bowl:{name}:wickets", seed_w)
2747:             self._tracker.force_set(f"bowl:{name}:overs", seed_o)
2748:             if from_scout:
2749:                 log.info(
2750:                     f"[BOWLER SEED] {name} figures seeded from scout "
2751:                     f"text to {seed_w}-{seed_r} ({seed_o}) — "
2752:                     f"mid-spell entry (impact sub / mid-match join)")
2753:             else:
2754:                 log.info(
2755:                     f"[BOWLER SEED] {name} figures seeded to 0-0(0.0) "
2756:                     f"on spell start (skipping cold-start consensus)")
2757:         return True
