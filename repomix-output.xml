395:                 old = current
396:                 self.confirmed[field] = value
397:                 self.pending.pop(field, None)
398:                 self.pending_counts.pop(field, None)
399:                 if field == "score" and old != value:
400:                     self._prev_confirmed_score = old
401:                 if old != value:
402:                     log.info(f"{field}: {old} → {value} (confirmed F{frame_count})")
403:                 return value
404:             else:
405:                 self.pending[field] = (value, frame_count)
