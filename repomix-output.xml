550:         action = None
551:         for marker in ("ACTION:", "CRICKET ACTION:", "STEP 4"):
552:             idx = text.upper().find(marker)
553:             if idx != -1:
554:                 after = text[idx:]
555:                 colon = after.find(":")
556:                 if colon != -1:
557:                     action_part = after[colon + 1:].strip()
558:                     nl = action_part.find("\n")
559:                     if nl != -1:
560:                         action_part = action_part[:nl].strip()
561:                     text = text[:idx].strip()
562:                     if len(action_part) > 10:
563:                         action = action_part
564:                 break
565: 
566:         return (text, action)
