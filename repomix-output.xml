 801:     def __init__(self):
 802:         self.over_complete = False
 803:         self.ad_detected = False
 804:         self._burst_until: float = 0.0
 805:         # Last Scout camera_view tag — drives active-play cadence.
 806:         self.last_camera_view: str | None = None
 807:         # Last Scout frame_phase tag — drives per-phase cadence
 808:         # (Phase 3, 2026-04-19) when present.
 809:         self.last_frame_phase: str | None = None
 810:         # Post-active-play "tail" window: the broadcast routinely
 811:         # cuts away the moment the bowler releases (closeup of
 812:         # the bowler, replay of the shot, crowd reaction) so the
 813:         # next 1-3 frames after a `bowlers_end` are tagged dead-
 814:         # time. Without this tail we relax the cadence to 2.5s
 815:         # immediately, missing the short window when the strip
 816:         # ticks to the new overs.  Holding 0.5s polling for ~5s
 817:         # past every active-play frame catches the dot-ball strip
 818:         # update without ballooning Groq spend (the tail expires
 819:         # when the broadcast settles into a true ad / replay).
 820:         self._active_tail_until: float = 0.0
 821:         self.ACTIVE_TAIL_HOLD = 5.0  # seconds
 822: 
 823:     def on_over_change(self):
 824:         self.over_complete = True
 825: 
 826:     def on_ball_5(self):
 827:         """Start burst when the scoreboard shows ball 5 of the over."""
 828:         self._burst_until = time.time() + self.BURST_DURATION
 829:         log.info("[SLEEP] Burst mode ON — last ball of over")
 830: 
 831:     def check_burst(self, overs: float | None):
 832:         """Called each scored frame. Triggers burst at X.5 if not already."""
 833:         if overs is None:
 834:             return
 835:         ball = round((overs % 1) * 10)
 836:         if ball == 5 and time.time() < self._burst_until:
 837:             return
 838:         if ball == 5:
 839:             self.on_ball_5()
 840: 
 841:     @property
 842:     def in_burst(self) -> bool:
 843:         return time.time() < self._burst_until
 844: 
 845:     def on_ad_detected(self, frame: np.ndarray | None = None):
 846:         """Trigger ad detection. If an over just completed AND the
 847:         bottom strip doesn't look like a scoreboard, sleep long."""
 848:         if self.in_burst:
 849:             return
 850:         if not self.over_complete or self.ad_detected:
 851:             return
 852:         if frame is not None:
 853:             h = frame.shape[0]
 854:             strip = frame[int(h * 0.88):, :]
 855:             if _strip_has_scoreboard(strip):
 856:                 log.info("[SLEEP] Ad tagged but scoreboard strip "
 857:                          "still visible — staying at 1s")
 858:                 return
 859:         self.ad_detected = True
 860:         log.info("[SLEEP] Over complete + full-screen ad → sleeping 25s")
 861: 
 862:     def on_scorecard_frame(self):
 863:         self.over_complete = False
 864:         self.ad_detected = False
 865: 
 866:     def on_camera_view(self, view: str | None) -> None:
 867:         """Record Scout's latest camera_view; drives the next sleep."""
 868:         self.last_camera_view = view
 869:         # Extend the active-tail window every time we see a live
 870:         # cricket frame.  This keeps cadence tight through the
 871:         # 1-3 frame dead-time blip that follows almost every ball.
 872:         if view in self._ACTIVE_PLAY_VIEWS:
 873:             self._active_tail_until = (
 874:                 time.time() + self.ACTIVE_TAIL_HOLD)
 875: 
 876:     def on_frame_phase(self, phase: str | None) -> None:
 877:         """Record Scout's latest frame_phase; drives per-phase cadence.
 878: 
 879:         Action phases (release/flight/shot/post_shot) also extend the
 880:         active-tail window so a late-cycle cut-away (closeup, replay)
 881:         doesn't immediately drop us back to dead-time cadence and miss
 882:         the strip tick to the new score.
 883:         """
 884:         self.last_frame_phase = phase
 885:         if phase in ("release", "flight", "shot", "post_shot"):
 886:             self._active_tail_until = (
 887:                 time.time() + self.ACTIVE_TAIL_HOLD)
 888: 
 889:     def get_sleep_time(self) -> float:
 890:         # Over-end burst always wins (last-ball-of-over coverage).
 891:         if self.in_burst:
 892:             return 0.0
 893:         if self.ad_detected:
 894:             self.ad_detected = False
 895:             self.over_complete = False
 896:             return 25.0
 897:         # Phase-driven cadence (Phase 3, 2026-04-19): when Scout has
 898:         # tagged the last frame with a frame_phase, that tag is the
 899:         # most informative signal we have — use the phase map
 900:         # directly.  Falls through to camera_view logic when phase
 901:         # is missing (frames recorded before the phase prompt).
 902:         if self.last_frame_phase is not None:
 903:             interval = self.PHASE_FREQUENCY.get(
 904:                 self.last_frame_phase)
 905:             if interval is not None:
 906:                 return interval
 907:         # ── back-compat: camera_view-driven cadence ──────────────
 908:         # Active-play burst: Scout tagged the last frame as live
 909:         # cricket → densely sample so the tagged buffer has enough
 910:         # bowlers_end frames at the moment of delivery detection.
 911:         if self.last_camera_view in self._ACTIVE_PLAY_VIEWS:
 912:             return self.ACTIVE_PLAY_INTERVAL
 913:         # Active-play tail: we just saw live cricket within the
 914:         # last ACTIVE_TAIL_HOLD seconds.  Stay fast — a dot ball's
 915:         # broadcast cut-away (closeup of the bowler walking back,
 916:         # replay of the shot) lasts ~3-5s before the strip
 917:         # repaints with the new overs.  Polling at 0.5s through
 918:         # this window means we catch the strip tick within ~1s
 919:         # of it appearing instead of waiting 2.5s.
 920:         if time.time() < self._active_tail_until:
 921:             return self.ACTIVE_PLAY_INTERVAL
 922:         if self.last_camera_view in self._DEAD_TIME_VIEWS:
 923:             return self.DEAD_TIME_INTERVAL
 924:         return self.DEFAULT_INTERVAL
