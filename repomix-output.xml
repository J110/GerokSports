150: def _format_squad_prompt(players: list[dict]) -> str:
151:     lines: list[str] = []
152:     current_team: str | None = None
153:     current_section: str | None = None
154:     for p in players:
155:         if p["team"] != current_team:
156:             current_team = p["team"]
157:             current_section = None
158:             lines.append(f"\nTeam: {current_team}")
159:         if p["section"] != current_section:
160:             current_section = p["section"]
161:             lines.append(f"  [{current_section}]")
162:         lines.append(f"    - {p['name']} (role: {p['role']})")
163:     return "\n".join(lines)
