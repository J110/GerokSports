1210:     def _log_count_mismatch(self, overs: str | None, legal_n: int) -> None:
1211:         """One-shot log per over when display count diverges from
1212:         team_overs. Helps diagnose wide-detection misses without
1213:         spamming the log."""
1214:         try:
1215:             sub = round((float(overs or "0") % 1) * 10)
1216:         except (ValueError, TypeError):
1217:             return
1218:         if sub == legal_n:
1219:             return
1220:         key = (self._last_over_int, sub, legal_n)
1221:         if getattr(self, "_last_mismatch_key", None) == key:
1222:             return
1223:         self._last_mismatch_key = key
1224:         log.info(
1225:             f"this_over count mismatch: team@{overs} expects "
1226:             f"{sub} legal balls, observed {legal_n} legal "
1227:             f"(tokens={self.this_over}) — keeping observations")
</file>

