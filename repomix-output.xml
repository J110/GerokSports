2364:             # previous over.
2365:             count = self._rotation_rejection_count.get(name, 0) + 1
2366:             self._rotation_rejection_count[name] = count
2367:             if count >= self._ROTATION_OVERRIDE_N:
2368:                 log.warn(
2369:                     f"  [ROTATION-OVERRIDE] Accepting '{name}' after "
2370:                     f"{count} consistent rejections — "
2371:                     f"_prev_over_bowler='{self._prev_over_bowler}' "
2372:                     f"record is likely wrong; clearing the lockout."
