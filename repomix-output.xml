2467:                     same_figures = (
2468:                         int(runs) == int(hist_r)
2469:                         and int(wickets) == int(hist_w)
2470:                         and str(overs) == str(hist_o))
2471:                 except (TypeError, ValueError):
2472:                     same_figures = False
2473:                 if same_figures:
2474:                     log.info(
2475:                         f"  [BOWLER-STALE] Rejecting '{name}' read — "
2476:                         f"proposed {wickets}-{runs}({overs}) exactly "
2477:                         f"matches recorded {hist_w}-{hist_r}({hist_o})"
2478:                         f"; no handoff grace "
2479:                         f"(must_change={self._bowler_must_change}). "
2480:                         f"Likely stale end-of-spell graphic; "
2481:                         f"current_bowler stays '{_cur_now}'"
2482:                     )
2483:                     return False
2484: 
2485:             # Identity change: clear any pending regression counter
2486:             # for the incoming bowler — the stale figures (if any)
2487:             # will be re-evaluated from the new reads.
2488:             self._bowler_regress_pending.pop(name, None)
