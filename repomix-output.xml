  1: """Cricket checker — enforces impossible-state rules AFTER tracker confirms.
  2: 
  3: Simplified from old CricketInvariantChecker. Removed harmful batter scaling
  4: (old invariants 4 & 5) that caused stat oscillation.
  5: """
  6: from __future__ import annotations
  7: 
  8: from eyes.cricket_logger import CricketLogger
  9: 
 10: log = CricketLogger("CRICKET")
 11: 
 12: 
 13: class CricketChecker:
 14: 
 15:     def __init__(self) -> None:
 16:         self._prev_active: list[str] = []
 17:         self._prev_wickets: int = 0
 18:         self._wickets_initialized: bool = False
 19:         self._wickets_confirmed: bool = False
 20:         self._batter_changed_recently: bool = False
 21: 
 22:     def reset(self) -> None:
 23:         self._prev_active = []
 24:         self._prev_wickets = 0
 25:         self._wickets_initialized = False
 26:         self._wickets_confirmed = False
 27:         self._batter_changed_recently = False
 28: 
 29:     def check(self, state: dict, batting_card: dict, bowling_card: dict,
 30:               this_over: list, tracker) -> list[str]:
 31:         """Run all checks. Correct violations in-place. Return corrections."""
 32:         corrections: list[str] = []
 33: 
 34:         score = int(state.get("score") or 0)
 35:         wickets = int(state.get("wickets") or 0)
 36:         overs = float(state.get("overs") or "0")
 37: 
 38:         active = [k for k, v in batting_card.items()
 39:                   if v.get("status") == "batting"]
 40:         dismissed = [k for k, v in batting_card.items()
 41:                      if v.get("status") == "out"]
 42: 
 43:         batter_set_changed = (set(active) != set(self._prev_active)
 44:                               and len(self._prev_active) > 0)
 45:         if batter_set_changed:
 46:             self._batter_changed_recently = True
 47:             log.info(f"Batter swap detected: "
 48:                      f"{self._prev_active} → {active}")
 49: 
 50:         # CHECK 1: Wickets can't increase if same 2 batters active
 51:         # Phase 1 (not confirmed): accept extractor wickets freely until
 52:         # we've seen a real batter-change-confirmed wicket transition.
 53:         # Phase 2 (confirmed): require batter swap for wicket increases.
 54:         if self._wickets_initialized:
 55:             if wickets > self._prev_wickets:
 56:                 if batter_set_changed or self._batter_changed_recently:
 57:                     self._wickets_confirmed = True
 58:                     log.info(f"Wicket {self._prev_wickets}→{wickets} "
 59:                              f"accepted (batter swap — guard now active)")
 60:                     self._batter_changed_recently = False
 61:                 elif not self._wickets_confirmed:
 62:                     log.info(f"Wicket {self._prev_wickets}→{wickets} "
 63:                              f"accepted (mid-innings join, guard inactive)")
 64:                 elif len(active) == 2 and set(active) == set(self._prev_active):
 65:                     corrections.append(
 66:                         f"Wicket {self._prev_wickets}→{wickets} but same "
 67:                         f"batters {active} — reverting")
 68:                     state["wickets"] = self._prev_wickets
 69:                     tracker.force_set("wickets", self._prev_wickets)
 70:                     wickets = self._prev_wickets
 71:         else:
 72:             if wickets > 0:
 73:                 self._wickets_initialized = True
 74: 
 75:         self._prev_active = active.copy()
 76:         self._prev_wickets = wickets
 77: 
 78:         # CHECK 3: Bowler overs can't exceed 4.0 in T20
 79:         for name, card in bowling_card.items():
 80:             bowl_ov = float(card.get("overs") or "0")
 81:             if bowl_ov > 4.0:
 82:                 corrections.append(
 83:                     f"Bowler {name} overs {bowl_ov} > 4.0 — clearing")
 84:                 card["overs"] = None
 85:                 tracker.force_set(f"bowl:{name}:overs", None)
 86: 
 87:         # CHECK 4: Bowler runs can't exceed team score
 88:         for name, card in bowling_card.items():
 89:             bowl_runs = card.get("runs") or 0
 90:             if bowl_runs > score and score > 0:
 91:                 corrections.append(
 92:                     f"Bowler {name} runs {bowl_runs} > score {score} — "
 93:                     f"capping")
 94:                 card["runs"] = score
 95:                 tracker.force_set(f"bowl:{name}:runs", score)
 96: 
 97:         # CHECK 5: This-over legal balls ≤ overs sub-ball count
 98:         # Only trim '?' placeholder tokens — those are speculative
 99:         # FLOOR-pads inserted by ThisOverManager.get_display() to match
100:         # team_overs. Real observations (W, numbers, dots) are never
101:         # trimmed here; they are managed exclusively by check_over_change
102:         # archival and on_ball_event append (the rollback path can
103:         # restore them and we must not destroy them again).
104:         # Trim '?' placeholders from the END (most recently added),
105:         # not the front (which would destroy the earliest real ball
106:         # like a first-ball wicket).
107:         if this_over:
108:             sub = round((overs % 1) * 10)
109:             if sub > 0:
110:                 legal = [x for x in this_over
111:                          if str(x).lower() not in ("wd", "nb")]
112:                 trimmed = 0
113:                 while len(legal) > sub and this_over:
114:                     # Find rightmost '?' placeholder to remove.
115:                     idx = next(
116:                         (i for i in range(len(this_over) - 1, -1, -1)
117:                          if this_over[i] == "?"),
118:                         None)
119:                     if idx is None:
120:                         # No placeholders left to safely remove.
121:                         # Real observations exceed the over count —
122:                         # leave them and surface a warning instead.
123:                         break
124:                     this_over.pop(idx)
125:                     trimmed += 1
126:                     legal = [x for x in this_over
127:                              if str(x).lower() not in ("wd", "nb")]
128:                 if trimmed > 0:
129:                     corrections.append(
130:                         f"This-over trimmed {trimmed} '?' placeholder"
131:                         f"{'s' if trimmed != 1 else ''} to match "
132:                         f"{sub} legal balls")
133: 
134:         if corrections:
135:             for c in corrections:
136:                 log.info(c)
137: 
138:         return corrections
