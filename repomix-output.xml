1347:     def _team_balls_seen(self) -> int:
1348:         try:
1349:             whole_s, ball_s = (
1350:                 str(self._inn.get("overs") or "0.0").split(".") + ["0"])[:2]
1351:             return int(whole_s) * 6 + int((ball_s or "0")[:1])
1352:         except (TypeError, ValueError):
