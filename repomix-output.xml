3902:     def on_new_over(self, completed_over: int):
3903:         """Archive the completed over and reset this_over.
3904: 
3905:         Sets _bowler_must_change flag — same bowler can't bowl
3906:         consecutive overs in limited-overs cricket.
3907:         """
3908:         bowler = self._inn.get("current_bowler")
3909:         archived: dict = {
3910:             "broadcast_balls": self.this_over.copy() if self.this_over else [],
3911:             "bowler": bowler,
3912:         }
3913: 
3914:         if bowler and bowler in self.bowling_card:
3915:             bc = self.bowling_card[bowler]
3916:             archived["bowler_figures"] = {
3917:                 "overs": bc.get("overs"),
3918:                 "runs": bc.get("runs"),
3919:                 "wickets": bc.get("wickets"),
3920:             }
3921: 
3922:         # Immutable: first archive of a given over slot wins. A second
3923:         # call for the same `completed_over` is treated as a duplicate
3924:         # archive attempt (e.g. the over rollover misfired and then
3925:         # re-fired on the next sane reading) — keep the original.
3926:         if completed_over in self.over_history:
3927:             log.info(
3928:                 f"[ARCHIVE] Over {completed_over} already archived "
3929:                 f"({self.over_history[completed_over]}). Refusing "
3930:                 f"second archive payload {archived}.")
3931:         else:
3932:             self.over_history[completed_over] = archived
3933: 
3934:         self._bowler_must_change = True
3935:         self._bowler_locked = False
3936:         self._prev_over_bowler = bowler
3937: 
3938:         if self.this_over:
3939:             over_runs = sum(int(x) for x in self.this_over
3940:                            if isinstance(x, str) and x.isdigit())
3941:             wkts = sum(1 for x in self.this_over if x == "W")
3942:             log.info(f"Over {completed_over} complete: "
3943:                      f"{self.this_over} = {over_runs} runs, "
3944:                      f"{wkts} wickets (by {bowler or '?'})")
3945:         else:
3946:             log.info(f"Over {completed_over} complete: "
3947:                      f"no ball data (by {bowler or '?'})")
3948:         # Reset per-over extras counter at over boundary; innings total
3949:         # and extras log are preserved for parity diagnostics.
3950:         if self.extras.get("this_over"):
3951:             log.info(f"[EXTRA] over {completed_over} closed with "
3952:                      f"{self.extras['this_over']} extra(s) — "
3953:                      f"resetting per-over counter")
3954:         self.extras["this_over"] = 0
3955:         self.this_over = []
3956: 
3957:     def record_speed(self, bowler_name: str, speed_kph: float) -> bool:
3958:         """Track bowling speed for a bowler with role-based validation."""
3959:         if not bowler_name or not speed_kph:
3960:             return False
3961:         if speed_kph < 60 or speed_kph > 170:
3962:             return False
3963: 
3964:         role = self._get_bowler_role(bowler_name)
3965: 
3966:         # Squad role overrides everything
3967:         if role == "spin" and speed_kph > 105:
3968:             log.info(f"[SPEED] {speed_kph}kph rejected — "
3969:                      f"{bowler_name} is a spinner (squad)")
3970:             return False
3971:         if role == "pace" and speed_kph < 100:
3972:             log.info(f"[SPEED] {speed_kph}kph rejected — "
3973:                      f"{bowler_name} is a pacer (squad)")
3974:             return False
3975: 
3976:         # First-reading classifier only when squad has no role
3977:         if bowler_name not in self.bowler_speeds:
3978:             self.bowler_speeds[bowler_name] = []
3979:             if role == "":
3980:                 if speed_kph < 100:
3981:                     self.bowler_type[bowler_name] = "spin"
3982:                 else:
3983:                     self.bowler_type[bowler_name] = "pace"
3984:             else:
3985:                 self.bowler_type[bowler_name] = role
3986:         else:
3987:             btype = self.bowler_type.get(bowler_name)
3988:             if btype == "spin" and speed_kph > 105:
3989:                 log.info(f"[SPEED] {speed_kph}kph rejected — {bowler_name} "
3990:                          f"classified as spinner")
3991:                 return False
3992:             if btype == "pace" and speed_kph < 85:
3993:                 log.info(f"[SPEED] {speed_kph}kph rejected — {bowler_name} "
3994:                          f"classified as pacer")
3995:                 return False
3996: 
3997:         self.bowler_speeds[bowler_name].append(speed_kph)
3998:         return True
3999: 
4000:     _KNOWN_SPINNERS = {
4001:         "RASHID KHAN", "YUZVENDRA CHAHAL", "RAVI BISHNOI",
4002:         "KULDEEP YADAV", "RAVINDRA JADEJA", "AXAR PATEL",
4003:         "MANIMARAN SIDDHARTH", "VARUN CHAKRAVARTHY",
4004:         "RAVICHANDRAN ASHWIN", "WASHINGTON SUNDAR",
4005:         "SUNIL NARINE", "ADAM ZAMPA", "NOOR AHMAD",
4006:         "RAHUL CHAHAR", "PIYUSH CHAWLA", "AMIT MISHRA",
4007:     }
4008: 
4009:     def _get_bowler_role(self, bowler_name: str) -> str:
4010:         """Determine if a bowler is spin or pace from squad data."""
4011:         role_str = self._squad_roles.get(bowler_name, "").lower()
4012:         if role_str:
4013:             if any(x in role_str for x in (
4014:                     "spin", "slow", "orthodox", "leg-break",
4015:                     "off-break", "sla", "chinaman")):
4016:                 return "spin"
4017:             if any(x in role_str for x in (
4018:                     "fast", "pace", "seam", "medium")):
4019:                 return "pace"
4020: 
4021:         if bowler_name.upper() in self._KNOWN_SPINNERS:
4022:             return "spin"
4023: 
4024:         return ""
4025: 
4026:     def get_bowler_speed_stats(self, bowler_name: str) -> dict | None:
4027:         """Get speed statistics for a bowler."""
4028:         speeds = self.bowler_speeds.get(bowler_name)
4029:         if not speeds:
4030:             return None
4031:         return {
4032:             "avg_speed": round(sum(speeds) / len(speeds), 1),
4033:             "max_speed": round(max(speeds), 1),
4034:             "min_speed": round(min(speeds), 1),
4035:             "count": len(speeds),
4036:         }
4037: 
4038:     def initialize_this_over(self, overs) -> None:
4039:         """Pre-fill this-over when joining mid-over."""
4040:         overs_f = float(overs or "0")
4041:         balls_this_over = round((overs_f % 1) * 10)
4042:         if balls_this_over > 0 and len(self.this_over) == 0:
4043:             self.this_over = ["?"] * balls_this_over
4044:             log.info(f"[THIS-OVER] Joined at {overs}, "
4045:                      f"pre-filled {balls_this_over} balls as '?'")
4046: 
4047:     def get_this_over_runs(self) -> int:
4048:         """Total runs in the current over."""
4049:         return sum(int(x) for x in self.this_over
4050:                    if isinstance(x, str) and x.isdigit())
4051: 
4052:     def get_this_over_for_display(self) -> list[str]:
4053:         """Return this-over trimmed to match the overs sub-ball count.
4054: 
4055:         If overs shows X.3, there should be at most 3 legal balls in
4056:         this-over (plus any extras like wd/nb). Excess legal balls from
4057:         a previous over or false detections are trimmed from the front,
4058:         keeping the most recent balls.
4059:         """
4060:         overs_raw = self._inn.get("overs") or "0"
4061:         try:
4062:             overs = float(overs_raw)
4063:         except (ValueError, TypeError):
4064:             return list(self.this_over)
4065: 
4066:         balls_this_over = round((overs % 1) * 10)
4067:         if balls_this_over == 0:
4068:             return list(self.this_over)
4069: 
4070:         display = list(self.this_over)
4071: 
4072:         legal = [x for x in display if str(x).lower() not in ("wd", "nb")]
4073:         extras = [x for x in display if str(x).lower() in ("wd", "nb")]
4074: 
4075:         if len(legal) > balls_this_over:
4076:             legal = legal[-balls_this_over:]
4077:             display = extras + legal
4078:             log.info(f"[THIS-OVER] Trimmed to {balls_this_over} "
4079:                      f"legal balls: {display}")
4080: 
4081:         return display
4082: 
4083:     # ------------------------------------------------------------------
4084:     # Display helpers
4085:     # ------------------------------------------------------------------
4086: 
4087:     def get_current_batters(self) -> str:
4088:         active = [(n, s) for n, s in self.batting_card.items()
4089:                   if s["status"] == "batting"]
4090:         if not active:
4091:             return "None"
4092:         striker = self._inn.get("striker")
4093:         parts = []
4094:         for name, stats in active:
4095:             marker = "*" if name == striker else ""
4096:             r = stats["runs"] if stats["runs"] is not None else "?"
4097:             parts.append(f"{name}{marker}({r})")
4098:         return " ".join(parts)
4099: 
4100:     def get_current_bowler(self) -> str:
4101:         cb = self._inn.get("current_bowler")
4102:         if not cb or cb not in self.bowling_card:
4103:             return "None"
4104:         e = self.bowling_card[cb]
4105:         return f"{cb} {e.get('wickets', '?')}-{e.get('runs', '?')}"
4106: 
4107:     # ------------------------------------------------------------------
4108:     # Player-style lookups (consumed by delivery classifier to derive
4109:     # frame-of-reference for `line`, `shot_side`, `bowling_angle`).
4110:     # Styles come from eyes/player_enrichment.py (2-pass LLM) and are
4111:     # stamped onto each card entry when the innings is initialised.
4112:     # ------------------------------------------------------------------
4113: 
4114:     def _batting_handed_from_style(self, style: str | None) -> str:
4115:         s = (style or "").strip().upper()
4116:         if s == "RHB":
4117:             return "right"
4118:         if s == "LHB":
4119:             return "left"
4120:         return "unknown"
4121: 
4122:     def _bowling_arm_from_style(self, style: str | None) -> str:
4123:         s = (style or "").strip().lower()
4124:         if not s or s in ("unknown", "none"):
4125:             return "unknown"
4126:         if s.startswith("right-arm") or "right arm" in s:
4127:             return "right"
4128:         if (s.startswith("left-arm")
4129:                 or "left arm" in s
4130:                 or "slow left-arm" in s
4131:                 or "left-arm wrist" in s):
4132:             return "left"
4133:         return "unknown"
4134: 
4135:     def get_current_batsman_handed(self) -> str:
4136:         """Return the striker's batting handedness ('left'/'right'/
4137:         'unknown') resolved pre-match from the squad enrichment pass."""
4138:         if not self._inn:
4139:             return "unknown"
4140:         striker = self._inn.get("striker")
4141:         if not striker:
4142:             return "unknown"
4143:         card = self.batting_card.get(striker) or {}
4144:         style = card.get("batting_style")
4145:         if style in (None, "unknown"):
4146:             style = (self._player_styles.get(striker) or {}).get(
4147:                 "batting_style")
4148:         return self._batting_handed_from_style(style)
4149: 
4150:     def get_current_bowling_arm(self) -> str:
4151:         """Return the current bowler's arm ('left'/'right'/'unknown')
4152:         resolved pre-match from the squad enrichment pass."""
4153:         if not self._inn:
4154:             return "unknown"
4155:         bowler = self._inn.get("current_bowler")
4156:         if not bowler:
4157:             return "unknown"
4158:         card = self.bowling_card.get(bowler) or {}
4159:         style = card.get("bowling_style")
4160:         if style in (None, "unknown", "None"):
4161:             style = (self._player_styles.get(bowler) or {}).get(
4162:                 "bowling_style")
4163:         return self._bowling_arm_from_style(style)
4164: 
4165:     # ------------------------------------------------------------------
4166:     # Internal
4167:     # ------------------------------------------------------------------
4168: 
4169:     def _log(self, category: str, field: str, old, new, frame: int):
4170:         entry = {"cat": category, "field": field, "old": old,
4171:                  "new": new, "frame": frame, "time": time.time()}
4172:         self._update_history.append(entry)
4173:         if len(self._update_history) > 200:
4174:             self._update_history = self._update_history[-100:]
4175:         log.info(f"{field}: {old} -> {new} [F{frame}]")
