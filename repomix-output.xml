3193:     @staticmethod
3194:     def make_fow_placeholder(wicket_number: int) -> dict:
3195:         """Single source of truth for FOW placeholder entry shape.
3196: 
3197:         Issue 4 fix (2026-04-21): consolidates the two divergent paths
3198:         (`_ensure_fow_placeholders` here and the cold-start pre-populate
3199:         in `test_pipeline.py`) into one factory.  Previously the
3200:         cold-start path seeded `batter="unknown", score="?", overs="?"`
3201:         WITHOUT `_unwitnessed: True`, so the UI rendered those as
3202:         confirmed wickets with garbage values.  Anyone needing a
3203:         placeholder MUST go through this function.
3204:         """
3205:         return {
3206:             "wicket": int(wicket_number),
3207:             "batter": None,
3208:             "score": None,
3209:             "overs": None,
3210:             "bowler": None,
3211:             "_unwitnessed": True,
3212:         }
