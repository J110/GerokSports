533:     # Split scout output into description + action
534:     # ------------------------------------------------------------------
535:     @staticmethod
536:     def _split_output(raw: str, frame_type: str,
537:                       ) -> tuple[str, str | None]:
538:         if frame_type == "ADVERTISEMENT":
539:             return ("", None)
540: 
541:         lines = raw.split("\n")
542:         text_lines = []
543:         for line in lines:
544:             stripped = line.strip()
545:             if stripped.startswith("{") and "has_strip" in stripped:
546:                 continue
547:             text_lines.append(line)
548:         text = "\n".join(text_lines).strip()
