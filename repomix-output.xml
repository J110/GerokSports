284:   ],
285:   "bowler": {{"name": "EXACT_NAME_FROM_VISION", "overs": null, "runs": null, "wickets": null, "speed_kph": null}},
286:   "bowlers": [],
287:   "extras": {{"type": null, "runs": null}},
288:   "this_over_broadcast": null,
289:   "batting_action": {{
290:     "shot_type": null, "direction": null, "elevation": null, "contact": null
291:   }},
292:   "bowling_action": {{
293:     "type": null, "variation": null, "line": null, "length": null
294:   }},
295:   "dismissal": null,
296:   "ground_truth": false,
297:   "graphic_type": null,
298:   "graphic_team": null,
299:   "other_match_ticker": null,
300:   "field_observed": null,
301:   "field_graphic": null,
302:   "info_panel": null
303: }}
