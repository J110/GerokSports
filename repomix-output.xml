2441:             # consensus mechanism downstream needs these repeats to
2442:             # accumulate and flip identity.  When the bowler
2443:             # context HAS changed in the interim, the original
2444:             # stale-graphic defense applies unchanged.
2445:             _last_w_frame = (
2446:                 self._bowling_card_active_write_frame.get(
2447:                     name, -10**9))
2448:             _last_w_bowler = (
2449:                 self._bowling_card_active_write_bowler.get(
2450:                     name, None))
2451:             _recently_written = (
2452:                 (frame - _last_w_frame)
2453:                 <= self._BOWLER_STALE_FRESH_FRAMES)
2454:             _same_bowler_context = (_last_w_bowler == _cur_now)
2455:             _fresh_between_ball = (
2456:                 _recently_written and _same_bowler_context)
2457: 
2458:             if (not self._bowler_must_change
2459:                     and not _fresh_between_ball
2460:                     and hist_r is not None
2461:                     and hist_w is not None
2462:                     and hist_o is not None
2463:                     and runs is not None
2464:                     and wickets is not None
2465:                     and overs is not None):
