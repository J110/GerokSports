 859:         # the display, the moment a CONFIRMED-DIFFERENT bowler appears
 860:         # the new over has unambiguously started — cricket forbids the
 861:         # same bowler bowling consecutive overs, so a different bowler
 862:         # name from a clean broadcast read is a fact, not a signal we
 863:         # need to wait on. Flush the held display immediately rather
 864:         # than waiting for the team-overs digit to advance or the
 865:         # 3-second hold timeout to expire.
 866:         if (self._pending_clear and bowler
 867:                 and self._held_over_bowler):
 868:             _a = (bowler or "").strip().lower()
 869:             _b = (self._held_over_bowler or "").strip().lower()
 870:             # Compare last name (single token) to absorb LLM
 871:             # firstname-vs-shortname variation (Praful Hinge ↔ Hinge).
 872:             _a_last = _a.split()[-1] if _a else ""
 873:             _b_last = _b.split()[-1] if _b else ""
