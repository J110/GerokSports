3561:     # === Match-end consensus (Fix A, 2026-04-22) ===
3562:     # Require 2 consecutive scoreboard frames proposing the same
3563:     # innings-2 end reason before finalizing the match. Protects
3564:     # against single-frame OCR flickers (e.g. 8→10 wickets misread,
3565:     # score briefly rewriting above target then self-correcting).
3566:     # `target_reached` / `all_out` / `overs_exhausted` each track
3567:     # consensus independently — a reason change resets the counter.
3568:     _match_end_consecutive = 0
3569:     _match_end_reason_pending: str | None = None
3570:     _MATCH_END_CONFIRM = 2
3571:     _correction_pending: dict | None = None  # tracks proposed score for consensus
3572:     _correction_count = 0  # consecutive frames proposing the same new score
3573:     _CORRECTION_CONFIRM = 2  # frames needed to accept a large delta
3574:     # === Unsupported-score-spike consensus ===
3575:     # An LLM can hallucinate a small (within-the-7-poison-threshold)
3576:     # score increase — e.g. read 44 instead of 37 — when none of the
3577:     # other strip cells move (overs unchanged, wickets unchanged,
3578:     # bowler runs unchanged, no broadcast WD/NB badge, batter runs
3579:     # unchanged).  Cricket physics says a real run-scoring event always
3580:     # moves at least one of these; an "unsupported" delta is therefore
3581:     # almost certainly a misread.  Pre-fix this poisoned `this_over`
3582:     # with a phantom `Nb+6` because the EXTRA-IMMEDIATE path in
3583:     # commentary.py emits the moment `balls_delta == 0 and s_delta > 0`
3584:     # — and the spurious token never recovered even after the score
3585:     # eventually stabilised.  Now: defer the score acceptance until a
3586:     # second consecutive frame agrees with the same value.
3587:     _unsupported_score_pending: int | None = None
3588:     _unsupported_score_count = 0
3589:     _UNSUPPORTED_SCORE_CONFIRM = 2
3590:     _squad_roles: dict[str, str] = {}
3591:     _last_wicket_frame = 0  # frame at which last wicket was detected
3592:     _new_batter_candidate: str | None = None  # pending replacement name
3593:     _new_batter_candidate_count = 0  # consecutive frames with same candidate
3594:     _NEW_BATTER_CONFIRM = 2  # frames needed to accept replacement
3595:     _first_frame_initialized = False  # set True after first valid scoreboard read
3596:     _last_ball_event_frame = 0  # frame at which last ball_event was detected
3597:     # Rollback tracking: when an EXTRA fires, snapshot the post-event
3598:     # score so we can detect a subsequent confirmed regression and
3599:     # peel the phantom Wd/Nb back off `over_mgr.this_over`.  See
3600:     # over_mgr.pop_last_extra() for the API contract.  This is
3601:     # defense-in-depth on top of the BED jitter-defer (which prevents
3602:     # the no-signal +1 case) and the unsupported-score-spike guard
3603:     # (which prevents +2..+7 phantoms): the residual case is a
3604:     # broadcast WD/NB strip that lit up briefly, drove an EXTRA via
3605:     # the broadcast_WD/broadcast_NB classifier, and then retracted on
3606:     # subsequent frames as the team-score regressed.
3607:     _last_extra_score: int | None = None
3608:     _last_extra_over_int: int | None = None
3609:     _ball_events_for_current_team = 0  # ball events fired since current
3610:     # `assign_teams()` call. Resets to 0 every time teams are (re)assigned.
3611:     # Used by Fix 3 (escape hatch) to detect cold-start team-lock: if we
3612:     # have stripped 30+ frames as "bowling-team comparison strips" but
3613:     # have never observed a single confirmed ball event for the team
3614:     # we *think* is batting, our team assignment is the misread, not
3615:     # the strip. Force-swap regardless of `_inn1_could_end`.
3616:     _bowling_team_strip_count = 0  # consecutive frames showing bowling team strip
3617:     # === S16/Day-1.5 hardening: cumulative (non-resetting) counter ===
3618:     # The consecutive counter (`_bowling_team_strip_count`) resets the
3619:     # moment one frame happens to read the assigned batting team — and
3620:     # the SCOUT VLM hallucinates a team name on roughly 1 frame in 8
3621:     # during cold-start, so the consecutive counter rarely reaches 30.
3622:     # The cumulative counter only ever resets on a successful
3623:     # `assign_teams()` call, so the escape hatch fires reliably even
3624:     # when the consecutive streak keeps getting interrupted.
3625:     _bowling_team_strip_total = 0
3626:     _BOWLING_TEAM_SWAP_TOTAL_THRESHOLD = 20
3627:     # Bug #16: was 5 — far too low. T20 broadcasts routinely show the
3628:     # bowling team's player profiles, "BOWLING STATS" panels,
3629:     # head-to-head graphics, and stat comparisons during between-overs
3630:     # breaks. 5 frames at ~3s/frame = 15s of broadcast — virtually any
3631:     # graphic exceeds it. We saw a real misfire at 8.0 overs of KKR's
3632:     # innings: a brief GT graphic block triggered the swap, then 74s
3633:     # later the live KKR strip returned and the system swapped back —
3634:     # but `current_innings` had already been promoted to 2 and never
3635:     # demoted, so KKR's own innings-1 data started landing in the
3636:     # innings-2 slot.
3637:     # 30 frames @ ~3s = ~90s of continuous broadcast — long enough that
3638:     # only a real innings break sustains it.
