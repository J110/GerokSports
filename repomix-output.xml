4499:     def build_full_payload(speed_kph=None):
4500:         """Build the SINGLE canonical payload — used everywhere."""
4501:         state = scoreboard.get_broadcast_state() if scoreboard._inn else {}
4502:         # === S1 fix: complete the SM cutover ===
4503:         # ScoreManager is the sole authority for striker / non_striker /
4504:         # current_bowler when running live (`shadow=False`). On idle
4505:         # frames the old code path leaked `scoreboard._inn["striker"]`
4506:         # (written by ~17 pre-SM sites) onto the UI, causing the
4507:         # per-frame striker flicker (S1) and the stale-bowler hallucination
4508:         # in Storyteller (S3). Override here so every WS payload — idle
4509:         # or event — uses SM's tracked names.
4510:         if state and not score_mgr.shadow:
4511:             # === S18: SM is now sole authority — write through, even
4512:             # when None. Otherwise after a WICKET (SM clears striker
4513:             # to None so the incoming batter slot is "empty until
4514:             # scout reads them") the original `state["striker"]` from
4515:             # scoreboard still holds the dismissed batter, leaking
4516:             # them onto the UI for 3-7s. Pass through None so the UI
4517:             # can render its placeholder ("incoming batter…" or "—").
4518:             #
4519:             # Issue 1 (2026-04-21): defense-in-depth canonicalization.
4520:             # SM's _build_scorecard already canonicalizes at ingest, but
4521:             # if the scoreboard reference isn't attached or a name can't
4522:             # be resolved at ingest time, raw scout surnames can still
4523:             # leak through.  Canonicalize once more at the WS boundary
4524:             # so the UI's `batting_card[i].is_striker = (name == striker)`
4525:             # comparison matches.
4526:             #
4527:             # Fix 7 (2026-04-26 inter-match bundle, WS-PROJECTION-GAP
4528:             # close-out): the SM cutover write + `sb._inn`-fallback-when-
4529:             # in-active-batting logic is now in module-level
4530:             # `_project_active_batters` so it's directly unit-testable.
4531:             # The fallback closes the ~24s post-wicket UI gap where SM
4532:             # had cleared striker/non_striker to None but `sb._inn`
4533:             # already held the new pair from scout's strip read.
4534:             _ws_fallback_events = _project_active_batters(
4535:                 state, score_mgr, scoreboard, _canon_player_name)
4536:             if score_mgr.bowler_name:
4537:                 state["current_bowler"] = _canon_player_name(
4538:                     score_mgr.bowler_name, bowler=True)
4539:             for _fb_slot, _fb_val in _ws_fallback_events:
4540:                 log.info(
4541:                     f"  [WS-PROJECTION-FALLBACK] {_fb_slot}={_fb_val!r} "
4542:                     f"surfaced from sb._inn (SM-null, in active_batting)")
4543:             # ── WS-boundary hygiene scrub (broadened 2026-04-22) ──
4544:             # Reject ANY striker / non_striker name that isn't currently
4545:             # `batting_card[name].status == "batting"`, and fall back
4546:             # to the active list so the UI never shows a None striker
4547:             # when two batters are clearly at the crease.
4548:             #
4549:             # Merges two bugs caught in live monitoring of MI-vs-CSK:
4550:             #   * P0-3 — striker=None after a wicket because SM cleared
4551:             #     it and the old scrub only checked status=="out", never
4552:             #     re-seeded from the active list.
4553:             #   * P1-4 — "Danish Malewar" phantom non_striker that wasn't
4554:             #     in batting_card AT ALL (Scout OCR'd a squad-stats
4555:             #     overlay); the old scrub skipped it because the
4556:             #     card-not-found path fell through without action.
4557:             #
4558:             # Fallback rule:
4559:             #   striker      → active[0] if available
4560:             #   non_striker  → first active name that isn't the striker
4561:             #                  (avoids writing the same name to both
4562:             #                  slots when striker just got re-seeded)
4563:             #
4564:             # Reason-tagged telemetry so post-deploy monitoring can
4565:             # distinguish the P0-3 class ("status_out" etc.) from the
4566:             # P1-4 class ("not_in_card"). Per-counter sub-tags land in
4567:             # `build_full_payload._ws_scrub_counts` for grep-ability.
4568:             _scrub_counts = getattr(
4569:                 build_full_payload, "_ws_scrub_counts", None)
4570:             if _scrub_counts is None:
4571:                 _scrub_counts = {}
4572:                 build_full_payload._ws_scrub_counts = _scrub_counts
4573: 
4574:             _bc = scoreboard.batting_card or {}
4575:             _active = [_n for _n, _c in _bc.items()
4576:                        if _c and _c.get("status") == "batting"]
4577: 
