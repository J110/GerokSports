389: async def _run_pass1(client, raw_data: dict, players: list[str]) -> dict:
390:     """Pass-1: prior-knowledge guess. Always fast (~1-3s)."""
391:     t0 = time.time()
392:     prompt1 = INFER_PROMPT.replace("{squads}", _format_squad_prompt(players))
393:     try:
394:         raw1 = await _call_groq_plain(client, prompt1, ENRICH_MODEL)
395:     except Exception as e:  # noqa: BLE001
396:         log.error(f"Pass-1 (infer) LLM call failed: {e}")
397:         raw1 = ""
398:     parsed1 = _extract_json_blob(raw1) or {}
399:     pass1 = _normalise_styles(parsed1, players)
400:     dt1 = (time.time() - t0) * 1000
401:     log.info(f"Pass-1 (infer) complete in {dt1:.0f}ms "
402:              f"({sum(1 for s in pass1.values() if s['batting_style'] != 'unknown')}"
403:              f"/{len(pass1)} known)")
404:     return pass1
