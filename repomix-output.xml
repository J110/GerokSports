 705: def _frame_int(frame_str: str) -> int:
 706:     """Parse 'F123' → 123; returns -1 if malformed."""
 707:     try:
 708:         return int(frame_str[1:]) if frame_str.startswith("F") else -1
 709:     except (ValueError, IndexError):
 710:         return -1
