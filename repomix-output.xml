  1: """GPU Monitor — measures idle time available for future Qwen 3.
  2: 
  3: Tracks when the GPU is busy (Qwen 1/2 running) vs idle (OCR only).
  4: Prints stats every 30 seconds so we know exactly how much headroom
  5: Qwen 3 would have for between-delivery analysis.
  6: """
  7: from __future__ import annotations
  8: 
  9: import time
 10: 
 11: from eyes.cricket_logger import CricketLogger
 12: 
 13: log = CricketLogger("GPU")
 14: 
 15: 
 16: class GPUMonitor:
 17:     """Tracks GPU busy/idle time for capacity planning."""
 18: 
 19:     PRINT_INTERVAL = 30.0  # seconds between stat prints
 20: 
 21:     def __init__(self):
 22:         self._start_time = time.time()
 23:         self._busy_seconds: float = 0.0
 24:         self._idle_seconds: float = 0.0
 25:         self._current_start: float | None = None
 26:         self._current_role: str | None = None
 27:         self._last_end: float = time.time()
 28:         self._last_print: float = time.time()
 29: 
 30:         self._calls: list[dict] = []  # [{role, start, end, duration}]
 31:         self._idle_gaps: list[float] = []  # seconds between Qwen calls
 32: 
 33:     def on_qwen_start(self, role: str, frame: int):
 34:         """Called when a Qwen model call begins."""
 35:         now = time.time()
 36:         if self._current_start is None:
 37:             idle_gap = now - self._last_end
 38:             self._idle_seconds += idle_gap
 39:             if idle_gap > 0.5:
 40:                 self._idle_gaps.append(idle_gap)
 41:         self._current_start = now
 42:         self._current_role = role
 43:         log.info(f"Qwen {role} started (frame {frame})")
 44: 
 45:     def on_qwen_end(self, role: str, frame: int, duration: float):
 46:         """Called when a Qwen model call finishes."""
 47:         now = time.time()
 48:         self._busy_seconds += duration
 49:         self._last_end = now
 50:         self._calls.append({
 51:             "role": role,
 52:             "frame": frame,
 53:             "duration": duration,
 54:             "timestamp": now,
 55:         })
 56:         self._current_start = None
 57:         self._current_role = None
 58:         log.info(f"Qwen {role} finished in {duration:.1f}s (frame {frame})")
 59: 
 60:     def on_frame_end(self, frame: int):
 61:         """Called at end of each frame to accumulate idle time."""
 62:         now = time.time()
 63:         if self._current_start is None:
 64:             # GPU is idle right now
 65:             pass
 66: 
 67:         if now - self._last_print >= self.PRINT_INTERVAL:
 68:             self.print_stats()
 69:             self._last_print = now
 70: 
 71:     def print_stats(self):
 72:         elapsed = time.time() - self._start_time
 73:         if elapsed < 1.0:
 74:             return
 75: 
 76:         total = self._busy_seconds + self._idle_seconds
 77:         if total < 1.0:
 78:             total = elapsed
 79: 
 80:         busy_pct = (self._busy_seconds / total) * 100
 81:         idle_pct = (self._idle_seconds / total) * 100
 82:         avg_gap = (sum(self._idle_gaps) / len(self._idle_gaps)) if self._idle_gaps else 0
 83: 
 84:         log.info(
 85:             f"Busy: {self._busy_seconds:.1f}s ({busy_pct:.0f}%) | "
 86:             f"Idle: {self._idle_seconds:.1f}s ({idle_pct:.0f}%) | "
 87:             f"Avg gap: {avg_gap:.1f}s | "
 88:             f"Calls: {len(self._calls)}"
 89:         )
 90: 
 91:     def get_stats(self) -> dict:
 92:         elapsed = time.time() - self._start_time
 93:         total = max(self._busy_seconds + self._idle_seconds, elapsed, 1.0)
 94:         avg_gap = (sum(self._idle_gaps) / len(self._idle_gaps)) if self._idle_gaps else 0
 95:         return {
 96:             "busy_seconds": round(self._busy_seconds, 1),
 97:             "idle_seconds": round(self._idle_seconds, 1),
 98:             "busy_pct": round((self._busy_seconds / total) * 100, 1),
 99:             "idle_pct": round((self._idle_seconds / total) * 100, 1),
100:             "avg_idle_gap": round(avg_gap, 1),
101:             "total_calls": len(self._calls),
102:             "elapsed": round(elapsed, 1),
103:         }
104: 
105:     def reset(self):
106:         self.__init__()
