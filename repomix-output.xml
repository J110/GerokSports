 674: def frame_changed(current: np.ndarray, previous: np.ndarray | None,
 675:                   threshold: float = 0.05) -> bool:
 676:     if previous is None:
 677:         return True
 678:     if current.shape != previous.shape:
 679:         return True
 680:     diff = np.mean(np.abs(current.astype(float) - previous.astype(float)))
 681:     return diff > (255 * threshold)
