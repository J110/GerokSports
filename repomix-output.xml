1617: def _get_previous_runs(canonical: str, scoreboard) -> int | None:
1618:     """Get last known runs for a player from the batting card."""
1619:     if not scoreboard or not scoreboard.batting_card:
1620:         return None
1621:     entry = scoreboard.batting_card.get(canonical)
1622:     if entry and entry.get("runs") is not None:
1623:         return entry["runs"]
1624:     return None
