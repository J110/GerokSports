4274:     def _scan_dismissal_keyword(text: str) -> str | None:
4275:         if not text:
4276:             return None
4277:         _t = text.lower()
4278:         for kw, mode in _DISMISSAL_KEYWORDS.items():
4279:             if kw in _t:
4280:                 return mode
4281:         return None
