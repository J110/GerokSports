 713: def _bin_by_wicket(
 714:     events: list[dict],
 715:     wicket_frames: list[dict],
 716: ) -> dict[int, list[dict]]:
 717:     """Bin events into [wicket_n_start, wicket_(n+1)_start) windows.
 718: 
 719:     Wicket 0 covers the pre-first-wicket window; wicket N covers the
 720:     window after the Nth wicket transition until the next.  Used by
 721:     the Fix 10 per-wicket counterfactual report.
 722:     """
 723:     if not wicket_frames:
 724:         return {0: events[:]}
 725:     sorted_wkts = sorted(wicket_frames, key=lambda w: _frame_int(w["frame"]))
 726:     bins: dict[int, list[dict]] = {0: []}
 727:     for w in sorted_wkts:
 728:         bins[w["wickets"]] = []
 729:     for ev in events:
 730:         ev_f = _frame_int(ev["frame"])
 731:         owner = 0
 732:         for w in sorted_wkts:
 733:             if ev_f >= _frame_int(w["frame"]):
 734:                 owner = w["wickets"]
 735:             else:
 736:                 break
 737:         bins.setdefault(owner, []).append(ev)
 738:     return bins
