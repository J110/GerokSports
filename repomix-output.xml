883: def get_spell_analysis(bowling_card: dict, current_bowler: str | None) -> dict:
884:     if not current_bowler:
885:         return {}
886:     entry = None
887:     for name, s in bowling_card.items():
888:         if name == current_bowler:
889:             entry = s
890:             break
891:     if not entry:
892:         return {}
893: 
894:     overs = float(entry.get("overs") or 0)
895:     runs = entry.get("runs") or 0
896:     wickets = entry.get("wickets") or 0
897:     if overs == 0:
898:         return {}
899: 
900:     economy = round(runs / overs, 2)
901:     if economy < 5 and wickets > 0:
902:         quality = "excellent"
903:     elif economy < 6:
904:         quality = "tight"
905:     elif economy < 8:
906:         quality = "decent"
907:     elif economy > 12:
908:         quality = "getting hammered"
909:     elif economy > 10:
910:         quality = "expensive"
911:     else:
912:         quality = "average"
913: 
914:     return {
915:         "economy": economy,
916:         "quality": quality,
917:         "wickets": wickets,
918:         "overs": overs,
919:         "runs": runs,
920:     }
