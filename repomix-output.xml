 642: def _percentile(values: list[float], pct: float) -> float | None:
 643:     if not values:
 644:         return None
 645:     s = sorted(values)
 646:     if len(s) == 1:
 647:         return float(s[0])
 648:     k = (len(s) - 1) * (pct / 100.0)
 649:     f = int(k)
 650:     c = min(f + 1, len(s) - 1)
 651:     if f == c:
 652:         return float(s[f])
 653:     return float(s[f] + (s[c] - s[f]) * (k - f))
