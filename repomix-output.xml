1472: def _resolve_to_squad(token: str, name_lookup: dict) -> str | None:
1473:     """Check if a token resolves to a squad member via the lookup table."""
1474:     up = token.upper().strip()
1475:     if up in name_lookup:
1476:         return name_lookup[up]
1477:     return None
