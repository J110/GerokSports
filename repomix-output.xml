102: def _load_cache(raw_data: dict) -> dict | None:
103:     p = _cache_path(raw_data)
104:     if not p.exists():
105:         return None
106:     try:
107:         cached = json.loads(p.read_text())
108:         if not isinstance(cached, dict):
109:             return None
110:         log.info(f"Loaded cached styles from {p.name} "
111:                  f"({len(cached)} players)")
112:         return cached
113:     except Exception as e:  # noqa: BLE001
114:         log.warn(f"Cache read failed ({p.name}): {e}")
115:         return None
