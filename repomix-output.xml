413:     def _flush_entity_suspicion(self):
414:         """If 2+ fields from the same entity were suspicious this frame,
415:         escalate ALL pending fields from that entity to need 3 readings."""
416:         for entity, flagged in self._suspicious_this_frame.items():
417:             if len(flagged) >= 2:
418:                 escalated = []
419:                 for f in list(self.pending.keys()):
420:                     if f.startswith(entity) and f not in flagged:
421:                         old_count = self.pending_counts.get(f, 0)
422:                         self.pending_counts[f] = max(old_count, 2)
423:                         escalated.append(f)
424:                 if escalated:
425:                     log.info(f"[ENTITY-SUSPICIOUS] {entity}: {len(flagged)} "
426:                              f"fields suspicious → escalating {escalated}")
427:         self._suspicious_this_frame = {}
428: 
429:     def _is_suspicious(self, field: str, old, new) -> bool:
430:         try:
431:             old_f, new_f = float(old), float(new)
432:         except (ValueError, TypeError):
433:             return False
434: 
435:         # --- Score ---
436:         # ANY downward drop is suspicious. Score in T20 cricket never
437:         # decreases outside two narrowly-scoped paths (both handled
438:         # elsewhere): a DRS overturn (caught by `_is_drs_pattern` in
439:         # post-gap grace) and an innings change (handled by the
440:         # innings-transition path which fully resets state). A -1/-2
441:         # OCR misread of the team-score digit during normal play used
442:         # to slip past this guard's old `>5` threshold and then
443:         # fabricate a phantom EXTRA on the next frame when the score
444:         # snapped back up. Treat every regression as suspicious so it
445:         # has to clear 4-frame consensus before being accepted.
446:         if field == "score" and new_f < old_f:
447:             log.info(f"[SUSPICIOUS] score: {old}→{new} "
448:                      f"(any decrease is suspicious in normal play)")
449:             return True
450:         # Large upward jumps are suspicious too.  Even after a long ad
451:         # break the pipeline catches up via repeated scoreboard reads;
452:         # a single +30 jump in one update means OCR noise (a sponsor
453:         # overlay number, a different innings's score graphic, two
454:         # numbers blending during a transition).  Require 3-frame
455:         # consensus before we accept it.
456:         if field == "score" and new_f - old_f > 30:
457:             log.info(f"[SUSPICIOUS] score: {old}→{new} "
458:                      f"(jump +{new_f - old_f:.0f} too large)")
459:             return True
460: 
461:         # --- Match overs: never go backwards ---
462:         if field == "overs":
463:             if new_f < old_f:
464:                 log.info(f"[SUSPICIOUS] overs: {old}→{new} (backwards)")
465:                 return True
466: 
467:         # --- Wickets (team) ---
468:         if field == "wickets" and new_f < old_f:
469:             return True
470: 
471:         # --- Batter runs ---
472:         if field.startswith("bat:") and field.endswith(":runs"):
473:             balls_field = field.replace(":runs", ":balls")
474:             balls = self.confirmed.get(balls_field)
475:             # STALE-0 override (hardened 2026-04-21, Fix A.3):
476:             #   Previously we accepted ANY non-zero runs value on a
477:             #   batter whose confirmed state was 0(0) after 3+ overs,
478:             #   reasoning "the batter clearly isn't at 0(0), this is
479:             #   a stale zero and we should unblock".  That reasoning
480:             #   is right in the common case but it also accepts
481:             #   comparison-overlay and career-summary graphics
482:             #   verbatim — e.g. the "Klaasen last 5 innings: 51, 43,
483:             #   62…" overlay gets ingested as "Klaasen is on 51
484:             #   RIGHT NOW" because we bypass the suspicion check on
485:             #   the first read.  The result: a locked-in wrong score
486:             #   that regression rejection then protects against
487:             #   correction.
488:             #
489:             #   New rule: fast-accept 0→X ONLY when X fits a single
490:             #   delivery (≤ 6 runs).  Any bigger jump MUST pass the
491:             #   normal 3-frame consensus path — which filters out
492:             #   one-off overlay reads while still converging on
493:             #   genuine catch-up values within a few seconds.
494:             if balls is not None and float(balls) == 0 and new_f > 0:
495:                 if old_f == 0 and new_f <= 6:
496:                     log.info(
497:                         f"[STALE-0-SMALL] {field}: 0→{new_f} — "
498:                         f"fast-accepting (fits a single delivery)")
499:                     return False
500:                 log.info(
501:                     f"[SUSPICIOUS] {field}: {old}→{new} while "
502:                     f"balls=0 — deferring to consensus "
503:                     f"(comparison-overlay protection)")
504:                 return True
505:             # Runs should never decrease within an innings — batter stats
506:             # are strictly monotonic. Any drop (even by 1) is an OCR
507:             # misread (tightened 2026-04-21; the old `> 1` threshold
508:             # let small regressions promote via post-event grace).
509:             if new_f < old_f:
510:                 log.info(f"[SUSPICIOUS] {field}: {old}→{new} "
511:                          f"(runs dropped by {old_f - new_f})")
512:                 return True
513:             if old_f > 10 and new_f < old_f * 0.5:
514:                 return True
515:             # Upward physics cap — a batter cannot score more than a
516:             # SIX off a single legal delivery, with one run of slack
517:             # for the NB+six strip-lag edge case. See the
518:             # BATTER_SINGLE_BALL_RUN_MAX comment at the top of the
519:             # class for the full derivation. Any jump above this cap
520:             # is routed into the normal 3/4-frame consensus paths; a
521:             # single-frame scramble cannot survive.
522:             _bat_cap = (self.BATTER_SINGLE_BALL_RUN_MAX
523:                         + self.BATTER_NO_BALL_ADDITIONAL)
524:             if new_f - old_f > _bat_cap:
525:                 log.info(
526:                     f"[BAT-PHYSICS] {field}: {old}→{new} "
527:                     f"(+{new_f - old_f:.0f} exceeds single-ball "
528:                     f"cap {_bat_cap}) — routing to consensus")
529:                 return True
530: 
531:         # --- Batter balls ---
532:         if field.startswith("bat:") and field.endswith(":balls"):
533:             # Batter balls are strictly monotonic within an innings
534:             # (tightened 2026-04-21 to reject any downward drift).
535:             if new_f < old_f:
536:                 log.info(f"[SUSPICIOUS] {field}: {old}→{new} "
537:                          f"(balls dropped by {old_f - new_f})")
538:                 return True
539:             if new_f > old_f + 20:
540:                 return True
541: 
542:         # --- Bowler runs: cross-check vs score delta ---
543:         if field.startswith("bowl:") and field.endswith(":runs"):
544:             bowler_name = field.split(":")[1]
545:             bowl_wkts = self.confirmed.get(f"bowl:{bowler_name}:wickets")
546:             if bowl_wkts is not None and new_f < float(bowl_wkts):
547:                 log.info(f"[SUSPICIOUS] {field}: runs={new_f} < "
548:                          f"wickets={bowl_wkts} — likely swapped")
549:                 return True
550:             runs_delta = new_f - old_f
551:             score = self.confirmed.get("score")
552:             if score is not None and new_f > float(score):
553:                 return True
554:             if self._prev_confirmed_score is not None and score is not None:
555:                 score_delta = float(score) - float(self._prev_confirmed_score)
556:                 if runs_delta > score_delta + 2:
557:                     return True
558:             if runs_delta > 7:
559:                 return True
560:             # Any drop in bowler runs is suspicious — a spell's runs are
561:             # strictly monotonically non-decreasing (2026-04-21). The old
562:             # `new_f < old_f - 3` threshold let small regressions (e.g.
563:             # Harsh Dubey 5→4, Malinga 20→18) slip through the post-event
564:             # grace path and corrupt the confirmed figures. Within a
565:             # spell runs can only go up; between spells `force_set` resets
566:             # the tracker key, so there's no legitimate downward case here.
567:             if new_f < old_f:
568:                 return True
569: 
570:         # --- Bowler wickets: max +1 per frame, never decrease ---
571:         if field.startswith("bowl:") and field.endswith(":wickets"):
572:             bowler_name = field.split(":")[1]
573:             bowl_runs = self.confirmed.get(f"bowl:{bowler_name}:runs")
574:             if bowl_runs is not None and new_f > float(bowl_runs):
575:                 log.info(f"[SUSPICIOUS] {field}: wickets={new_f} > "
576:                          f"runs={bowl_runs} — likely swapped")
577:                 return True
578:             if new_f > old_f + 1:
579:                 return True
580:             if new_f < old_f:
581:                 return True
582: 
583:         # --- Bowler overs: cap 4.0, never decrease ---
584:         # Allow up to +1.0 jump (full over) for ad-break gaps,
585:         # but block career-stat leaks (e.g. 0.4→3.0)
586:         if field.startswith("bowl:") and field.endswith(":overs"):
587:             if new_f > 4.0:
588:                 return True
589:             if new_f > old_f + 1.0:
590:                 return True
591:             if new_f < old_f:
592:                 return True
593: 
594:         return False
595: 
596:     @staticmethod
597:     def _is_natural_batter_increment(field: str, old, new) -> bool:
598:         """Small positive batter increments from the broadcast strip
599:         are ground truth — no need to wait for a second read."""
600:         try:
601:             old_f, new_f = float(old), float(new)
602:         except (ValueError, TypeError):
603:             return False
604:         delta = new_f - old_f
605:         if field.startswith("bat:") and field.endswith(":runs"):
606:             return 1 <= delta <= 6
607:         if field.startswith("bat:") and field.endswith(":balls"):
608:             return delta == 1
609:         return False
610: 
611:     @staticmethod
612:     def _is_natural_bowler_increment(field: str, old, new) -> bool:
613:         """Tight-delta bowler increments whose value-space rules out
614:         OCR collisions — wickets can only step +1 (a single wicket
615:         on the ball), overs can only step +0.1 within a spell.
616:         Runs are intentionally excluded (see caller comment)."""
617:         try:
618:             old_f, new_f = float(old), float(new)
619:         except (ValueError, TypeError):
620:             return False
621:         if field.startswith("bowl:") and field.endswith(":wickets"):
622:             return new_f - old_f == 1
623:         if field.startswith("bowl:") and field.endswith(":overs"):
624:             delta = new_f - old_f
625:             return 0.09 <= delta <= 0.11
626:         return False
627: 
628:     @staticmethod
629:     def _values_close(a, b, field: str) -> bool:
630:         """Check if two rejected values are 'close enough' to count as
631:         the same consensus signal (e.g. score 82 and 83 both disagree
632:         with the tracker's 239)."""
633:         try:
634:             fa, fb = float(a), float(b)
635:         except (ValueError, TypeError):
636:             return a == b
637:         if field == "score":
638:             return abs(fa - fb) <= 5
639:         if field == "overs":
640:             return abs(fa - fb) <= 0.3
641:         if field == "wickets":
642:             return abs(fa - fb) <= 1
643:         return abs(fa - fb) <= 2
644: 
645:     def _is_drs_pattern(self, field: str, value) -> bool:
646:         """Check if this looks like a DRS outcome change."""
647:         old = self.confirmed.get(field)
648:         if old is None or value is None:
649:             return False
650:         try:
651:             old_f, new_f = float(old), float(value)
652:         except (ValueError, TypeError):
653:             return False
654:         if field == "overs" and 0 < old_f - new_f <= 0.1:
655:             return True
656:         if field == "wickets" and old_f - new_f == 1:
657:             return True
658:         if field == "score" and abs(new_f - old_f) <= 2:
659:             return True
660:         return False
661: 
662:     def on_ball_event(self):
663:         """After a ball event, accept changes on first read for 2 frames.
664:         The frame_poisoned flag already blocks corrupted data upstream,
665:         so consensus can be safely relaxed here."""
666:         self._post_event_grace = 2
667: 
668:     def force_set(self, field: str, value):
669:         """Override without consistency check. Used by cricket checks."""
670:         self.confirmed[field] = value
671:         self.pending.pop(field, None)
672:         self._initial_consensus.pop(field, None)
673: 
674:     def get(self, field: str, default=None):
675:         return self.confirmed.get(field, default)
676: 
677:     def get_all_batters(self) -> dict:
678:         batters: dict = {}
679:         for field, value in self.confirmed.items():
680:             if field.startswith("bat:"):
681:                 parts = field.split(":")
682:                 if len(parts) == 3:
683:                     _, name, stat = parts
684:                     batters.setdefault(name, {})[stat] = value
685:         return batters
686: 
687:     def get_all_bowlers(self) -> dict:
688:         bowlers: dict = {}
689:         for field, value in self.confirmed.items():
690:             if field.startswith("bowl:"):
691:                 parts = field.split(":")
692:                 if len(parts) == 3:
693:                     _, name, stat = parts
694:                     bowlers.setdefault(name, {})[stat] = value
695:         return bowlers
