3429:     def _set_innings_2_logged(*args, **kwargs):
3430:         # Cold-start mid-innings-2 protection.
3431:         #
3432:         # Multiple call sites (`[CODE] Innings 2 confirmed`,
3433:         # `[INNINGS] Scorer target`, auto-swap fresh-strip, etc.)
3434:         # invoke `set_innings_2` to flip the innings flag and reset
3435:         # state.  In a *real* innings transition this is correct —
3436:         # innings 2 starts at 0/0 (0.0).  But during a cold-start
3437:         # that began mid-innings-2 (pipeline started after the
3438:         # interval), the data we accumulated under `current_innings
3439:         # = 1` is *actually* innings 2 — wiping it to 0/0 destroys
3440:         # legitimate observations (score, overs, batter / bowler
3441:         # progress, this-over balls) and triggers the `delta>7`
3442:         # poison guard against every recovery frame, freezing the
3443:         # pipeline at 0/0 inn 2 forever.
3444:         #
3445:         # Heuristic: if at the time of the call we are in
3446:         # `current_innings == 1` AND the state has any observed
3447:         # progress (score > 0 OR overs > 0) AND it is *physically
3448:         # impossible* for innings 1 to have ended (overs < 18.0 AND
3449:         # wickets < 8), this must be a cold-start mid-innings-2
3450:         # correction.  Snapshot the state, let the original method
3451:         # blank everything, then restore the snapshot into
3452:         # innings[2].
3453:         _pre_inn = scoreboard.current_innings
3454:         _pre_state: dict | None = None
3455:         _is_cold_start_correction = False
3456:         # Unified INNINGS-TRANSITION telemetry — one log line for every
3457:         # set_innings_2 invocation regardless of trigger source. Lets
3458:         # us audit transition frequency, time-to-detect, and catch
3459:         # over-triggering (expected: exactly 1 per match, or 2 on
3460:         # cold-start scenarios). Caller file:line reconstructed from
3461:         # the stack so every trigger site is attributable.
3462:         try:
3463:             import inspect as _ins
3464:             _frm = _ins.currentframe().f_back
3465:             _caller = f"{os.path.basename(_frm.f_code.co_filename)}:{_frm.f_lineno}" if _frm else "?"
3466:         except Exception:
3467:             _caller = "?"
3468:         _tel_target = args[0] if args else kwargs.get("target")
3469:         _tel_inn = getattr(scoreboard, "_inn", None)
3470:         _tel_score = (_tel_inn or {}).get("score") if _tel_inn else None
3471:         _tel_wkts = (_tel_inn or {}).get("wickets") if _tel_inn else None
3472:         _tel_overs = (_tel_inn or {}).get("overs") if _tel_inn else None
3473:         _tel_team = (_tel_inn or {}).get("batting_team") if _tel_inn else None
3474:         log.info(
3475:             f"[INNINGS-TRANSITION-TELEMETRY] source=set_innings_2 "
3476:             f"caller={_caller} "
3477:             f"pre_inn={_pre_inn} "
3478:             f"pre_state={_tel_score}/{_tel_wkts} ({_tel_overs}) "
3479:             f"pre_team={_tel_team} "
3480:             f"target={_tel_target}")
3481:         if _pre_inn == 1 and scoreboard._inn:
3482:             try:
3483:                 _pre_score = int(
3484:                     scoreboard._inn.get("score") or 0)
3485:             except (ValueError, TypeError):
3486:                 _pre_score = 0
3487:             try:
3488:                 _pre_overs_raw = scoreboard._inn.get("overs")
3489:                 _pre_overs_f = (
3490:                     float(_pre_overs_raw)
3491:                     if _pre_overs_raw is not None else 0.0)
3492:             except (ValueError, TypeError):
3493:                 _pre_overs_f = 0.0
3494:             try:
3495:                 _pre_wkts = int(
3496:                     scoreboard._inn.get("wickets") or 0)
3497:             except (ValueError, TypeError):
3498:                 _pre_wkts = 0
3499:             _has_progress = (_pre_score > 0 or _pre_overs_f > 0.0)
3500:             _impossible_end = (
3501:                 _pre_overs_f < 18.0 and _pre_wkts < 8)
3502:             if _has_progress and _impossible_end:
3503:                 _is_cold_start_correction = True
3504:                 _pre_state = dict(scoreboard._inn)
3505:                 log.info(
3506:                     f"[INNINGS] set_innings_2 with cold-start "
3507:                     f"state {_pre_score}/{_pre_wkts} "
3508:                     f"({_pre_overs_f}) — preserving (innings 1 "
3509:                     f"physically incomplete; this is a cold-"
3510:                     f"start mid-innings-2 correction).")
3511:         _r = _orig_set_innings_2(*args, **kwargs)
3512:         if _is_cold_start_correction and _pre_state is not None:
3513:             # Carry the requested target into the preserved
3514:             # state so the caller's intent is honoured.
3515:             _target = (
3516:                 args[0] if args
3517:                 else kwargs.get("target"))
3518:             if _target is not None:
3519:                 _pre_state["target"] = _target
