309: 
310: class Extractor:
311:     """Dumb data extractor. Passes through what vision saw.
312: 
313:     Primary: Groq Llama 4 Scout 17B (~0.7s)
314:     Fallback: Groq Llama 3.1 8B (~0.3s)
315:     """
316: 
317:     def __init__(self):
318:         self._client = AsyncGroq(api_key=GROQ_API_KEY, timeout=15.0)
319:         self._fallback_count = 0
320: 
321:     async def extract(self, description: str, frame_type: str,
322:                       team_a_name: str = "", team_b_name: str = "",
323:                       **kwargs) -> dict:
324:         if not description:
325:             return {}
326: 
327:         prompt = EXTRACTOR_PROMPT.format(
328:             frame_type=frame_type,
329:             team_a_name=team_a_name or "Unknown",
330:             team_b_name=team_b_name or "Unknown",
331:             description=description,
332:         )
333: 
334:         t0 = time.time()
335:         try:
336:             return await self._call_model(PRIMARY_MODEL, prompt, t0)
337:         except Exception as e:
338:             err = str(e).lower()
339:             if "rate_limit" in err or "429" in err:
340:                 self._fallback_count += 1
341:                 log.info(f"Scout rate limited, falling back to 8B "
342:                          f"(#{self._fallback_count})")
343:                 try:
344:                     return await self._call_model(
345:                         FALLBACK_MODEL, prompt, t0)
346:                 except Exception as e2:
347:                     log.error(f"Fallback also failed: {e2}")
348:                     return {}
349:             log.error(f"Extractor call failed: {e}")
350:             return {}
351: 
352:     async def _call_model(self, model: str, prompt: str,
353:                           t0: float) -> dict:
354:         resp = await self._client.chat.completions.create(
355:             model=model,
356:             temperature=0,
357:             max_tokens=500,
358:             messages=[{"role": "user", "content": prompt}],
359:         )
360:         elapsed = time.time() - t0
361:         raw = resp.choices[0].message.content
362:         log.info(f"Extracted in {elapsed:.1f}s ({model.split('/')[-1]})")
363:         return self._parse_json(raw)
364: 
365:     @staticmethod
366:     def _parse_json(raw: str) -> dict:
367:         text = raw.strip()
368:         if text.startswith("```"):
369:             lines = text.split("\n")
370:             text = "\n".join(lines[1:])
371:             if "```" in text:
372:                 text = text[:text.index("```")]
373:             text = text.strip()
374:         try:
375:             return json.loads(text)
376:         except json.JSONDecodeError:
377:             start = text.find("{")
378:             end = text.rfind("}") + 1
379:             if start >= 0 and end > start:
380:                 try:
381:                     return json.loads(text[start:end])
382:                 except json.JSONDecodeError:
383:                     pass
384:             log.error(f"JSON parse failed: {text[:200]}")
385:             return {}
386: 
387:     async def close(self):
388:         await self._client.close()
