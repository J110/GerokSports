 764:     @staticmethod
 765:     def _is_legal_run_token(t: str) -> bool:
 766:         """Return True iff `t` belongs to the cricket-scorecard
 767:         alphabet that `_merge_broadcast` is permitted to emit.
 768: 
 769:         This is the inverse of an OCR-misread escape: the broadcast
 770:         `THIS OVER:` field is occasionally polluted by adjacent
 771:         graphic strips (most often the per-ball-speed track that
 772:         sits directly above the run-track on production overlays).
 773:         Without alphabet validation the pipeline ingests speed
 774:         numbers as run-tokens — see RR vs SRH 2026-04-25 F2461
 775:         which archived `[139, 148, 143, 147, 145, 140] = 862 runs`
 776:         for over 2.
 777: 
 778:         Legal alphabet (matches `_merge_broadcast` output):
 779:           - "." dot ball
 780:           - "?" placeholder (intra-pipeline; cold-start fills,
 781:             MULTI_BALL gaps, etc.)
 782:           - single-digit runs in 0..7 (7 covers the rare
 783:             overthrow / wide+6 case)
 784:           - "W" wicket, "Wd" wide, "Nb" no-ball (compound
 785:             forms like "Wd+4" never come from `_merge_broadcast`
 786:             — they originate in observed `on_ball_event` and
 787:             bypass this gate, so we don't need to allow them
 788:             here)
 789:           - "{N}b" bye and "{N}lb" leg-bye where N is a
 790:             single digit
 791: 
 792:         Anything else (3-digit speed values, gibberish OCR)
 793:         triggers wholesale rejection of the broadcast list at
 794:         the caller.
 795:         """
 796:         if t in (".", "?", "W", "Wd", "Nb"):
 797:             return True
 798:         if t.isdigit() and len(t) == 1 and 0 <= int(t) <= 7:
 799:             return True
 800:         # leg-byes: "{N}lb" with N a single digit
 801:         if (t.endswith("lb") and len(t) == 3
 802:                 and t[0].isdigit() and 0 <= int(t[0]) <= 7):
 803:             return True
 804:         # byes: "{N}b" with N a single digit; must not be "nb"
 805:         if (t.endswith("b") and not t.endswith("nb")
 806:                 and len(t) == 2
 807:                 and t[0].isdigit() and 0 <= int(t[0]) <= 7):
 808:             return True
 809:         return False
 810: 
 811:     @staticmethod
 812:     def _merge_broadcast(tokens: list[str]) -> list[str]:
 813:         """Normalize broadcast tokens to our display format.
 814:         'w' alone = WICKET (W), 'wd'/'wide' = WIDE (Wd),
 815:         'lb'/'2lb' = leg bye, 'b'/'1b' = bye."""
 816:         result = []
 817:         for t in tokens:
 818:             low = t.lower()
 819:             if low in ("wd", "wide"):
 820:                 result.append("Wd")
 821:             elif low in ("nb", "noball"):
 822:                 result.append("Nb")
 823:             elif low == "w":
 824:                 result.append("W")
 825:             elif low == "lb":
 826:                 result.append("1lb")
 827:             elif low.endswith("lb") and low[:-2].isdigit():
 828:                 result.append(low)
 829:             elif low == "b" and len(t) == 1:
 830:                 result.append("1b")
 831:             elif low.endswith("b") and low[:-1].isdigit() and not low.endswith("nb"):
 832:                 result.append(low)
 833:             elif t == ".":
 834:                 result.append(".")
 835:             elif t.isdigit():
 836:                 result.append(t)
 837:             else:
 838:                 result.append(t)
 839:         return result
