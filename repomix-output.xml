<file path="files/eyes/bare_loop.py">
  1: """Bare-bones loop: capture → crop → downscale → Ollama → print.
  2: 
  3: No debug UI, no SSE, no broadcaster, no state modules.
  4: Tests whether the slowness is from the LLM call itself or from everything around it.
  5: """
  6: 
  7: import asyncio
  8: import base64
  9: import json
 10: import time
 11: import sys
 12: 
 13: import cv2
 14: import numpy as np
 15: import requests
 16: 
 17: from eyes.capture.frame_source import FrameSource
 18: from eyes.capture.broadcast_detector import BroadcastDetector
 19: from eyes.capture.downscale import downscale
 20: from eyes.config import DOWNSCALE_WIDTH, VISION_MODEL, OLLAMA_HOST
 21: from eyes.vision.prompts import FAST_PROMPT
 22: 
 23: WINDOW_ID = int(sys.argv[1]) if len(sys.argv) > 1 else 103
 24: 
 25: 
 26: def encode(frame):
 27:     _, buf = cv2.imencode(".jpg", frame, [cv2.IMWRITE_JPEG_QUALITY, 85])
 28:     return base64.b64encode(buf.tobytes()).decode()
 29: 
 30: 
 31: def call_ollama(b64):
 32:     payload = {
 33:         "model": VISION_MODEL,
 34:         "messages": [
 35:             {"role": "system", "content": "Cricket broadcast analyst. Read numbers exactly. JSON only."},
 36:             {"role": "user", "content": FAST_PROMPT, "images": [b64]},
 37:         ],
 38:         "stream": False,
 39:         "options": {"temperature": 0.1, "num_predict": 200, "num_ctx": 2048},
 40:     }
 41:     return requests.post(f"{OLLAMA_HOST}/api/chat", json=payload, timeout=120)
 42: 
 43: 
 44: def main():
 45:     print(f"Bare loop: model={VISION_MODEL}, width={DOWNSCALE_WIDTH}, window={WINDOW_ID}")
 46: 
 47:     # Warmup
 48:     print("Warming up model...")
 49:     t0 = time.monotonic()
 50:     tiny = encode(np.zeros((64, 64, 3), dtype=np.uint8))
 51:     r = requests.post(f"{OLLAMA_HOST}/api/chat", json={
 52:         "model": VISION_MODEL,
 53:         "messages": [{"role": "user", "content": "Hi", "images": [tiny]}],
 54:         "stream": False,
 55:         "options": {"num_predict": 1, "num_ctx": 2048},
 56:     }, timeout=180)
 57:     print(f"Model warm in {time.monotonic()-t0:.1f}s")
 58: 
 59:     fs = FrameSource(window_id=WINDOW_ID, fps=2)
 60:     bd = BroadcastDetector()
 61:     fs.start()
 62:     time.sleep(1)
 63: 
 64:     frame_num = 0
 65:     while True:
 66:         raw = fs.get_latest()
 67:         if raw is None:
 68:             time.sleep(0.5)
 69:             continue
 70: 
 71:         frame_num += 1
 72:         if frame_num % 2 != 0:
 73:             time.sleep(0.05)
 74:             continue
 75: 
 76:         if not bd.detected:
 77:             bd.detect(raw)
 78:             if not bd.detected:
 79:                 time.sleep(0.5)
 80:                 continue
 81:             print(f"[F{frame_num}] Broadcast locked: {bd._region}")
 82: 
 83:         frame = bd.crop(raw)
 84:         frame = downscale(frame, DOWNSCALE_WIDTH)
 85:         h, w = frame.shape[:2]
 86:         b64 = encode(frame)
 87:         kb = len(b64) * 3 // 4 // 1024
 88: 
 89:         print(f"[F{frame_num}] Sending {w}x{h} ({kb}KB)...", end=" ", flush=True)
 90:         t0 = time.monotonic()
 91:         try:
 92:             resp = call_ollama(b64)
 93:             elapsed = time.monotonic() - t0
 94:             data = resp.json()
 95:             ptoks = data.get("prompt_eval_count", "?")
 96:             otoks = data.get("eval_count", "?")
 97:             content = data.get("message", {}).get("content", "")[:200]
 98:             print(f"{elapsed:.1f}s (p={ptoks} o={otoks}) → {content}")
 99:         except requests.Timeout:
100:             elapsed = time.monotonic() - t0
101:             print(f"TIMEOUT {elapsed:.0f}s")
102:         except Exception as e:
103:             print(f"ERROR: {e}")
104: 
105: 
106: if __name__ == "__main__":
107:     main()
