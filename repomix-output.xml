2551: def apply_scorer_decision(scoreboard, decision, frame, jump_guard,
2552:                           batting_team=None, extracted=None,
2553:                           frame_type: str | None = None,
2554:                           score_mgr=None):
2555:     changes = []
2556: 
2557:     # GRAPHIC frames (career/comparison overlays) regularly leak
2558:     # career-stat numbers into the scorer's batter/bowler updates
2559:     # ("Klaasen 44(18) v Noor in T20s" — those are vs-bowler career
2560:     # numbers, not the live match). Hard-strip any
2561:     # batter/bowler/score updates from a GRAPHIC frame; only innings-
2562:     # change signals are allowed through.
2563:     if frame_type == "GRAPHIC":
2564:         for k in ("batter_updates", "bowler_update", "bowlers",
2565:                   "score_update", "extras_update"):
2566:             decision.pop(k, None)
2567: 
2568:     if decision.get("innings_change"):
2569:         old_score = scoreboard._inn.get("score") or 0
2570:         score_up = decision.get("score_update", {})
2571:         new_score = score_up.get("to") if isinstance(score_up, dict) else None
2572:         if new_score is not None and int(new_score) >= int(old_score):
2573:             log.info(f"  [GUARD] Innings change rejected — score increased "
2574:                      f"({old_score} → {new_score})")
2575:             decision["innings_change"] = False
2576:         else:
2577:             log.info(f"  [SCORER] Innings change signalled — "
2578:                      f"deferring to target detection logic")
2579:             changes.append("INNINGS CHANGE (deferred)")
2580:             return changes
2581: 
2582:     if not batting_team:
2583:         log.info("  No batting team set — skipping all updates")
2584:         return changes
2585: 
2586:     batter_ups = decision.get("batter_updates", {})
2587:     batters_accepted = any(
2588:         isinstance(u, dict) and u.get("accepted", True)
2589:         for u in (batter_ups.values() if isinstance(batter_ups, dict) else [])
2590:     )
2591:     bowler_up = decision.get("bowler_update", {})
2592:     if isinstance(bowler_up, dict) and "name" in bowler_up:
2593:         bowler_accepted = bowler_up.get("accepted", True) and not _is_placeholder(bowler_up.get("name", ""))
2594:     else:
2595:         bowler_accepted = any(
2596:             isinstance(d, dict) and d.get("accepted", True)
2597:             for d in (bowler_up.values() if isinstance(bowler_up, dict) else [])
2598:         )
2599:     has_bowlers_array = bool(decision.get("bowlers"))
2600:     has_ground_truth = bool(decision.get("ground_truth_applied"))
2601:     if not batters_accepted and not bowler_accepted \
2602:             and not has_bowlers_array and not has_ground_truth:
2603:         log.info("  No players from our match recognized — skipping score")
2604:         return changes
2605: 
2606:     _ext_has_score = (extracted.get("score") is not None) if extracted else False
2607:     _ext_has_overs = (extracted.get("match_overs") is not None) if extracted else False
2608:     _ext_has_wickets = (extracted.get("wickets") is not None) if extracted else False
2609:     _ext_has_batters = bool(extracted.get("batters")) if extracted else False
2610:     _ext_has_any_data = _ext_has_score or _ext_has_overs or _ext_has_wickets or _ext_has_batters
2611: 
2612:     # Score correction guard: if the proposed score differs from
2613:     # current by more than 7, this frame has stale/corrupted data.
2614:     # Block ALL updates, not just ball events.
2615:     score_up = decision.get("score_update", {})
2616:     _proposed_score = None
2617:     if isinstance(score_up, dict) and score_up.get("accepted") and score_up.get("to") is not None:
2618:         try:
2619:             _ps = score_up["to"]
2620:             _proposed_score = int(str(_ps).split("-")[0]) if "-" in str(_ps) else int(_ps)
2621:         except (ValueError, TypeError):
2622:             pass
2623:     if _proposed_score is not None:
2624:         _cur_score = int(scoreboard._inn.get("score") or 0)
2625:         _score_delta = _proposed_score - _cur_score
2626:         if abs(_score_delta) > 7:
2627:             log.info(f"  [GUARD] Score correction in Scorer output: "
2628:                      f"{_cur_score}→{_proposed_score} (delta={_score_delta}) "
2629:                      f"— blocking ALL updates for this frame")
2630:             changes.append(f"CORRECTION_BLOCKED:{_proposed_score}")
2631:             return changes
2632: 
2633:     if isinstance(score_up, dict) and score_up.get("accepted") and score_up.get("to") is not None:
2634:         if not _ext_has_score and not _ext_has_any_data:
2635:             log.info(f"  [GUARD] Scorer proposed score={score_up['to']} — "
2636:                      f"extractor empty, blocking")
2637:         else:
2638:             if _proposed_score is not None:
2639:                 # Fix 15 (Layer 1.5 score-side admission gate,
2640:                 # 2026-04-26): sibling to Fix 11 EXTRAS-INF on the
2641:                 # orthogonal score-side phantom dimension.  Catches
2642:                 # the F52/F53-class score inflation where score
2643:                 # jumps by +N with no corresponding bat-runs delta
2644:                 # AND no wicket increment to absorb the runs.  In
2645:                 # that case the maximum legitimate single-frame
2646:                 # advance is 6 (one ball with all-extras combined:
2647:                 # wide + leg-bye + boundary + penalty).  Any
2648:                 # proposed advance above that without bat/wicket
2649:                 # support is a stat-overlay or season-aggregate
2650:                 # leak into the score field.  Hard-reject before
2651:                 # the score commits.
2652:                 _cur_score_for_gate = int(
2653:                     scoreboard._inn.get("score") or 0)
2654:                 _gate_advance = (_proposed_score
2655:                                  - _cur_score_for_gate)
2656:                 if _gate_advance > 0:
2657:                     # bat_delta = sum of (proposed - current) across
2658:                     # accepted batter_ups.  Use scorer-decision values
2659:                     # directly (this gate runs BEFORE the
2660:                     # _ext_batter_stats overlay map is built; the
2661:                     # extras-vs-scorer trust hierarchy doesn't matter
2662:                     # here because we only need a lower bound on the
2663:                     # bat-side advance to validate the score-side).
2664:                     _gate_bat_delta = 0
2665:                     for _bgname, _bgupd in batter_ups.items():
2666:                         if not isinstance(_bgupd, dict):
2667:                             continue
2668:                         if not _bgupd.get("accepted", True):
2669:                             continue
2670:                         _bgnew = _bgupd.get("runs")
2671:                         if _bgnew is None:
2672:                             continue
2673:                         _bgresolved = (
2674:                             scoreboard.resolve_name(_bgname)
2675:                             or _bgname)
2676:                         _bgcard = scoreboard.batting_card.get(
2677:                             _bgresolved, {})
2678:                         _bgcur = _bgcard.get("runs") or 0
2679:                         try:
2680:                             _bgdelta = int(_bgnew) - int(_bgcur)
2681:                         except (ValueError, TypeError):
2682:                             continue
2683:                         if _bgdelta > 0:
2684:                             _gate_bat_delta += _bgdelta
2685:                     # wicket-fire signal: a new dismissal this frame
2686:                     # can carry a positive runs delta into the
2687:                     # accumulated score (the dismissed batter's last
2688:                     # ball, if it scored).  Detect via wickets_update
2689:                     # accepted-and-greater-than-current.
2690:                     _gate_wkt_increment = 0
2691:                     _wu_for_gate = decision.get("wickets_update", {})
2692:                     if (isinstance(_wu_for_gate, dict)
2693:                             and _wu_for_gate.get("accepted")
2694:                             and _wu_for_gate.get("to") is not None):
2695:                         try:
2696:                             _gate_wkt_increment = (
2697:                                 int(_wu_for_gate["to"])
2698:                                 - int(scoreboard._inn.get(
2699:                                     "wickets") or 0))
2700:                         except (ValueError, TypeError):
2701:                             _gate_wkt_increment = 0
2702:                     # Maximum legitimate single-frame extras on a
2703:                     # single ball: 6 (wide + leg-bye/no-ball
2704:                     # combinations capped at boundary-extra value).
2705:                     # Allow 1 additional run if wickets fired this
2706:                     # frame to absorb the dismissed batter's last-
2707:                     # ball completion.
2708:                     _gate_max_extras = 6
2709:                     if _gate_wkt_increment > 0:
2710:                         _gate_max_extras += 6  # last-ball headroom
2711:                     _gate_score_explained = (_gate_bat_delta
2712:                                              + _gate_max_extras)
2713:                     if _gate_advance > _gate_score_explained:
2714:                         log.warn(
2715:                             f"  [SCORE-INF-GATE] score "
2716:                             f"{_cur_score_for_gate}→"
2717:                             f"{_proposed_score} "
2718:                             f"(advance=+{_gate_advance}) > "
2719:                             f"explained "
2720:                             f"(bat_delta={_gate_bat_delta} + "
2721:                             f"extras_max={_gate_max_extras} = "
2722:                             f"{_gate_score_explained}) — "
2723:                             f"rejecting score commit.  Score-"
2724:                             f"side phantom (Layer 1.5, "
2725:                             f"F52/F53 class).")
2726:                         changes.append(
2727:                             f"SCORE-INF-GATE:advance="
2728:                             f"{_gate_advance}>"
2729:                             f"{_gate_score_explained}")
2730:                     else:
2731:                         if scoreboard.set("score",
2732:                                           _proposed_score, frame):
2733:                             changes.append(
