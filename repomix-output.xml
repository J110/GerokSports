1364: def clean_player_name(name: str) -> str:
1365:     """Strip common broadcast suffixes: IMP, (C), (WK), * etc."""
1366:     if not name:
1367:         return name
1368:     suffixes = [" IMP", " (IMP)", " IMPACT", " (C)", " (WK)",
1369:                 " (WK-C)", "(C)", "(WK)", "*"]
1370:     upper = name.upper().strip()
1371:     for suffix in suffixes:
1372:         if upper.endswith(suffix):
1373:             name = name[:len(name) - len(suffix)].strip()
1374:             break
1375:     return name
