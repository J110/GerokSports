 966:     # Scalar updates — hard limits only
 967:     # ------------------------------------------------------------------
 968: 
 969:     def set(self, field: str, value, frame: int) -> bool:
 970:         if value is None:
 971:             return False
 972: 
 973:         old = self._inn.get(field)
 974: 
 975:         if field == "score":
 976:             try:
 977:                 v = int(value)
 978:             except (ValueError, TypeError):
 979:                 return False
 980:             # Absolute T20 ceiling — no team has ever passed 287 in
 981:             # men's T20Is.  720 was way too loose for a T20 pipeline
 982:             # and let OCR garbage (e.g. "446" misread of an overlay
 983:             # number) through to the headline.
 984:             if v < 0 or v > 320:
 985:                 log.warn(f"Score rejected: absolute {v} > 320")
 986:                 return False
 987:             # Chase-aware ceiling: in 2nd innings, the score can equal
 988:             # target on the winning ball but never exceed target by more
 989:             # than a small OCR-jitter buffer.  Rejects e.g. 446/2 when
 990:             # the chase target is 181.
 991:             if self.current_innings >= 2:
 992:                 tgt = self._inn.get("target")
 993:                 if tgt is not None and v > int(tgt) + 4:
 994:                     log.warn(f"Score rejected: chase {v} > "
 995:                              f"target {tgt} + 4")
 996:                     return False
 997:             # Per-update jump guard: even after a long ad break,
 998:             # consecutive scoreboard reads should not differ by 100+
 999:             # runs.  Hard-reject before the consensus tracker so
1000:             # repeated bad reads can't form consensus.
1001:             cur_score = self._inn.get("score")
1002:             if cur_score is not None:
1003:                 try:
1004:                     cur_int = int(cur_score)
1005:                     if v < cur_int:
1006:                         log.warn(
1007:                             f"Score regression rejected: {cur_int}→{v} "
1008:                             f"(normal-play score physics; reset authority "
1009:                             f"required)")
1010:                         return False
1011:                     if v - cur_int > 100:
1012:                         log.warn(f"Score rejected: jump "
1013:                                  f"{cur_int} → {v} (+{v - cur_int}) "
1014:                                  f"too large for a single update")
1015:                         return False
1016:                 except (ValueError, TypeError):
1017:                     pass
1018:             confirmed = self._tracker.update("score", v, frame)
1019:             if confirmed != v:
1020:                 return False
1021:             value = v
1022: 
1023:         elif field == "wickets":
1024:             try:
1025:                 v = int(value)
1026:             except (ValueError, TypeError):
1027:                 return False
1028:             if v < 0 or v > 10:
1029:                 return False
1030:             # Fix #1 (2026-04-23): count per-frame Scout observations
1031:             # of wickets=0 — the gate below uses this to distinguish
1032:             # a cold-start attach from a live 0→1 transition.  We
1033:             # increment on the RAW observation (before tracker gate)
1034:             # because we care about how many frames Scout has shown
1035:             # zero, not how many consensus commits fired.  Threshold
1036:             # in the seed logic is >=2 observed zeros.
1037:             if v == 0:
1038:                 self._wickets_confirmed_frames_at_zero += 1
1039:             cur_w = self._inn.get("wickets")
1040:             if cur_w is not None:
1041:                 cur_wi = int(cur_w)
1042:                 if v < cur_wi:
1043:                     if self._all_out_lock and cur_wi >= 10:
1044:                         log.warn(
1045:                             f"Wickets regression rejected under all-out "
1046:                             f"lock: {cur_w}→{v} "
1047:                             f"(source={self._all_out_lock_source})")
1048:                         return False
1049:                     # Broadcast-authoritative regression path. Reject
1050:                     # the lower reading by default (single-frame OCR
1051:                     # noise), but if the SAME lower value persists for
1052:                     # 3 SCOREBOARD frames in a row it's the broadcast
1053:                     # correcting our over-counted wickets — accept it
1054:                     # AND drop any tentative FOW entries we added on
1055:                     # top of the now-invalid wicket.
1056:                     if self._pending_wickets_low == v:
1057:                         self._pending_wickets_low_count += 1
1058:                     else:
1059:                         self._pending_wickets_low = v
1060:                         self._pending_wickets_low_count = 1
1061:                     if self._pending_wickets_low_count < 3:
1062:                         log.warn(
1063:                             f"Wickets regression rejected: "
