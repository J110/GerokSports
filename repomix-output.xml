2377:             else:
2378:                 log.info(
2379:                     f"  [ROTATION] Rejecting bowler read '{name}' — "
2380:                     f"can't bowl two consecutive overs (just bowled "
2381:                     f"prev over; rejection "
2382:                     f"{count}/{self._ROTATION_OVERRIDE_N}). "
2383:                     f"current_bowler stays '{_cur_now}'"
