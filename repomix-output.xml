373: def _normalise_styles(raw: dict, players: list[dict]) -> dict:
374:     """Ensure every player has an entry; clean vocab; drop strays."""
375:     valid_names = {p["name"] for p in players}
376:     out: dict[str, dict] = {}
377:     for name in valid_names:
378:         s = raw.get(name) if isinstance(raw, dict) else None
379:         s = s if isinstance(s, dict) else {}
380:         out[name] = {
381:             "batting_style": _clean_batting(s.get("batting_style")),
382:             "bowling_style": _clean_bowling(s.get("bowling_style")),
383:         }
384:     return out
