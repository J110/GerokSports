3831:     def record_extra(self, extra_type: str, runs: int = 1):
3832:         """Record an extra (wide, no_ball, bye, leg_bye)."""
3833:         key_map = {
3834:             "wide": "wides", "no_ball": "no_balls",
3835:             "bye": "byes", "leg_bye": "leg_byes",
3836:             "penalty": "penalties",
3837:         }
3838:         key = key_map.get(extra_type)
3839:         if key:
3840:             self.extras[key] += runs
3841:             self.extras["total"] += runs
3842:             self.extras["this_over"] = (self.extras.get("this_over", 0)
3843:                                         or 0) + 1
3844:             entry = {
3845:                 "over": self._inn.get("overs"),
3846:                 "type": extra_type,
3847:                 "runs": runs,
3848:                 "this_over_after": list(self.this_over),
3849:             }
3850:             log_list = self.extras.setdefault("log", [])
3851:             log_list.append(entry)
3852:             if len(log_list) > 50:
3853:                 self.extras["log"] = log_list[-50:]
3854:             log.info(f"[EXTRA] {extra_type} +{runs} at "
3855:                      f"{self._inn.get('overs')}o  "
3856:                      f"this_over_extras={self.extras['this_over']}  "
3857:                      f"innings_total={self.extras['total']}  "
3858:                      f"this_over_now={self.this_over}")
3859: 
3860:     def update_this_over(self, broadcast: list):
3861:         """Update this-over from the broadcast indicator — sole source of
3862:         ball-by-ball data. The broadcast shows cumulative results like
3863:         ['.', '4', '1'] after 3 balls. Always trust broadcast over any
3864:         local state."""
3865:         if not broadcast:
3866:             return
3867: 
3868:         # Normalise all entries to strings (extractor may send ints)
3869:         broadcast = [str(x) for x in broadcast]
3870: 
3871:         if broadcast == self.this_over:
3872:             return
3873: 
3874:         if len(broadcast) < len(self.this_over) and len(self.this_over) > 6:
3875:             log.info(f"[THIS-OVER] Broadcast shorter "
3876:                      f"({len(self.this_over)}→{len(broadcast)}) "
3877:                      f"— new over, resetting")
3878:             self.this_over = broadcast
3879:         elif len(broadcast) >= len(self.this_over):
3880:             self.this_over = broadcast
3881: 
3882:         if len(self.this_over) > 12:
3883:             log.info(f"[THIS-OVER] {len(self.this_over)} entries — "
3884:                      f"missed reset, trimming to last 6")
3885:             self.this_over = self.this_over[-6:]
3886: 
3887:     def over_just_changed(self) -> bool:
3888:         """Check if the over number changed since last check."""
3889:         overs_str = self._inn.get("overs") or "0.0"
3890:         try:
3891:             over_num = int(str(overs_str).split(".")[0])
3892:         except (ValueError, TypeError):
3893:             return False
3894:         if self._last_over_num is None:
3895:             self._last_over_num = over_num
3896:             return False
3897:         if over_num != self._last_over_num:
3898:             self._last_over_num = over_num
3899:             return True
3900:         return False
