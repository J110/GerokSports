407: async def _run_pass2(client, raw_data: dict, pass1: dict,
408:                      players: list[str]) -> dict | None:
409:     """Pass-2: websearch-grounded verification. Slow (~30s-5min) and may
410:     time out. Returns the corrected styles dict on success, or None when
411:     the call failed or the response was unparseable (caller falls back to
412:     Pass-1)."""
413:     t1 = time.time()
414:     teams_str = (
415:         f"{(raw_data.get('team_a') or {}).get('name', '?')} vs "
416:         f"{(raw_data.get('team_b') or {}).get('name', '?')}"
417:     )
418:     prompt2 = (VERIFY_PROMPT
419:                .replace("{teams}", teams_str)
420:                .replace("{guesses}", json.dumps(pass1, indent=2)))
421:     try:
422:         raw2 = await _call_groq_with_search(
423:             client, prompt2, VERIFY_MODEL)
424:     except Exception as e:  # noqa: BLE001
425:         log.error(f"Pass-2 (verify) LLM call failed: {e}")
426:         return None
427:     parsed2 = _extract_json_blob(raw2)
428:     if not parsed2:
429:         # First action item from backlog P2 entry: log the actual
430:         # response body so the malformed shape is observable.  The
431:         # four fix candidates (preamble-strip, prompt-tightening,
432:         # wider extractor, parse-retry) can't be ranked without
433:         # knowing what `groq/compound` is actually returning.
434:         # Truncate to keep log size sane on long preambles.
435:         body_preview = (raw2 or "").replace("\n", "\\n")[:2048]
436:         body_len = len(raw2 or "")
437:         log.warn(
438:             f"Pass-2 returned unparseable JSON — keeping pass-1 styles "
439:             f"(raw_len={body_len} preview={body_preview!r})"
440:         )
441:         return None
442:     pass2 = _normalise_styles(parsed2, players)
443:     dt2 = (time.time() - t1) * 1000
444:     log.info(f"Pass-2 (verify) complete in {dt2:.0f}ms "
445:              f"({sum(1 for s in pass2.values() if s['batting_style'] != 'unknown')}"
446:              f"/{len(pass2)} known)")
447:     corrections = sum(
448:         1 for n in pass1
449:         if pass1[n]["batting_style"] != pass2.get(n, {}).get(
450:             "batting_style")
451:         or pass1[n]["bowling_style"] != pass2.get(n, {}).get(
452:             "bowling_style"))
453:     log.info(f"Pass-2 corrected {corrections} players vs pass-1")
454:     return pass2
