1029:                     int(x) for x in self.this_over
1030:                     if isinstance(x, str) and x.isdigit())
1031:                 for _t in self.this_over:
1032:                     if not isinstance(_t, str):
1033:                         continue
1034:                     _low = _t.lower()
1035:                     if _low.startswith("wd") or _low.startswith("nb"):
1036:                         _tracked_runs += 1
1037:                         if "+" in _t:
1038:                             try:
1039:                                 _tracked_runs += int(_t.split("+")[-1])
1040:                             except (ValueError, IndexError):
1041:                                 pass
1042:                 _total_over_runs = score - self._over_start_score
1043:                 _missing = _total_over_runs - _tracked_runs
