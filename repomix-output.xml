3232: # Debug-frame archival (P2 fix, 2026-04-25).
3233: #
3234: # Earlier behaviour deleted everything in `debug_frames/` on pipeline
3235: # startup, which caused us to lose the 23 stratified prod-eval frames
3236: # from the V5 evaluation when we restarted the pipeline mid-day to
3237: # deploy the P0-A / P0-B / Pass-2 fixes.  The frames had only just been
3238: # labeled and lived nowhere else; the eval json's image paths pointed
3239: # straight at the live capture dir.  Going forward we move the
3240: # existing frames into a dated subdir under `debug_frames_archive/`
3241: # so the JSON's path field resolves transparently for any
3242: # post-eval shadow run, and then bound disk usage with a retention cap.
3243: # ---------------------------------------------------------------------
3244: 
3245: DEBUG_FRAMES_DIR = "debug_frames"
3246: DEBUG_FRAMES_ARCHIVE_DIR = "debug_frames_archive"
3247: DEBUG_FRAMES_ARCHIVE_KEEP = 10  # keep at most this many session subdirs
