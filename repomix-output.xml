1641: def build_team_variants(team: dict) -> set[str]:
1642:     """Generate all valid ways a team might appear on broadcast."""
1643:     variants: set[str] = set()
1644:     name = team.get("name", "")
1645:     full = team.get("full_name", name)
1646: 
1647:     variants.add(name.upper())
1648:     variants.add(full.upper())
1649: 
1650:     variants.add(name[:2].upper())
1651:     variants.add(name[:3].upper())
1652: 
1653:     words = full.split()
1654:     if len(words) >= 2:
1655:         variants.add("".join(w[0] for w in words).upper())
1656: 
1657:     for w in words:
1658:         w_up = w.upper()
1659:         variants.add(w_up)
1660:         if len(w_up) >= 4:
1661:             variants.add(w_up[:3])
1662: 
1663:     for key, abbrs in _IPL_BROADCAST_NAMES.items():
1664:         if key.upper() in full.upper() or full.upper() in key.upper():
1665:             variants.update(a.upper() for a in abbrs)
1666: 
1667:     variants.discard("")
1668:     return variants
