129: def _all_players(raw_data: dict) -> list[dict]:
130:     """Flat list of player dicts across both teams, both sections,
131:     annotated with the team/section they came from so we can format
132:     a clean prompt."""
133:     out: list[dict] = []
134:     for key in ("team_a", "team_b"):
135:         team = raw_data.get(key) or {}
136:         team_name = team.get("name", key)
137:         for section in ("playing_xi", "bench"):
138:             for p in team.get(section, []) or []:
139:                 if not p.get("name"):
140:                     continue
141:                 out.append({
142:                     "team": team_name,
143:                     "section": section,
144:                     "name": p["name"],
145:                     "role": p.get("role", "unknown"),
