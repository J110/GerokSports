212: def _make_client():
213:     try:
214:         from groq import AsyncGroq
215:         # Pass-2 calls groq/compound with web-search fan-out.  Production
216:         # data (3/3 sessions on 2026-04-25) showed every call exceeding
217:         # 90 s, and SDK default max_retries=2 turned that into a
218:         # deterministic 271 s budget burn (3 attempts × 90 s) with zero
219:         # successes.  Single-shot 240 s is shorter wall-clock than the
220:         # old 3-attempt budget AND actually fits compound's prod latency.
221:         # max_retries=0 disables SDK auto-retry: Pass-2 runs background-
222:         # async with graceful Pass-1 fallback, so a second SDK attempt
223:         # only triples wall-clock cost without changing failure semantics.
224:         # See backlog "P1: Pass-2 enrichment retry/timeout policy".
225:         return AsyncGroq(api_key=GROQ_API_KEY, timeout=240.0, max_retries=0)
226:     except Exception as e:  # noqa: BLE001
227:         log.error(f"Groq SDK init failed: {e}")
228:         return None
