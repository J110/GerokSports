<file path="files/eyes/bare_nocapture.py">
  1: """Bare loop: capture ONE frame, STOP capture, call Ollama, repeat.
  2: 
  3: Tests whether continuous Quartz capture is what slows Ollama down.
  4: """
  5: 
  6: import base64
  7: import json
  8: import time
  9: import sys
 10: 
 11: import cv2
 12: import numpy as np
 13: import requests
 14: 
 15: from eyes.capture.frame_source import FrameSource
 16: from eyes.capture.broadcast_detector import BroadcastDetector
 17: from eyes.capture.downscale import downscale
 18: from eyes.config import DOWNSCALE_WIDTH, VISION_MODEL, OLLAMA_HOST
 19: from eyes.vision.prompts import FAST_PROMPT
 20: 
 21: WINDOW_ID = int(sys.argv[1]) if len(sys.argv) > 1 else 103
 22: 
 23: 
 24: def encode(frame):
 25:     _, buf = cv2.imencode(".jpg", frame, [cv2.IMWRITE_JPEG_QUALITY, 85])
 26:     return base64.b64encode(buf.tobytes()).decode()
 27: 
 28: 
 29: def call_ollama(b64):
 30:     payload = {
 31:         "model": VISION_MODEL,
 32:         "messages": [
 33:             {"role": "system", "content": "Cricket broadcast analyst. Read numbers exactly. JSON only."},
 34:             {"role": "user", "content": FAST_PROMPT, "images": [b64]},
 35:         ],
 36:         "stream": False,
 37:         "options": {"temperature": 0.1, "num_predict": 200, "num_ctx": 2048},
 38:     }
 39:     return requests.post(f"{OLLAMA_HOST}/api/chat", json=payload, timeout=120)
 40: 
 41: 
 42: def grab_one_frame():
 43:     """Start capture, grab one frame, stop capture immediately."""
 44:     fs = FrameSource(window_id=WINDOW_ID, fps=2)
 45:     fs.start()
 46:     deadline = time.monotonic() + 3
 47:     while time.monotonic() < deadline:
 48:         f = fs.get_latest()
 49:         if f is not None:
 50:             fs.stop()
 51:             return f
 52:         time.sleep(0.1)
 53:     fs.stop()
 54:     return None
 55: 
 56: 
 57: def main():
 58:     print(f"Bare loop (no continuous capture): model={VISION_MODEL}, width={DOWNSCALE_WIDTH}")
 59: 
 60:     # Warmup
 61:     print("Warming up model...")
 62:     t0 = time.monotonic()
 63:     tiny = encode(np.zeros((64, 64, 3), dtype=np.uint8))
 64:     requests.post(f"{OLLAMA_HOST}/api/chat", json={
 65:         "model": VISION_MODEL,
 66:         "messages": [{"role": "user", "content": "Hi", "images": [tiny]}],
 67:         "stream": False,
 68:         "options": {"num_predict": 1, "num_ctx": 2048},
 69:     }, timeout=180)
 70:     print(f"Model warm in {time.monotonic()-t0:.1f}s")
 71: 
 72:     bd = BroadcastDetector()
 73: 
 74:     for i in range(5):
 75:         raw = grab_one_frame()
 76:         if raw is None:
 77:             print(f"[{i+1}] No frame captured")
 78:             continue
 79: 
 80:         if not bd.detected:
 81:             bd.detect(raw)
 82:             if not bd.detected:
 83:                 print(f"[{i+1}] No broadcast detected")
 84:                 continue
 85: 
 86:         frame = bd.crop(raw)
 87:         frame = downscale(frame, DOWNSCALE_WIDTH)
 88:         h, w = frame.shape[:2]
 89:         b64 = encode(frame)
 90:         kb = len(b64) * 3 // 4 // 1024
 91: 
 92:         print(f"[{i+1}] {w}x{h} ({kb}KB)...", end=" ", flush=True)
 93:         t0 = time.monotonic()
 94:         resp = call_ollama(b64)
 95:         elapsed = time.monotonic() - t0
 96:         data = resp.json()
 97:         ptoks = data.get("prompt_eval_count", "?")
 98:         otoks = data.get("eval_count", "?")
 99:         content = data.get("message", {}).get("content", "")[:200]
100:         print(f"{elapsed:.1f}s (p={ptoks} o={otoks}) → {content}")
101: 
102: 
103: if __name__ == "__main__":
104:     main()
</file>

<file path="files/eyes/commentary.py">
  1: """Commentary-quality data derived from scorecard deltas.
  2: 
  3: All classes here compute data Machine 2 needs WITHOUT any extra
  4: vision calls — purely from frame-to-frame state changes.
  5: """
  6: from __future__ import annotations
  7: 
  8: from copy import deepcopy
  9: 
 10: from eyes.cricket_logger import CricketLogger
 11: 
 12: log = CricketLogger("COMMENTARY")
 13: 
 14: 
 15: class BallEventDetector:
 16:     """Detect ball events from confirmed tracker values only.
 17: 
 18:     Emits certain events when overs advance by exactly 1 ball.
 19:     Also detects wides/no-balls via broadcast_extra signal or
 20:     score+1 with overs unchanged.
 21:     """
 22: 
 23:     def __init__(self):
 24:         # When a wicket is detected without an overs tick we
 25:         # already credited the delivery to that wicket. The
 26:         # broadcast's eventual overs tick must then be silently
 27:         # consumed (otherwise we'd emit a phantom DOT for the
 28:         # same delivery). `_balls_owed_to_silence` tracks how
 29:         # many upcoming legal-ball ticks should be ignored.
 30:         self._balls_owed_to_silence: int = 0
 31:         self.prev_score: int | None = None
 32:         self.prev_wickets: int | None = None
 33:         self.prev_overs: str | None = None
 34:         self.prev_bowler_runs: int | None = None
 35:         # Track previous frame's bowler so we can tell when an over
 36:         # rollover invalidates `prev_bowler_runs` for delta math
 37:         # (the new bowler's small total minus the old bowler's large
 38:         # total gives a meaningless negative delta).
 39:         self.prev_bowler: str | None = None
 40:         # Track striker name + balls to infer extras when score
 41:         # advances but neither legal-balls nor batter-balls do.
 42:         self.prev_striker: str | None = None
 43:         self.prev_striker_balls: int | None = None
 44:         # Track striker runs as an independent witness for leg-bye
 45:         # classification (Bug #11). Bowler runs in the broadcast strip
 46:         # often lag the team score by 1-2 frames; if we relied only on
 47:         # bowler_runs_delta == 0, every legal off-the-bat single during
 48:         # that lag window would be mislabelled as a leg bye.
 49:         self.prev_striker_runs: int | None = None
 50:         self.events: list[dict] = []
 51:         self._possible_extra: dict | None = None
 52:         self._broadcast_extra: str | None = None
 53:         self._free_hit_next = False
 54:         self._event_queue: list[dict] = []
 55:         self._prev_broadcast_extra: str | None = None
 56:         self._broadcast_extra_changed_at: int = 0
 57:         self._detect_count: int = 0
 58:         # Recent (over, type, runs, score_at_event) tuples so we can
 59:         # suppress a duplicate emission of the SAME event within a short
 60:         # window.  Entries are aged out after _DEDUP_WINDOW detect calls
 61:         # (≈30s @ 1Hz processing) — long enough to swallow OCR jitter
 62:         # that re-presents the same delta one or two frames later, short
 63:         # enough that a real second wide on the same scoreboard read is
 64:         # not falsely suppressed (which can't happen anyway: a real
 65:         # second wide changes the score, which changes the dedup key).
 66:         self._recent_emissions: list[tuple[int, tuple]] = []
 67:         self._DEDUP_WINDOW = 30
 68:         # Pending-jitter deferral for the EXTRA-IMMEDIATE catch-all path.
 69:         # When score increases by +1 with NO corroborating signal (no
 70:         # broadcast WD/NB, no bowler-runs delta, no striker-balls
 71:         # quiet — i.e. the only evidence is the team-score digit
 72:         # itself), defer one frame to confirm.  Real wides almost
 73:         # always come with at least one supporting signal within the
 74:         # 1-3s broadcast lag; isolated +1 score deltas with zero
 75:         # corroboration are overwhelmingly OCR jitter on the score
 76:         # digit.  Discovered 2026-04-19 KKR-vs-RR: 5 phantom Wd
 77:         # tokens fired this run via this catch-all.
 78:         self._extra_jitter_pending: dict | None = None
 79: 
 80:     def reset(self) -> None:
 81:         """Wipe all state for a fresh innings (Bug #14).
 82: 
 83:         Without this, prev_score / prev_overs / prev_striker_runs from
 84:         innings 1 produce huge spurious deltas at the first frame of
 85:         innings 2 (e.g. score 230 → 0 looks like a -230 score
 86:         correction; overs 20.0 → 0.5 looks like a multi-ball jump).
 87:         """
 88:         self._balls_owed_to_silence = 0
 89:         self.prev_score = None
 90:         self.prev_wickets = None
 91:         self.prev_overs = None
 92:         self.prev_bowler_runs = None
 93:         self.prev_bowler = None
 94:         self.prev_striker = None
 95:         self.prev_striker_balls = None
 96:         self.prev_striker_runs = None
 97:         self.events = []
 98:         self._possible_extra = None
 99:         self._broadcast_extra = None
100:         self._free_hit_next = False
101:         self._event_queue = []
102:         self._prev_broadcast_extra = None
103:         self._broadcast_extra_changed_at = 0
104:         self._detect_count = 0
105:         self._extra_jitter_pending = None
106:         log.info("[BED] Detector reset for new innings")
107: 
108:     def set_broadcast_extra(self, extra_type: str | None):
109:         """Feed broadcast EXTRA: WD/NB signal from info panel."""
110:         if extra_type != self._prev_broadcast_extra:
111:             self._broadcast_extra_changed_at = self._detect_count
112:         self._prev_broadcast_extra = self._broadcast_extra
113:         self._broadcast_extra = extra_type
114: 
115:     def _broadcast_extra_is_fresh(self, within_calls: int = 5) -> bool:
116:         """True if _broadcast_extra changed value recently.
117: 
118:         Avoids treating stale broadcast display (e.g. "EXTRA: WD" left
119:         visible for multiple deliveries within an over) as a fresh signal.
120:         """
121:         return (self._broadcast_extra is not None
122:                 and self._detect_count - self._broadcast_extra_changed_at
123:                 <= within_calls)
124: 
125:     def _dedup_key(self, event: dict, score_at_event) -> tuple:
126:         """Compose the dedup tuple per Bug #6 spec.
127: 
128:         Includes score_at_event so a legitimate second extra of the
129:         same type at the same over (which always changes the score)
130:         produces a distinct key and fires correctly.
131:         """
132:         return (
133:             str(event.get("over") or ""),
134:             event.get("type"),
135:             event.get("extra_type"),
136:             int(event.get("runs") or 0),
137:             int(score_at_event or 0),
138:         )
139: 
140:     def _is_duplicate(self, key: tuple) -> bool:
141:         cutoff = self._detect_count - self._DEDUP_WINDOW
142:         self._recent_emissions = [
143:             (c, k) for c, k in self._recent_emissions if c >= cutoff]
144:         for _, k in self._recent_emissions:
145:             if k == key:
146:                 return True
147:         return False
148: 
149:     def _record_emission(self, key: tuple) -> None:
150:         self._recent_emissions.append((self._detect_count, key))
151: 
152:     @staticmethod
153:     def _to_balls(overs) -> int:
154:         o = float(overs or "0")
155:         return int(o) * 6 + round((o % 1) * 10)
156: 
157:     def detect(self, tracker) -> dict | None:
158:         """Read from ConsistentReadTracker directly."""
159:         self._detect_count += 1
160: 
161:         # Drain queued events before processing new state.
162:         # This delivers the legal delivery that was queued behind an extra.
163:         if self._event_queue:
164:             event = self._event_queue.pop(0)
165:             score_now = tracker.get("score")
166:             dedup_key = self._dedup_key(event, score_now)
167:             if self._is_duplicate(dedup_key):
168:                 log.info(f"[DEDUP] suppressed duplicate (queued) "
169:                          f"{event.get('type')} | "
170:                          f"{event.get('over')} key={dedup_key}")
171:                 return None
172:             self._record_emission(dedup_key)
173:             self.events.append(event)
174:             tag = "✓" if event.get("certain") else "?"
175:             log.info(f"[BALL {tag}] {event['type']} | "
176:                      f"{event.get('over', '?')} "
177:                      f"+{event.get('runs', 0)} runs (queued)")
178:             return event
179: 
180:         score = tracker.get("score")
181:         wickets = tracker.get("wickets")
182:         overs = tracker.get("overs")
183: 
184:         cur_bowler_early = tracker.get("current_bowler")
185: 
186:         if self.prev_overs is None or overs is None:
187:             self._save(score, wickets, overs, bowler=cur_bowler_early)
188:             return None
189: 
190:         new_b = self._to_balls(overs)
191:         old_b = self._to_balls(self.prev_overs)
192:         balls_delta = new_b - old_b
193:         s_delta = (score or 0) - (self.prev_score or 0)
194:         w_delta = (wickets or 0) - (self.prev_wickets or 0)
195: 
196:         # Pending-jitter housekeeping: a deferred extra is only valid
197:         # if THIS frame is the exact "same +1, same score, no other
198:         # change" we expected.  Anything else — over advanced, wicket
199:         # fell, score moved by something other than +1 — overtakes
200:         # the deferral; drop the pending marker so it can't fire on
201:         # a future frame.  (The pure-regression case is handled by
202:         # the steady-state branch below.)
203:         if (self._extra_jitter_pending is not None
204:             and not (s_delta == 1 and balls_delta == 0 and w_delta == 0
205:                      and (self._extra_jitter_pending.get("score_at")
206:                           == score))
207:             and not (s_delta == 0 and balls_delta == 0 and w_delta == 0)):
208:             log.info(
209:                 f"[EXTRA] method=jitter_overtaken s_delta={s_delta} "
210:                 f"balls_delta={balls_delta} w_delta={w_delta} — "
211:                 f"discarding deferred extra "
212:                 f"(pending_score={self._extra_jitter_pending.get('score_at')})")
213:             self._extra_jitter_pending = None
214: 
215:         if balls_delta == 0 and s_delta == 0 and w_delta == 0:
216:             # Score steady-state — if a jittered +1 was deferred last
217:             # frame and the score regressed back here, the deferral
218:             # was correct: the +1 was OCR noise.  Clear the pending
219:             # marker so we don't fire a stale EXTRA on the next +1.
220:             if self._extra_jitter_pending is not None:
221:                 log.info(
222:                     f"[EXTRA] method=jitter_cleared "
223:                     f"pending_score={self._extra_jitter_pending['score_at']} "
224:                     f"now_steady_at={score} — discarding deferred extra")
225:                 self._extra_jitter_pending = None
226:             self._save(score, wickets, overs, bowler=cur_bowler_early)
227:             return None
228: 
229:         # A legal delivery can produce at most 7 runs (6 + 1 no-ball).
230:         # Larger deltas are score corrections, not real deliveries.
231:         if abs(s_delta) > 7 and w_delta == 0:
232:             log.info(f"[GUARD] Score correction detected: delta={s_delta}, "
233:                      f"not a ball event")
234:             self._save(score, wickets, overs, bowler=cur_bowler_early)
235:             return None
236: 
237:         # Compute bowler runs delta early — needed for leg bye detection
238:         bowler_runs = None
239:         cur_bowler = tracker.get("current_bowler")
240:         if cur_bowler:
241:             bowler_runs = tracker.get(f"bowl:{cur_bowler}:runs")
242:             if bowler_runs is not None:
243:                 bowler_runs = int(bowler_runs)
244:         bowler_runs_delta = 0
245:         if bowler_runs is not None and self.prev_bowler_runs is not None:
246:             bowler_runs_delta = bowler_runs - self.prev_bowler_runs
247: 
248:         # Striker faced-balls delta — independent witness for whether
249:         # any legal delivery was bowled to this batter.
250:         cur_striker = tracker.get("striker")
251:         striker_balls = None
252:         if cur_striker:
253:             _sb = tracker.get(f"bat:{cur_striker}:balls")
254:             if _sb is not None:
255:                 try:
256:                     striker_balls = int(_sb)
257:                 except (ValueError, TypeError):
258:                     striker_balls = None
259:         striker_balls_delta = 0
260:         # Only meaningful if the striker hasn't changed since last
261:         # detect call (rotation would naturally show prev=None for
262:         # the new batter, falsely registering 0 delta).
263:         if (cur_striker
264:                 and cur_striker == self.prev_striker
265:                 and striker_balls is not None
266:                 and self.prev_striker_balls is not None):
267:             striker_balls_delta = striker_balls - self.prev_striker_balls
268: 
269:         # Striker runs delta — independent witness for whether the runs
270:         # came off the bat. If this is positive, the runs are NOT a leg
271:         # bye/bye, regardless of where the bowler runs strip currently
272:         # sits.
273:         striker_runs = None
274:         if cur_striker:
275:             _sr = tracker.get(f"bat:{cur_striker}:runs")
276:             if _sr is not None:
277:                 try:
278:                     striker_runs = int(_sr)
279:                 except (ValueError, TypeError):
280:                     striker_runs = None
281:         striker_runs_delta = 0
282:         striker_runs_witnessed = False
283:         if (cur_striker
284:                 and cur_striker == self.prev_striker
285:                 and striker_runs is not None
286:                 and self.prev_striker_runs is not None):
287:             striker_runs_delta = striker_runs - self.prev_striker_runs
288:             striker_runs_witnessed = True
289: 
290:         event: dict | None = None
291: 
292:         # Consume any owed silenced ball-ticks first. These exist
293:         # when we previously emitted a WICKET for a delivery whose
294:         # overs hadn't yet ticked on the broadcast strip; we owe
295:         # one silent tick per such wicket so the broadcast catch-up
296:         # doesn't re-emit a phantom DOT for the same delivery.
297:         if (self._balls_owed_to_silence > 0
298:                 and balls_delta >= 1
299:                 and s_delta == 0
300:                 and w_delta == 0):
301:             self._balls_owed_to_silence -= 1
302:             log.info(
303:                 f"[BED] Silencing 1 owed ball-tick "
304:                 f"(balls_delta={balls_delta}); "
305:                 f"remaining owed={self._balls_owed_to_silence}")
306:             self._save(score, wickets, overs, bowler_runs,
307:                        cur_striker, striker_balls, striker_runs)
308:             return None
309: 
310:         # LATE-BOUNDARY PROMOTION: when the previous frame held a
311:         # `_possible_extra` (score increased without overs ticking),
312:         # and THIS frame the overs tick with no further score change,
313:         # the held score-delta was actually a legal boundary whose
314:         # over-tick lagged by one frame. Promote to FOUR/SIX/N_RUNS
315:         # instead of emitting a phantom DOT for the catch-up frame.
316:         # Without this, score 121→125 (overs lagged) → next frame
317:         # overs tick (s_delta=0) emits DOT and we lose the boundary
318:         # token in this_over.
319:         if (balls_delta == 1
320:                 and s_delta == 0
321:                 and w_delta == 0
322:                 and self._possible_extra is not None
323:                 and self._possible_extra.get("score_at") == score
324:                 and self._possible_extra.get("runs", 0) > 0):
325:             late_runs = int(self._possible_extra.get("runs", 0))
326:             if late_runs == 4:
327:                 event = {"type": "FOUR", "runs": 4, "certain": True}
328:             elif late_runs == 6:
329:                 event = {"type": "SIX", "runs": 6, "certain": True}
330:             else:
331:                 event = {"type": f"{late_runs}_RUNS",
332:                          "runs": late_runs, "certain": True}
333:             event["over"] = overs
334:             event["bowler"] = tracker.get("current_bowler")
335:             event["batter"] = tracker.get("striker")
336:             log.info(
337:                 f"[BED] Late-boundary promotion: held score+"
338:                 f"{late_runs} (overs lagged) is now confirmed by "
339:                 f"overs tick — emitting "
340:                 f"{event['type']} instead of DOT")
341:             self._possible_extra = None
342: 
343:         if event is None and balls_delta == 1:
344:             # Check if a fresh broadcast_extra implies an extra + legal
345:             # delivery were both missed in the same Scout gap.  The wide/NB
346:             # always precedes the legal re-bowl chronologically.
347:             if self._broadcast_extra_is_fresh(within_calls=5):
348:                 _bcast = self._broadcast_extra
349:                 extra_type = "wide" if _bcast == "WD" else "no_ball"
350: 
351:                 # The extra consumed 1 run; remaining runs are from the
352:                 # legal delivery that followed.
353:                 extra_runs = 1
354:                 legal_runs = max(0, s_delta - extra_runs)
355: 
356:                 extra_event = {
357:                     "type": "EXTRA", "extra_type": extra_type,
358:                     "runs": extra_runs, "certain": True,
359:                     "over": self.prev_overs,
360:                     "bowler": cur_bowler,
361:                     "_event_age_hint": "older",
362:                 }
363: 
364:                 # Build the legal delivery event for the queue
365:                 if w_delta > 0:
366:                     legal_event = {"type": "WICKET", "runs": legal_runs,
367:                                   "certain": True}
368:                 elif legal_runs == 0:
369:                     legal_event = {"type": "DOT", "runs": 0, "certain": True}
370:                 elif legal_runs == 4:
371:                     legal_event = {"type": "FOUR", "runs": 4, "certain": True}
372:                 elif legal_runs == 6:
373:                     legal_event = {"type": "SIX", "runs": 6, "certain": True}
374:                 else:
375:                     legal_event = {"type": f"{legal_runs}_RUNS",
376:                                   "runs": legal_runs, "certain": True}
377:                 legal_event["over"] = overs
378:                 legal_event["bowler"] = tracker.get("current_bowler")
379:                 legal_event["batter"] = tracker.get("striker")
380: 
381:                 log.info(f"[DECOMPOSE] balls_delta=1 + fresh {_bcast}: "
382:                          f"emitting EXTRA({extra_runs}) first, "
383:                          f"queueing {legal_event['type']}({legal_runs})")
384: 
385:                 self._event_queue.append(legal_event)
386:                 self._broadcast_extra = None
387:                 if extra_type == "no_ball":
388:                     self._free_hit_next = True
389: 
390:                 event = extra_event
391:             else:
392:                 if w_delta > 0:
393:                     event = {"type": "WICKET", "runs": s_delta,
394:                              "certain": True}
395:                 elif s_delta == 0:
396:                     event = {"type": "DOT", "runs": 0, "certain": True}
397:                 elif s_delta == 4:
398:                     event = {"type": "FOUR", "runs": 4, "certain": True}
399:                 elif s_delta == 6:
400:                     event = {"type": "SIX", "runs": 6, "certain": True}
401:                 else:
402:                     event = {"type": f"{s_delta}_RUNS", "runs": s_delta,
403:                              "certain": True}
404:                 event["over"] = overs
405:                 event["bowler"] = tracker.get("current_bowler")
406:                 event["batter"] = tracker.get("striker")
407: 
408:                 # Leg bye / bye detection (Bug #11 hardened):
409:                 # The OLD heuristic — bowler_runs_delta == 0 alone — fired
410:                 # false positives whenever the bowler stats strip lagged
411:                 # the team score by 1-2 frames (a normal Star Sports broadcast
412:                 # behaviour). A real off-the-bat single would be tagged "1lb"
413:                 # until the bowler strip caught up — by then the over ribbon
414:                 # had already shipped the wrong token to the UI.
415:                 #
416:                 # New rule: ONLY classify as leg-bye/bye when we have BOTH
417:                 # witnesses agreeing the runs went past the bat:
418:                 #   1. Bowler runs unchanged (existing — runs not credited
419:                 #      to bowler)
420:                 #   2. Striker runs unchanged AND we successfully read the
421:                 #      same striker in both frames (new — runs not credited
422:                 #      to batter either)
423:                 # If the striker witness is absent (rotation, missed read),
424:                 # fall back to "regular run" rather than risk the false
425:                 # positive. A missed leg-bye tag is far less harmful than
426:                 # silently downgrading a batter's actual run.
427:                 striker_quiet = (striker_runs_witnessed
428:                                  and striker_runs_delta == 0)
429:                 if (event["type"] not in ("DOT", "WICKET", "FOUR", "SIX")
430:                         and s_delta > 0 and bowler_runs_delta == 0
431:                         and bowler_runs is not None
432:                         and self.prev_bowler_runs is not None
433:                         and striker_quiet):
434:                     event["extras_type"] = "leg_bye_or_bye"
435:                     event["extras_runs"] = s_delta
436:                     log.info(f"[DETECT] Likely leg bye/bye: score +{s_delta}, "
437:                              f"bowler runs unchanged AND striker "
438:                              f"{cur_striker} runs unchanged "
439:                              f"(prev={self.prev_striker_runs}, "
440:                              f"now={striker_runs})")
441:                 elif (event["type"] not in ("DOT", "WICKET", "FOUR", "SIX")
442:                         and s_delta > 0 and bowler_runs_delta == 0
443:                         and bowler_runs is not None
444:                         and self.prev_bowler_runs is not None
445:                         and striker_runs_witnessed
446:                         and striker_runs_delta > 0):
447:                     log.info(f"[DETECT] Bowler runs lag detected: score "
448:                              f"+{s_delta}, bowler runs flat but striker "
449:                              f"{cur_striker} runs +{striker_runs_delta} "
450:                              f"— treating as legal run off the bat, NOT "
451:                              f"leg-bye")
452: 
453:         elif balls_delta > 1:
454:             event = {"type": "MULTI_BALL", "balls_missed": balls_delta,
455:                      "total_runs": s_delta, "certain": False}
456: 
457:         # WICKET-WITHOUT-OVERS-TICK: wicket fell but the broadcast
458:         # team-overs strip hasn't ticked yet (very common — the
459:         # wicket animation/celebration freezes the overs counter for
460:         # 1-3 frames). Without this path we'd later see the overs
461:         # tick with w_delta=0 and emit a DOT for what was actually
462:         # a wicket ball.
463:         #
464:         # Two sub-cases:
465:         #   (a) overs has NOT yet ticked: emit WICKET now AND
466:         #       advance prev_overs internally so the upcoming
467:         #       broadcast overs tick is silently consumed.
468:         #   (b) overs ALREADY ticked in a prior frame and we
469:         #       emitted the previous ball as DOT/RUNS — now wickets
470:         #       caught up. Emit WICKET_LATE which replaces the most
471:         #       recent token in this_over with 'W' (cricket: the
472:         #       "previous" ball was actually a wicket ball).
473:         if (event is None
474:                 and balls_delta == 0
475:                 and w_delta > 0):
476:             # Detect "late" sub-case: was the immediately-preceding
477:             # event a normal delivery (DOT / N_RUNS / WICKET / FOUR
478:             # / SIX, NOT an extra) at the SAME overs string the
479:             # tracker now reports? If yes, the wicket maps to that
480:             # delivery, not a new one.
481:             _is_late = False
482:             if self.events:
483:                 _last = self.events[-1]
484:                 _last_over = str(_last.get("over") or "")
485:                 _last_type = _last.get("type", "")
486:                 if (_last_over == str(overs)
487:                         and _last_type in ("DOT", "FOUR", "SIX",
488:                                             "WICKET")
489:                         and not _last_type.startswith("WICKET_LATE")
490:                         and not _last.get("extra_type")):
491:                     _is_late = True
492:                 elif (_last_over == str(overs)
493:                       and _last_type.endswith("_RUNS")):
494:                     _is_late = True
495:             if _is_late:
496:                 event = {"type": "WICKET_LATE", "runs": s_delta,
497:                          "certain": True}
498:                 event["over"] = overs
499:                 event["bowler"] = tracker.get("current_bowler")
500:                 event["batter"] = tracker.get("striker")
501:                 log.info(
502:                     f"[BED] Late wicket reading (w_delta=+{w_delta} "
503:                     f"after overs already ticked) — emitting "
504:                     f"WICKET_LATE to upgrade last token to 'W'")
505:             else:
506:                 event = {"type": "WICKET", "runs": s_delta,
507:                          "certain": True}
508:                 event["over"] = overs
509:                 event["bowler"] = tracker.get("current_bowler")
510:                 event["batter"] = tracker.get("striker")
511:                 # Owe a silenced legal-ball tick: when the
512:                 # broadcast's overs strip eventually catches up
513:                 # (often 1-3 frames later), we must NOT emit a
514:                 # phantom DOT for the same delivery we just
515:                 # credited to the wicket.
516:                 self._balls_owed_to_silence += 1
517:                 log.info(
518:                     f"[BED] Wicket detected without overs tick "
519:                     f"(w_delta={w_delta}, s_delta={s_delta}) — "
520:                     f"emitting WICKET, owing 1 silenced ball-tick")
521: 
522:         # DRS outcomes: overs go back, wickets decrease
523:         if balls_delta == -1 and s_delta >= 1 and s_delta <= 2:
524:             event = {"type": "DRS_WIDE", "runs": s_delta,
525:                      "certain": True, "over": overs,
526:                      "bowler": tracker.get("current_bowler")}
527:         if balls_delta == 0 and w_delta == -1:
528:             event = {"type": "DRS_NOT_OUT", "runs": 0,
529:                      "certain": True, "over": overs,
530:                      "bowler": tracker.get("current_bowler")}
531: 
532:         # Extras: score changed but overs unchanged (wide / no-ball).
533:         #
534:         # CRICKET INVARIANT (the user's hard rule): if `balls_delta ==
535:         # 0` and `s_delta > 0`, the only cricket-legal explanation is
536:         # an extra. There is NO scenario where the team can score runs
537:         # without the legal-balls counter ticking, except wides and
538:         # no-balls. Therefore we emit an EXTRA event IMMEDIATELY on
539:         # the first frame we see this delta — no consensus, no fall-
540:         # through to a slow path. The 4 supplementary signals
541:         # (`_bcast`, striker_balls_quiet, bowler_runs_delta, etc.)
542:         # only refine the wide-vs-no_ball CLASSIFICATION; they no
543:         # longer gate the event itself.
544:         if bowler_runs is not None and self.prev_bowler_runs is not None:
545:             bowler_runs_delta = bowler_runs - self.prev_bowler_runs
546: 
547:         if balls_delta == 0 and s_delta > 0 and event is None:
548:             _bcast = self._broadcast_extra
549:             striker_witnessed = (
550:                 cur_striker is not None
551:                 and cur_striker == self.prev_striker
552:                 and striker_balls is not None
553:                 and self.prev_striker_balls is not None)
554:             striker_balls_quiet = (
555:                 striker_witnessed and striker_balls_delta == 0)
556: 
557:             # Sanity-cap on bowler_runs_delta: max runs charged on a
558:             # single delivery is 7 (no-ball + 6 off the bat). Anything
559:             # larger means the LLM read a different bowler's row; do
560:             # not trust it as a wide-vs-no_ball signal.
561:             bowler_runs_signal_ok = (
562:                 bowler_runs_delta is not None
563:                 and bowler_runs_delta > 0
564:                 and bowler_runs_delta <= 7
565:                 and self.prev_bowler is not None
566:                 and cur_bowler == self.prev_bowler)
567: 
568:             # Evidence-source-aware classification.  The branches below
569:             # set both `extra_type` AND a `_method` tag for the new
570:             # [EXTRA] log line so we can audit which evidence drove
571:             # each decision.  The trailing catch-all is gated by a
572:             # one-frame deferral when there is NO corroboration —
573:             # see the `_extra_jitter_pending` block below for why.
574:             _method: str | None = None
575:             extra_type = None
576:             _why = ""
577:             if _bcast == "NB":
578:                 extra_type = "no_ball"
579:                 _method = "broadcast_NB"
580:                 _why = "broadcast NB signal"
581:             elif _bcast == "WD":
582:                 extra_type = "wide"
583:                 _method = "broadcast_WD"
584:                 _why = "broadcast WD signal"
585:             elif striker_balls_quiet:
586:                 extra_type = "wide"
587:                 _method = "striker_balls_quiet"
588:                 _why = (f"striker {cur_striker} balls unchanged "
589:                         f"(prev={self.prev_striker_balls}, "
590:                         f"now={striker_balls}); a no-ball would have "
591:                         f"ticked striker balls")
592:             elif bowler_runs_signal_ok:
593:                 extra_type = "wide" if s_delta <= 2 else "no_ball"
594:                 _method = "bowler_runs_delta"
595:                 _why = (f"bowler {cur_bowler} runs "
596:                         f"+{bowler_runs_delta} (stable bowler)")
597:             else:
598:                 # NO corroborating signal at all.  This branch is the
599:                 # phantom-extra factory — one stray frame where the
600:                 # team-score digit jitters from 125 → 126 and back is
601:                 # all it takes to ship a Wd token to the UI that
602:                 # never gets cleaned up.  Defer one frame: if the
603:                 # delta persists, fire; if the score regresses, the
604:                 # steady-state path above will clear the pending
605:                 # marker and we never fire.
606:                 if (s_delta == 1
607:                         and self._extra_jitter_pending is None):
608:                     self._extra_jitter_pending = {
609:                         "score_at": score,
610:                         "overs": overs,
611:                         "bowler": cur_bowler,
612:                     }
613:                     log.info(
614:                         f"[EXTRA] method=deferred reason=no_corroboration "
615:                         f"score+{s_delta} at overs={overs} — "
616:                         f"will confirm next frame "
617:                         f"(no broadcast WD/NB, no bowler-runs delta, "
618:                         f"no striker-balls signal)")
619:                     # Critical: do NOT call self._save() — we need the
620:                     # next frame's delta to recompute against the same
621:                     # prev_score so a steady +1 looks like +1 again
622:                     # (then we fire) and a regression looks like 0
623:                     # (then steady-state path clears pending).
624:                     self._possible_extra = None
625:                     return None
626: 
627:                 # If we ARE pending and the delta is still +1 vs the
628:                 # previous (un-saved) prev_score AND score matches the
629:                 # pending score_at, that's the confirmation we waited
630:                 # for.  Fire as wide (no signal still, but two
631:                 # consecutive frames of agreement is enough).
632:                 if (s_delta == 1
633:                         and self._extra_jitter_pending is not None
634:                         and (self._extra_jitter_pending.get("score_at")
635:                              == score)):
636:                     extra_type = "wide"
637:                     _method = "deferred_confirmed"
638:                     _why = (f"score +{s_delta} sustained 2 frames "
639:                             f"(jitter ruled out)")
640:                     self._extra_jitter_pending = None
641:                 else:
642:                     # Multi-run no-signal extra (s_delta == 2..7) or
643:                     # something else unexpected — keep prior behaviour.
644:                     extra_type = "wide"
645:                     _method = "no_signal_default"
646:                     _why = (f"score +{s_delta} with overs unchanged → "
647:                             f"cricket-invariant extra, defaulting wide "
648:                             f"(no broadcast signal, multi-run)")
649: 
650:             event = {
651:                 "type": "EXTRA", "extra_type": extra_type,
652:                 "runs": s_delta, "certain": True, "over": overs,
653:                 "bowler": cur_bowler}
654:             log.info(
655:                 f"[EXTRA-IMMEDIATE] {extra_type}: score +{s_delta}, "
656:                 f"overs unchanged ({overs}) — {_why}")
657:             log.info(f"[EXTRA] method={_method} extra_type={extra_type} "
658:                      f"runs={s_delta} fired")
659:             self._possible_extra = None
660:             self._broadcast_extra = None
661:             # A real-signal fire supersedes any pending jitter (e.g.
662:             # we deferred on frame N for no signal, then on frame N+1
663:             # the broadcast WD strip caught up — fire on the WD signal
664:             # and clear pending so we don't double-fire next frame).
665:             self._extra_jitter_pending = None
666:             if extra_type == "no_ball":
667:                 self._free_hit_next = True
668:         else:
669:             self._possible_extra = None
670: 
671:         # Tag free hit on the next legal delivery after a no-ball
672:         if event and balls_delta == 1 and self._free_hit_next:
673:             event["free_hit"] = True
674:             self._free_hit_next = False
675: 
676:         self._save(score, wickets, overs, bowler_runs,
677:                    cur_striker, striker_balls, striker_runs,
678:                    bowler=cur_bowler)
679: 
680:         if event:
681:             dedup_key = self._dedup_key(event, score)
682:             if self._is_duplicate(dedup_key):
683:                 log.info(f"[DEDUP] suppressed duplicate "
684:                          f"{event.get('type')} | {event.get('over')} "
685:                          f"+{event.get('runs')} runs (key={dedup_key})")
686:                 return None
687:             self._record_emission(dedup_key)
688:             self.events.append(event)
689:             tag = "✓" if event.get("certain") else "?"
690:             log.info(f"[BALL {tag}] {event['type']} | {overs} "
691:                      f"+{s_delta} runs (Δballs={balls_delta})")
692:         return event
693: 
694:     def _save(self, s, w, o, br=None,
695:               striker=None, striker_balls=None, striker_runs=None,
696:               bowler=None):
697:         self.prev_score = s
698:         self.prev_wickets = w
699:         self.prev_overs = o
700:         if br is not None:
701:             self.prev_bowler_runs = br
702:         # Track bowler identity even when bowler_runs is None — we
703:         # need it to detect over-rollover bowler swaps for the
704:         # extras classifier.
705:         if bowler is not None:
706:             self.prev_bowler = bowler
707:         # Always overwrite striker so rotations are reflected; only
708:         # remember striker_balls/runs when the striker is stable AND we
709:         # actually have a value (avoid wiping a known prev value
710:         # when this frame's tracker read came back None).
711:         if striker is not None:
712:             self.prev_striker = striker
713:         if striker_balls is not None:
714:             self.prev_striker_balls = striker_balls
715:         if striker_runs is not None:
716:             self.prev_striker_runs = striker_runs
