 50: # ------------------------------------------------------------------
 51: # Pixel-hash frame diff — skip unchanged frames, zero API cost
 52: # ------------------------------------------------------------------
 53: 
 54: def frame_changed(current: np.ndarray, previous: np.ndarray | None,
 55:                   threshold: float = 0.05) -> bool:
 56:     """Compare bottom 20% of frame (scoreboard strip). <1ms, local."""
 57:     if previous is None:
 58:         return True
 59:     diff = np.mean(np.abs(current.astype(float) - previous.astype(float)))
 60:     return diff > (255 * threshold)
