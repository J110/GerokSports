 848:         # Bug #12: while still in the live over, cache any non-None
 849:         # bowler we see. We use this cache as the archive fallback if
 850:         # `bowler` is None at the exact frame the over rolls (very
 851:         # common — the broadcast clears the bowling strip in the
 852:         # inter-over gap).
 853:         if (bowler
 854:                 and self._last_over_int is not None
 855:                 and new_int == self._last_over_int):
 856:             self._current_over_bowler = bowler
