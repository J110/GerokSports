329: async def _call_groq_plain(client, prompt: str, model: str) -> str:
330:     """One-shot chat completion on a plain Groq text model.
331:     No tools, low temperature for deterministic JSON."""
332:     resp = await client.chat.completions.create(
333:         model=model,
334:         messages=[{"role": "user", "content": prompt}],
335:         temperature=0.1,
336:         max_tokens=4000,
337:     )
338:     if not resp.choices:
339:         return ""
340:     return resp.choices[0].message.content or ""
341: 
342: 
343: async def _call_groq_with_search(client, prompt: str, model: str) -> str:
344:     """Chat completion against Groq's Compound agentic system, which
345:     transparently runs web searches (Tavily) server-side when it
346:     decides it needs fresher / more authoritative info.  Caller just
347:     sees the final synthesised text."""
348:     # groq/compound doesn't accept temperature overrides on some
349:     # versions — keep the call minimal.
350:     resp = await client.chat.completions.create(
351:         model=model,
352:         messages=[{"role": "user", "content": prompt}],
353:         max_tokens=4000,
354:     )
355:     if not resp.choices:
356:         return ""
357:     return resp.choices[0].message.content or ""
