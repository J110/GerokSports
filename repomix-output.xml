342:     # === INIT AGENTS ===
343:     vision = Vision()
344:     extractor = Extractor()
345:     scorer = MatchStateAgent()
346:     gpu = GPUMonitor()
347:     broadcaster = Broadcaster(SERVER_URL)
348:     debug = DebugUI()
349:     frames = FrameSource(window_id=window_id, fps=CAPTURE_FPS)
350: 
351:     set_sse_callback(debug.emit)
352: 
353:     debug.set_state_getters(
354:         scorecard=lambda: scoreboard.get_state(),
355:         field=lambda: {},
356:         micro=lambda: {},
357:         validation=lambda: {},
358:         full_state=lambda: {
359:             "scoreboard": scoreboard.get_state(),
360:             "gpu": gpu.get_stats(),
361:         },
362:         select_window=lambda wid: setattr(frames, 'window_id', wid),
363:     )
364: 
365:     await debug.start()
366:     frames.start()
367:     log.info(f"Pipeline starting — window: {window_id or 'none (select in debug UI)'}")
368:     log.info("Debug UI: http://localhost:8001")
369: 
370:     frame_count = 0
371:     vision_hint: str | None = None
372:     prev_strip: np.ndarray | None = None
373:     jump_guard = ScoreJumpGuard()
374: 
375:     try:
376:         while True:
377:             raw = frames.get_latest()
378:             if raw is None:
379:                 await asyncio.sleep(0.1)
380:                 continue
381: 
382:             frame_count += 1
383:             set_global_frame(frame_count)
384: 
385:             frame = downscale(raw, FRAME_WIDTH)
386:             h = frame.shape[0]
387:             strip_region = frame[int(h * 0.8):, :]
388: 
389:             # === PIXEL DIFF: skip if nothing changed on screen ===
390:             if not frame_changed(strip_region, prev_strip):
391:                 if frame_count % 20 == 0:
392:                     log.info(f"[F{frame_count}] No pixel change — skipping")
393:                 await asyncio.sleep(5)
394:                 continue
395:             prev_strip = strip_region.copy()
396: 
397:             # === VISION: describe the frame ===
398:             gpu.on_qwen_start("vision", frame_count)
399:             t_vision = time.time()
400:             frame_type, description = await vision.describe(frame, vision_hint)
401:             vision_ms = (time.time() - t_vision) * 1000
402:             gpu.on_qwen_end("vision", frame_count, vision_ms / 1000)
403: 
404:             if not description and frame_type == "UNKNOWN":
405:                 log.warn("Vision returned empty — skipping")
406:                 await asyncio.sleep(5)
407:                 continue
408: 
409:             # --- Route by frame type ---
410:             if frame_type == "ADVERTISEMENT":
411:                 log.info(f"[F{frame_count}] AD — {vision_ms:.0f}ms — skip")
412:                 await asyncio.sleep(5)
413:                 continue
414: 
415:             if frame_type in ("CLOSEUP", "PREMATCH"):
416:                 log.info(f"[F{frame_count}] {frame_type} {vision_ms:.0f}ms — "
417:                          f"{description[:120]}")
418:                 await debug.emit("vision", {"frame_type": frame_type,
419:                                              "description": description[:200],
420:                                              "ms": round(vision_ms)})
421:                 await asyncio.sleep(5)
422:                 continue
423: 
424:             # SCOREBOARD or GRAPHIC or UNKNOWN — full pipeline
425:             log.info(f"[F{frame_count}] {frame_type} {vision_ms:.0f}ms — "
426:                      f"{description[:180]}")
427:             await debug.emit("vision", {"frame_type": frame_type,
428:                                          "description": description,
429:                                          "ms": round(vision_ms)})
430: 
431:             # === EXTRACTOR: map to scorecard fields ===
432:             gpu.on_qwen_start("extractor", frame_count)
433:             t_ext = time.time()
434: 
435: 
436:             extracted = await extractor.extract(
437:                 description,
438:                 frame_type=frame_type,
439:                 team_a_name=team_names[0] if team_names else "",
440:                 team_b_name=team_names[1] if len(team_names) > 1 else "",
441:             )
442:             ext_ms = (time.time() - t_ext) * 1000
443:             gpu.on_qwen_end("extractor", frame_count, ext_ms / 1000)
444: 
445:             if not extracted or extracted.get("frame_type") == "ad":
446:                 log.info(f"[EXTRACT {ext_ms:.0f}ms] No scorecard data")
447:                 await asyncio.sleep(5)
448:                 continue
449: 
450:             if not extracted.get("has_scorecard_data", True):
451:                 log.info(f"[EXTRACT {ext_ms:.0f}ms] Context only: "
452:                          f"{extracted.get('frame_type', '?')}")
453:                 await asyncio.sleep(5)
454:                 continue
455: 
456:             corrections = extracted.get("corrections", [])
457:             if corrections:
458:                 log.info(f"[EXTRACT] Corrections: {corrections}")
459: 
460:             log.info(f"[EXTRACT {ext_ms:.0f}ms] {extracted.get('frame_type', '?')} | "
461:                      f"score={extracted.get('score', '?')}-"
462:                      f"{extracted.get('wickets', '?')} "
463:                      f"({extracted.get('match_overs', '?')})")
464: 
465:             # === MATCH STATE: official scorer validates ===
466:             gpu.on_qwen_start("scorer", frame_count)
467:             t_scorer = time.time()
468: 
469:             fow_str = json.dumps(scoreboard.fall_of_wickets[-5:]) \
470:                 if scoreboard.fall_of_wickets else "None yet"
471:             history_str = json.dumps(scoreboard.get_update_history(10))
472: 
473:             decision = await scorer.validate(
474:                 extracted=extracted,
475:                 team_a=team_names[0] if team_names else "?",
476:                 team_b=team_names[1] if len(team_names) > 1 else "?",
477:                 batting_team=batting_team or "NOT SET",
478:                 bowling_team=bowling_team or "NOT SET",
479:                 innings=scoreboard.current_innings,
480:                 target=str(scoreboard._inn.get("target") or "first innings"),
481:                 batting_squad_roles=batting_squad_roles,
482:                 bowling_squad_roles=bowling_squad_roles,
483:                 batting_card=scoreboard.format_batting_card(),
484:                 bowling_card=scoreboard.format_bowling_card(),
485:                 live_state=scoreboard.get_live_state_str(),
486:                 fow=fow_str,
487:                 history=history_str,
488:                 vision_desc=description,
489:             )
490:             scorer_ms = (time.time() - t_scorer) * 1000
491:             gpu.on_qwen_end("scorer", frame_count, scorer_ms / 1000)
492: 
493:             # === HANDLE TEAM ASSIGNMENT from scorer ===
494:             ta = decision.get("team_assignment", {})
495:             if isinstance(ta, dict) and ta.get("batting_team"):
496:                 new_bat = ta["batting_team"]
497:                 new_inn = ta.get("innings", 1)
498: 
499:                 # Code guard: if extractor says bowling_scorecard for team X,
500:                 # then X is bowling, not batting. Flip if scorer got it wrong.
501:                 g_type = extracted.get("graphic_type")
502:                 g_team = extracted.get("graphic_team", "")
503:                 if g_type == "bowling_scorecard" and g_team:
504:                     for tn in team_names:
505:                         if (g_team.upper() in tn.upper()
506:                                 or tn.upper() in g_team.upper()):
507:                             if (new_bat.upper() in tn.upper()
508:                                     or tn.upper() in new_bat.upper()):
509:                                 other = [t for t in team_names if t != tn][0]
510:                                 log.info(f"Bowling scorecard for {tn} — "
511:                                          f"flipping: {tn} bowls, {other} bats")
512:                                 new_bat = other
513:                             break
514: 
515:                 # ONLY accept names matching our two teams
516:                 resolved_bat = None
517:                 for tn in team_names:
518:                     if (new_bat.upper() in tn.upper()
519:                             or tn.upper() in new_bat.upper()):
520:                         resolved_bat = tn
521:                         break
522: 
523:                 if not resolved_bat:
524:                     log.info(f"Team assignment IGNORED: '{new_bat}' "
525:                              f"not in {team_names}")
526:                 elif resolved_bat != batting_team:
527:                     resolved_bowl = [t for t in team_names
528:                                      if t != resolved_bat][0]
529:                     assign_teams(resolved_bat, resolved_bowl,
530:                                  new_inn or 1)
531:                     target_val = ta.get("target")
532:                     if target_val:
533:                         scoreboard.set("target", target_val, frame_count)
534: 
535:             vision_hint = decision.get("vision_hint")
536:             if vision_hint:
537:                 log.info(f"[SCORER] Hint: {vision_hint}")
538: 
539:             if decision:
540:                 changes = apply_scorer_decision(scoreboard, decision,
541:                                                 frame_count, jump_guard,
542:                                                 batting_team=batting_team)
543:                 if changes:
544:                     log.info(f"[SCORER {scorer_ms:.0f}ms] {changes}")
545:                     await debug.emit("update", {"changes": changes})
546:                 else:
547:                     log.info(f"[SCORER {scorer_ms:.0f}ms] No changes")
548:             else:
549:                 log.info(f"[SCORER {scorer_ms:.0f}ms] Empty decision")
550: 
551:             # === PERIODIC ===
552:             gpu.on_frame_end(frame_count)
553: 
554:             if frame_count % 10 == 0:
555:                 log.info(f"Score: {scoreboard.get_summary()} | "
556:                          f"Bat: {scoreboard.get_current_batters()} | "
557:                          f"Bowl: {scoreboard.get_current_bowler()}")
558: 
559:             if frame_count % 30 == 0:
560:                 gpu.print_stats()
561: 
562:             if frame_count % STATE_BROADCAST_INTERVAL == 0:
563:                 await broadcaster.send_state(scoreboard.get_state())
564: 
565:             if frame_count % PREVIEW_INTERVAL == 0:
566:                 await debug.update_preview(frame)
567: 
568:             await debug.emit("status", {
569:                 "frame": frame_count,
570:                 "vision_ms": round(vision_ms),
571:                 "extract_ms": round(ext_ms),
572:                 "scorer_ms": round(scorer_ms),
573:                 "gpu": gpu.get_stats(),
574:             })
575: 
576:             await asyncio.sleep(5)
577: 
578:     except asyncio.CancelledError:
579:         log.info("Shutting down...")
580:     except Exception as e:
581:         log.error(f"Main loop exception: {e}")
582:         import traceback
583:         traceback.print_exc()
584:     finally:
585:         frames.stop()
586:         await vision.close()
587:         await extractor.close()
588:         await scorer.close()
589:         await broadcaster.close()
590:         await debug.stop()
591:         log.info("Eyes stopped.")
592: 
593: 
594: def main():
595:     parser = argparse.ArgumentParser(description="Machine 1 — The Eyes")
596:     parser.add_argument("--window-id", type=int, default=None,
597:                         help="macOS window ID to capture")
598:     args = parser.parse_args()
599: 
600:     loop = asyncio.new_event_loop()
601:     asyncio.set_event_loop(loop)
602: 
603:     task = loop.create_task(main_loop(args.window_id))
604: 
605:     def shutdown(sig, _frame):
606:         log.info(f"Received signal {sig}, shutting down...")
607:         task.cancel()
608: 
609:     signal.signal(signal.SIGINT, shutdown)
610:     signal.signal(signal.SIGTERM, shutdown)
611: 
612:     try:
613:         loop.run_until_complete(task)
614:     except asyncio.CancelledError:
615:         pass
616:     finally:
617:         loop.close()
618: 
619: 
620: if __name__ == "__main__":
621:     main()
</file>

<file path="files/eyes/match_state.py">
  1: """Match State — Official Scorer. All intelligence lives here.
  2: 
  3: Reconciles → Corrects → Defers → Rejects (in that order).
  4: Maintains complete match record. Generates vision hints.
  5: 
  6: Uses Groq (Llama 4 Scout 17B) for speed.
  7: Falls back to Llama 3.1 8B on rate limits.
  8: """
  9: 
 10: import json
 11: import time
 12: 
 13: from groq import AsyncGroq
 14: 
 15: from eyes.config import GROQ_API_KEY, GROQ_PRIMARY_MODEL, GROQ_FALLBACK_MODEL
 16: from eyes.cricket_logger import CricketLogger
 17: 
 18: log = CricketLogger("SCORER")
 19: 
 20: PRIMARY_MODEL = GROQ_PRIMARY_MODEL
 21: FALLBACK_MODEL = GROQ_FALLBACK_MODEL
 22: 
 23: SCORER_PROMPT = """\
 24: You are the official scorer for this cricket match.
 25: 
 26: TEAMS IN THIS MATCH: {team_a} and {team_b}
 27: Current config: batting={batting_team}, bowling={bowling_team}, \
 28: innings={innings}, target={target}.
 29: 
 30: BATTING SQUAD ({batting_team}) — listed in batting order:
 31: {batting_squad_roles}
 32: 
 33: BOWLING SQUAD ({bowling_team}) — with roles:
 34: {bowling_squad_roles}
 35: 
 36: BATTING CARD:
 37: {batting_card}
 38: 
 39: BOWLING CARD:
 40: {bowling_card}
 41: 
 42: LIVE STATE:
 43: {live_state}
 44: 
 45: FALL OF WICKETS: {fow}
 46: 
 47: LAST 10 DECISIONS: {history}
 48: 
 49: NEW DATA FROM EXTRACTOR:
 50: {extracted}
 51: 
 52: VISION CONTEXT: "{vision_first_200}"
 53: 
 54: TEAM DETECTION (MOST IMPORTANT — do this FIRST):
 55:   To identify the batting team, look for the pattern:
 56:   TEAM_NAME SCORE-WICKETS (OVERS)
 57:   e.g. "England 38-1 (5.1)"
 58:   The team name MUST match one of our two teams: {team_a} or {team_b}.
 59:   If you see a team name that is NOT one of our two teams \
 60: (e.g. IND, AUS when our match is {team_a} vs {team_b}) → IGNORE IT.
 61: 
 62: TEAM ASSIGNMENT — NOT YOUR JOB:
 63:   Teams are assigned by code (toss detection, player-name matching).
 64:   Do NOT set batting_team or bowling_team in team_assignment.
 65:   Leave them null always.
 66: 
 67: INNINGS DETECTION (check every frame):
 68:   If the extractor provides target != null (e.g. target: 177):
 69:     - This IS innings 2. No exceptions.
 70:     - Set innings = 2 in team_assignment.
 71:     - Set target = the extracted value in team_assignment.
 72:     - Target NEVER changes once set (lock it).
 73:   If no target but runs_needed != null:
 74:     - This is innings 2.
 75:     - Set innings = 2 in team_assignment.
 76:     - Calculate: target = score + runs_needed.
 77:     - Set target in team_assignment. Lock it.
 78:   If no target and no runs_needed but required_rate != null:
 79:     - This is also innings 2.
 80:     - Set innings = 2 in team_assignment.
 81: 
 82:   INNINGS CHANGE requires ALL of these simultaneously:
 83:     - Score resets to BELOW 10 (a near-zero restart, not a decrease)
 84:     - Batter names are from the OTHER team's squad
 85:   A score going 142 → 148 is a boundary, NOT an innings change.
 86:   A score going 142 → 5 IS an innings change.
 87:   NEVER propose innings_change if the score INCREASED or stayed same.
 88: 
 89: MATCH OVERS FROM BALLS REMAINING (always calculate when available):
 90:   When runs_needed and balls_remaining arrive from extractor:
 91:     For T20: match_balls_bowled = 120 - balls_remaining
 92:     match_overs = (match_balls_bowled // 6) . (match_balls_bowled % 6)
 93:     Example: 51 balls remaining → 120-51=69 → 69//6=11 r 3 → 11.3 overs
 94:   This OVERRIDES any extracted match_overs. It is more reliable. \
 95:   Use it in overs_update with accepted=true.
 96: 
 97: NAME RESOLUTION (scorer's exclusive job):
 98:   The extractor sends raw names exactly as vision described \
 99: (e.g. "S CURRAN", "LIVINGSTONE", "HOSEIN"). \
100: You must resolve them against the squads:
101:   "S CURRAN" → matches Sam Curran in {batting_team} squad → batter.
102:   "LIVINGSTONE" → matches Liam Livingstone in {batting_team} → batter.
103:   "HOSEIN" → matches Akeal Hosein in {bowling_team} squad → bowler.
104:   If a name matches a player in the batting squad → it's a batter.
105:   If a name matches a player in the bowling squad → it's a bowler.
106:   If a name matches NO squad member → reject it (noise/venue label).
107: 
108: TEAM DETECTION:
109:   batting_team and bowling_team are assigned by code. \
110: If batting_team shows "NOT SET", just resolve names against \
111: both squads and let code handle the assignment.
112: 
113: PROCESS EACH FIELD — in this order of preference:
114: 
115: 1. RECONCILE (accept data that fits):
116:    Score increased? Check if consistent with runs/boundary.
117:    Overs advanced by one ball? Accept.
118:    Batter runs increased proportionally? Accept.
119: 
120: 2. CORRECT (fix using your records):
121:    Batter stats normally increase during an innings. \
122: If the extractor reports LOWER stats than your records, \
123: the previous higher value may have been contaminated by \
124: a career/info panel stat. Accept the lower value if it is \
125: plausible (runs < team score, balls < innings balls). \
126: The code has sustained-decrease detection that will correct \
127: contaminated values after 3 consistent frames — pass through \
128: whatever the extractor reports from the strip.
129:    Overs could be match or bowler? Check your records.
130:    Name doesn't match squad? Check resolved_name from extractor.
131: 
132: 3. DEFER (need more evidence):
133:    New name appeared but wickets unchanged? Hold as provisional.
134:    Large score jump without ball events? Wait one frame.
135: 
136: 4. REJECT (fundamentally impossible):
137:    TEAM score decreased in same innings. Wickets decreased. Overs > 20.
138:    Only reject what CANNOT be explained by any cricket logic.
139:    NOTE: BATTER stats CAN appear to decrease if a previous frame \
140: was contaminated by career/info panel data. Pass through the \
141: extractor's batter stats as-is — the code handles correction.
142: 
143: BATTING ORDER CHECK:
144:   The batting squad is listed in batting order. Positions 1-3 are \
145: openers/top order. Positions 8-11 are bowlers who bat last.
146:   If the innings just started (0 wickets, overs < 1): batters MUST \
147: be from positions 1-3. A position 9 batter (bowler) cannot open.
148:   After 5+ wickets: lower-order batters (7-11) are expected.
149:   Reject batters who are clearly out of order for the match situation.
150: 
151: PLAYER ROLE CHECK:
152:   Cross-check the squad roles for every name:
153:   - A player with role "bowler" should NOT appear as batter unless \
154: 7+ wickets have fallen (tail-enders batting).
155:   - A player with role "batter" or "wk_batter" should NOT appear \
156: as the bowler — they don't bowl.
157:   - Wicket-keepers (WK) do not bowl.
158:   - If a bowler appears as batter at position 1, REJECT.
159:   Reject any assignment that contradicts the player's role.
160: 
161: BATTER ACTIVATION (critical):
162:   NEVER activate a batter based on your own inference.
163:   Only accept batters that the extractor explicitly reports with a \
164: name from the vision description. If you think a batter SHOULD be \
165: there but the extractor didn't report them, mention them in the \
166: vision_hint instead. Let vision confirm on the next frame.
167: 
168: DISMISSALS:
169:   When wickets increases: identify who got out from extractor data.
170:   Mark them out. Record FOW. Add new batter.
171:   NEVER dismiss a batter who is already marked "out" in the \
172: batting card above. Check the card FIRST — if status is "out", \
173: do NOT include them in the dismissal field again.
174: 
175: BOWLER CHANGES:
176:   Only at over boundaries. Mid-over name change → reject name.
177: 
178: GROUND TRUTH (scorecard graphics):
179:   Verify team assignment first. Then override entire card.
180: 
181: OBSERVED vs ESTIMATED:
182:   Only record what was directly read from broadcast.
183:   Never calculate overs from run rate. Keep last observed value.
184: 
185: VISION HINT (what to look for — NAMES ONLY, NO STATS):
186:   List current batter surnames and bowler surname. \
187:   NEVER include runs, balls, overs, or any numbers. \
188:   Example: "Current batters: SURYAKUMAR and ROHIT. \
189:   Bowler: VIPRAJ. Read their stats from the scoreboard. \
190:   ONLY report numbers you can see on screen."
191:   Vision must read stats from the frame, not from this hint.
192: 
193: RETURN JSON:
194: {{
195:   "team_assignment": {{
196:     "batting_team": null,
197:     "bowling_team": null,
198:     "innings": null,
199:     "target": null
200:   }},
201:   "score_update": {{"from": null, "to": null, "accepted": false}},
202:   "overs_update": {{"from": null, "to": null, "accepted": false}},
203:   "wickets_update": {{"from": null, "to": null, "accepted": false}},
204:   "batter_updates": {{}},
205:   "bowler_update": {{}},
206:   "dismissal": null,
207:   "ball_event": null,
208:   "ground_truth_applied": null,
209:   "rejected": {{}},
210:   "deferred": {{}},
211:   "innings_change": false,
212:   "vision_hint": "specific instruction for next frame"
213: }}
214: 
215: team_assignment: DO NOT set batting_team or bowling_team — \
216: always null. Only set innings (1 or 2) and target if visible. \
217: If no innings/target change, set all to null.
218: 
219: JSON only. No explanation.\
220: """
221: 
222: 
223: class MatchStateAgent:
224:     """Official Scorer. Reconciles, corrects, defers, rejects.
225: 
226:     Primary: Groq Llama 4 Scout 17B (~0.7s)
227:     Fallback: Groq Llama 3.1 8B (~0.3s)
228:     """
229: 
230:     def __init__(self):
231:         self._client = AsyncGroq(api_key=GROQ_API_KEY, timeout=15.0)
232:         self._fallback_count = 0
233: 
234:     async def validate(self, extracted: dict,
235:                        team_a: str, team_b: str,
236:                        batting_team: str, bowling_team: str,
237:                        innings: int, target: str,
238:                        batting_squad_roles: str, bowling_squad_roles: str,
239:                        batting_card: str, bowling_card: str,
240:                        live_state: str, fow: str,
241:                        history: str, vision_desc: str) -> dict:
242:         if not extracted or extracted.get("frame_type") == "ad":
243:             return {}
244: 
245:         if not extracted.get("has_scorecard_data", True):
246:             return {"vision_hint": None}
247: 
248:         prompt = SCORER_PROMPT.format(
249:             team_a=team_a or "?",
250:             team_b=team_b or "?",
251:             batting_team=batting_team or "NOT SET",
252:             bowling_team=bowling_team or "NOT SET",
253:             innings=innings,
254:             target=target or "first innings",
255:             batting_squad_roles=batting_squad_roles or "(not assigned yet)",
256:             bowling_squad_roles=bowling_squad_roles or "(not assigned yet)",
257:             batting_card=batting_card,
258:             bowling_card=bowling_card,
259:             live_state=live_state,
260:             fow=fow or "None yet",
261:             history=history or "None yet",
262:             extracted=json.dumps(extracted, indent=2),
263:             vision_first_200=vision_desc[:200] if vision_desc else "",
264:         )
265: 
266:         t0 = time.time()
267:         try:
268:             return await self._call_model(PRIMARY_MODEL, prompt, t0)
269:         except Exception as e:
270:             err = str(e).lower()
271:             if "rate_limit" in err or "429" in err:
272:                 self._fallback_count += 1
273:                 log.info(f"Scout rate limited, falling back to 8B "
274:                          f"(#{self._fallback_count})")
275:                 try:
276:                     return await self._call_model(
277:                         FALLBACK_MODEL, prompt, t0)
278:                 except Exception as e2:
279:                     log.error(f"Scorer fallback also failed: {e2}")
280:                     return {}
281:             log.error(f"Scorer call failed: {e}")
282:             return {}
283: 
284:     async def _call_model(self, model: str, prompt: str,
285:                           t0: float) -> dict:
286:         resp = await self._client.chat.completions.create(
287:             model=model,
288:             temperature=0,
289:             max_tokens=600,
290:             messages=[{"role": "user", "content": prompt}],
291:         )
292:         elapsed = time.time() - t0
293:         raw = resp.choices[0].message.content
294:         log.info(f"Scored in {elapsed:.1f}s ({model.split('/')[-1]})")
295:         return self._parse_json(raw)
296: 
297:     @staticmethod
298:     def _parse_json(raw: str) -> dict:
299:         text = raw.strip()
300:         if text.startswith("```"):
301:             lines = text.split("\n")
302:             text = "\n".join(lines[1:])
303:             if "```" in text:
304:                 text = text[:text.index("```")]
305:             text = text.strip()
306:         try:
307:             return json.loads(text)
308:         except json.JSONDecodeError:
309:             start = text.find("{")
310:             end = text.rfind("}") + 1
311:             if start >= 0 and end > start:
312:                 try:
313:                     return json.loads(text[start:end])
314:                 except json.JSONDecodeError:
315:                     pass
316:             log.error(f"JSON parse failed: {text[:200]}")
317:             return {}
318: 
319:     async def close(self):
320:         await self._client.close()
