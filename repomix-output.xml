2217:     @staticmethod
2218:     def _overs_to_balls(ov) -> int:
2219:         try:
2220:             s = str(ov)
2221:             if "." in s:
2222:                 w, b = s.split(".")
2223:                 return int(w) * 6 + int(b)
2224:             return int(s) * 6
2225:         except (ValueError, TypeError):
2226:             return 0
