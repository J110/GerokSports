1058:             # If we're being asked to write a slot that already
1059:             # exists, log it loudly and keep the original entry.
1060:             _archive_payload = {
1061:                 "balls": self.this_over.copy(),
1062:                 "bowler": bowler,
1063:                 "runs": sum(int(x) for x in self.this_over
