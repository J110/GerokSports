 67: class ScoreJumpGuard:
 68:     """Hold score jumps >7 for 2-frame confirmation. Code, not prompt."""
 69: 
 70:     def __init__(self):
 71:         self._pending_score: int | None = None
 72:         self._pending_count = 0
 73: 
 74:     def check(self, old_score: int | None, new_score: int) -> bool:
 75:         """Return True if the score update should be applied."""
 76:         if old_score is None or old_score == 0:
 77:             self._reset()
 78:             return True
 79: 
 80:         jump = new_score - old_score
 81:         if jump <= 7:
 82:             self._reset()
 83:             return True
 84: 
 85:         if jump < 0:
 86:             self._reset()
 87:             return False
 88: 
 89:         # Jump > 7 — need 2-frame confirmation
 90:         if self._pending_score == new_score:
 91:             self._pending_count += 1
 92:             if self._pending_count >= 2:
 93:                 log.info(f"Score jump {old_score}→{new_score} CONFIRMED "
 94:                          f"after {self._pending_count} frames")
 95:                 self._reset()
 96:                 return True
 97:             log.info(f"Score jump {old_score}→{new_score} — "
 98:                      f"waiting ({self._pending_count}/2)")
 99:             return False
100: 
101:         log.info(f"Score jump {old_score}→{new_score} (+{jump}) — "
102:                  f"HOLDING for confirmation")
103:         self._pending_score = new_score
104:         self._pending_count = 1
105:         return False
106: 
107:     def _reset(self):
108:         self._pending_score = None
109:         self._pending_count = 0
110: 
