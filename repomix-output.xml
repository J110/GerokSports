1178: _THIS_OVER_RE = re.compile(
1179:     r'(?:this[_ ]?over|current[_ ]?over|ball[_ ]?by[_ ]?ball)\s*[:\-]?\s*'
1180:     r'([0-9WwDdNnBb.\s/]+(?:\s+[0-9WwDdNnBb.]+)*)',
1181:     re.IGNORECASE
1182: )
1183: _THIS_OVER_TOKEN_RE = re.compile(
