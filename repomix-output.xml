<file path="files/wire.py">
  1: """Wire — single-line factual commentary for each delivery.
  2: 
  3: A format string, not an LLM call.  Every word comes from data.
  4: Zero latency, zero hallucination.
  5: 
  6: Format:
  7:     {over}.{ball}: {bowler} to {striker} — {outcome}{, enrichment}{(speed)}. {score}/{wickets}
  8: """
  9: from __future__ import annotations
 10: 
 11: from typing import TYPE_CHECKING
 12: 
 13: if TYPE_CHECKING:
 14:     from score_manager import ScoreManager
 15: 
 16: 
 17: def _format_overs(overs: object) -> str:
 18:     """Return cricket overs as X.Y without treating it as base-10 math."""
 19:     if overs is None or overs == "":
 20:         return "0.0"
 21:     s = str(overs).strip()
 22:     if "." in s:
 23:         whole_s, ball_s = s.split(".", 1)
 24:         try:
 25:             whole = int(whole_s or 0)
 26:             ball = int((ball_s or "0")[:1])
 27:         except (TypeError, ValueError):
 28:             return "0.0"
 29:         return f"{whole}.{ball}"
 30:     try:
 31:         return f"{int(float(s))}.0"
 32:     except (TypeError, ValueError):
 33:         return "0.0"
 34: 
 35: 
 36: def format_wire(event: dict, snap: dict, state: "ScoreManager") -> str:
 37:     """Build a single Wire commentary line.
 38: 
 39:     Args:
 40:         event: Ball event dict from ScoreManager._infer_event().
 41:                Must have at least ``type``, ``runs``, ``striker``.
 42:         snap:  The scorecard portion of the ScoreManager payload
 43:                (``payload["scorecard"]``).  Keys: ``score``, ``wickets``,
 44:                ``overs``, ``bowler`` (dict with ``name``).
 45:         state: The ScoreManager instance, used for ``last_speed``.
 46: 
 47:     Returns:
 48:         A single-line string.
 49:     """
 50:     ob = _format_overs(snap.get("overs"))
 51: 
 52:     bowler_info = snap.get("bowler") or {}
 53:     bowler = bowler_info.get("name") or "bowler"
 54:     striker = event.get("striker") or "batter"
 55: 
 56:     # --- Outcome ---
 57:     etype = event.get("type", "")
 58:     runs = event.get("runs", 0)
 59: 
 60:     if etype == "DOT":
 61:         outcome = "no run"
 62:     elif etype == "RUNS":
 63:         outcome = f"{runs} run{'s' if runs != 1 else ''}"
 64:     elif etype == "FOUR":
 65:         outcome = "FOUR"
 66:     elif etype == "SIX":
 67:         outcome = "SIX"
 68:     elif etype == "WICKET":
 69:         dismissed = event.get("dismissed")
 70:         if dismissed:
 71:             outcome = f"{dismissed} is OUT"
 72:         else:
 73:             outcome = "OUT"
 74:         wt = event.get("wicket_type")
 75:         if wt and wt != "unknown":
 76:             outcome += f" ({wt.replace('_', ' ')})"
 77:         if runs and runs > 0:
 78:             outcome += f", {runs} run{'s' if runs != 1 else ''}"
 79:     elif etype == "WIDE":
 80:         outcome = "wide"
 81:     elif etype == "NO_BALL":
 82:         batter_runs = event.get("batter_runs")
 83:         if batter_runs and batter_runs > 0:
 84:             outcome = (f"no ball, {batter_runs} "
 85:                        f"run{'s' if batter_runs != 1 else ''}")
 86:         else:
 87:             outcome = "no ball"
 88:     elif etype == "LEG_BYE":
 89:         outcome = f"leg bye, {runs} run{'s' if runs != 1 else ''}"
 90:     elif etype == "MULTI_BALL":
 91:         overs_skipped = event.get("overs_skipped", 0)
 92:         balls_count = round(overs_skipped * 10)
 93:         outcome = f"{runs} runs off {balls_count} balls"
 94:     elif etype == "EXTRA":
 95:         outcome = f"{runs} extra{'s' if runs != 1 else ''}"
 96:     else:
 97:         outcome = f"{runs} run{'s' if runs != 1 else ''}"
 98: 
 99:     line = f"{ob}: {bowler} to {striker} — {outcome}"
100: 
101:     # --- Enrichment (from delivery analysis) ---
102:     delivery = event.get("delivery")
103:     if delivery:
104:         parts: list[str] = []
105:         length = delivery.get("length")
106:         if length and length != "unknown":
107:             parts.append(length.replace("_", " "))
108:         direction = delivery.get("direction")
109:         if direction and direction != "unknown":
110:             parts.append(f"through the {direction.replace('_', ' ')}")
111:         elevation = delivery.get("elevation")
112:         if elevation == "in_the_air":
113:             parts.append("in the air")
114:         if parts:
115:             line += f", {', '.join(parts)}"
116: 
117:     # --- Speed ---
118:     speed = snap.get("speed_kph") or (state.last_speed if state else None)
119:     if speed:
120:         line += f" ({speed} kph)"
121: 
122:     # --- Score after ---
123:     score = snap.get("score")
124:     wickets = snap.get("wickets")
125:     if score is not None and wickets is not None:
126:         line += f". {score}/{wickets}"
127: 
128:     # --- Free hit marker ---
129:     if event.get("is_free_hit"):
130:         line = "FREE HIT — " + line
131: 
132:     return line
