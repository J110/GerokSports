360: def _fallback_styles(players: list[dict]) -> dict:
361:     """All-unknown fallback when the LLM is unavailable."""
362:     out: dict[str, dict] = {}
363:     for p in players:
364:         out[p["name"]] = {
365:             "batting_style": "unknown",
366:             "bowling_style": ("None"
367:                               if p.get("role") in ("batter", "wk_batter")
368:                               else "unknown"),
369:         }
