1120:         if (not self._pending_clear
1121:                 and float(overs) == float(new_int)
1122:                 and self.this_over):
1123:             legal = [x for x in self.this_over
1124:                      if str(x).lower() not in ("wd", "nb", "w")
1125:                      and not str(x).lower().startswith("wd")
1126:                      and not str(x).lower().startswith("nb")]
1127:             if len(legal) >= 6:
1128:                 log.info(f"Stale this-over at {overs} with "
