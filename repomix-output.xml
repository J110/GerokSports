 656: def compute_interval_distributions(
 657:     snap: Snapshot,
 658: ) -> dict[str, dict[str, float | int | None]]:
 659:     """Inter-read interval distributions in frames.
 660: 
 661:     Two distinct populations:
 662:     - within_bowler: gaps between consecutive BOARD writes for the
 663:       *same* bowler (proxy for inter-ball strip-read intervals
 664:       during a single spell).
 665:     - across_bowler: gaps between the last BOARD write of bowler A
 666:       and the first BOARD write of the next-different bowler B
 667:       (proxy for inter-over handoff gaps — the genuine stale-
 668:       graphic window the BOWLER-STALE defense exists to cover).
 669: 
 670:     Returns dict with min / median / p95 / max / n for each.
 671:     """
 672:     within: list[int] = []
 673:     across: list[int] = []
 674:     last_frame_per_bowler: dict[str, int] = {}
 675:     last_global_bowler: str | None = None
 676:     last_global_frame: int | None = None
 677:     for ev in snap.bowler_strip_reads:
 678:         f = ev["frame_int"]
 679:         name = ev["name"]
 680:         if name in last_frame_per_bowler:
 681:             within.append(f - last_frame_per_bowler[name])
 682:         last_frame_per_bowler[name] = f
 683:         if (last_global_bowler is not None
 684:                 and name != last_global_bowler
 685:                 and last_global_frame is not None):
 686:             across.append(f - last_global_frame)
 687:         last_global_bowler = name
 688:         last_global_frame = f
 689: 
 690:     def stats(xs: list[int]) -> dict[str, float | int | None]:
 691:         return {
 692:             "n": len(xs),
 693:             "min": (min(xs) if xs else None),
 694:             "median": _percentile([float(x) for x in xs], 50),
 695:             "p95": _percentile([float(x) for x in xs], 95),
 696:             "max": (max(xs) if xs else None),
 697:         }
 698: 
 699:     return {
 700:         "within_bowler_frames": stats(within),
 701:         "across_bowler_frames": stats(across),
 702:     }
 703: 
