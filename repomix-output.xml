  1: """ConsistentReadTracker — replaces LiveMatchTracker.
  2: 
  3: Two consecutive frames showing the same value = confirmed truth.
  4: Suspicious changes (big drops, halved stats) need 3 readings.
  5: Bowler stats cross-checked against score delta to block info panel leaks.
  6: """
  7: from __future__ import annotations
  8: 
  9: from eyes.cricket_logger import CricketLogger
 10: 
 11: log = CricketLogger("TRACK")
 12: 
 13: 
 14: class ConsistentReadTracker:
 15: 
 16:     CONSENSUS_THRESHOLD = 4  # frames of consistent disagreement → reset
 17:     # Cold-start consensus. The very first reading we get for a field
 18:     # (`field not in self.confirmed`) must be SEEN ON N CONSECUTIVE
 19:     # FRAMES with the SAME value before we accept it. This is the
 20:     # primary defence against single-frame Scout hallucinations
 21:     # ("GT 112-3 (12.5)" appearing on a frame where the actual match
 22:     # is 0-0 — a coherent, physics-valid scorecard that no warm-mode
 23:     # diff guard can catch because there's no prior state to compare
 24:     # against). 3 frames is the sweet spot: catches one-frame
 25:     # hallucinations cheaply (~1.5s of pipeline latency at 2fps), but
 26:     # not so high that we lag the real first ball of an innings.
 27:     INITIAL_CONSENSUS_FRAMES = 3
 28: 
 29:     # Fields exempt from cold-start consensus — these are inherently
 30:     # initial-only or self-validating elsewhere. Adding everything to
 31:     # the consensus path would block legitimate first reads of static
 32:     # metadata and damage the cold-start UX without security gain.
 33:     INITIAL_CONSENSUS_EXEMPT: set[str] = {
 34:         # Add here any field that is metadata-only or already
 35:         # protected by an upstream consensus mechanism (e.g. team
 36:         # assignment uses team_confirm_count >= 3 in test_pipeline).
 37:     }
 38: 
 39:     # --- Batter physics bounds (2026-04-24, Fix #1 for F24 row-swap) ---
 40:     # Max legal single-delivery credit to a batter is a SIX (6 runs).
 41:     # With a no-ball on the same delivery, the batter can still only
 42:     # score the 6 off the bat — the +1 for the no-ball is an EXTRA,
 43:     # credited to the team not the batter. However, Scout strip reads
 44:     # occasionally lag by one frame relative to the ball-event stream,
 45:     # so a legitimate "NB + six off the bat" can arrive as a +7 strip
 46:     # delta during the reconciliation window. We give the cap one run
 47:     # of slack to avoid false-rejecting that edge case.
 48:     #
 49:     # The old threshold here was +30, which is ~4× looser than cricket
 50:     # physics allows. RCB-vs-GT 2026-04-24 F24 demonstrated the impact:
 51:     # a Scout row-swap misread of Gill 2→16 (+14) sailed past the +30
 52:     # gate, returned `suspicious=False`, and promoted via the
 53:     # pending-match fast-confirm path once a same-frame second caller
 54:     # re-proposed the same value. The downward half of the swap
 55:     # (Sudharsan 37→21) was correctly rejected by the monotonic
 56:     # guard, leaving state asymmetrically poisoned for ~80 seconds
 57:     # until the fast-confirm path happened to accept a correcting
 58:     # read. Parity monitor showed UI=23 vs Cricbuzz=9.
 59:     #
 60:     # Tightening to +7 forces any above-single-ball delta through
 61:     # either the 4-frame reject-streak consensus (L198-263) or the
 62:     # 3-frame pending-consensus (L274-333); neither can fire from a
 63:     # single-frame scramble, which is the exact F24 class of bug.
 64:     # Also symmetrises with the bowler-runs rule at L475 (also +7).
 65:     BATTER_SINGLE_BALL_RUN_MAX = 6
 66:     BATTER_NO_BALL_ADDITIONAL = 1
 67: 
 68:     def __init__(self):
 69:         self.confirmed: dict = {}
 70:         self.pending: dict = {}
 71:         self.pending_counts: dict = {}
 72:         self._prev_confirmed_score: int | None = None
 73:         self._suspicious_this_frame: dict[str, set[str]] = {}
 74:         self._last_frame: int = -1
 75:         self._no_data_streak: int = 0
 76:         self._post_gap_grace: int = 0
 77:         self._reject_streak: dict[str, list] = {}  # field → [value, count]
 78:         self._post_event_grace: int = 0  # frames of 1-read acceptance after ball event
 79:         # Cold-start consensus bookkeeping: maps field → [proposed_value, count].
 80:         # Reset to 1 if a different value arrives before INITIAL_CONSENSUS_FRAMES.
 81:         self._initial_consensus: dict[str, list] = {}
 82: 
 83:     def update(self, field: str, value, frame_count: int = 0):
 84:         """Submit a reading. Returns the confirmed value."""
 85:         if value is None:
 86:             self._no_data_streak += 1
 87:             return self.confirmed.get(field)
 88: 
 89:         if self._no_data_streak >= 5:
 90:             self._post_gap_grace = 3
 91:             log.info(f"[GAP] {self._no_data_streak} frames without data "
 92:                      f"— entering grace period for {field}")
 93:         self._no_data_streak = 0
 94: 
 95:         if self._post_gap_grace > 0 and self._is_drs_pattern(field, value):
 96:             old = self.confirmed.get(field)
 97:             self.confirmed[field] = value
 98:             self.pending.pop(field, None)
 99:             self.pending_counts.pop(field, None)
100:             self._post_gap_grace -= 1
101:             if old != value:
102:                 log.info(f"[DRS-GRACE] {field}: {old} → {value} "
103:                          f"(grace={self._post_gap_grace})")
104:             return value
105: 
106:         if frame_count != self._last_frame:
107:             self._flush_entity_suspicion()
108:             self._last_frame = frame_count
109: 
110:         current = self.confirmed.get(field)
111: 
112:         # Cold-start fast-path. If this field has never been confirmed,
113:         # bypass the entire warm-mode logic (suspicious / pending /
114:         # consensus-override paths) — those paths assume there is a
115:         # prior confirmed value to compare against. Route through
116:         # `_initial_consensus` instead, which requires
117:         # INITIAL_CONSENSUS_FRAMES of identical readings before
118:         # promoting to `self.confirmed`. Without this fast-path the
119:         # second-frame `pending`-confirm at the bottom commits the
120:         # value too early, which is the very hallucination
121:         # vulnerability we are trying to close.
122:         if field not in self.confirmed:
123:             if field in self.INITIAL_CONSENSUS_EXEMPT:
124:                 self.confirmed[field] = value
125:                 if field == "score":
126:                     self._prev_confirmed_score = None
127:                 log.info(f"{field}: initial → {value} (exempt)")
128:                 return value
129: 
130:             streak = self._initial_consensus.get(field)
131:             if streak and streak[0] == value:
132:                 streak[1] += 1
133:                 if streak[1] >= self.INITIAL_CONSENSUS_FRAMES:
134:                     self.confirmed[field] = value
135:                     self._initial_consensus.pop(field, None)
136:                     self.pending.pop(field, None)
137:                     self.pending_counts.pop(field, None)
138:                     if field == "score":
139:                         self._prev_confirmed_score = None
140:                     log.info(
141:                         f"{field}: initial → {value} "
142:                         f"(cold-start consensus "
143:                         f"{self.INITIAL_CONSENSUS_FRAMES}/"
144:                         f"{self.INITIAL_CONSENSUS_FRAMES})")
145:                     return value
146:                 log.info(
147:                     f"{field}: initial proposed {value} "
148:                     f"({streak[1]}/{self.INITIAL_CONSENSUS_FRAMES}"
149:                     f" — waiting)")
150:                 return None
151: 
152:             if streak and streak[0] != value:
153:                 log.info(
154:                     f"{field}: initial proposal flipped "
155:                     f"{streak[0]} → {value} — resetting consensus "
156:                     f"to 1/{self.INITIAL_CONSENSUS_FRAMES}")
157:             self._initial_consensus[field] = [value, 1]
158:             return None
159: 
160:         if current == value:
161:             self.pending.pop(field, None)
162:             self.pending_counts.pop(field, None)
163:             return value
164: 
165:         # Fast-path: small natural cricket increments on batter stats
166:         # from the strip are almost always correct — confirm immediately
167:         if current is not None and self._is_natural_batter_increment(
168:                 field, current, value):
169:             old = current
170:             self.confirmed[field] = value
171:             self.pending.pop(field, None)
172:             self.pending_counts.pop(field, None)
173:             self._reject_streak.pop(field, None)
174:             log.info(f"{field}: {old} → {value} (fast-confirm, "
175:                      f"natural increment F{frame_count})")
176:             return value
177: 
178:         # Fast-path: tight-delta bowler increments (Issue 3 fix,
179:         # 2026-04-21).  Wickets stepping +1 and overs stepping
180:         # exactly +0.1 are the unambiguous ball-by-ball shape of
181:         # bowler figures; neither value-space has room for an OCR
182:         # misread to masquerade as a legal increment (wickets 0..10
183:         # only ever tick once; overs are always N.0-N.5 within a
184:         # single over).  Confirm immediately so a just-seeded
185:         # "0-0(0.0)" card promotes on the next strip read after
186:         # the first delivery.  Runs are deliberately NOT in this
187:         # fast-path — a 0→3 runs jump matches both a triple and a
188:         # comparison-strip misread, so it still flows through the
189:         # pending path with score-delta cross-check (the same
190:         # reasoning we apply to the suspicious guards above).
191:         if current is not None and self._is_natural_bowler_increment(
192:                 field, current, value):
193:             old = current
194:             self.confirmed[field] = value
195:             self.pending.pop(field, None)
196:             self.pending_counts.pop(field, None)
197:             self._reject_streak.pop(field, None)
198:             log.info(f"{field}: {old} → {value} (fast-confirm, "
199:                      f"natural bowler increment F{frame_count})")
200:             return value
201: 
202:         # Post-ball-event grace: accept non-suspicious changes on first read.
203:         # Batter/bowler/wickets change legitimately after a delivery;
204:         # frame_poisoned already blocks corruption upstream.
205:         if self._post_event_grace > 0 and current is not None:
206:             suspicious_check = self._is_suspicious(field, current, value)
207:             if not suspicious_check:
208:                 old = current
209:                 self.confirmed[field] = value
210:                 self.pending.pop(field, None)
211:                 self.pending_counts.pop(field, None)
212:                 self._reject_streak.pop(field, None)
213:                 self._post_event_grace -= 1
214:                 if old != value:
215:                     log.info(f"{field}: {old} → {value} (post-event "
216:                              f"immediate, grace={self._post_event_grace})")
217:                 return value
218: 
219:         suspicious = current is not None and self._is_suspicious(field, current, value)
220:         if suspicious:
221:             entity = ":".join(field.split(":")[:2])
222:             self._suspicious_this_frame.setdefault(entity, set()).add(field)
223: 
224:             # Consensus override: if extractor keeps proposing the same
225:             # "suspicious" value for N frames, the tracker is stale — reset
226:             streak = self._reject_streak.get(field)
227:             if streak and self._values_close(streak[0], value, field):
228:                 streak[1] += 1
229:                 streak[0] = value  # track latest proposed value
230:                 if streak[1] >= self.CONSENSUS_THRESHOLD:
231:                     # Couple batter runs+balls: if runs wants to regress
232:                     # but balls hasn't changed, the extractor is stale.
233:                     try:
234:                         _old_f, _new_f = float(current), float(value)
235:                     except (ValueError, TypeError):
236:                         _old_f, _new_f = 0.0, 0.0
237:                     if (field.startswith("bat:") and field.endswith(":runs")
238:                             and _new_f < _old_f):
239:                         balls_field = field.replace(":runs", ":balls")
240:                         cur_balls = self.confirmed.get(balls_field)
241:                         if cur_balls is not None and float(cur_balls) > 2:
242:                             log.info(
243:                                 f"[CONSENSUS-BLOCKED] {field}: "
244:                                 f"{current}→{value} — balls still at "
245:                                 f"{cur_balls}, runs regression impossible")
246:                             self._reject_streak.pop(field, None)
247:                             return current
248: 
249:                     # Same logic for bowler stats: a bowler's runs,
250:                     # wickets, and overs CANNOT regress mid-spell.
251:                     # Without this guard, repeated mis-reads during
252:                     # ad-breaks / replays / dead-time frames (where
253:                     # scout reads `0-0 (0.0)`) silently overwrite
254:                     # the real bowler stats after 4 frames, e.g.
255:                     # KKR-vs-RR 2026-04-19 F373 18:58:55:
256:                     #   `[CONSENSUS] bowl:Jofra Archer:runs:
257:                     #     16 → 0 (extractor agreed 4 frames)`
258:                     #   `[CONSENSUS] bowl:Jofra Archer:wickets:
259:                     #     1 → 0 (extractor agreed 4 frames)`
260:                     #   `[CONSENSUS] bowl:Jofra Archer:overs:
261:                     #     2.1 → 0.0 (extractor agreed 4 frames)`
262:                     # which then leaks into the UI as a stale
263:                     # `Bowler 0-0 (0.0)` line / a different-bowler
264:                     # broadcast for the next ~30s until a real ball
265:                     # event re-syncs the card.  A bowler's stats
266:                     # only legitimately reset when the bowler's
267:                     # NAME changes (handled separately by the
268:                     # bowling card swap in scoreboard.update_bowler);
269:                     # never within a single spell.
270:                     if (field.startswith("bowl:")
271:                             and (field.endswith(":runs")
272:                                  or field.endswith(":wickets")
273:                                  or field.endswith(":overs"))
274:                             and _new_f < _old_f):
275:                         log.info(
276:                             f"[CONSENSUS-BLOCKED] {field}: "
277:                             f"{current}→{value} — bowler stats "
278:                             f"cannot regress mid-spell (likely "
279:                             f"dead-time misread)")
280:                         self._reject_streak.pop(field, None)
281:                         return current
282: 
283:                     # Match-level overs cannot regress within an
284:                     # innings — the only legitimate reset is via
285:                     # `set_innings_2()`, which clears `confirmed`
286:                     # wholesale rather than going through this
287:                     # consensus path.  Without this guard, four
288:                     # consecutive `(POWERPLAY)`-misparse frames
289:                     # silently overwrite a real over-7 reading
290:                     # with 0.5 and poison every dependent field
291:                     # (RR vs SRH 2026-04-25 F3120: `(POWERPLAY)`
292:                     # text → `[CONSENSUS] overs: 6.0 → 0.5
293:                     # (extractor agreed 4 frames)` → cascading
294:                     # batter/bowler/this_over corruption until
295:                     # process restart).  Mirrors the bowler /
296:                     # batter regression guards above.
297:                     if field == "overs" and _new_f < _old_f:
298:                         log.info(
299:                             f"[CONSENSUS-BLOCKED] {field}: "
300:                             f"{current}→{value} — match overs "
301:                             f"cannot regress within an innings "
302:                             f"(likely dead-time / placeholder-"
303:                             f"graphic misread)")
304:                         self._reject_streak.pop(field, None)
305:                         return current
306: 
307:                     old = current
308:                     self.confirmed[field] = value
309:                     self.pending.pop(field, None)
310:                     self.pending_counts.pop(field, None)
311:                     self._reject_streak.pop(field, None)
312:                     if field == "score":
313:                         self._prev_confirmed_score = old
314:                     log.info(f"[CONSENSUS] {field}: {old} → {value} "
315:                              f"(extractor agreed {streak[1]} frames)")
316:                     return value
317:             else:
318:                 self._reject_streak[field] = [value, 1]
319:         else:
320:             self._reject_streak.pop(field, None)
321: 
322:         pending = self.pending.get(field)
323: 
324:         if pending is not None:
325:             pending_value, _ = pending
326: 
327:             if pending_value == value:
328:                 if suspicious:
329:                     count = self.pending_counts.get(field, 1) + 1
330:                     self.pending_counts[field] = count
331:                     log.info(f"[SUSPICIOUS] {field}: {current}→{value} "
332:                              f"count={count}/3")
333:                     if count < 3:
334:                         return current
335: 
336:                     # Regression guards must apply on the pending-consensus
337:                     # promotion path too, not just reject-streak (2026-04-21).
338:                     # Without this, a repeat "suspicious" read that survived
339:                     # Path 1's CONSENSUS-BLOCKED ends up promoted here,
340:                     # silently regressing bowler/batter figures.  Observed
341:                     # live (SRH-vs-DC F113):
342:                     #   F111 [CONSENSUS-BLOCKED] bowl:Eshan Malinga:runs:
343:                     #         26→22 (Path 1 pops streak, correctly blocks)
344:                     #   F113 [SUSPICIOUS] …:runs: 26→22 count=3/3
345:                     #   F113 bowl:Eshan Malinga:runs: 26 → 22 (confirmed)
346:                     # Parity monitor confirmed CB had Malinga at 3-23 while
347:                     # UI ended up at 3-28/3-22 due to this drift.
348:                     try:
349:                         _old_f, _new_f = float(current), float(value)
350:                     except (ValueError, TypeError):
351:                         _old_f, _new_f = 0.0, 0.0
352:                     if (field.startswith("bat:") and field.endswith(":runs")
353:                             and _new_f < _old_f):
354:                         balls_field = field.replace(":runs", ":balls")
355:                         cur_balls = self.confirmed.get(balls_field)
356:                         if cur_balls is not None and float(cur_balls) > 2:
357:                             log.info(
358:                                 f"[CONSENSUS-BLOCKED] {field}: "
359:                                 f"{current}→{value} — balls still at "
360:                                 f"{cur_balls}, runs regression impossible "
361:                                 f"(pending-path)")
362:                             self.pending.pop(field, None)
363:                             self.pending_counts.pop(field, None)
364:                             return current
365:                     if (field.startswith("bowl:")
366:                             and (field.endswith(":runs")
367:                                  or field.endswith(":wickets")
368:                                  or field.endswith(":overs"))
369:                             and _new_f < _old_f):
370:                         log.info(
371:                             f"[CONSENSUS-BLOCKED] {field}: "
372:                             f"{current}→{value} — bowler stats cannot "
373:                             f"regress mid-spell (pending-path)")
374:                         self.pending.pop(field, None)
375:                         self.pending_counts.pop(field, None)
376:                         return current
377: 
378:                     # Match-level overs regression guard, pending
379:                     # path — analogue of the consensus-override
380:                     # guard above.  Without this, the same
381:                     # `(POWERPLAY)`-misparse pattern can promote
382:                     # via the SUSPICIOUS-count=3/3 path instead of
383:                     # the reject-streak path and still poison
384:                     # confirmed state.
385:                     if field == "overs" and _new_f < _old_f:
386:                         log.info(
387:                             f"[CONSENSUS-BLOCKED] {field}: "
388:                             f"{current}→{value} — match overs cannot "
389:                             f"regress within an innings "
390:                             f"(pending-path)")
391:                         self.pending.pop(field, None)
392:                         self.pending_counts.pop(field, None)
393:                         return current
