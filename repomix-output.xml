719: class PartnershipTracker:
720:     """Track partnerships from active batter pairs."""
721: 
722:     def __init__(self):
723:         self.current_pair: set[str] = set()
724:         self.partnership_start_score = 0
725:         self.partnership_start_balls = 0
726:         self.partnerships: list[dict] = []
727: 
728:     def reset(self) -> None:
729:         """Wipe all state for a fresh innings (Bug #14).
730: 
731:         Without this, partnership_start_balls carries the innings-1
732:         anchor (e.g. 73) into innings 2 and produces nonsense like
733:         '26 runs (-25 balls)' until the first ball event of the new
734:         innings re-anchors the tracker.
735:         """
736:         self.current_pair = set()
737:         self.partnership_start_score = 0
738:         self.partnership_start_balls = 0
739:         self.partnerships = []
740:         log.info("[PARTNERSHIP] Tracker reset for new innings")
741: 
742:     def update(self, active_batters: dict, team_score: int,
743:                team_balls: int,
744:                initial_guess_runs: int | None = None,
745:                initial_guess_balls: int | None = None) -> dict | None:
746:         """Update active pair; returns the just-ended partnership if any.
747: 
748:         New (2026-04-18): when anchoring a fresh pair, callers may
749:         supply `initial_guess_runs` and `initial_guess_balls` — the
750:         best-effort estimate of how much the new pair has already
751:         accumulated. We then back-date the anchor so that
752:         `current(team_score, team_balls)` returns the guess straight
753:         away, instead of zero. This matters during cold-start mid-
754:         innings: without it the tracker pretends the pair is fresh
755:         and `current = team_score - 0 = 169` which is wildly wrong.
756:         """
757:         pair = set(active_batters.keys())
758:         ended = None
759: 
760:         if pair != self.current_pair and len(pair) == 2:
761:             if self.current_pair:
762:                 ended = {
763:                     "batters": list(self.current_pair),
764:                     "runs": team_score - self.partnership_start_score,
765:                     "balls": team_balls - self.partnership_start_balls,
766:                     "ended": True,
767:                 }
768:                 self.partnerships.append(ended)
769:                 log.info(f"[PARTNERSHIP] {ended['batters']} — "
770:                          f"{ended['runs']} runs off {ended['balls']} balls")
771: 
772:             self.current_pair = pair
773:             if initial_guess_runs is not None:
774:                 self.partnership_start_score = (
775:                     team_score - max(0, int(initial_guess_runs)))
776:             else:
777:                 self.partnership_start_score = team_score
778:             if initial_guess_balls is not None:
779:                 self.partnership_start_balls = (
780:                     team_balls - max(0, int(initial_guess_balls)))
781:             else:
782:                 self.partnership_start_balls = team_balls
783:             log.info(
784:                 f"[PARTNERSHIP] new pair {pair} anchored at score="
785:                 f"{self.partnership_start_score} balls="
786:                 f"{self.partnership_start_balls}  (team={team_score}/"
787:                 f"{team_balls}, guess_runs={initial_guess_runs} "
788:                 f"guess_balls={initial_guess_balls})")
789: 
790:         return ended
791: 
792:     def override(self, team_score: int, team_balls: int,
793:                  broadcast_runs: int, broadcast_balls: int) -> None:
794:         """Hard-override anchor from a trusted broadcast read.
795: 
796:         Cricbuzz / Hotstar overlays periodically render the literal
797:         "P'SHIP 26 (18)" — when we see that, prefer it over our
798:         derived numbers. We rebase the anchor so that subsequent
799:         `current()` calls return broadcast_runs / broadcast_balls
800:         relative to the now-current team_score / team_balls.
801:         """
802:         new_start_score = team_score - max(0, int(broadcast_runs))
803:         new_start_balls = team_balls - max(0, int(broadcast_balls))
804:         if (new_start_score != self.partnership_start_score
805:                 or new_start_balls != self.partnership_start_balls):
806:             log.info(
807:                 f"[PARTNERSHIP] broadcast override: {broadcast_runs}"
808:                 f"({broadcast_balls}) — anchor {self.partnership_start_score}"
809:                 f"/{self.partnership_start_balls} → {new_start_score}/"
810:                 f"{new_start_balls}")
811:             self.partnership_start_score = new_start_score
812:             self.partnership_start_balls = new_start_balls
813: 
814:     def current(self, team_score: int, team_balls: int) -> dict:
815:         return {
816:             "runs": max(0, team_score - self.partnership_start_score),
817:             "balls": max(0, team_balls - self.partnership_start_balls),
818:             "batters": list(self.current_pair),
819:             "ended": False,
820:         }
821: 
822: 
823: def overs_to_balls(overs_str: str) -> int:
824:     s = str(overs_str or "0")
825:     if "." in s:
826:         w, b = s.split(".")
827:         return int(w) * 6 + int(b)
828:     return int(s) * 6
829: 
830: 
831: def get_match_situation(state: dict) -> dict:
832:     score = state.get("score") or 0
833:     wickets = state.get("wickets") or 0
834:     overs = float(state.get("overs") or "0")
835:     target = state.get("target")
836:     innings = state.get("innings", 1)
837: 
838:     balls_bowled = overs_to_balls(str(overs))
839:     # Bug #15: compute run-rate from balls_bowled (the canonical
840:     # measure) and require BOTH score AND balls > 0. Previous formula
841:     # `score / (overs or 0.1)` produced CRR=590 whenever score lagged
842:     # the overs reset by one frame at innings transition (59 / 0.1 =
843:     # 590 displayed in the situation panel while the ScoreStrip
844:     # showed the correct 7.38 from a different code path). Falling
845:     # back to 0 here also ensures the UI's `sit.run_rate > 0` guard
846:     # correctly hides the field instead of rendering bogus numbers.
847:     if balls_bowled > 0 and score > 0:
848:         run_rate = round(score / balls_bowled * 6, 2)
849:     else:
850:         run_rate = 0.0
851: 
852:     situation: dict = {
853:         "run_rate": run_rate,
854:         "balls_bowled": balls_bowled,
855:         "balls_remaining": 120 - balls_bowled,
856:         "wickets_in_hand": 10 - wickets,
857:     }
858: 
859:     if target and innings == 2:
860:         runs_needed = int(target) - score
861:         balls_left = 120 - balls_bowled
862:         req_rate = round(runs_needed / (balls_left / 6), 2) if balls_left > 0 else 999
863:         situation["runs_needed"] = runs_needed
864:         situation["balls_remaining"] = balls_left
865:         situation["required_rate"] = req_rate
866: 
867:         if runs_needed <= 0:
868:             situation["phase"] = "WON"
869:         elif wickets >= 8:
870:             situation["phase"] = "DESPERATE"
871:         elif req_rate > 12:
872:             situation["phase"] = "VERY_DIFFICULT"
873:         elif req_rate > 9:
874:             situation["phase"] = "CHALLENGING"
875:         elif req_rate < 6:
876:             situation["phase"] = "COMFORTABLE"
877:         else:
878:             situation["phase"] = "IN_THE_BALANCE"
879: 
880:     return situation
881: 
