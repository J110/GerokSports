182: def _clean_batting(v) -> str:
183:     if not isinstance(v, str):
184:         return "unknown"
185:     up = v.strip().upper().replace("-", "").replace(" ", "")
186:     if up in ("RHB", "RIGHTHAND", "RIGHTHANDED",
187:               "RIGHTHANDBAT", "RIGHTHANDBATTER"):
188:         return "RHB"
189:     if up in ("LHB", "LEFTHAND", "LEFTHANDED",
190:               "LEFTHANDBAT", "LEFTHANDBATTER"):
191:         return "LHB"
192:     return "unknown"
193: 
194: 
195: def _clean_bowling(v) -> str:
196:     if not isinstance(v, str):
197:         return "unknown"
198:     s = v.strip()
199:     if not s:
200:         return "unknown"
201:     if s.lower() in ("none", "n/a", "na", "does not bowl",
202:                      "doesn't bowl", "non-bowler", "pure batter"):
203:         return "None"
204:     if s.lower() in ("unknown", "?"):
205:         return "unknown"
206:     # Keep as-is, trim whitespace.
207:     return re.sub(r"\s+", " ", s)
