 223: def test_this_over_late_boundary_ball_appends_to_held() -> None:
 224:     header("Late boundary ball appends to held over (not new over)")
 225:     from eyes.this_over import ThisOverManager, ROLLOVER_MAX_DEFER_FRAMES
 226:     om = ThisOverManager()
 227:     # Simulate over 5 just rolled to over 6 with 5 tokens already
 228:     # observed and the boundary ball still pending in BED's queue.
 229:     om.this_over = [".", "1", "4", ".", "."]
 230:     om.this_over_sources = ["obs"] * 5
 231:     om._last_over_int = 5
 232:     om._over_start_score = 100
 233:     # Ticking from 5.5 → 6.0 with 5 tokens present hits the rollover-
 234:     # defer path (this_over.py: `_legal_count < 6` triggers up to
 235:     # ROLLOVER_MAX_DEFER_FRAMES deferred frames before forcing the
 236:     # archive).  We need (defer_frames + 1) calls to exhaust the defer
 237:     # budget and reach the force-archive branch that sets
 238:     # _pending_clear=True.  The first N calls return False (deferred);
 239:     # the (N+1)th call falls through to the held-state setup.
 240:     for _ in range(ROLLOVER_MAX_DEFER_FRAMES + 1):
 241:         om.check_over_change("6.0", "Bumrah", score=106)
 242:     assert om._pending_clear is True, "expected pending_clear=True"
 243:     assert om._pending_clear_over_int == 5
 244:     assert om._last_over_int == 6
 245:     held_before = list(om.this_over)
 246: 
 247:     # Late legal-event for the 6th ball of over 5 (BED queue popped
 248:     # AFTER the rollover; event.over reads "6.0" because team-overs
 249:     # had already ticked).
 250:     late = {"type": "1_RUNS", "runs": 1, "certain": True,
 251:             "over": "6.0", "bowler": "Bumrah"}
 252:     om.on_ball_event(late)
 253: 
 254:     # Held over should NOT have been flushed; the "1" must be the
 255:     # LAST token of the held over, not the first of over 6.
 256:     check("hold not flushed by late boundary ball",
 257:           om._pending_clear is True,
 258:           f"_pending_clear={om._pending_clear}")
 259:     check("late ball appended to END of held over",
 260:           om.this_over == held_before + ["1"],
 261:           f"this_over={om.this_over}, held_before={held_before}")
 262:     arch = om.over_history.get(5, {})
 263:     check("over_history[5] re-archived with late ball included",
 264:           arch.get("balls") == held_before + ["1"]
 265:           and arch.get("runs") >= 1,
 266:           f"archive={arch}")
