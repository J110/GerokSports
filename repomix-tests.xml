 602:     from score_manager import ScoreManager, FrameInput
 603:     import time as _t
 604: 
 605:     sm = ScoreManager(shadow=True)
 606:     # Three identical frames with score+wickets but overs=None.
 607:     # OLD bug: cold_candidate_streak hits 3 → COLD_START → WARM
 608:     # with overs=None → next _apply_event crashes with int(None).
 609:     # NEW guard: incomplete cards are skipped without seeding
 610:     # cold_candidate, so promotion never occurs.
 611:     base = dict(frame_id="x", timestamp=_t.time(),
 612:                 ext_score=28, ext_wickets=0, ext_overs=None,
 613:                 ext_bat1_name="A", ext_bat1_runs=15, ext_bat1_balls=10,
 614:                 ext_bat2_name="B", ext_bat2_runs=13, ext_bat2_balls=8,
 615:                 ext_bowler_name="X", ext_bowler_wickets=0,
 616:                 ext_bowler_runs=18, ext_bowler_overs=None,
 617:                 scorer_changes=[], speed_kph=None,
 618:                 broadcast_extra=None, broadcast_this_over=None,
 619:                 broadcast_target=None, broadcast_striker=None,
 620:                 broadcast_venue=None, broadcast_team=None,
 621:                 broadcast_match_info=None, scout_text="",
 622:                 action_text=None, delivery_info=None, drs_state=None)
 623:     for i in range(3):
 624:         sm.on_frame(FrameInput(**base))
 625: 
 626:     check("ScoreManager stays in COLD_START with overs=None",
 627:           sm.mode == "COLD_START",
 628:           f"mode={sm.mode}, overs={sm.overs}")
 629:     check("cold_candidate not seeded by incomplete card",
 630:           sm.cold_candidate is None,
