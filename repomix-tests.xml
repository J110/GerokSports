 671: def test_twenty_over_invariant_check_in_source() -> None:
 672:     """Light-touch check that the source code references the
 673:     20-over / 10-wicket invariant in both auto-swap call sites.
 674: 
 675:     Historical note: this test once asserted `'>= 18.0' not in content`
 676:     as a regression guard against Bug #16's stale 18.0 cap in the
 677:     auto-swap trigger.  That negative grep is now over-broad: post-
 678:     Bug-#16 the codebase legitimately uses `< 18.0` (cold-start
 679:     innings-2 detection at ~L2559, L3170 — substring matches `18.0`)
 680:     and `>= 18.0` (innings-1 near-end heuristic at ~L5181, used as
 681:     one of several `or`-ed predicates with `_inn1_wkts >= 8`).  Both
 682:     are intentional non-rollover uses and shouldn't trip a regression
 683:     test.  We've replaced the negative grep with positive assertions
 684:     on the auto-swap site itself (20.0 + 10-wicket presence)."""
 685:     header("20.0-over guard wired in test_pipeline.py")
 686:     src = Path(__file__).parent / "test_pipeline.py"
 687:     content = src.read_text()
 688:     check("20.0 overs threshold present",
 689:           ">= 20.0" in content,
