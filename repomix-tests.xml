3017: def test_this_over_reorder_extras_are_skipped_in_legal_count() -> None:
3018:     """Compound extras (`Wd+4`) and pure extras (`Wd`, `Nb`) must not
3019:     advance the legal-ball counter when computing W's target slot."""
3020:     header("Fix 3: legal-ball counter skips extras (incl. compound)")
3021:     from eyes.this_over import ThisOverManager
3022:     om = ThisOverManager()
3023:     # Tokens mapping: Wd extra, '6' = X.1, 'Nb+1' compound extra,
3024:     # '.' = X.2, '1' = X.3, 'W' detected at end (current legal-pos 4),
3025:     # FOW upgrade says X.3 — W should move to right after the '1'.
3026:     om.this_over = ["Wd", "6", "Nb+1", ".", "1", "W"]
3027:     om.this_over_sources = ["obs"] * 6
3028:     moved = om.reorder_wicket_to_ball(3)
3029:     check("reorder fired (target=3 differs from current legal=4)",
3030:           moved is True, f"got {moved!r}")
3031:     check("W placed after '1' (3rd legal ball)",
3032:           om.this_over == ["Wd", "6", "Nb+1", ".", "1", "W"]
3033:           or om.this_over == ["Wd", "6", "Nb+1", ".", "W", "1"],
3034:           f"this_over={om.this_over}")
3035:     # The exact insertion places W immediately after the 3rd legal
3036:     # ball; with our list, position-of-3rd-legal is at index 4 ('1'),
3037:     # so W should land at index 5 (end). That's a no-op-ish but the
3038:     # algorithm correctly recomputed.  Now test a case where it
3039:     # actually moves W backwards in the list:
3040:     om2 = ThisOverManager()
3041:     # ["Wd", "6", "Nb+1", "1", "W"]: legal-balls = 6(1), 1(2), W(3).
3042:     # Target=2 should pull W back so it's the 2nd legal ball.
3043:     om2.this_over = ["Wd", "6", "Nb+1", "1", "W"]
3044:     om2.this_over_sources = ["obs"] * 5
3045:     moved2 = om2.reorder_wicket_to_ball(2)
3046:     check("backward reorder fired (legal 3 → legal 2)",
3047:           moved2 is True, f"got {moved2!r} list={om2.this_over}")
3048:     # Verify W's new legal-ball position is exactly 2.
3049:     legal_count = 0
3050:     w_pos = None
3051:     for t in om2.this_over:
3052:         if not (t == "Wd" or t == "Nb"
3053:                 or t.startswith("Wd+") or t.startswith("Nb+")):
3054:             legal_count += 1
3055:         if t == "W" and w_pos is None:
3056:             w_pos = legal_count
3057:     check("W is now the 2nd legal ball post-reorder",
3058:           w_pos == 2, f"w_pos={w_pos} this_over={om2.this_over}")
