5033: def _make_sb_with_phantom_runs(name: str, phantom_runs: int,
5034:                                phantom_balls: int):
5035:     """Construct a Scoreboard where `name` is batting with an
5036:     inflated (phantom) runs value committed.  Subsequent
5037:     `update_batter` calls with truth values lower than the phantom
5038:     will be rejected by the runs-monotonic guard until Layer 4's
5039:     consensus-release fires.
5040:     """
5041:     from eyes.scoreboard import Scoreboard
5042:     sb = Scoreboard()
5043:     sb.setup_innings("BAT", "BOWL",
5044:                      [name, "Other", "C", "D", "E"],
5045:                      ["B1", "B2"])
5046:     sb.batting_card[name]["status"] = "batting"
5047:     sb.batting_card[name]["runs"] = phantom_runs
5048:     sb.batting_card[name]["balls"] = phantom_balls
5049:     sb.batting_card["Other"]["status"] = "batting"
5050:     sb.batting_card["Other"]["runs"] = 5
5051:     sb.batting_card["Other"]["balls"] = 8
5052:     sb._inn["striker"] = name
5053:     sb._inn["non_striker"] = "Other"
5054:     sb._inn["score"] = phantom_runs + 5 + 5  # leave room for extras
5055:     sb._inn["wickets"] = 0
5056:     sb._inn["overs"] = "10.0"
5057:     # Seed the consensus tracker so the phantom value is "committed"
5058:     # — otherwise updates land cold-start consensus instead of the
5059:     # regression guard.
5060:     sb._tracker.force_set(f"bat:{name}:runs", phantom_runs)
5061:     sb._tracker.force_set(f"bat:{name}:balls", phantom_balls)
5062:     return sb
5063: 
