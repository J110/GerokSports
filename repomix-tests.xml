  47: def test_tracker_cold_start_consensus() -> None:
  48:     header("ConsistentReadTracker cold-start consensus (3 frames)")
  49:     from eyes.consistent_tracker import ConsistentReadTracker
  50:     t = ConsistentReadTracker()
  51:     assert t.INITIAL_CONSENSUS_FRAMES == 3, "constant must be 3"
  52: 
  53:     # First read → not yet committed (returns None)
  54:     r1 = t.update("score", 42, frame_count=1)
  55:     check("frame 1 returns None (not yet committed)",
  56:           r1 is None and t.confirmed.get("score") is None,
  57:           f"r1={r1}, confirmed={t.confirmed.get('score')}")
  58: 
  59:     # Second read same value → still None
  60:     r2 = t.update("score", 42, frame_count=2)
  61:     check("frame 2 returns None (still 2/3)",
  62:           r2 is None and t.confirmed.get("score") is None,
  63:           f"r2={r2}, confirmed={t.confirmed.get('score')}")
  64: 
  65:     # Third matching read → commits
  66:     r3 = t.update("score", 42, frame_count=3)
  67:     check("frame 3 commits 42 (3/3 consensus)",
  68:           r3 == 42 and t.confirmed.get("score") == 42,
  69:           f"r3={r3}, confirmed={t.confirmed.get('score')}")
