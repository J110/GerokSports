5472: def _synth_log(lines: list[str]) -> "Path":
5473:     """Write a synthetic log to a temp file and return the path."""
5474:     import tempfile
5475:     fp = tempfile.NamedTemporaryFile(
5476:         mode="w", suffix=".log", delete=False, encoding="utf-8")
5477:     fp.write("\n".join(lines))
5478:     fp.close()
5479:     return Path(fp.name)
