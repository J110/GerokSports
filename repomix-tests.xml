 479: def test_legbye_requires_both_witnesses() -> None:
 480:     header("Bug #11: leg-bye requires bowler AND striker witnesses")
 481:     from eyes.commentary import BallEventDetector
 482: 
 483:     class _Tracker:
 484:         def __init__(self, **vals):
 485:             self._v = vals
 486:         def get(self, k, default=None):
 487:             return self._v.get(k, default)
 488:         def get_with_freshness(self, k):
 489:             return (self._v.get(k), "live", 1.0)
 490: 
 491:     def _seed(bed):
 492:         # The internal `detect()` only fully populates the prev_*
 493:         # bowler/striker fields after an actual ball event has been
 494:         # processed. For deterministic isolation we hand-seed the
 495:         # prev_* state instead of running 2-3 priming frames.
 496:         bed.prev_score = 50
 497:         bed.prev_wickets = 0
 498:         bed.prev_overs = 5.0
 499:         bed.prev_bowler_runs = 20
 500:         bed.prev_striker = "A"
 501:         bed.prev_striker_balls = 7
 502:         bed.prev_striker_runs = 10
 503: 
 504:     # Case 1: legal ball, score +1. Bowler runs unchanged (LAG),
 505:     # but striker runs went 10 → 11. New rule: this is NOT a leg-bye
 506:     # — it's a real run off the bat (striker runs +1 = independent
 507:     # witness that the run was credited to the batter).
 508:     bed1 = BallEventDetector()
 509:     _seed(bed1)
 510:     t2 = _Tracker(score=51, wickets=0, overs=5.1,
 511:                   current_bowler="X", striker="A",
 512:                   **{"bowl:X:runs": 20, "bat:A:balls": 8,
 513:                      "bat:A:runs": 11})
 514:     ev = bed1.detect(t2)
 515:     check("not classified as leg-bye when striker runs increased",
 516:           ev is not None and ev.get("extras_type") != "leg_bye_or_bye",
 517:           f"event={ev}")
 518: 
 519:     # Case 2: legal ball, score +1, bowler runs unchanged AND striker
 520:     # runs ALSO unchanged (10 → 10). Both witnesses agree → genuine
 521:     # leg-bye.
 522:     bed2 = BallEventDetector()
 523:     _seed(bed2)
 524:     t3 = _Tracker(score=51, wickets=0, overs=5.1,
 525:                   current_bowler="X", striker="A",
 526:                   **{"bowl:X:runs": 20, "bat:A:balls": 8,
 527:                      "bat:A:runs": 10})
 528:     ev2 = bed2.detect(t3)
 529:     check("classified as leg-bye when BOTH witnesses agree",
 530:           ev2 is not None and ev2.get("extras_type") == "leg_bye_or_bye",
 531:           f"event={ev2}")
 532: 
