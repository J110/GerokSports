 710:         "BAT", "BOWL",
 711:         ["Rahul", "Pathum", "Three", "Four", "Rana"],
 712:         ["B1", "B2"],
 713:     )
 714:     sb.batting_card["Rahul"]["status"] = "batting"
 715:     sb.batting_card["Rahul"]["runs"] = 25
 716:     sb.batting_card["Rahul"]["balls"] = 18
 717:     sb.batting_card["Pathum"]["status"] = "out"
 718:     sb.batting_card["Pathum"]["runs"] = 12
 719:     sb.batting_card["Pathum"]["balls"] = 9
 720:     sb.batting_card["Pathum"]["dismissal"] = {
 721:         "how": "caught", "bowler": "B1", "fielder": "F1"}
 722:     sb.batting_card["Rana"]["status"] = "batting"
 723:     sb.batting_card["Rana"]["runs"] = 5
 724:     sb.batting_card["Rana"]["balls"] = 4
 725:     sb.fall_of_wickets = [{
 726:         "wicket": 1, "batter": "Pathum", "score": 40, "overs": "5.4",
 727:         "how": "caught", "bowler": "B1", "_witnessed": True,
 728:     }]
 729:     sb._inn["score"] = 60
 730:     sb._inn["wickets"] = 1
 731:     sb._inn["overs"] = "8.2"
 732:     return sb
