1366: # WS-PROJECTION-GAP fallback (Fix 7, 2026-04-26): when SM has cleared
1367: # striker / non_striker to None mid-wicket-transition but `sb._inn`
1368: # already holds the new pair from scout's strip read, project the
1369: # `sb._inn` value into the WS payload provided the value is currently
1370: # in `active_batting` (i.e. not a stale dismissed-batter leftover).
1371: # Closes the ~24 s post-wicket UI gap observed at F145 W2 in the
1372: # 2026-04-25 RR-vs-SRH match-2 trace.  Strengthened by Fix 5 (same
1373: # bundle): `sb._inn` is now collision-protected, so this fallback
1374: # can't surface a `striker == non_striker` payload pair.
1375: # See backlog "P2: WS-PROJECTION-GAP — striker / non_striker null in
1376: # payload" (entry includes the F145 evidence and Fix-5 reframing).
1377: # ---------------------------------------------------------------------
1378: def _setup_ws_projection_pair_sb():
1379:     """Fresh Scoreboard with two batters at the crease + a dismissed
1380:     batter mid-innings, ready for SM-null fallback scenarios."""
1381:     from eyes.scoreboard import Scoreboard
1382:     sb = Scoreboard()
1383:     sb.setup_innings(
1384:         batting_team="Rajasthan Royals",
1385:         bowling_team="Sunrisers Hyderabad",
1386:         batting_squad=["Sooryavanshi", "Parag", "Jurel", "Three"],
1387:         bowling_squad=["Sakib Hussain", "Shivang Kumar"],
1388:         batting_xi=["Sooryavanshi", "Parag", "Jurel", "Three"],
1389:         bowling_xi=["Sakib Hussain", "Shivang Kumar"],
1390:     )
1391:     for name, runs, balls, status in (
1392:             ("Sooryavanshi", 103, 50, "batting"),
1393:             ("Parag", 2, 4, "batting"),
1394:             ("Jurel", 8, 12, "out")):
1395:         sb.batting_card[name]["status"] = status
1396:         sb.batting_card[name]["runs"] = runs
1397:         sb.batting_card[name]["balls"] = balls
1398:     sb._inn["score"] = 113
1399:     sb._inn["wickets"] = 2
1400:     sb._inn["overs"] = "13.2"
1401:     return sb
