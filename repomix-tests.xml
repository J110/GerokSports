2892:     """RR vs SRH 2026-04-25 F3117-F3120 replay: confirmed overs=6.0,
2893:     then 4 consecutive reads of 0.5 (the (POWERPLAY)-misparse pattern)
2894:     must NOT flip confirmed; [CONSENSUS-BLOCKED] fires instead of
2895:     [CONSENSUS]."""
2896:     header("Fix 4: overs (POWERPLAY)-class regression rejected by CONSENSUS-BLOCKED")
2897:     from eyes.consistent_tracker import ConsistentReadTracker
2898:     t = ConsistentReadTracker()
2899:     f = _confirm_overs_via_cold_start(t, 6.0, start_frame=1)
2900:     check("cold-start confirmed overs=6.0",
2901:           t.confirmed.get("overs") == 6.0,
2902:           f"confirmed={t.confirmed.get('overs')}")
2903: 
2904:     # 4 consecutive regression reads — what F3117-F3120 produced
2905:     for _ in range(t.CONSENSUS_THRESHOLD):
2906:         t.update("overs", 0.5, frame_count=f)
2907:         f += 1
2908: 
2909:     # Without the fix, confirmed would have flipped to 0.5 here.
2910:     check("confirmed.overs stays 6.0 after 4 consecutive 0.5 reads",
2911:           t.confirmed.get("overs") == 6.0,
2912:           f"confirmed={t.confirmed.get('overs')} "
2913:           f"(regression to 0.5 should have been blocked)")
