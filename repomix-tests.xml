3727: def test_fix10_powell_f179_f258_placeholder_upgrade_with_drifted_slots() -> None:
3728:     """**Coverage gap fixture (LSG-vs-KKR 2026-04-26, Powell W4).**
3729: 
3730:     Production sequence (from `pipeline-…-fix12-v6-validation.log`):
3731:       * F179 (20:06:07): `[FOW] Placeholder W4: _unwitnessed`
3732:         (broadcast registered `wickets→4` but no batter name yet)
3733:       * F258 (20:08:09, ~2 min later): `[FOW] Upgraded
3734:         placeholder W4: Rovman Powell at 31/4 (6.1)
3735:         (was _unwitnessed)`
3736:       * At F258, `sb._inn["striker"]` is None and
3737:         `sb._inn["non_striker"]` is `Cameron Green` — Powell is
3738:         no longer in either crease slot because the broadcast
3739:         had moved past Powell's tenure during the 79-frame gap.
3740: 
3741:     Result: Fix 10's `_post_witnessed_dismissal_slot_rotation`
3742:     hook fires (the upgrade path correctly invokes it per
3743:     `test_fix10_placeholder_upgrade_path_also_fires_hook`) but
3744:     the slot-membership check at scoreboard.py line 2842
3745:     (`if not (striker_dismissed or non_striker_dismissed):
3746:     return`) returns silently — Case 3 of the docstring
3747:     ("dismissed name in **neither** slot: no-op").
3748: 
3749:     The docstring assumed Case 3 only fires for cold-start
3750:     back-fill of *historic* wickets where current crease state
3751:     legitimately reflects a much later innings stage.  Powell
3752:     shows it also fires for **recent** wickets when the
3753:     placeholder→witness gap (~2 min in production) outlives the
3754:     crease state.  Per-match-3 baseline (Sarfaraz/Dube/Overton)
3755:     had crease slots populated at the moment of witness; Powell
3756:     is the first observed case of a real-time but delayed
3757:     witness.
3758: 
3759:     Related deeper gap: `_add_fow` does NOT update
3760:     `batting_card[dismissed].status = "out"` on the
3761:     placeholder→witness upgrade (only `dismiss_batter` and
3762:     `_auto_dismiss_for_new_batter` set the status flag).  After
3763:     the F258 upgrade, Powell remains in `batting_card` with
3764:     status `batting`, which is why subsequent BEFORE_bat2
3765:     snapshots continued to show `Rovman Powell 14(56)` (the
3766:     phantom stats persisting because the dismissal didn't
3767:     propagate to the card).
3768: 
3769:     **Current behaviour (this test asserts the existing
3770:     contract — no-op when dismissed not in slots).**  When the
3771:     coverage-gap fix lands, this test should be updated to
3772:     assert the new expected behaviour (e.g. clearing
3773:     `batting_card` status, or extending the hook to also act
3774:     on `active_batters` membership).
3775:     """
3776:     header("Fix 10: Powell F179→F258 production fixture "
3777:            "(coverage gap — hook correctly no-ops on drifted-slots case)")
3778:     from eyes.scoreboard import Scoreboard
3779:     sb = Scoreboard()
3780:     sb.setup_innings("KKR", "LSG",
3781:                      ["Powell", "Green", "Singh", "D", "E"],
3782:                      ["Khan", "Bishnoi"])
3783:     # Reproduce F179 state: _unwitnessed placeholder at W4.
3784:     sb.fall_of_wickets = [
3785:         {"wicket": 1, "batter": "?", "score": "?", "overs": "?",
3786:          "tentative": True, "_unwitnessed": True},
3787:         {"wicket": 2, "batter": "?", "score": "?", "overs": "?",
3788:          "tentative": True, "_unwitnessed": True},
3789:         {"wicket": 3, "batter": "?", "score": "?", "overs": "?",
3790:          "tentative": True, "_unwitnessed": True},
3791:         {"wicket": 4, "batter": None, "score": "?", "overs": "?",
3792:          "_unwitnessed": True, "tentative": True},
3793:     ]
3794:     # Reproduce F258 crease state: striker=None, non_striker=Green
3795:     # (Powell already cleared from slots; Singh not yet promoted).
3796:     sb._inn["striker"] = None
3797:     sb._inn["non_striker"] = "Green"
3798:     sb._inn["score"] = 31
3799:     sb._inn["wickets"] = 4
3800:     sb._inn["overs"] = "6.1"
3801:     # Powell still in batting_card with status "batting" (the second
3802:     # related gap — _add_fow doesn't propagate dismissal to card).
3803:     sb.batting_card["Powell"]["status"] = "batting"
3804:     sb.batting_card["Powell"]["runs"] = 14
3805:     sb.batting_card["Powell"]["balls"] = 56  # Phantom — separately
3806:     # filed under the cricket-physics-balls-ceiling P0.
3807: 
3808:     # Trigger the F258 upgrade.
3809:     sb._add_fow(4, "Powell", 31, "6.1", how="caught", bowler="Khan")
3810: 
3811:     check("FOW W4 upgraded to witnessed",
3812:           sb.fall_of_wickets[3].get("_witnessed") is True
3813:           and sb.fall_of_wickets[3]["batter"] == "Powell",
3814:           f"fow[3]={sb.fall_of_wickets[3]}")
3815:     check("slot rotation correctly no-op'd: striker still None "
3816:           "(Powell wasn't in striker slot)",
3817:           sb._inn["striker"] is None,
3818:           f"striker={sb._inn['striker']!r}")
3819:     check("slot rotation correctly no-op'd: non_striker still "
3820:           "'Green' (Powell wasn't in non_striker slot)",
3821:           sb._inn["non_striker"] == "Green",
3822:           f"non_striker={sb._inn['non_striker']!r}")
3823:     # Fix 13 (Path D, 2026-04-26): Case 5 now propagates the
3824:     # dismissal to batting_card.status even when not in slots.
