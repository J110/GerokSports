2880: # --- Fix 4: overs CONSENSUS-BLOCKED regression guard -----------------
2881: def _confirm_overs_via_cold_start(tracker, value, start_frame=1):
2882:     """Push `value` through the 3-frame cold-start consensus to land
2883:     it in `confirmed[overs]`. Returns the frame after confirmation."""
2884:     f = start_frame
2885:     for _ in range(tracker.INITIAL_CONSENSUS_FRAMES):
2886:         tracker.update("overs", value, frame_count=f)
2887:         f += 1
2888:     return f
2889: 
