4091: def _drive_apply_scorer_decision(sb, batter_proposals: dict):
4092:     """Build a minimal `decision` + `extracted` and run
4093:     `apply_scorer_decision`.  `batter_proposals` is a dict of
4094:     {name: (runs, balls)}.  Returns (changes, post_state) where
4095:     `post_state` is a dict snapshotting batter runs after the call
4096:     so tests can assert which proposals were committed vs gated.
4097:     """
4098:     from test_pipeline import apply_scorer_decision
4099:     decision = {
4100:         "batter_updates": {
4101:             n: {"runs": r, "balls": b, "accepted": True}
4102:             for n, (r, b) in batter_proposals.items()
4103:         }
4104:     }
4105:     extracted = {
4106:         "batters": [
4107:             {"name": n, "runs": r, "balls": b}
4108:             for n, (r, b) in batter_proposals.items()
4109:         ]
4110:     }
4111:     changes = apply_scorer_decision(
4112:         sb, decision, frame=999, jump_guard=None,
4113:         batting_team={"name": "BAT"}, extracted=extracted,
4114:         frame_type="LIVE")
4115:     post_state = {
4116:         n: sb.batting_card[n].get("runs")
4117:         for n in batter_proposals
4118:         if n in sb.batting_card
4119:     }
4120:     return changes, post_state
4121: 
