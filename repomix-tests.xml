4047: # ---------------------------------------------------------------------
4048: # Fix 11: EXTRAS-INF admission gate (Layer 1 of phantom +N quartet)
4049: # ---------------------------------------------------------------------
4050: def _make_sb_for_extras_inf_gate(
4051:         score: int,
4052:         wickets: int,
4053:         active: list[tuple[str, int, int]],
4054:         dismissed: list[tuple[str, int, int]],
4055: ):
4056:     """Build a Scoreboard configured for Fix 11 gate testing.
4057: 
4058:     `active`/`dismissed` are lists of (name, runs, balls).  Dismissed
4059:     batters get a witnessed FOW entry stamped so the completeness
4060:     check (`_dismissed_count == wickets`) is satisfied when
4061:     `len(dismissed) == wickets`.
4062:     """
4063:     from eyes.scoreboard import Scoreboard
4064:     sb = Scoreboard()
4065:     squad_bat = [n for n, _, _ in active] + [
4066:         n for n, _, _ in dismissed] + ["Spare1", "Spare2"]
4067:     sb.setup_innings("BAT", "BOWL", squad_bat[:11], ["B1", "B2"])
4068:     for name, runs, balls in active:
4069:         sb.batting_card[name]["status"] = "batting"
4070:         sb.batting_card[name]["runs"] = runs
4071:         sb.batting_card[name]["balls"] = balls
4072:     for i, (name, runs, balls) in enumerate(dismissed):
4073:         sb.batting_card[name]["status"] = "out"
4074:         sb.batting_card[name]["runs"] = runs
4075:         sb.batting_card[name]["balls"] = balls
4076:         sb.fall_of_wickets.append({
4077:             "wicket": i + 1, "batter": name, "score": runs * 2,
4078:             "overs": f"{i + 1}.0", "how": "caught", "bowler": "B1",
4079:             "_witnessed": True,
4080:         })
4081:     if active:
4082:         sb._inn["striker"] = active[0][0]
4083:         if len(active) > 1:
4084:             sb._inn["non_striker"] = active[1][0]
4085:     sb._inn["score"] = score
4086:     sb._inn["wickets"] = wickets
4087:     sb._inn["overs"] = "10.0"
4088:     return sb
4089: 
