 924:     sb.batting_card["Rahul"]["runs"] = 31
 925:     sb.batting_card["Rahul"]["balls"] = 32
 926:     sb.batting_card["Pathum"]["status"] = "batting"  # CORRUPTED
 927:     sb.batting_card["Pathum"]["runs"] = 11
 928:     sb.batting_card["Pathum"]["balls"] = 23
 929:     sb.batting_card["Pathum"]["dismissal"] = None  # wiped by un-dismiss
 930:     sb.batting_card["Rana"]["status"] = "yet_to_bat"
 931:     sb.fall_of_wickets = [{
 932:         "wicket": 1, "batter": "Pathum", "score": 50, "overs": "6.3",
 933:         "how": "caught", "bowler": "B1", "_witnessed": True,
 934:     }]
 935:     sb._inn["score"] = 86
 936:     sb._inn["wickets"] = 1
 937:     sb._inn["overs"] = "7.5"
 938:     sb._last_autodismiss_wickets = 1  # gate would block at this count
 939:     return sb
