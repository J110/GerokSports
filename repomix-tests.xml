2237: # ---------------------------------------------------------------------
2238: # 10. BOWLER-STALE freshness disambiguator (2026-04-25 RR-vs-SRH fix)
2239: #
2240: # The same-figures rejection in update_bowler() pre-fix had no way to
2241: # distinguish "fresh between-ball repeat read of a new bowler trying
2242: # to take over" (recorded values were just written 1-N frames ago by
2243: # THIS spell) from "genuine end-of-spell stale graphic of a long-
2244: # departed bowler" (recorded values were written long ago and the
2245: # graphic is now resurfacing).  The trap: every same-figures read
2246: # was rejected, so 3-frame consensus never accumulated, so
2247: # current_bowler never flipped.
2248: #
2249: # Production damage 2026-04-25 (match-2 RR vs SRH innings 1):
2250: # 54+ rejects across 4 distinct bowlers (Shivang / Sakib / Hinge /
2251: # Cummins).  Damage propagates via BOWLER-AUTO inflating still-current
2252: # bowler's stats with the new bowler's deliveries.
2253: #
2254: # Fix: bypass same-figures rejection iff (a) recorded values written
2255: # within `_BOWLER_STALE_FRESH_FRAMES` AND (b) `current_bowler` hasn't
2256: # changed since that write.  When EITHER condition fails (figures are
2257: # old, or bowler context changed in the interim), original stale-
2258: # graphic defense fires unchanged.
2259: # ---------------------------------------------------------------------
2260: def _setup_bowler_trap_sb(initial_current_bowler: str = "Sakib Hussain"):
2261:     """Fresh Scoreboard wired for the BOWLER-STALE trap exercise.
2262: 
2263:     Bowling card pre-populated with the four match-2 bowlers; one is
2264:     already the established `current_bowler`.  No rotation lock
2265:     (so `_prev_over_bowler` is None and the rotation guard is inert).
2266:     """
2267:     from eyes.scoreboard import Scoreboard
2268:     sb = Scoreboard()
2269:     sb.setup_innings(
2270:         batting_team="Rajasthan Royals",
2271:         bowling_team="Sunrisers Hyderabad",
2272:         batting_squad=["Sooryavanshi", "Jurel"],
2273:         bowling_squad=[
2274:             "Sakib Hussain", "Shivang Kumar",
2275:             "Pat Cummins", "Eshan Malinga"],
2276:         batting_xi=["Sooryavanshi", "Jurel"],
2277:         bowling_xi=[
2278:             "Sakib Hussain", "Shivang Kumar",
2279:             "Pat Cummins", "Eshan Malinga"],
2280:     )
2281:     sb._inn["current_bowler"] = initial_current_bowler
2282:     sb._prev_over_bowler = None
2283:     sb._bowler_must_change = False
2284:     return sb
2285: 
2286: 
2287: def _establish_bowler_stats(
2288:         sb, name: str, *,
2289:         overs: str, runs: int, wickets: int, start_frame: int) -> int:
2290:     """Push 3 consecutive reads through update_bowler() so the cold-
2291:     start tracker commits the figures and the freshness disambiguator
2292:     stamps `_bowling_card_active_write_*`.  Returns the next free
2293:     frame number (start_frame + 3).
2294:     """
2295:     f = start_frame
2296:     for _ in range(3):
2297:         sb.update_bowler(name, overs=overs, runs=runs,
2298:                          wickets=wickets, frame=f)
2299:         f += 1
2300:     return f
